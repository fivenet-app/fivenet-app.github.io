ren":170},"Development","\u002Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":195,"body":219,"description":474,"extension":475,"links":476,"meta":477,"navigation":478,"path":196,"redirect":476,"seo":479,"stem":197,"__hash__":480},"content_en\u002F9.design\u002Fdata-separation-management.md",{"type":220,"value":221,"toc":466},"minimark",[222,230,235,245,249,293,297,365,369],[223,224,225,229],"p",{},[226,227,228],"strong",{},"Status",": Implemented",[231,232,234],"h2",{"id":233},"glossary","Glossary",[236,237,238,242],"ul",{},[239,240,241],"li",{},"User - An user account that can log into FiveNet.",[239,243,244],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[231,246,248],{"id":247},"problems","Problems",[236,250,251,272,290],{},[239,252,253,254,257,258],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[226,255,256],{},"or more"," groups to an user. This is currently not really supported.\n",[236,259,260],{},[239,261,262,263,267,268,271],{},"In case of ESX an user can only have one group assigned via the ",[264,265,266],"code",{},"users"," table ",[264,269,270],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[239,273,274,275],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[236,276,277,283],{},[239,278,279,280,282],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[264,281,266],{}," .",[239,284,285,286,289],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[264,287,288],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[239,291,292],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[231,294,296],{"id":295},"goals","Goals",[236,298,299,323,345],{},[239,300,301,302],{},"Citizens - Info\u002FData Changes\n",[236,303,304,307,315],{},[239,305,306],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[239,308,309,310],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[236,311,312],{},[239,313,314],{},"A clear distinction between primary and secondary jobs is needed.",[239,316,317,318],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[236,319,320],{},[239,321,322],{},"A clear distinction between primary and secondary phone numbers is needed.",[239,324,325,326],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[236,327,328,339,342],{},[239,329,330,331],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[236,332,333,336],{},[239,334,335],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[239,337,338],{},"Ability to set citizen information based on permission levels.",[239,340,341],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[239,343,344],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[239,346,347,348,351,352,355,356],{},"Improve performance of account to citizens lookup by not having to use ",[264,349,350],{},"WHERE ","identifier",[264,353,354],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[236,357,358],{},[239,359,360,361,364],{},"An ",[264,362,363],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[231,366,368],{"id":367},"solutions","Solutions",[236,370,371,455],{},[239,372,373,374,376,377],{},"Changing the ",[264,375,288],{}," table structure.\n",[236,378,379,390,412],{},[239,380,381,382,385,386,389],{},"Adding a ",[264,383,384],{},"deleted_at"," column to be able to soft-delete users, with a ",[264,387,388],{},"deleted_reason"," field.",[239,391,392,393,395,396,399,400,403,404,407,408,411],{},"The current \"singular\" columns (",[264,394,270],{},", ",[264,397,398],{},"job",", and ",[264,401,402],{},"phone_number",") will be kept as they are, a prefix of ",[264,405,406],{},"active_"," or ",[264,409,410],{},"primary_"," might be added to clarify their purpose.",[239,413,414,415,395,418,399,421,424,425,407,428,431,432],{},"Adding new (plural named) columns for ",[264,416,417],{},"groups",[264,419,420],{},"jobs",[264,422,423],{},"phone_numbers"," that are of type ",[264,426,427],{},"JSON",[264,429,430],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[236,433,434],{},[239,435,436,437,395,440,395,443,446,447],{},"Or even seperate tables for each of them, e.g., ",[264,438,439],{},"fivenet_user_groups",[264,441,442],{},"fivenet_user_jobs",[264,444,445],{},"fivenet_user_phone_numbers",".\n",[236,448,449],{},[239,450,451,452,454],{},"These tables would have a foreign key to the ",[264,453,288],{}," table and store multiple entries per user.",[239,456,457,458],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[236,459,460,463],{},[239,461,462],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[239,464,465],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":467,"searchDepth":468,"depth":468,"links":469},"",2,[470,471,472,473],{"id":233,"depth":468,"text":234},{"id":247,"depth":468,"text":248},{"id":295,"depth":468,"text":296},{"id":367,"depth":468,"text":368},"Status: Implemented","md",null,{},true,{"title":195,"description":474},"nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",[476,476],1788904840772]