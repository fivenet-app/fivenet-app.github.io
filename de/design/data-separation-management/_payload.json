:167},"Mailer","\u002Fuser-guides\u002Fmailer","3.user-guides\u002F6.mailer",{"title":169,"path":170,"stem":171},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":173,"path":174,"stem":175},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":177,"path":178,"stem":179},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":181,"path":182,"stem":183},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":185,"path":186,"stem":187,"children":188},"Development","\u002Fdevelopment","8.development\u002F1.index",[189,190,194,198,202],{"title":185,"path":186,"stem":187},{"title":191,"path":192,"stem":193},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":195,"path":196,"stem":197},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":199,"path":200,"stem":201},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":173,"path":203,"stem":204},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":206,"path":207,"stem":208,"children":209},"Design Docs","\u002Fdesign","9.design\u002F1.index",[210,212,216,220,223,227,231],{"title":211,"path":207,"stem":208},"Designs",{"title":213,"path":214,"stem":215},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":217,"path":218,"stem":219},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":161,"path":221,"stem":222},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":224,"path":225,"stem":226},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":228,"path":229,"stem":230},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":232,"path":233,"stem":234},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":236,"title":213,"body":237,"description":492,"extension":493,"links":4,"meta":494,"navigation":495,"path":214,"redirect":4,"seo":496,"stem":215,"__hash__":497},"content_en\u002F9.design\u002Fdata-separation-management.md",{"type":238,"value":239,"toc":484},"minimark",[240,248,253,263,267,311,315,383,387],[241,242,243,247],"p",{},[244,245,246],"strong",{},"Status",": Implemented",[249,250,252],"h2",{"id":251},"glossary","Glossary",[254,255,256,260],"ul",{},[257,258,259],"li",{},"User - An user account that can log into FiveNet.",[257,261,262],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[249,264,266],{"id":265},"problems","Problems",[254,268,269,290,308],{},[257,270,271,272,275,276],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[244,273,274],{},"or more"," groups to an user. This is currently not really supported.\n",[254,277,278],{},[257,279,280,281,285,286,289],{},"In case of ESX an user can only have one group assigned via the ",[282,283,284],"code",{},"users"," table ",[282,287,288],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[257,291,292,293],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[254,294,295,301],{},[257,296,297,298,300],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[282,299,284],{}," .",[257,302,303,304,307],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[282,305,306],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[257,309,310],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[249,312,314],{"id":313},"goals","Goals",[254,316,317,341,363],{},[257,318,319,320],{},"Citizens - Info\u002FData Changes\n",[254,321,322,325,333],{},[257,323,324],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[257,326,327,328],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[254,329,330],{},[257,331,332],{},"A clear distinction between primary and secondary jobs is needed.",[257,334,335,336],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[254,337,338],{},[257,339,340],{},"A clear distinction between primary and secondary phone numbers is needed.",[257,342,343,344],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[254,345,346,357,360],{},[257,347,348,349],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[254,350,351,354],{},[257,352,353],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[257,355,356],{},"Ability to set citizen information based on permission levels.",[257,358,359],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[257,361,362],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[257,364,365,366,369,370,373,374],{},"Improve performance of account to citizens lookup by not having to use ",[282,367,368],{},"WHERE ","identifier",[282,371,372],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[254,375,376],{},[257,377,378,379,382],{},"An ",[282,380,381],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[249,384,386],{"id":385},"solutions","Solutions",[254,388,389,473],{},[257,390,391,392,394,395],{},"Changing the ",[282,393,306],{}," table structure.\n",[254,396,397,408,430],{},[257,398,399,400,403,404,407],{},"Adding a ",[282,401,402],{},"deleted_at"," column to be able to soft-delete users, with a ",[282,405,406],{},"deleted_reason"," field.",[257,409,410,411,413,414,417,418,421,422,425,426,429],{},"The current \"singular\" columns (",[282,412,288],{},", ",[282,415,416],{},"job",", and ",[282,419,420],{},"phone_number",") will be kept as they are, a prefix of ",[282,423,424],{},"active_"," or ",[282,427,428],{},"primary_"," might be added to clarify their purpose.",[257,431,432,433,413,436,417,439,442,443,425,446,449,450],{},"Adding new (plural named) columns for ",[282,434,435],{},"groups",[282,437,438],{},"jobs",[282,440,441],{},"phone_numbers"," that are of type ",[282,444,445],{},"JSON",[282,447,448],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[254,451,452],{},[257,453,454,455,413,458,413,461,464,465],{},"Or even seperate tables for each of them, e.g., ",[282,456,457],{},"fivenet_user_groups",[282,459,460],{},"fivenet_user_jobs",[282,462,463],{},"fivenet_user_phone_numbers",".\n",[254,466,467],{},[257,468,469,470,472],{},"These tables would have a foreign key to the ",[282,471,306],{}," table and store multiple entries per user.",[257,474,475,476],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[254,477,478,481],{},[257,479,480],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[257,482,483],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":485,"searchDepth":486,"depth":486,"links":487},"",2,[488,489,490,491],{"id":251,"depth":486,"text":252},{"id":265,"depth":486,"text":266},{"id":313,"depth":486,"text":314},{"id":385,"depth":486,"text":386},"Status: Implemented","md",{},true,{"title":213,"description":492},"nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",1795668797762,"327ba70d-3fd6-46b8-a994-eb9ed570f162"]