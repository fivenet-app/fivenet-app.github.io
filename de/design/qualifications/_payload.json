er-tracker-rework",{"title":232,"path":233,"stem":234},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":236,"title":232,"body":237,"description":444,"extension":445,"links":4,"meta":446,"navigation":447,"path":233,"redirect":4,"seo":448,"stem":234,"__hash__":449},"content_en\u002F9.design\u002Fqualifications.md",{"type":238,"value":239,"toc":434},"minimark",[240,248,253,266,271,304,308,311,331,335,338,349,353,403,407,430],[241,242,243,247],"p",{},[244,245,246],"strong",{},"Status",": Implemented",[249,250,252],"h2",{"id":251},"what-is-a-qualifications","What is a Qualifications?",[254,255,256,260,263],"ul",{},[257,258,259],"li",{},"An access level protected entity with a \"public\" (as in \"anyone can see\") facing name and description.",[257,261,262],{},"A training\u002Fmodule that someone has been \"granted\" or has succcessfully taken the test for.",[257,264,265],{},"A qualification can require certain prerequisites. A prerequisite can be a job rank, other successful qualification.",[267,268,270],"h3",{"id":269},"what-elements-are-needed","What elements are needed?",[254,272,273,284,287,290],{},[257,274,275,276],{},"Qualification: Holds all basic infos about the qualification.\n",[254,277,278,281],{},[257,279,280],{},"Access: Holds the access levels to the qualification.",[257,282,283],{},"Requirements: Requirements to be able to take the qualification. -> Don't deny the access to the qualification like access, but are required to send a request or to take the qualification.",[257,285,286],{},"Requests: List of user requests to take the test for the qualification.",[257,288,289],{},"Results: A \"mapping\" of score of an user test.",[257,291,292,293],{},"Tests: Test progress of (started) tests from users.\n",[254,294,295,298,301],{},[257,296,297],{},"Info\u002FConfig of the Test: E.g., how many questions need to be right to pass, how much time do they have, etc.",[257,299,300],{},"Test Questions: Questions for the qualification tests.",[257,302,303],{},"User Test Answers: Answered questions \"waiting for approval\" by a \"trainer\".",[267,305,307],{"id":306},"access-levels","Access Levels",[241,309,310],{},"Similarily structured to documents access levels.",[254,312,313,316,319,322,325,328],{},[257,314,315],{},"Blocked.",[257,317,318],{},"View.",[257,320,321],{},"Request.",[257,323,324],{},"Take.",[257,326,327],{},"Grade.",[257,329,330],{},"Edit.",[249,332,334],{"id":333},"exams","Exams",[241,336,337],{},"3 modes for a qualification with an exam:",[254,339,340,343,346],{},[257,341,342],{},"Disabled.",[257,344,345],{},"Request needed.",[257,347,348],{},"Enabled.",[267,350,352],{"id":351},"flow-request-needed","Flow - Request needed",[354,355,356],"mermaid",{},[357,358,362],"pre",{"className":359,"code":360,"language":354,"meta":361,"style":361},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sequenceDiagram\nUser->>+Qualification: Send Request\nApprover-->Qualification: Approve Request\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover->>Exam: Create Result\n","",[363,364,365,373,379,385,391,397],"code",{"__ignoreMap":361},[366,367,370],"span",{"class":368,"line":369},"line",1,[366,371,372],{},"sequenceDiagram\n",[366,374,376],{"class":368,"line":375},2,[366,377,378],{},"User->>+Qualification: Send Request\n",[366,380,382],{"class":368,"line":381},3,[366,383,384],{},"Approver-->Qualification: Approve Request\n",[366,386,388],{"class":368,"line":387},4,[366,389,390],{},"User-->Exam: Take exam\n",[366,392,394],{"class":368,"line":393},5,[366,395,396],{},"User->>Exam: Submit exam response\n",[366,398,400],{"class":368,"line":399},6,[366,401,402],{},"Approver->>Exam: Create Result\n",[267,404,406],{"id":405},"flow-enabled","Flow - Enabled",[354,408,409],{},[357,410,412],{"className":359,"code":411,"language":354,"meta":361,"style":361},"sequenceDiagram\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover