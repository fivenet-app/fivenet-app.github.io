:230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":230,"body":235,"description":442,"extension":443,"links":444,"meta":445,"navigation":446,"path":231,"redirect":444,"seo":447,"stem":232,"__hash__":448},"content_en\u002F9.design\u002Fqualifications.md",{"type":236,"value":237,"toc":432},"minimark",[238,246,251,264,269,302,306,309,329,333,336,347,351,401,405,428],[239,240,241,245],"p",{},[242,243,244],"strong",{},"Status",": Implemented",[247,248,250],"h2",{"id":249},"what-is-a-qualifications","What is a Qualifications?",[252,253,254,258,261],"ul",{},[255,256,257],"li",{},"An access level protected entity with a \"public\" (as in \"anyone can see\") facing name and description.",[255,259,260],{},"A training\u002Fmodule that someone has been \"granted\" or has succcessfully taken the test for.",[255,262,263],{},"A qualification can require certain prerequisites. A prerequisite can be a job rank, other successful qualification.",[265,266,268],"h3",{"id":267},"what-elements-are-needed","What elements are needed?",[252,270,271,282,285,288],{},[255,272,273,274],{},"Qualification: Holds all basic infos about the qualification.\n",[252,275,276,279],{},[255,277,278],{},"Access: Holds the access levels to the qualification.",[255,280,281],{},"Requirements: Requirements to be able to take the qualification. -> Don't deny the access to the qualification like access, but are required to send a request or to take the qualification.",[255,283,284],{},"Requests: List of user requests to take the test for the qualification.",[255,286,287],{},"Results: A \"mapping\" of score of an user test.",[255,289,290,291],{},"Tests: Test progress of (started) tests from users.\n",[252,292,293,296,299],{},[255,294,295],{},"Info\u002FConfig of the Test: E.g., how many questions need to be right to pass, how much time do they have, etc.",[255,297,298],{},"Test Questions: Questions for the qualification tests.",[255,300,30