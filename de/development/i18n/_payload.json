309,"searchDepth":310,"depth":310,"links":311},"",2,[312],{"id":242,"depth":310,"text":243},"md",null,{},true,"\u002Fde\u002Fdevelopment\u002Fi18n",{"title":235,"description":309},"de\u002F8.development\u002Fi18n","f7Elm0rYZH_5jqyQOJ5mtQZGTtETHrSE0xfCimD1Fmg",[322,325],{"title":197,"path":323,"stem":324,"description":309,"children":-1},"\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":326,"path":327,"stem":328,"description":329,"children":-1},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index","Willkommen im Design-Bereich der FiveNet-Dokumentation. Hier finden Sie Informationen zu den verschiedenen Designentscheidungen und -richtlinien, die bei der Entwicklung von FiveNet berücksichtigt wurden.",1789156034193]