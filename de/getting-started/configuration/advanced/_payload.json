4,211,212],{},"Object Storage",", wenn Uploads in S3-kompatiblem Storage statt im lokalen Dateisystem gespeichert werden sollen.",[201,215,216,219],{},[204,217,218],{},"OAuth2-Provider",", wenn Benutzer sich über externe Identitätsanbieter authentifizieren sollen.",[201,221,222,225],{},[204,223,224],{},"Tracing und Observability"," für Debugging, Performance-Analysen und verteiltes Request-Tracing.",[186,227,228,229,234],{},"Für die wichtigsten Optionsnamen und Konfigurationspfade siehe die ",[230,231,233],"a",{"href":232},".\u002Fconfig-reference","Konfigurationsreferenz",".",[236,237,239],"h3",{"id":238},"hinweise-zu-tracing","Hinweise zu Tracing",[198,241,242,250,257,275],{},[201,243,244,245,249],{},"Setzen Sie ",[246,247,248],"code",{},"enabled: true"," erst, wenn ein funktionierender OTLP-Endpunkt vorhanden ist.",[201,251,252,253,256],{},"Verwenden Sie in Produktion einen niedrigen ",[246,254,255],{},"ratio","-Wert, sofern Sie nicht bewusst mehr Traffic sampeln möchten.",[201,258,259,260,263,264,267,268,271,272,234],{},"Halten Sie den Wert von ",[246,261,262],{},"environment"," passend zur Umgebung, in der FiveNet läuft, zum Beispiel ",[246,265,266],{},"development",", ",[246,269,270],{},"staging"," oder ",[246,273,274],{},"production",[201,276,277,278,281],{},"Nutzen Sie ",[246,279,280],{},"attributes",", um zusätzliche Metadaten anzuhängen, die das Identifizieren von Traces in Ihrer Observability-Plattform erleichtern.",[190,283,285],{"id":284},"reverse-proxy-und-trusted-proxies","Reverse-Proxy und Trusted Proxies",[186,287,288,289,292,293,234],{},"Wenn FiveNet hinter einem oder mehreren Reverse-Proxys bereitgestellt wird, prüfen Sie die Option ",[246,290,291],{},"http.trustedProxies"," in Ihrer ",[246,294,295],{},"config.yaml",[186,297,298],{},"Das ist besonders wichtig, wenn:",[198,300,301,304,307],{},[201,302,303],{},"Client-IP-Adressen korrekt erhalten bleiben sollen",[201,305,306],{},"FiveNet hinter NGINX, Traefik oder Cloudflare läuft",[201,308,309],{},"Sie auf weitergereichte Header aus vertrauenswürdiger Infrastruktur angewiesen sind",[186,311,312,313,316,317,234],{},"Siehe die ",[230,314,233],{"href":315},".\u002Fconfig-reference#commonly-adjusted-options"," für die Einstellung ",[246,318,291],{},[190,320,212],{"id":321},"object-storage",[186,323,324,325,328],{},"Standardmäßig speichert FiveNet Uploads im lokalen Dateisystem. Für skalierbareres oder extern verwaltetes Storage können Sie über die ",[246,326,327],{},"storage","-Konfiguration auf S3-kompatibles Object Storage umstellen.",[186,330,331],{},"Das ist besonders nützlich, wenn Sie:",[198,333,334,337,340],{},[201,335,336],{},"mehrere Instanzen betreiben",[201,338,339],{},"Cloud-Infrastruktur verwenden",[201,341,342],{},"hochgeladene Dateien außerhalb des Anwendungshosts speichern möchten",[186,344,312,345,316,347,350],{},[230,346,233],{"href":315},[246,348,349],{},"storage.type"," und zugehörige Storage-Optionen.",[190,352,218],{"id":353},"oauth2-provider",[186,355,356,357,360],{},"FiveNet kann über die Konfiguration ",[246,358,359],{},"oauth2.providers"," mit externen Authentifizierungsanbietern integriert werden.",[186,362,363],{},"Nutzen Sie dies, wenn Benutzer sich über Systeme wie Discord oder einen anderen OAuth2- oder OpenID-Connect-Anbieter anmelden sollen, anstatt nur lokale Authentifizierungsabläufe zu verwenden.",[186,365,312,366,316,368,234],{},[230,367,233],{"href":315},[246,369,359],{},[190,371,373],{"id":372},"tracing","Tracing",[186,375,376],{},"FiveNet unterstützt OpenTelemetry-basiertes Tracing für die Server- und Worker-Komponenten. Damit können Sie Request-Flows, Hintergrundverarbeitung und Performance-Engpässe in komplexeren Umgebungen analysieren.",[186,378,379],{},"Tracing wird in der Regel nur benötigt, wenn Sie bereits einen Observability-Stack betreiben oder komplexere Probleme untersuchen.",[236,381,383],{"id":382},"beispielkonfiguration-für-tracing","Beispielkonfiguration für Tracing",[385,386,391],"pre",{"className":387,"code":388,"language":389,"meta":390,"style":390},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc oder otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP-Tracing-Endpunkt-URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"dev\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[246,392,393,405,418,425,443,449,464,474,485,500,512,520],{"__ignoreMap":390},[394,395,398,401],"span",{"class":396,"line":397},"line",1,[394,399,372],{"class":400},"swJcz",[394,402,404],{"class":403},"sMK4o",":\n",[394,406,408,411,414],{"class":396,"line":407},2,[394,409,410],{"class":400},"  enabled",[394,412,413],{"class":403},":",[394,415,417],{"class":416},"sfNiH"," false\n",[394,419,421],{"class":396,"line":420},3,[394,422,424],{"class":423},"sHwdD","  # otlptracegrpc oder otlptracehttp\n",[394,426,428,431,433,436,440],{"class":396,"line":427},4,[394,429,430],{"class":400},"  type",[394,432,413],{"class":403},[394,434,435],{"class":403}," \"",[394,437,439],{"class":438},"sfazB","otlptracegrpc",[394,441,442],{"class":403},"\"\n",[394,444,446],{"class":396,"line":445},5,[394,447,448],{"class":423},"  # OTLP-Tracing-Endpunkt-URL\n",[394,450,452,455,457,459,462],{"class":396,"line":451},6,[394,453,454],{"class":400},"  url",[394,456,413],{"class":403},[394,458,435],{"class":403},[394,460,461],{"class":438},"https:\u002F\u002Fexample.com:4317",[394,463,442],{"class":403},[394,465,467,470,472],{"class":396,"line":466},7,[394,468,469],{"class":400},"  insecure",[394,471,413],{"class":403},[394,473,417],{"class":416},[394,475,477,480,482],{"class":396,"line":476},8,[394,478,479],{"class":400},"  timeout",[394,481,413],{"class":403},[394,483,484],{"class":438}," 10s\n",[394,486,488,491,493,495,498],{"class":396,"line":487},9,[394,489,490],{"class":400},"  environment",[394,492,413],{"class":403},[394,494,435],{"class":403},[394,496,497],{"class":438},"dev",[394,499,442],{"class":403},[394,501,503,506,508],{"class":396,"line":502},10,[394,504,505],{"class":400},"  ratio",[394,507,413],{"class":403},[394,509,511],{"class":510},"sbssI"," 0.1\n",[394,513,515,518],{"class":396,"line":514},11,[394,516,517],{"class":400},"  attributes",[394,519,404],{"class":403},[394,521,523,526],{"class":396,"line":522},12,[394,524,525],{"class":403},"    -",[394,527,528],{"class":438}," service.name=fivenet-server\n",[530,531,532],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .s