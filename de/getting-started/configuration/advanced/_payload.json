":165},{"title":169,"path":170,"stem":171},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":173,"path":174,"stem":175},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":177,"path":178,"stem":179},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":181,"stem":182},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":184,"path":185,"stem":186,"children":187},"Design Docs","\u002Fdesign","9.design\u002F1.index",[188,190,194,198,201,205,209],{"title":189,"path":185,"stem":186},"Designs",{"title":191,"path":192,"stem":193},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":195,"path":196,"stem":197},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":199,"stem":200},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":202,"path":203,"stem":204},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":206,"path":207,"stem":208},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":210,"path":211,"stem":212},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":214,"title":215,"body":216,"description":578,"extension":579,"links":580,"meta":581,"navigation":582,"path":583,"redirect":580,"seo":584,"stem":585,"__hash__":586},"content_de\u002Fde\u002F1.getting-started\u002F5.configuration\u002F7.advanced.md","Erweiterte Konfiguration",{"type":217,"value":218,"toc":567},"minimark",[219,223,228,231,260,269,274,316,320,330,333,344,353,356,363,366,377,385,388,395,398,404,408,411,414,418,563],[220,221,222],"p",{},"Nutzen Sie diese Seite, wenn Ihre FiveNet-Einrichtung über die Basisinstallation und die erforderlichen Konfigurationsoptionen hinausgeht.",[224,225,227],"h2",{"id":226},"häufige-erweiterte-themen","Häufige erweiterte Themen",[220,229,230],{},"Die häufigsten erweiterten Konfigurationsbereiche sind:",[232,233,234,242,248,254],"ul",{},[235,236,237,241],"li",{},[238,239,240],"strong",{},"Trusted Proxies",", wenn FiveNet hinter NGINX, Traefik, Cloudflare oder einem anderen Reverse-Proxy läuft.",[235,243,244,247],{},[238,245,246],{},"Object Storage",", wenn Uploads in S3-kompatiblem Storage statt im lokalen Dateisystem gespeichert werden sollen.",[235,249,250,253],{},[238,251,252],{},"OAuth2-Provider",", wenn Benutzer sich über externe Identitätsanbieter authentifizieren sollen.",[235,255,256,259],{},[238,257,258],{},"Tracing und Observability"," für Debugging, Performance-Analysen und verteiltes Request-Tracing.",[220,261,262,263,268],{},"Für die wichtigsten Optionsnamen und Konfigurationspfade siehe die ",[264,265,267],"a",{"href":266},".\u002Fconfig-reference","Konfigurationsreferenz",".",[270,271,273],"h3",{"id":272},"hinweise-zu-tracing","Hinweise zu Tracing",[232,275,276,284,291,309],{},[235,277,278,279,283],{},"Setzen Sie ",[280,281,282],"code",{},"enabled: true"," erst, wenn ein funktionierender OTLP-Endpunkt vorhanden ist.",[235,285,286,287,290],{},"Verwenden Sie in Produktion einen niedrigen ",[280,288,289],{},"ratio","-Wert, sofern Sie nicht bewusst mehr Traffic sampeln möchten.",[235,292,293,294,297,298,301,302,305,306,268],{},"Halten Sie den Wert von ",[280,295,296],{},"environment"," passend zur Umgebung, in der FiveNet läuft, zum Beispiel ",[280,299,300],{},"development",", ",[280,303,304],{},"staging"," oder ",[280,307,308],{},"production",[235,310,311,312,315],{},"Nutzen Sie ",[280,313,314],{},"attributes",", um zusätzliche Metadaten anzuhängen, die das Identifizieren von Traces in Ihrer Observability-Plattform erleichtern.",[224,317,319],{"id":318},"reverse-proxy-und-trusted-proxies","Reverse-Proxy und Trusted Proxies",[220,321,322,323,326,327,268],{},"Wenn FiveNet hinter einem oder mehreren Reverse-Proxys bereitgestellt wird, prüfen Sie die Option ",[280,324,325],{},"http.trustedProxies"," in Ihrer ",[280,328,329],{},"config.yaml",[220,331,332],{},"Das ist besonders wichtig, wenn:",[232,334,335,338,341],{},[235,336,337],{},"Client-IP-Adressen korrekt erhalten bleiben sollen",[235,339,340],{},"FiveNet hinter NGINX, Traefik oder Cloudflare läuft",[235,342,343],{},"Sie auf weitergereichte Header aus vertrauenswürdiger Infrastruktur angewiesen sind",[220,345,346,347,350,351,268],{},"Siehe die ",[264,348,267],{"href":349},".\u002Fconfig-reference#commonly-adjusted-options"," für die Einstellung ",[280,352,325],{},[224,354,246],{"id":355},"object-storage",[220,357,358,359,362],{},"Standardmäßig speichert FiveNet Uploads im lokalen Dateisystem. Für skalierbareres oder extern verwaltetes Storage können Sie über die ",[280,360,361],{},"storage","-Konfiguration auf S3-kompatibles Object Storage umstellen.",[220,364,365],{},"Das ist besonders nützlich, wenn Sie:",[232,367,368,371,374],{},[235,369,370],{},"mehrere Instanzen betreiben",[235,372,373],{},"Cloud-Infrastruktur verwenden",[235,375,376],{},"hochgeladene Dateien außerhalb des Anwendungshosts speichern möchten",[220,378,346,379,350,381,384],{},[264,380,267],{"href":349},[280,382,383],{},"storage.type"," und zugehörige Storage-Optionen.",[224,386,252],{"id":387},"oauth2-provider",[220,389,390,391,394],{},"FiveNet kann über die Konfiguration ",[280,392,393],{},"oauth2.providers"," mit externen Authentifizierungsanbietern integriert werden.",[220,396,397],{},"Nutzen Sie dies, wenn Benutzer sich über Systeme wie Discord oder einen anderen OAuth2- oder OpenID-Connect-Anbieter anmelden sollen, anstatt nur lokale Authentifizierungsabläufe zu verwenden.",[220,399,346,400,350,402,268],{},[264,401,267],{"href":349},[280,403,393],{},[224,405,407],{"id":406},"tracing","Tracing",[220,409,410],{},"FiveNet unterstützt OpenTelemetry-basiertes Tracing für die Server- und Worker-Komponenten. Damit können Sie Request-Flows, Hintergrundverarbeitung und Performance-Engpässe in komplexeren Umgebungen analysieren.",[220,412,413],{},"Tracing wird in der Regel nur benötigt, wenn Sie bereits einen Observability-Stack betreiben oder komplexere Probleme untersuchen.",[270,415,417],{"id":416},"beispielkonfiguration-für-tracing","Beispielkonfiguration für Tracing",[419,420,425],"pre",{"className":421,"code":422,"language":423,"meta":424,"style":424},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc oder otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP-Tracing-Endpunkt-URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"dev\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[280,426,427,439,452,459,477,483,498,508,519,534,546,554],{"__ignoreMap":424},[428,429,432,435],"span",{"class":430,"line":431},"line",1,[428,433,406],{"class":434},"swJcz",[428,436,438],{"class":437},"sMK4o",":\n",[428,440,442,445,448],{"class":430,"line":441},2,[428,443,444],{"class":434},"  enabled",[428,446,447],{"class":437},":",[428,449,451],{"class":450},"sfNiH"," false\n",[428,453,455],{"class":430,"line":454},3,[428,456,458],{"class":457},"sHwdD","  # otlptracegrpc oder otlptracehttp\n",[428,460,462,465,467,470,474],{"class":430,"line":461},4,[428,463,464],{"class":434},"  type",[428,466,447],{"class":437},[428,468,469],{"class":437}," \"",[428,471,473],{"class":472},"sfazB","otlptracegrpc",[428,475,476],{"class":437},"\"\n",[428,478,480],{"class":430,"line":479},5,[428,481,482],{"class":457},"  # OTLP-Tracing-Endpunkt-URL\n",[428,484,486,489,491,493,496],{"class":430,"line":485},6,[428,487,488],{"class":434},"  url",[428,490,447],{"class":437},[428,492,469],{"class":437},[428,494,495],{"class":472},"https:\u002F\u002Fexample.com:4317",[428,497,476],{"class":437},[428,499,501,504,506],{"class":430,"li