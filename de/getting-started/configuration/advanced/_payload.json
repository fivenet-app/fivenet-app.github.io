,[208,209,210],"strong",{},"Trusted Proxies",", wenn FiveNet hinter NGINX, Traefik, Cloudflare oder einem anderen Reverse-Proxy läuft.",[205,213,214,217],{},[208,215,216],{},"Object Storage",", wenn Uploads in S3-kompatiblem Storage statt im lokalen Dateisystem gespeichert werden sollen.",[205,219,220,223],{},[208,221,222],{},"OAuth2-Provider",", wenn Benutzer sich über externe Identitätsanbieter authentifizieren sollen.",[205,225,226,229],{},[208,227,228],{},"Tracing und Observability"," für Debugging, Performance-Analysen und verteiltes Request-Tracing.",[190,231,232,233,238],{},"Für die wichtigsten Optionsnamen und Konfigurationspfade siehe die ",[234,235,237],"a",{"href":236},".\u002Fconfig-reference","Konfigurationsreferenz",".",[240,241,243],"h3",{"id":242},"hinweise-zu-tracing","Hinweise zu Tracing",[202,245,246,254,261,279],{},[205,247,248,249,253],{},"Setzen Sie ",[250,251,252],"code",{},"enabled: true"," erst, wenn ein funktionierender OTLP-Endpunkt vorhanden ist.",[205,255,256,257,260],{},"Verwenden Sie in Produktion einen niedrigen ",[250,258,259],{},"ratio","-Wert, sofern Sie nicht bewusst mehr Traffic sampeln möchten.",[205,262,263,264,267,268,271,272,275,276,238],{},"Halten Sie den Wert von ",[250,265,266],{},"environment"," passend zur Umgebung, in der FiveNet läuft, zum Beispiel ",[250,269,270],{},"development",", ",[250,273,274],{},"staging"," oder ",[250,277,278],{},"production",[205,280,281,282,285],{},"Nutzen Sie ",[250,283,284],{},"attributes",", um zusätzliche Metadaten anzuhängen, die das Identifizieren von Traces in Ihrer Observability-Plattform erleichtern.",[194,287,289],{"id":288},"reverse-proxy-und-trusted-proxies","Reverse-Proxy und Trusted Proxies",[190,291,292,293,296,297,238],{},"Wenn FiveNet hinter einem oder mehreren Reverse-Proxys bereitgestellt wird, prüfen Sie die Option ",[250,294,295],{},"http.trustedProxies"," in Ihrer ",[250,298,299],{},"config.yaml",[190,301,302],{},"Das ist besonders wichtig, wenn:",[202,304,305,308,311],{},[205,306,307],{},"Client-IP-Adressen korrekt erhalten bleiben sollen",[205,309,310],{},"FiveNet hinter NGINX, Traefik oder Cloudflare läuft",[205,312,313],{},"Sie auf weitergereichte Header aus vertrauenswürdiger Infrastruktur angewiesen sind",[190,315,316,317,320,321,238],{},"Siehe die ",[234,318,237],{"href":319},".\u002Fconfig-reference#commonly-adjusted-options"," für die Einstellung ",[250,322,295],{},[194,324,216],{"id":325},"object-storage",[190,327,328,329,332],{},"Standardmäßig speichert FiveNet Uploads im lokalen Dateisystem. Für skalierbareres oder extern verwaltetes Storage können Sie über die ",[250,330,331],{},"storage","-Konfiguration auf S3-kompatibles Object Storage umstellen.",[190,334,335],{},"Das ist besonders nützlich, wenn Sie:",[202,337,338,341,344],{},[205,339,340],{},"mehrere Instanzen betreiben",[205,342,343],{},"Cloud-Infrastruktur verwenden",[205,345,346],{},"hochgeladene Dateien außerhalb des Anwendungshosts speichern möchten",[190,348,316,349,320,351,354],{},[234,350,237],{"href":319},[250,352,353],{},"storage.type"," und zugehörige Storage-Optionen.",[194,356,222],{"id":357},"oauth2-provider",[190,359,360,361,364],{},"FiveNet kann über die Konfiguration ",[250,362,363],{},"oauth2.providers"," mit externen Authentifizierungsanbietern integriert werden.",[190,366,367],{},"Nutzen Sie dies, wenn Benutzer sich über Systeme wie Discord oder einen anderen OAuth2- oder OpenID-Connect-Anbieter anmelden sollen, anstatt nur lokale Authentifizierungsabläufe zu verwenden.",[190,369,316,370,320,372,238],{},[234,371,237],{"href":319},[250,373,363],{},[194,375,377],{"id":376},"tracing","Tracing",[190,379,380],{},"FiveNet unterstützt OpenTelemetry-basiertes Tracing für die Server- und Worker-Komponenten. Damit können Sie Request-Flows, Hintergrundverarbeitung und Performance-Engpässe in komplexeren Umgebungen analysieren.",[190,382,383],{},"Tracing wird in der Regel nur benötigt, wenn Sie bereits einen Observability-Stack betreiben oder komplexere Probleme untersuchen.",[240,385,387],{"id":386},"beispielkonfiguration-für-tracing","Beispielkonfiguration für Tracing",[389,390,395],"pre",{"className":391,"code":392,"language":393,"meta":394,"style":394},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc oder otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP-Tracing-Endpunkt-URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"dev\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[250,396,397,409,422,429,447,453,468,478,489,504,516,524],{"__ignoreMap":394},[398,399,402,405],"span",{"class":400,"line":401},"line",1,[398,403,376],{"class":404},"swJcz",[398,406,408],{"class":407},"sMK4o",":\n",[398,410,412,415,418],{"class":400,"line":411},2,[398,413,414],{"class":404},"  enabled",[398,416,417],{"class":407},":",[398,419,421],{"class":420},"sfNiH"," false\n",[398,423,425],{"class":400,"line":424},3,[398,426,428],{"class":427},"sHwdD","  # otlptracegrpc oder otlptracehttp\n",[398,430,432,435,437,440,444],{"class":400,"line":431},4,[398,433,434],{"class":404},"  type",[398,436,417],{"class":407},[398,438,439],{"class":407}," \"",[398,441,443],{"class":442},"sfazB","otlptracegrpc",[398,445,446],{"class":407},"\"\n",[398,448,450],{"class":400,"line":449},5,[398,451,452],{"class":427},"  # OTLP-Tracing-Endpunkt-URL\n",[398,454,456,459,461,463,466],{"class":400,"line":455},6,[398,457,458],{"class":404},"  url",[398,460,417],{"class":407},[398,462,439],{"class":407},[398,464,465],{"class":442},"https:\u002F\u002Fexample.com:4317",[398,467,446],{"class":407},[398,469,471,474,476],{"class":400,"line":470},7,[398,472,473],{"class":404},"  insecure",[398,475,417],{"class":407},[398,477,421],{"class":420},[398,479,481,484,486],{"class":400,"line":480},8,[398,482,483],{"class":404},"  timeout",[398,485,417],{"class":407},[398,487,488],{"class":442}," 10s\n",[