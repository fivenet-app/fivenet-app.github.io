ts\u002Ftemplates","de\u002F3.user-guides\u002F3.documents\u002Ftemplates",{"title":146,"path":147,"stem":148},"Jobs","\u002Fde\u002Fuser-guides\u002Fjobs","de\u002F3.user-guides\u002F3.jobs",{"title":150,"path":151,"stem":152},"Kalender","\u002Fde\u002Fuser-guides\u002Fcalendar","de\u002F3.user-guides\u002F4.calendar",{"title":154,"path":155,"stem":156},"Livemap","\u002Fde\u002Fuser-guides\u002Flivemap","de\u002F3.user-guides\u002F5.livemap",{"title":158,"path":159,"stem":160},"Einsatzzentrale","\u002Fde\u002Fuser-guides\u002Fcentrum","de\u002F3.user-guides\u002F6.centrum",{"title":162,"path":163,"stem":164},"Mailer","\u002Fde\u002Fuser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":166,"path":167,"stem":168},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":170,"path":171,"stem":172},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":174,"path":175,"stem":176},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":178,"path":179,"stem":180},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":182,"path":183,"stem":184,"children":185},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[186,187,191],{"title":182,"path":183,"stem":184},{"title":188,"path":189,"stem":190},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":170,"path":192,"stem":193},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":195,"path":196,"stem":197,"children":198},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[199],{"title":195,"path":196,"stem":197},{"id":201,"title":62,"body":202,"description":842,"extension":843,"links":844,"meta":845,"navigation":496,"path":63,"redirect":844,"seo":846,"stem":64,"__hash__":847},"content_de\u002Fde\u002F1.getting-started\u002F5.configuration\u002F2.configure.md",{"type":203,"value":204,"toc":829},"minimark",[205,209,216,221,224,248,251,259,262,287,297,301,304,382,385,392,396,399,402,470,473,549,552,556,563,589,595,599,605,631,641,645,648,689,692,696,699,738,748,752,755,781,791,795,798,815,825],[206,207,208],"p",{},"Nutzen Sie diese Anleitung, nachdem Sie eine Bereitstellungsmethode gewählt haben und bevor Sie DBSync oder das FiveM-Plugin einrichten. Sie behandelt die minimale Konfiguration für eine funktionierende FiveNet-Installation.",[206,210,211,212,215],{},"Eine vollständige Übersicht aller Optionen und Standardwerte finden Sie in der ",[213,214,96],"a",{"href":97},". Die Beispieldatei im FiveNet-Repository bleibt die maßgebliche Quelle für die vollständige Konfiguration.",[217,218,220],"h2",{"id":219},"voraussetzungen","Voraussetzungen",[206,222,223],{},"Stellen Sie sicher, dass Sie Folgendes haben:",[225,226,227,231,234,237,240],"ul",{},[228,229,230],"li",{},"Eine unterstützte MySQL- oder MariaDB-Datenbank.",[228,232,233],{},"Einen NATS-Server mit aktiviertem JetStream.",[228,235,236],{},"Eine öffentliche HTTPS-URL für FiveNet oder einen Plan, die Instanz über einen Reverse-Proxy bereitzustellen.",[228,238,239],{},"Einen Speicherort für Uploads: ein persistentes lokales Verzeichnis oder S3-kompatiblen Storage.",[228,241,242,243,247],{},"Die ",[244,245,246],"code",{},"config.example.yaml","-Datei aus demselben Release wie das eingesetzte FiveNet-Image oder die verwendete Binary.",[206,249,250],{},"Wenn Sie Docker oder Helm verwenden, folgen Sie zuerst der jeweiligen Bereitstellungsanleitung, damit Sie wissen, wo die Konfigurationsdatei eingebunden wird und unter welchen internen Hostnamen die Dienste erreichbar sind.",[217,252,254,255,258],{"id":253},"_1-configyaml-erstellen","1. ",[244,256,257],{},"config.yaml"," erstellen",[206,260,261],{},"Kopieren Sie die Beispieldatei und bewahren Sie sie bei den Bereitstellungsdateien auf. Bearbeiten Sie die Beispieldatei nicht direkt:",[263,264,269],"pre",{"className":265,"code":266,"language":267,"meta":268,"style":268},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cp config.example.yaml config.yaml\n","bash","",[244,270,271],{"__ignoreMap":268},[272,273,276,280,284],"span",{"class":274,"line":275},"line",1,[272,277,279],{"class":278},"sBMFI","cp",[272,281,283],{"class":282},"sfazB"," config.example.yaml",[272,285,286],{"class":282}," config.yaml\n",[206,288,289,290,292,293,296],{},"Bei containerisierten Bereitstellungen binden Sie die fertige ",[244,291,257],{}," an dem in der Bereitstellungsvorlage erwarteten Ort ein. FiveNet sucht zuerst im aktuellen Arbeitsverzeichnis und danach in ",[244,294,295],{},"\u002Fconfig"," nach der Datei.",[217,298,300],{"id":299},"_2-öffentliche-url-konfigurieren","2. Öffentliche URL konfigurieren",[206,302,303],{},"Setzen Sie die URL, die Benutzer im Browser öffnen:",[263,305,309],{"className":306,"code":307,"language":308,"meta":268,"style":268},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","http:\n  publicURL: \"https:\u002F\u002Ffivenet.example.com\"\n  origins:\n    - \"https:\u002F\u002Ffivenet.example.com\"\n  sessions:\n    domain: \"fivenet.example.com\"\n","yaml",[244,310,311,321,339,347,359,367],{"__ignoreMap":268},[272,312,313,317],{"class":274,"line":275},[272,314,316],{"class":315},"swJcz","http",[272,318,320],{"class":319},"sMK4o",":\n",[272,322,324,327,330,333,336],{"class":274,"line":323},2,[272,325,326],{"class":315},"  publicURL",[272,328,329],{"class":319},":",[272,331,332],{"class":319}," \"",[272,334,335],{"class":282},"https:\u002F\u002Ffivenet.example.com",[272,337,338],{"class":319},"\"\n",[272,340,342,345],{"class":274,"line":341},3,[272,343,344],{"class":315},"  origins",[272,346,320],{"class":319},[272,348,350,353,355,357],{"class":274,"line":349},4,[272,351,352],{"class":319},"    -",[272,354,332],{"class":319},[272,356,335],{"class":282},[272,358,338],{"class":319},[272,360,362,365],{"class":274,"line":361},5,[272,363,364],{"class":315},"  sessions",[272,366,320],{"class":319},[272,368,370,373,375,377,380],{"class":274,"line":369},6,[272,371,372],{"class":315},"    domain",[272,374,329],{"class":319},[272,376,332],{"class":319},[272,378,379],{"class":282},"fivenet.example.com",[272,381,338],{"class":319},[206,383,384],{},"URL, Browser-Origin und Session-Domain müssen zur Domain Ihres Reverse-Proxys passen. Wenn Sie einen separaten Hostnamen für API- oder Plugin-Datenverkehr verwenden, ergänzen Sie die Origins entsprechend Ihrer Bereitstellung.",[206,386,387,388,391],{},"Prüfen Sie ",[244,389,390],{},"http.trustedProxies",", wenn FiveNet hinter NGINX, Traefik, Cloudflare oder einem anderen Proxy läuft. Tragen Sie dort nur Proxy-Adressen oder Netzwerke ein, die Sie kontrollieren.",[217,393,395],{"id":394},"_3-secrets-generieren-und-speichern","3. Secrets generieren und speichern",[206,397,398],{},"Generieren Sie eindeutige Werte für das Anwendungs-Secret, das Session-Cookie-Secret und das JWT-Secret. Bewahren Sie sie nach der Bereitstellung unverändert auf und committen Sie sie nicht in ein öffentliches Repository.",[206,400,401],{},"Zum Beispiel können Sie je nach Betriebssystem folgenden Befehl verwenden:",[403,404,405,426],"code-group",{},[263,406,409],{"className":265,"code":407,"filename":408,"language":267,"meta":268,"style":268},"openssl rand -base64 32\n","Linux \u002F macOS",[244,410,411],{"__ignoreMap":268},[272,412,413,416,419,422],{"class":274,"line":275},[272,414,415],{"class":278},"openssl",[272,417,418],{"class":282}," rand",[272,420,421],{"class":282}," -base64",[272,423,425],{"class":424},"sbssI"," 32\n",[263,427,432],{"className":428,"code":429,"filename":430,"language":431,"meta":268,"style":268},"language-powershell shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))\n","Windows","powershell",[244,433,434],{"__ignoreMap":268},[272,435,436,439,443,446,450,453,456,458,461,464,467],{"class":274,"line":275},[272,437,438],{"class":319},"[",[272,440,442],{"class":441},"spNyl","Convert",[272,444,445],{"class":319},"]",[272,447,449],{"class":448},"sTEyZ","::ToBase64String",[272,451,452],{"class":319},"([",[272,454,455],{"class":441},"Security.Cryptography.RandomNumberGenerator",[272,457,445],{"class":319},[272,459,460],{"class":448},"::GetBytes",[272,462,463],{"class":319},"(",[272,465,466],{"class":424},"32",[272,468,469],{"class":319},"))\n",[206,471,472],{},"Tragen Sie die erzeugten Werte in den entsprechenden Optionen ein:",[263,474,476],{"className":306,"code":475,"language":308,"meta":268,"style":268},"secret: \"CHANGE_ME\"\n\nhttp:\n  sessions:\n    cookieSecret: \"CHANGE_ME\"\n\njwt:\n  secret: \"CHANGE_ME\"\n",[244,477,478,492,498,504,510,523,527,535],{"__ignoreMap":268},[272,479,480,483,485,487,490],{"class":274,"line":275},[272,481,482],{"class":315},"secret",[272,484,329],{"class":319},[272,486,332],{"class":319},[272,488,489],{"class":282},"CHANGE_ME",[272,491,338],{"class":319},[272,493,494],{"class":274,"line":323},[272,495,497],{"emptyLinePlaceholder":496},true,"\n",[272,499,500,502],{"class":274,"line":341},[272,501,316],{"class":315},[272,503,320],{"class":319},[272,505,506,508],{"class":274,"line":349},[272,507,364],{"class":315},[272,509,320],{"class":319},[272,511,512,515,517,519,521],{"class":274,"line":361},[272,513,514],{"class":315},"    cookieSecret",[272,516,329],{"class":319},[272,518,332],{"class":319},[272,520,489],{"class":282},[272,522,338],{"class":319},[272,524,525],{"class":274,"line":369},[272,526,497],{"emptyLinePlaceholder":496},[272,528,530,533],{"class":274,"line":529},7,[272,531,532],{"class":315},"jwt",[272,534,320],{"class":319},[272,536,538,541,543,545,547],{"class":274,"line":537},8,[272,539,540],{"class":315},"  secret",[272,542,329],{"class":319},[272,544,332],{"class":319},[272,546,489],{"class":282},[272,548,338],{"class":319},[206,550,551],{},"Eine spätere Änderung dieser Werte kann Sitzungen oder Tokens ungültig machen. Behandeln Sie Sync-API-Tokens ebenfalls als Secrets.",[217,553,555],{"id":554},"_4-fivenet-datenbank-konfigurieren","4. FiveNet-Datenbank konfigurieren",[206,557,558,559,562],{},"Setzen Sie ",[244,560,561],{},"database.dsn"," auf die von FiveNet verwendete MySQL- oder MariaDB-Datenbank:",[263,564,566],{"className":306,"code":565,"language":308,"meta":268,"style":268},"database:\n  dsn: \"DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\"\n",[244,567,568,575],{"__ignoreMap":268},[272,569,570,573],{"class":274,"line":275},[272,571,572],{"class":315},"database",[272,574,320],{"class":319},[272,576,577,580,582,584,587],{"class":274,"line":323},[272,578,579],{"class":315},"  dsn",[272,581,329],{"class":319},[272,583,332],{"class":319},[272,585,586],{"class":282},"DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin",[272,588,338],{"class":319},[206,590,591,592,594],{},"Verwenden Sie einen Datenbankbenutzer mit den für FiveNet-Migrationen und den normalen Betrieb erforderlichen Berechtigungen. Die konfigurierte Kollation sollte mit der Datenbank und den Tabellen übereinstimmen. Siehe ",[213,593,100],{"href":101},", wenn Migrationen Kollations- oder Fremdschlüsselfehler melden.",[217,596,598],{"id":597},"_5-nats-konfigurieren","5. NATS konfigurieren",[206,600,558,601,604],{},[244,602,603],{},"nats.url"," auf den NATS-Server und stellen Sie sicher, dass JetStream aktiviert ist:",[263,606,608],{"className":306,"code":607,"language":308,"meta":268,"style":268},"nats:\n  url: \"nats:\u002F\u002FUSER:PASSWORD@NATS_HOST:4222\"\n",[244,609,610,617],{"__ignoreMap":268},[272,611,612,615],{"class":274,"line":275},[272,613,614],{"class":315},"nats",[272,616,320],{"class":319},[272,618,619,622,624,626,629],{"class":274,"line":323},[272,620,621],{"class":315},"  url",[272,623,329],{"class":319},[272,625,332],{"class":319},[272,627,628],{"class":282},"nats:\u002F\u002FUSER:PASSWORD@NATS_HOST:4222",[272,630,338],{"class":319},[206,632,633,634,636,637,640],{},"Wenn FiveNet in Docker Compose läuft, verwenden Sie den Namen des NATS-Dienstes als Hostnamen, z. B. ",[244,635,614],{},", und nicht ",[244,638,639],{},"localhost",". In Kubernetes verwenden Sie den DNS-Namen des NATS-Service.",[217,642,644],{"id":643},"_6-sync-api-aktivieren","6. Sync-API aktivieren",[206,646,647],{},"DBSync und das FiveM-Plugin verwenden die Sync-API. Aktivieren Sie sie und erstellen Sie mindestens ein langes, eindeutiges Token:",[263,649,651],{"className":306,"code":650,"language":308,"meta":268,"style":268},"sync:\n  enabled: true\n  apiTokens:\n    - \"CHANGE_ME_TO_A_LONG_RANDOM_TOKEN\"\n",[244,652,653,660,671,678],{"__ignoreMap":268},[272,654,655,658],{"class":274,"line":275},[272,656,657],{"class":315},"sync",[272,659,320],{"class":319},[272,661,662,665,667],{"class":274,"line":323},[272,663,664],{"class":315},"  enabled",[272,666,329],{"class":319},[272,668,670],{"class":669},"sfNiH"," true\n",[272,672,673,676],{"class":274,"line":341},[272,674,675],{"class":315},"  apiTokens",[272,677,320],{"class":319},[272,679,680,682,684,687],{"class":274,"line":349},[272,681,352],{"class":319},[272,683,332],{"class":319},[272,685,686],{"class":282},"CHANGE_ME_TO_A_LONG_RANDOM_TOKEN",[272,688,338],{"class":319},[206,690,691],{},"Verwenden Sie das Token nur in den DBSync- und Plugin-Konfigurationen, die es benötigen. Wenn Sie das Token austauschen, aktualisieren Sie beide Integrationen.",[217,693,695],{"id":694},"_7-upload-speicher-konfigurieren","7. Upload-Speicher konfigurieren",[206,697,698],{},"Der standardmäßige Dateisystem-Speicher ist für eine einzelne Instanz geeignet, wenn das Verzeichnis persistent ist:",[263,700,702],{"className":306,"code":701,"language":308,"meta":268,"style":268},"storage:\n  type: filesystem\n  filesystem:\n    path: \u002Fdata\n",[244,703,704,711,721,728],{"__ignoreMap":268},[272,705,706,709],{"class":274,"line":275},[272,707,708],{"class":315},"storage",[272,710,320],{"class":319},[272,712,713,716,718],{"class":274,"line":323},[272,714,715],{"class":315},"  type",[272,717,329],{"class":319},[272,719,720],{"class":282}," filesystem\n",[272,722,723,726],{"class":274,"line":341},[272,724,725],{"class":315},"  filesystem",[272,727,320],{"class":319},[272,729,730,733,735],{"class":274,"line":349},[272,731,732],{"class":315},"    path",[272,734,329],{"class":319},[272,736,737],{"class":282}," \u002Fdata\n",[206,739,740,741,744,745,747],{},"Stellen Sie sicher, dass ",[244,742,743],{},"\u002Fdata"," in Docker oder Kubernetes durch ein persistentes Volume gesichert ist. Für mehrere Instanzen oder extern verwaltete Uploads konfigurieren Sie stattdessen den S3-kompatiblen Speicher. Siehe ",[213,746,92],{"href":93},".",[217,749,751],{"id":750},"_8-zugriff-auf-die-erstkonfiguration-gewähren","8. Zugriff auf die Erstkonfiguration gewähren",[206,753,754],{},"Geben Sie der Gruppe Ihres ersten Administrators Zugriff auf die Konfigurationseinstellungen:",[263,756,758],{"className":306,"code":757,"language":308,"meta":268,"style":268},"auth:\n  configAdminGroups:\n    - admin\n",[244,759,760,767,774],{"__ignoreMap":268},[272,761,762,765],{"class":274,"line":275},[272,763,764],{"class":315},"auth",[272,766,320],{"class":319},[272,768,769,772],{"class":274,"line":323},[272,770,771],{"class":315},"  configAdminGroups",[272,773,320],{"class":319},[272,775,776,778],{"class":274,"line":341},[272,777,352],{"class":319},[272,779,780],{"class":282}," admin\n",[206,782,783,784,787,788,790],{},"Alternativ können Sie ",[244,785,786],{},"auth.configAdminUsers"," für bestimmte Benutzer verwenden. Das erste Konto muss trotzdem erstellt und registriert werden, wie unter ",[213,789,52],{"href":53}," beschrieben.",[217,792,794],{"id":793},"_9-fivenet-starten-und-prüfen","9. FiveNet starten und prüfen",[206,796,797],{},"Starten Sie die Bereitstellung mit dem für Ihre Installationsmethode passenden Befehl. Prüfen Sie anschließend:",[225,799,800,803,806,809,812],{},[228,801,802],{},"Der Server startet ohne Datenbank- oder NATS-Fehler.",[228,804,805],{},"Datenbankmigrationen werden erfolgreich abgeschlossen.",[228,807,808],{},"Die konfigurierte öffentliche URL ist über HTTPS erreichbar.",[228,810,811],{},"Das erste Konto kann sich registrieren und anmelden.",[228,813,814],{},"Der Upload-Speicher ist beschreibbar.",[206,816,817,818,821,822,824],{},"Wenn der Kernserver funktioniert, fahren Sie mit ",[213,819,820],{"href":67},"DBSync"," und anschließend mit ",[213,823,52],{"href":53}," fort.",[826,827,828],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background