207,208],{},"Kollation"," Ihrer Datenbank, Tabellen und Spalten konsistent sind.",[190,211,212],{},"Kollationsfehler gehören zu den häufigsten Gründen, warum Datenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[214,215,216],"callout",{},[190,217,218,219,223,224],{},"Empfohlene Kollation: ",[220,221,222],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[220,225,226],{},"utf8mb4",[194,228,230],{"id":229},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[190,232,233],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[235,236,241],"pre",{"className":237,"code":238,"language":239,"meta":240,"style":240},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql","",[220,242,243,267,287],{"__ignoreMap":240},[244,245,248,252,256,260,263],"span",{"class":246,"line":247},"line",1,[244,249,251],{"class":250},"sbssI","USE",[244,253,255],{"class":254},"sMK4o"," `",[244,257,259],{"class":258},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[244,261,262],{"class":254},"`",[244,264,266],{"class":265},"sTEyZ",";\n",[244,268,270,273,276,279,281,283,285],{"class":246,"line":269},2,[244,271,272],{"class":265},"SHOW ",[244,274,275],{"class":250},"CREATE",[244,277,278],{"class":250}," DATABASE",[244,280,255],{"class":254},[244,282,259],{"class":258},[244,284,262],{"class":254},[244,286,266],{"class":265},[244,288,290,292,295,298],{"class":246,"line":289},3,[244,291,272],{"class":265},[244,293,294],{"class":250},"TABLE",[244,296,297],{"class":250}," STATUS",[244,299,266],{"class":265},[190,301,302],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[235,304,306],{"className":237,"code":305,"language":239,"meta":240,"style":240},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[220,307,308],{"__ignoreMap":240},[244,309,310,312,314,317,319,322,324],{"class":246,"line":247},[244,311,272],{"class":265},[244,313,275],{"class":250},[244,315,316],{"class":250}," TABLE",[244,318,255],{"class":254},[244,320,321],{"class":258},"__IHRE_TABELLEN_NAME_HIER__",[244,323,262],{"class":254},[244,325,266],{"class":265},[194,327,329],{"id":328},"kollationskonflikte-beheben","Kollationskonflikte beheben",[190,331,332,333,335,336,338,339,346],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[220,334,226],{},"\u002F",[220,337,222],{}," in MySQL 5.5 finden Sie auf ",[340,341,345],"a",{"href":342,"rel":343},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[344],"nofollow","Database Administrators Stack Exchange",".",[190,348,349],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[235,351,353],{"className":237,"code":352,"language":239,"meta":240,"style":240},"SET foreign_key_checks = 0;\n",[220,354,355],{"__ignoreMap":240},[244,356,357,360,363,366,369],{"class":246,"line":247},[244,358,359],{"class":250},"SET",[244,361,362],{"class":265}," foreign_key_checks ",[244,364,365],{"class":254},"=",[244,367,368],{"class":250}," 0",[244,370,266],{"class":265},[190,372,373],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[235,375,377],{"className":237,"code":376,"language":239,"meta":240,"style":240},"SET foreign_key_checks = 1;\n",[220,378,379],{"__ignoreMap":240},[244,380,381,383,385,387,390],{"class":246,"line":247},[244,382,359],{"class":250},[244,384,362],{"class":265},[244,386,365],{"class":254},[244,388,389],{"class":250}," 1",[244,391,266],{"class":265},[393,394,395],"warning",{},[190,396,397],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[194,399,401],{"id":400},"dsn-kollation","DSN-Kollation",[190,403,404],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[190,406,407],{},"Beispiel:",[235,409,414],{"className":410,"code":412,"language":413,"meta":240},[411],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[220,415,412],{"__ignoreMap":240},[190,417,418],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[194,420,422],{"id":421},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[190,424,425,426,429,430,205,433,436],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[220,427,428],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[220,431,432],{},"password",[220,434,435],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[235,438,440],{"className":237,"code":439,"language":239,"meta":240,"style":240},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[220,441,442,480],{"__ignoreMap":240},[244,443,444,446,449,452,455,458,461,464,466,469,472,474,476,478],{"class":246,"line":247},[244,445,275],{"class":250},[244,447,448],{"class":250}," USER",[244,450,451],{"class":265}," '",[244,453,428],{"class":454},"s2Zo4",[244,456,457],{"class":265},"'@",[244,459,460],{"class":254},"'",[244,462,463],{"class":258},"%",[244,465,460],{"class":254},[244,467,468],{"class":265}," IDENTIFIED ",[244,470,471],{"class":250},"BY",[244,473,451],{"class":254},[244,475,432],{"class":258},[244,477,460],{"class":254},[244,479,266],{"class":265},[244,481,482,485,488,491,493,495,497,499,502,505,507,509,511,514,516,518,520],{"class":246,"line":269},[244,483,484],{"class":250},"GRANT",[244,486,487],{"class":265}," ALL PRIVILEGES ",[244,489,490],{"class":250},"ON",[244,492,255],{"class":254},[244,494,435],{"class":258},[244,496,262],{"class":254},[244,498,346],{"class":265},[244,500,501],{"class":254},"*",[244,503,504],{"class":250}," TO",[244,506,451],{"class":254},[244,508,428],{"class":258},[244,510,460],{"class":254},[244,512,513],{"class":265},"@",[244,515,460],{"class":254},[244,517,463],{"class":258},[244,519,460],{"class":254},[244,521,266],{"class":265},[190,523,524,525,528],{},"Für einen separaten DBSync-Quellbenutzer reicht in der Regel Lesezugriff aus. Siehe ",[340,526,66],{"href":527},".\u002Fdbsync"," für ein Beispiel eines dedizierten Nur-Lese-Benutzers.",[194,530,532],{"id":531},"empfohlene-werkzeuge","Empfohlene Werkzeuge",[190,534,535,540],{},[340,536,539],{"href":537,"rel":538},"https:\u002F\u002Fdbeaver.io\u002F",[344],"DBeaver"," ist ein gutes allgemeines Datenbankverwaltungswerkzeug, wenn Sie lieber mit einer grafischen Oberfläche Schemas, Kollationen und Daten prüfen möchten.",[542,543,544],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);ba