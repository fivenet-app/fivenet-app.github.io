432,436,439,442,450,453,457,471,556,563,567,575],[224,225,226],"p",{},"Verstehen Sie die Datenbank-Standards, die FiveNet erwartet, und wie Sie häufige migrationsbezogene Kollationsprobleme vermeiden.",[228,229,231],"h2",{"id":230},"zeichensatz-und-kollation","Zeichensatz und Kollation",[224,233,234,235,239,240,243],{},"Stellen Sie sicher, dass ",[236,237,238],"strong",{},"Zeichensatz"," und ",[236,241,242],{},"Kollation"," Ihrer Datenbank, Tabellen und Spalten konsistent sind.",[224,245,246],{},"Kollationsfehler gehören zu den häufigsten Gründen, warum Datenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[248,249,250],"callout",{},[224,251,252,253,257,258],{},"Empfohlene Kollation: ",[254,255,256],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[254,259,260],{},"utf8mb4",[228,262,264],{"id":263},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[224,266,267],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[269,270,275],"pre",{"className":271,"code":272,"language":273,"meta":274,"style":274},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql","",[254,276,277,301,321],{"__ignoreMap":274},[278,279,282,286,290,294,297],"span",{"class":280,"line":281},"line",1,[278,283,285],{"class":284},"sbssI","USE",[278,287,289],{"class":288},"sMK4o"," `",[278,291,293],{"class":292},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[278,295,296],{"class":288},"`",[278,298,300],{"class":299},"sTEyZ",";\n",[278,302,304,307,310,313,315,317,319],{"class":280,"line":303},2,[278,305,306],{"class":299},"SHOW ",[278,308,309],{"class":284},"CREATE",[278,311,312],{"class":284}," DATABASE",[278,314,289],{"class":288},[278,316,293],{"class":292},[278,318,296],{"class":288},[278,320,300],{"class":299},[278,322,324,326,329,332],{"class":280,"line":323},3,[278,325,306],{"class":299},[278,327,328],{"class":284},"TABLE",[278,330,331],{"class":284}," STATUS",[278,333,300],{"class":299},[224,335,336],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[269,338,340],{"className":271,"code":339,"language":273,"meta":274,"style":274},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[254,341,342],{"__ignoreMap":274},[278,343,344,346,348,351,353,356,358],{"class":280,"line":281},[278,345,306],{"class":299},[278,347,309],{"class":284},[278,349,350],{"class":284}," TABLE",[278,352,289],{"class":288},[278,354,355],{"class":292},"__IHRE_TABELLEN_NAME_HIER__",[278,357,296],{"class":288},[278,359,300],{"class":299},[228,361,363],{"id":362},"kollationskonflikte-beheben","Kollationskonflikte beheben",[224,365,366,367,369,370,372,373,380],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[254,368,260],{},"\u002F",[254,371,256],{}," in MySQL 5.5 finden Sie auf ",[374,375,379],"a",{"href":376,"rel":377},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[378],"nofollow","Database Administrators Stack Exchange",".",[224,382,383],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[269,385,387],{"className":271,"code":386,"language":273,"meta":274,"style":274},"SET foreign_key_checks = 0;\n",[254,388,389],{"__ignoreMap":274},[278,390,391,394,397,400,403],{"class":280,"line":281},[278,392,393],{"class":284},"SET",[278,395,396],{"class":299}," foreign_key_checks ",[278,398,399],{"class":288},"=",[278,401,402],{"class":284}," 0",[278,404,300],{"class":299},[224,406,407],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[269,409,411],{"className":271,"code":410,"language":273,"meta":274,"style":274},"SET foreign_key_checks = 1;\n",[254,412,413],{"__ignoreMap":274},[278,414,415,417,419,421,424],{"class":280,"line":281},[278,416,393],{"class":284},[278,418,396],{"class":299},[278,420,399],{"class":288},[278,422,423],{"class":284}," 1",[278,425,300],{"class":299},[427,428,429],"warning",{},[224,430,431],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[228,433,435],{"id":434},"dsn-kollation","DSN-Kollation",[224,437,438],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[224,440,441],{},"Beispiel:",[269,443,448],{"className":444,"code":446,"language":447,"meta":274},[445],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[254,449,446],{"__ignoreMap":274},[224,451,452],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[228,454,456],{"id":455},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[224,458,459,460,463,464,239,467,470],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[254,461,462],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[254,465,466],{},"password",[254,468,469],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[269,472,474],{"className":271,"code":473,"language":273,"meta":274,"style":274},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[254,475,476,514],{"__ignoreMap":274},[278,477,478,480,483,486,489,492,495,498,500,503,506,508,510,512],{"class":280,"line":281},[278,479,309],{"class":284},[278,481,482],{"class":284}," USER",[278,484,485],{"class":299}," '",[278,487,462],{"class":488},"s2Zo4",[278,490,491],{"class":299},"'@",[278,493,494],{"class":288},"'",[278,496,497],{"class":292},"%",[278,499,494],{"class":288},[278,501,502],{"class":299}," IDENTIFIED ",[278,504,505],{"class":284},"BY",[278,507,485],{"class":288},[278,509,466],{"class":292},[278,511,494],{"class":288},[278,513,300],{"class":299},[278,515,516,519,522,525,527,529,531,533,536,539,541,543,545,548,550,552,554],{"class":280,"line":303},[278,517,518],{"class":284},"GRANT",[278,520,521],{"class":299}," ALL PRIVILEGES ",[278,523,524],{"class":284},"ON",[278,526,289],{"class":288},[278,528,469],{"class":292},[278,530,296],{"class":288},[278,532,380],{"class":299},[278,534,535],{"class":288},"*",[278,537,538],{"class":284}," TO",[278,540,485],{"class":288},[278,542,462],{"class":292},[278,544,494],{"class":288},[278,546,547],{"class":299},"@",[278,549,494],{"class":288},[278,551,497],{"class":292},[278,553,494],{"class":288},[278,555,300],{"class":299},[224,557,558,559,562],{},"Für einen separaten DBSync-Quellbenutzer reicht in der Regel Lesezugriff aus. Siehe ",[374,560,67],{"href":561},".\u002Fdbsync"," für ein Beispiel eines dedizierten Nur-Lese-Benutzers.",[228,564,566],{"id":565},"empfohlene-werkzeuge","Empfohlene Werkzeuge",[224,568,569,574],{},[374,570,573],{"href":571,"rel":572},"https:\u002F\u002Fdbeaver.io\u002F",[378],"DBeaver"," ist ein gutes allgemeines Datenbankverwaltungswerkzeug, wenn Sie lieber mit einer grafischen Oberfläche Schemas, Kollationen und Daten prüfen möchten.",[576,577,578],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(-