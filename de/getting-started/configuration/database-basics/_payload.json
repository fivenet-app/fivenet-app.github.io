tenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[210,211,212],"callout",{},[186,213,214,215,219,220],{},"Empfohlene Kollation: ",[216,217,218],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[216,221,222],{},"utf8mb4",[190,224,226],{"id":225},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[186,228,229],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[231,232,237],"pre",{"className":233,"code":234,"language":235,"meta":236,"style":236},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql","",[216,238,239,263,283],{"__ignoreMap":236},[240,241,244,248,252,256,259],"span",{"class":242,"line":243},"line",1,[240,245,247],{"class":246},"sbssI","USE",[240,249,251],{"class":250},"sMK4o"," `",[240,253,255],{"class":254},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[240,257,258],{"class":250},"`",[240,260,262],{"class":261},"sTEyZ",";\n",[240,264,266,269,272,275,277,279,281],{"class":242,"line":265},2,[240,267,268],{"class":261},"SHOW ",[240,270,271],{"class":246},"CREATE",[240,273,274],{"class":246}," DATABASE",[240,276,251],{"class":250},[240,278,255],{"class":254},[240,280,258],{"class":250},[240,282,262],{"class":261},[240,284,286,288,291,294],{"class":242,"line":285},3,[240,287,268],{"class":261},[240,289,290],{"class":246},"TABLE",[240,292,293],{"class":246}," STATUS",[240,295,262],{"class":261},[186,297,298],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[231,300,302],{"className":233,"code":301,"language":235,"meta":236,"style":236},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[216,303,304],{"__ignoreMap":236},[240,305,306,308,310,313,315,318,320],{"class":242,"line":243},[240,307,268],{"class":261},[240,309,271],{"class":246},[240,311,312],{"class":246}," TABLE",[240,314,251],{"class":250},[240,316,317],{"class":254},"__IHRE_TABELLEN_NAME_HIER__",[240,319,258],{"class":250},[240,321,262],{"class":261},[190,323,325],{"id":324},"kollationskonflikte-beheben","Kollationskonflikte beheben",[186,327,328,329,331,332,334,335,342],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[216,330,222],{},"\u002F",[216,333,218],{}," in MySQL 5.5 finden Sie auf ",[336,337,341],"a",{"href":338,"rel":339},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[340],"nofollow","Database Administrators Stack Exchange",".",[186,344,345],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[231,347,349],{"className":233,"code":348,"language":235,"meta":236,"style":236},"SET foreign_key_checks = 0;\n",[216,350,351],{"__ignoreMap":236},[240,352,353,356,359,362,365],{"class":242,"line":243},[240,354,355],{"class":246},"SET",[240,357,358],{"class":261}," foreign_key_checks ",[240,360,361],{"class":250},"=",[240,363,364],{"class":246}," 0",[240,366,262],{"class":261},[186,368,369],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[231,371,373],{"className":233,"code":372,"language":235,"meta":236,"style":236},"SET foreign_key_checks = 1;\n",[216,374,375],{"__ignoreMap":236},[240,376,377,379,381,383,386],{"class":242,"line":243},[240,378,355],{"class":246},[240,380,358],{"class":261},[240,382,361],{"class":250},[240,384,385],{"class":246}," 1",[240,387,262],{"class":261},[389,390,391],"warning",{},[186,392,393],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[190,395,397],{"id":396},"dsn-kollation","DSN-Kollation",[186,399,400],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[186,402,403],{},"Beispiel:",[231,405,410],{"className":406,"code":408,"language":409,"meta":236},[407],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[216,411,408],{"__ignoreMap":236},[186,413,414],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[190,416,418],{"id":417},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[186,420,421,422,425,426,201,429,432],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[216,423,424],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[216,427,428],{},"password",[216,430,431],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[231,434,436],{"className":233,"code":435,"language":235,"meta":236,"style":236},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[216,437,438,476],{"__ignoreMap":236},[240,439,440,442,445,448,451,454,457,460,462,465,468,470,472,474],{"class":242,"line":243},[240,441,271],{"class":246},[240,443,444],{"class":246}," USER",[240,446,447],{"class":261}," '",[240,449,424],{"class":450},"s2Zo4",[240,452,453],{"class":261},"'@",[240,455,456],{"class":250},"'",[240,458,459],{"class":254},"%",[240,461,456],{"class":250},[240,463,464],{"class":261}," IDENTIFIED ",[240,466,467],{"class":246},"BY",[240,469,447],{"class":250},[240,471,428],{"class":254},[240,473,456],{"class":250},[240,475,262],{"class":261},[240,477,478,481,484,487,489,491,493,495,498,501,503,505,507,510,512,514,516],{"class":242,"line":265},[240,479,480],{"class":246},"GRANT",[240,482,483],{"class":261}," ALL PRIVILEGES ",[240,485,486],{"class":246},"ON",[240,488,251],{"class":250},[240,490,431],{"class":254},[240,492,258],{"class":250},[240,494,342],{"class":261},[240,496,497],{"class":250},"*",[240,499,500],{"class":246}," TO",[240,502,447],{"class":250},[240,504,424],{"class":254},[240,506,456],{"class":250},[240,508,509],{"class":261},"@",[240,511,456],{"class":250},[240,513,459],{"class":254},[240,515,456],{"class":250},[240,517,262],{"class":261},[186,519,520,521,524],{},"Für einen separaten DBSync-Quellbenutzer reicht in der Regel Lesezugriff aus. Siehe ",[336,522,66],{"href":523},".\u002Fdbsync"," für ein Beispiel eines dedizierten Nur-Lese-Benutzers.",[190,526,528],{"id":527},"empfohlene-werkzeuge","Empfohlene Werkzeuge",[186,530,531,536],{},[336,532,535],{"href":533,"rel":534},"https:\u002F\u002Fdbeaver.io\u002F",[340],"DBeaver"," ist ein gutes allgemeines Datenbankverwaltungswerkzeug, wenn Sie lieber mit einer grafischen Oberfläche Schemas, Kollationen und Daten prüfen möchten.",[538,539,540],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default