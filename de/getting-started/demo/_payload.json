4,336],{"id":335},"feedback","Feedback",[224,338,339],{},"Wenn Sie auf Probleme stoßen oder Vorschläge haben, wenden Sie sich gerne an das FiveNet-Team auf unserem Discord.",[224,341,342],{},"Viel Spaß beim Erkunden!",{"title":344,"searchDepth":345,"depth":345,"links":346},"",2,[347,348,349],{"id":253,"depth":345,"text":254},{"id":291,"depth":345,"text":292},{"id":335,"depth":345,"text":336},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Fdemo",{"title":16,"description":226},"de\u002F1.getting-started\u002F2.demo","TGRcE79tisHEMr-zo4PlBdPnKDUhqj5fLT9jlGn0vlY",[359,364],{"title":360,"path":361,"stem":362,"description":363,"children":-1},"Funktionen","\u002Fde\u002Fgetting-started\u002Ffeatures","de\u002F1.getting-started\u002F1.features","Eine Übersicht über die Funktionen von FiveNet, einschließlich Details, Frontend, Backend und Gameserver Plugin.",{"title":365,"path":366,"stem":367,"description":344,"children":-1},"Anforderungen","\u002Fde\u002Fgetting-started\u002Frequirements","de\u002F1.getting-started\u002F2.requirements",1788139797708]