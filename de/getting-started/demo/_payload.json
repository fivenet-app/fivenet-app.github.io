30,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":16,"body":235,"description":246,"extension":370,"links":371,"meta":372,"navigation":373,"path":374,"redirect":371,"seo":375,"stem":376,"__hash__":377},"content_de\u002Fde\u002F1.getting-started\u002F2.demo.md",{"type":236,"value":237,"toc":363},"minimark",[238,243,247,257,270,275,278,300,309,313,328,336,343,353,357,360],[239,240,242],"h1",{"id":241},"fivenet-demo-instanz","FiveNet Demo-Instanz",[244,245,246],"p",{},"Entdecken Sie die Funktionen von FiveNet mit unserer Demo-Instanz:",[248,249],"prose-button",{"color":250,"external":251,"icon":252,"label":253,"size":254,"target":255,"to":256},"primary","true","i-mdi-play-circle-outline","Zugriff auf die Demo-Instanz","lg","_blank","https:\u002F\u002Fdemo.fivenet.app\u002F",[258,259,262],"callout",{"icon":260,"color":261},"i-mdi-warning-circle","warning",[244,263,264,265,269],{},"Die Demo-Instanz wird alle ",[266,267,268],"strong",{},"12 Stunden"," zurückgesetzt. Während des Zurücksetzens ist sie für einige Sekunden nicht verfügbar. Bitte planen Sie Ihre Tests entsprechend.",[271,272,274],"h2",{"id":273},"demo-zugangsdaten","Demo-Zugangsdaten",[244,276,277],{},"Verwenden Sie die folgenden Zugangsdaten, um sich anzumelden:",[279,280,281,292],"ul",{},[282,283,284,287,288],"li",{},[266,285,286],{},"Benutzername",": ",[289,290,291],"code",{},"demo",[282,293,294,287,297],{},[266,295,296],{},"Passwort",[289,298,299],{},"fivenet-demo",[258,301,303],{"icon":302},"i-mdi-info-slab-circle",[244,304,305,308],{},[266,306,307],{},"Hinweis:"," Nicht alle Funktionen sind in der Demo-Instanz vollständig funktionsfähig. Einige erweiterte Funktionen können eingeschränkt sein.",[271,310,312],{"id":311},"zusätzliche-informationen","Zusätzliche Informationen",[244,314,315,316,319,320,323,324,327],{},"Das Demo-Konto bietet Zugriff auf mehrere Charaktere. Einer dieser Charaktere ist Teil des ",[266,317,318],{},"Los Santos Police Department (LSPD)"," mit dem Job ",[289,321,322],{},"police",". Dieser Charakter hat Zugriff auf den ",[266,325,326],{},"Superuser-Modus",", der es Ihnen ermöglicht:",[279,329,330,333],{},[282,331,332],{},"Zwischen Jobs zu wechseln.",[282,334,335],{},"Die Verwaltungsfunktionen von FiveNet zu erkunden.",[244,337,338,339,342],{},"Um den Superuser-Modus zu aktivieren oder zu deaktivieren, verwenden Sie das ",[266,340,341],{},"Benutzermenü"," in der linken Seitenleiste.",[258,344,347],{"icon":345,"color":346},"i-mdi-lightbulb-on-outline","info",[244,348,349,352],{},[266,350,351],{},"Tipp:"," Verwenden Sie den Polizeicharakter, um erweiterte Funktionen und Verwaltungstools zu entdecken.",[271,354,356],{"id":355},"feedback","Feedback",[244,358,359],{},"Wenn Sie auf Probleme stoßen oder Vorschläge haben, wenden Sie sich gerne an das FiveNet-Team auf unserem Discord.",[244,361,362],{},"Viel Spaß beim Erkunden!",{"title":364,"searchDepth":365,"depth":365,"links":366},"",2,[367,368,369],{"id":273,"depth":365,"text":274},{"id":311,"depth":365,"text":312},{"id":355,"depth":365,"text":356},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Fdemo",{"title":16,"description":246},"de\u002F1.getting-started\u002F2.demo","TGRcE79tisHEMr-zo4PlBdPnKDUhqj5fLT9jlGn0vlY",[379,384],{"title":380,"path":381,"stem":382,"description":383,"children":-1},"Funktionen","\u002Fde\u002Fgetting-started\u002Ffeatures","de\u002F1.getting-started\u002F1.features","Eine Übersicht über die Funktionen von FiveNet, einschließlich Details, Frontend, Backend und Gameserver Plugin.",{"title":385,"path":386,"stem":387,"description":364,"children":-1},"Anforderungen","\u002Fde\u002Fgetting-started\u002Frequirements","de\u002F1.getting-started\u002F2.requirements",1789079048696]