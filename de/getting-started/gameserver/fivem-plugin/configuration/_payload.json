623,624,629,634],{},[301,625,626],{},[211,627,628],{},"Config.UserProps.BloodTypes",[301,630,631],{},[211,632,633],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[301,635,636],{},"Blutgruppen, die Benutzern zugewiesen werden, wenn sie noch nicht festgelegt sind.",[190,638,11],{"id":639},"funktionen",[186,641,642,643,646],{},"Einige Plugin-Integrationen hängen von den ",[211,644,645],{},"Functions","-Definitionen in den Konfigurationsdateien ab. Diese Funktionen dienen als Integrationspunkte für Sprachsysteme, Inventarsysteme, Duty-Prüfungen und ähnliches framework-spezifisches Verhalten.",[186,648,649],{},"Stellen Sie sicher, dass die erforderlichen Funktionen für die Ressourcen implementiert sind, die Ihr Server verwendet.",[186,651,652],{},"Nachfolgend finden Sie Beispiele für client- und serverseitige Funktionen.",[266,654,269],{"id":655},"client-seite-1",[186,657,658,659,662,663,666],{},"Wenn Sie ",[211,660,661],{},"pma-voice"," verwenden, implementieren Sie ",[211,664,665],{},"SetRadioFrequency"," in Ihrem clientseitigen Skript. Diese Funktion ist dafür verantwortlich, die Funkfrequenz des Spielers zu setzen.",[668,669,674],"pre",{"className":670,"code":671,"language":672,"meta":673,"style":673},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Funkfrequenz einstellen\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- Dies ist für pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[211,675,676,685,716,722,754,761,778,796,802],{"__ignoreMap":673},[677,678,681],"span",{"class":679,"line":680},"line",1,[677,682,684],{"class":683},"sHwdD","-- Funkfrequenz einstellen\n",[677,686,688,692,695,699,703,706,710,713],{"class":679,"line":687},2,[677,689,691],{"class":690},"sTEyZ","Functions.",[677,693,665],{"class":694},"s2Zo4",[677,696,698],{"clas