6,457],{},[231,458,459],{},"false",[321,461,462],{},"Ob unsichere Verbindungen erlaubt sind.",[303,464,465,470,474],{},[321,466,467],{},[231,468,469],{},"Config.TrackCharIDs",[321,471,472],{},[231,473,344],{},[321,475,476],{},"Ob die letzte Charakter-ID aufgezeichnet werden soll.",[303,478,479,484,488],{},[321,480,481],{},[231,482,483],{},"Config.Tracking.Enable",[321,485,486],{},[231,487,344],{},[321,489,490],{},"Aktivieren oder Deaktivieren des Spieler-Trackings.",[303,492,493,498,503],{},[321,494,495],{},[231,496,497],{},"Config.Tracking.Jobs",[321,499,500],{},[231,501,502],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[321,504,505],{},"Jobs, die verfolgt werden.",[303,507,508,513,518],{},[321,509,510],{},[231,511,512],{},"Config.Tracking.Item",[321,514,515],{},[231,516,517],{},"'radio'",[321,519,520],{},"Spieler ohne diesen Gegenstand werden als \"versteckt\" markiert.",[303,522,523,528,533],{},[321,524,525],{},[231,526,527],{},"Config.Tracking.Interval",[321,529,530],{},[231,531,532],{},"3000",[321,534,535],{},"Intervall in Millisekunden für Positionsaktualisierungen.",[303,537,538,543,547],{},[321,539,540],{},[231,541,542],{},"Config.TimeclockJobs",[321,544,545],{},[231,546,502],{},[321,548,549],{},"Jobs, die für Zeiterfassungszwecke verfolgt werden.",[303,551,552,557,562],{},[321,553,554],{},[231,555,556],{},"Config.Events.BillingJobs",[321,558,559],{},[231,560,561],{},"{ ['doj'] = true, ['police'] = true }",[321,563,564],{},"Jobs, die Benutzeraktivitäten für Abrechnungszyklusereignisse auslösen.",[303,566,567,572,576],{},[321,568,569],{},[231,570,571],{},"Config.Discord.ConnectOnJoin",[321,573,574],{},[231,575,344],{},[321,577,578],{},"Automatisch Discord-OAuth2-Verbindungen erstellen, wenn ein Spieler mit einer Discord-ID beitritt.",[303,580,581,586,591],{},[321,582,583],{},[231,584,585],{},"Config.Discord.OAuth2Provider",[321,587,588],{},[231,589,590],{},"'discord'",[321,592,593],{},"Name des Discord-OAuth2-Providers aus der FiveNet-Serverkonfiguration.",[303,595,596,601,606],{},[321,597,598],{},[231,599,600],{},"Config.Dispatches.CivilProtectionJobs",[321,602,603],{},[231,604,605],{},"{ ['police'] = true }",[321,607,608,609,612],{},"Jobs, die Dispatches erhalten, die über die Funktion ",[231,610,611],{},"createCivilProtectionJobDispatch"," erstellt wurden.",[303,614,615,620,625],{},[321,616,617],{},[231,618,619],{},"Config.Dispatches.PanicButtonTitle",[321,621,622],{},[231,623,624],{},"'Panikknopf ausgelöst'",[321,626,627],{},"Titel für den Panikknopf-Dispatch.",[303,629,630,635,639],{},[321,631,632],{},[231,633,634],{},"Config.UserProps.SetBloodType",[321,636,637],{},[231,638,344],{},[321,640,641],{},"Aktivieren der Einstellung der Blutgruppe für einen Benutzer beim \"join\u002Floaded\"-Ereignis.",[303,643,644,649,654],{},[321,645,646],{},[231,647,648],{},"Config.UserProps.BloodTypes",[321,650,651],{},[231,652,653],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[321,655,656],{},"Blutgruppen, die Benutzern zugewiesen werden, wenn sie noch nicht festgelegt sind.",[210,658,11],{"id":659},"funktionen",[206,661,662,663,666],{},"Einige Plugin-Integrationen hängen von den ",[231,664,665],{},"Functions","-Definitionen in den Konfigurationsdateien ab. Diese Funktionen dienen als Integrationspunkte für Sprachsysteme, Inventarsysteme, Duty-Prüfungen und ähnliches framework-spezifisches Verhalten.",[206,668,669],{},"Stellen Sie sicher, dass die erforderlichen Funktionen für die Ressourcen implementiert sind, die Ihr Server verwendet.",[206,671,672],{},"Nachfolgend finden Sie Beispiele für client- und serverseitige Funktionen.",[286,674,289],{"id":675},"client-seite-1",[206,677,678,679,682,683,686],{},"Wenn Sie ",[231,680,681],{},"pma-voice"," verwenden, implementieren Sie ",[231,684,685],{},"SetRadioFrequency"," in Ihrem clientseitigen Skript. Diese Funktion ist dafür verantwortlich, die Funkfrequenz des Spielers zu setzen.",[688,689,694],"pre",{"className":690,"code":691,"language":692,"meta":693,"style":693},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Funkfrequenz einstellen\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- Dies ist für pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[231,695,696,705,736,742,774,781,798,816,822],{"__ignoreMap":693},[697,698,701],"span",{"class":699,"line":700},"line",1,[697,702,704],{"class":703},"sHwdD","-- Funkfrequenz einstellen\n",[697,706,708,712,715,719,723,726,730,733],{"class":699,"line":707},2,[697,709,711],{"class":710},"sTEyZ","Functions.",[697,713,685],{"class":714},"s2Zo4",[697,716,718],{"class":717},"sMK4o"," =",[697,720,722],{"class":721},"s7zQu"," function",[697,724,725],{"class":717},"(",[697,727,729],{"class":728},"sHdIc","frequency",[697,731,732],{"class":703}," --[[number]]",[697,734,735],{"class":710},")\n",[697,737,739],{"class":699,"line":738},3,[697,740,741],{"class":703},"    -- Dies ist für pma-voice\n",[697,743,745,748,751,754,757,760,763,765,768,771],{"class":699,"line":744},4,[697,746,747],{"class":717},"    local",[697,749,750],{"class":710}," currentChannel ",[697,752,753],{"class":717},"=",[697,755,756],{"class":710}," exports[",[697,758,759],{"class":717},"'",[697,761,681],{"class":762},"sfazB",[697,764,759],{"class":717},[697,766,767],{"class":710},"]:",[697,769,770],{"class":714},"getRadioChannel",[697,772,773],{"class":710},"()\n",[697,775,777],{"class":699,"line":776},5,[697,778,780],{"emptyLinePlaceholder":779},true,"\n",[697,782,784,787,789,792,795],{"class":699,"line":783},6,[697,785,786],{"class":721},"    if",[697,788,750],{"class":710},[697,790,791],{"class":717},"~=",[697,793,794],{"class":710}," frequency ",[697,796,797],{"class":721},"then\n",[697,799,801,804,806,808,811,813],{"class":699,"line":800},7,[697,802,803],{"class":714},"        TriggerEvent",[