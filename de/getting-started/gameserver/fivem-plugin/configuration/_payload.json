egt sind.",[254,702,704],{"id":703},"funktionen","Funktionen",[250,706,707,708,711],{},"Einige Plugin-Integrationen hängen von den ",[275,709,710],{},"Functions","-Definitionen in den Konfigurationsdateien ab. Diese Funktionen dienen als Integrationspunkte für Sprachsysteme, Inventarsysteme, Duty-Prüfungen und ähnliches framework-spezifisches Verhalten.",[250,713,714],{},"Stellen Sie sicher, dass die erforderlichen Funktionen für die Ressourcen implementiert sind, die Ihr Server verwendet.",[250,716,717],{},"Nachfolgend finden Sie Beispiele für client- und serverseitige Funktionen.",[330,719,333],{"id":720},"client-seite-1",[250,722,723,724,727,728,731],{},"Wenn Sie ",[275,725,726],{},"pma-voice"," verwenden, implementieren Sie ",[275,729,730],{},"SetRadioFrequency"," in Ihrem clientseitigen Skript. Diese Funktion ist dafür verantwortlich, die Funkfrequenz des Spielers zu setzen.",[733,734,739],"pre",{"className":735,"code":736,"language":737,"meta":738,"style":738},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Funkfrequenz einstellen\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- Dies ist für pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[275,740,741,750,781,787,819,826,843,861,867],{"__ignoreMap":738},[742,743,746],"span",{"class":744,"line":745},"line",1,[742,747,749],{"class":748},"sHwdD","-- Funkfrequenz einstellen\n",[742,751,753,757,760,764,768,771,775,778],{"class":744,"line":752},2,[742,754,756],{"class":755},"sTEyZ","Functions.",[742,758,730],{"class":759},"s2Zo4",[742,761,763],{"class":762},"sMK4o"," =",[742,765,767],{"class":766},"s7zQu"," function",[742,769,770],{"class":762},"(",[742,772,774],{"class":773},"sHdIc","frequency",[742,776,777],{"class":748}," --[[number]]",[742,779,780],{"class":755},")\n",[742,782,784],{"class":744,"line":783},3,[742,785,786],{"class":748},"    -- Dies ist für pma-voice\n",[742,788,790,793,796,799,802,805,808,810,813,816],{"class":744,"line":789},4,[742,791,792],{"class":762},"    local",[742,794,795],{"class":755}," currentChannel ",[742,797,798],{"class":762},"=",[742,800,801],{"class":755}," exports[",[742,803,804],{"class":762},"'",[742,806,726],{"class":807},"sfazB",[742,809,804],{"class":762},[742,811,812],{"class":755},"]:",[742,814,815],{"class":759},"getRadioChannel",[742,817,818],{"class":755},"()\n",[742,820,822],{"class":744,"line":821},5,[742,823,825],{"emptyLinePlaceholder":824},true,"\n",[742,827,829,832,834,837,840],{"class":744,"line":828},6,[742,830,831],{"class":766},"    if",[742,833,795],{"class":755},[742,835,836],{"class":762},"~=",[742,838,839],{"class":755}," frequency ",[742,841,842],{"class":766},"then\n",[742,844,846,849,851,853,856,858],{"class":744,"line":845},7,[742,847,848],{"class":759},"        TriggerEvent",[742,850,770],{"class":755},[742,852,804],{"class":762},[742,854,855],{"class":807},"tgiann-radio:t",[742,857,804],{"class":762},[742,859,860],{"class":755},", frequency)\n",[742,862,864],{"class":744,"line":863},8,[742,865,866],{"class":766},"    end\n",[742,868,870],{"class":744,"line":869},9,[742,871,872],{"class":766},"end\n",[330,874,425],{"id":875},"server-seite-1",[250,877,723,878,278,880,727,882,885],{},[275,879,277],{},[275,881,281],{},[275,883,884],{},"CheckIfPlayerHidden"," in Ihrem serverseitigen Skript. Diese Funktion prüft, ob ein Spieler basierend auf seinem Duty-Status und dem erforderlichen Tracking-Gegenstand im Inventar verborgen sein soll.",[733,887,889],{"className":735,"code":888,"language":737,"meta":738,"style":738},"-- Spieler-Tracker - Versteckt-Funktion überprüfen\nFunctions.CheckIfPlayerHidden = function(xPlayer)\n    if Config.Framework == 'esx' then\n        -- ESX\n        return not xPlayer.job.onDuty or (Config.Tracking.Item and not xPlayer.getInventoryItem(Config.Tracking.Item))\n    elseif Config.Framework == 'qbcore' then\n        -- QBCore\n        return not xPlayer.PlayerData.job.onduty or (Config.Tracking.Item and not exports['qb-inventory']:HasItem(xPlayer.PlayerData.source, Config.Tracking.Item))\n    else\n        -- Fallback\n        return false\n    end\nend\n",[275,890,891,896,913,937,942,997,1016,1021,1090,1095,1101,1109,1114],{"__ignoreMap":738},[742,892,893],{"class":744,"line":745},[742,894,895],{"class":748},"-- Spieler-Tracker - Versteckt-Funktion überprüfen\n",[742,897,898,900,902,904,906,908,911],{"class":744,"line":752},[742,899,756],{"class":755},[742,901,884],{"class":759},[742,903,763],{"class":762},[742,905,767],{"class":766},[742,907,770],{"class":762},[742,909,910],{"class":773},"xPlayer",[742,912,780],{"class":762},[742,914,915,917,920,924,927,930,932,935],{"class":744,"line":783},[742,916,831],{"class":766},[742,918,919],{"class":755}," Config.",[742,921,923],{"class":922},"sBMFI","Framework",[742,925,926],{"class":762}," ==",[742,928,929],{"class":762}," '",[742,931,277],{"class":807},[742,933,934],{"class":762},"' ",[742,936,842],{"class":766},[742,938,939],{"class":744,"line":789},[742,940,941],{"class":748},"        -- ESX\n",[742,943,944,947,950,953,956,958,961,964,967,970,972,975,978,980,982,985,988,990,992,994],{"class":744,"line":821},[742,945,946],{"class":766},"        return",[742,948,949],{"class":762}," not",[742,951,952],{"class":755}," xPlayer.",[742,954,955],{"class":922},"job",[742,957,339],{"class":755},[742,959,960],{"class":922},"onDuty",[742,962,963],{"class":762}," or",[742,965,966],{"class":755}," (Config.",[742,968,969],{"class":922},"Tracking",[742,971,339],{"class":755},[742,973,974],{"class":922},"Item",[742,976,977],{"class":762}," and",[742,979,949],{"class":762},[742,981,952],{"class":755},[742,983,984],{"class":759},"getInventoryItem",[742,986,987],{"class":755},"(Config.",[742,989,969],{"class":922},[742,991,339],{"class":755},[742,993,974],{"class":922},[742,995,996],{"class":755},"))