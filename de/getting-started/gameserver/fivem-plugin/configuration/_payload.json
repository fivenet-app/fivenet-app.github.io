,338],{},"Config.Hotkey.Key",[305,340,341],{},[215,342,343],{},"'F5'",[305,345,346],{},"Die Taste, die für den Tablet-Hotkey verwendet wird.",[287,348,349,354,359],{},[305,350,351],{},[215,352,353],{},"Config.PostalCommand",[305,355,356],{},[215,357,358],{},"'plz'",[305,360,361],{},"Befehl, um die Postleitzahl auf der Karte des Spielers zu markieren.",[270,363,365],{"id":364},"server-seite","Server-Seite",[190,367,368,369,279],{},"Die serverseitige Konfiguration befindet sich in ",[215,370,247],{},[281,372,373,383],{},[284,374,375],{},[287,376,377,379,381],{},[290,378,292],{},[290,380,295],{},[290,382,298],{},[300,384,385,404,418,432,447,461,475,490,505,520,534,549,563,578,597,612,626],{},[287,386,387,391,396],{},[305,388,389],{},[215,390,244],{},[305,392,393],{},[215,394,395],{},"'esx'",[305,397,398,399,218,401,403],{},"Das verwendete Framework. Kann ",[215,400,217],{},[215,402,221],{}," sein.",[287,405,406,410,415],{},[305,407,408],{},[215,409,252],{},[305,411,412],{},[215,413,414],{},"'demo.fivenet.app:443'",[305,416,417],{},"Der FiveNet-Hostname, muss den Port enthalten, wenn nicht 443, erfordert HTTPS.",[287,419,420,424,429],{},[305,421,422],{},[215,423,259],{},[305,425,426],{},[215,427,428],{},"'YOUR_SYNC_API_TOKEN'",[305,430,431],{},"Der API-Token für FiveNet.",[287,433,434,439,444],{},[305,435,436],{},[215,437,438],{},"Config.API.Insecure",[305,440,441],{},[215,442,443],{},"false",[305,445,446],{},"Ob unsichere Verbindungen erlaubt sind.",[287,448,449,454,458],{},[305,450,451],{},[215,452,453],{},"Config.TrackCharIDs",[305,455,456],{},[215,457,328],{},[305,459,460],{},"Ob die letzte Charakter-ID aufgezeichnet werden soll.",[287,462,463,468,472],{},[305,464,465],{},[215,466,467],{},"Config.Tracking.Enable",[305,469,470],{},[215,471,328],{},[305,473,474],{},"Aktivieren oder Deaktivieren des Spieler-Trackings.",[287,476,477,482,487],{},[305,478,479],{},[215,480,481],{},"Config.Tracking.Jobs",[305,483,484],{},[215,485,486],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[305,488,489],{},"Jobs, die verfolgt werden.",[287,491,492,497,502],{},[305,493,494],{},[215,495,496],{},"Config.Tracking.Item",[305,498,499],{},[215,500,501],{},"'radio'",[305,503,504],{},"Spieler ohne diesen Gegenstand werden als \"versteckt\" markiert.",[287,506,507,512,517],{},[305,508,509],{},[215,510,511],{},"Config.Tracking.Interval",[305,513,514],{},[215,515,516],{},"3000",[305,518,519],{},"Intervall in Millisekunden für Positionsaktualisierungen.",[287,521,522,527,531],{},[305,523,524],{},[215,525,526],{},"Config.TimeclockJobs",[305,528,529],{},[215,530,486],{},[305,532,533],{},"Jobs, die für Zeiterfassungszwecke verfolgt werden.",[287,535,536,541,546],{},[305,537,538],{},[215,539,540],{},"Config.Events.BillingJobs",[305,542,543],{},[215,544,545],{},"{ ['doj'] = true, ['police'] = true }",[305,547,548],{},"Jobs, die Benutzeraktivitäten für Abrechnungszyklusereignisse auslösen.",[287,550,551,556,560],{},[305,552,553],{},[215,554,555],{},"Config.Discord.ConnectOnJoin",[305,557,558],{},[215,559,328],{},[305,561,562],{},"Automatisch Discord-OAuth2-Verbindungen erstellen, wenn ein Spieler mit einer Discord-ID beitritt.",[287,564,565,570,575],{},[305,566,567],{},[215,568,569],{},"Config.Discord.OAuth2Provider",[305,571,572],{},[215,573,574],{},"'discord'",[305,576,577],{},"Name des Discord-OAuth2-Providers aus der FiveNet-Serverkonfiguration.",[287,579,580,585,590],{},[305,581,582],{},[215,583,584],{},"Config.Dispatches.CivilProtectionJobs",[305,586,587],{},[215,588,589],{},"{ ['police'] = true }",[305,591,592,593,596],{},"Jobs, die Dispatches erhalten, die über die Funktion ",[215,594,595],{},"createCivilProtectionJobDispatch"," erstellt wurden.",[287,598,599,604,609],{},[305,600,601],{},[215,602,603],{},"Config.Dispatches.PanicButtonTitle",[305,605,606],{},[215,607,608],{},"'Panikknopf ausgelöst'",[305,610,611],{},"Titel für den Panikknopf-Dispatch.",[287,613,614,619,623],{},[305,615,616],{},[215,617,618],{},"Config.UserProps.SetBloodType",[305,620,621],{},[215,622,328],{},[305,624,625],{},"Aktivieren der Einstellung der Blutgruppe für einen Benutzer beim \"join\u002Floaded\"-Ereignis.",[287,627,628,633,638],{},[305,629,630],{},[215,631,632],{},"Config.UserProps.BloodTypes",[305,634,635],{},[215,636,637],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[305,639,640],{},"Blutgruppen, die Benutzern zugewiesen werden, wenn sie noch nicht festgelegt sind.",[194,642,11],{"id":643},"funktionen",[190,645,646,647,650],{},"Einige Plugin-Integrationen hängen von den ",[215,648,649],{},"Functions","-Definitionen in den Konfigurationsdateien ab. Diese Funktionen dienen als Integrationspunkte für Sprachsysteme, Inventarsysteme, Duty-Prüfungen und ähnliches framework-spezifisches Verhalten.",[190,652,653],{},"Stellen Sie sicher, dass die erforderlichen Funktionen für die Ressourcen implementiert sind, die Ihr Server verwendet.",[190,655,656],{},"Nachfolgend finden Sie Beispiele für client- und serverseitige Funktionen.",[270,658,273],{"id":659},"client-seite-1",[190,661,662,663,666,667,670],{},"Wenn Sie ",[215,664,665],{},"pma-voice"," verwenden, implementieren Sie ",[215,668,669],{},"SetRadioFrequency"," in Ihrem clientseitigen Skript. Diese Funktion ist dafür verantwortlich, die Funkfrequenz des Spielers zu setzen.",[672,673,678],"pre",{"className":674,"code":675,"language":676,"meta":677,"style":677},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Funkfrequenz einstellen\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- Dies ist für pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[215,679,680,689,720,726,758,765,782,800,806],{"__ignoreMap":677},[681,682,685],"span",{"class":683,"line":684},"line",1,[681,686,688],{"class":687},"sHwdD","-- Funkfrequenz einstellen\n",[681,690,692,6