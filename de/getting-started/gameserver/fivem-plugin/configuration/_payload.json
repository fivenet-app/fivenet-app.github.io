5,609,378],{},[355,611,612],{},"Automatisch Discord-OAuth2-Verbindungen erstellen, wenn ein Spieler mit einer Discord-ID beitritt.",[337,614,615,620,625],{},[355,616,617],{},[265,618,619],{},"Config.Discord.OAuth2Provider",[355,621,622],{},[265,623,624],{},"'discord'",[355,626,627],{},"Name des Discord-OAuth2-Providers aus der FiveNet-Serverkonfiguration.",[337,629,630,635,640],{},[355,631,632],{},[265,633,634],{},"Config.Dispatches.CivilProtectionJobs",[355,636,637],{},[265,638,639],{},"{ ['police'] = true }",[355,641,642,643,646],{},"Jobs, die Dispatches erhalten, die über die Funktion ",[265,644,645],{},"createCivilProtectionJobDispatch"," erstellt wurden.",[337,648,649,654,659],{},[355,650,651],{},[265,652,653],{},"Config.Dispatches.PanicButtonTitle",[355,655,656],{},[265,657,658],{},"'Panikknopf ausgelöst'",[355,660,661],{},"Titel für den Panikknopf-Dispatch.",[337,663,664,669,673],{},[355,665,666],{},[265,667,668],{},"Config.UserProps.SetBloodType",[355,670,671],{},[265,672,378],{},[355,674,675],{},"Aktivieren der Einstellung der Blutgruppe für einen Benutzer beim \"join\u002Floaded\"-Ereignis.",[337,677,678,683,688],{},[355,679,680],{},[265,681,682],{},"Config.UserProps.BloodTypes",[355,684,685],{},[265,686,687],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[355,689,690],{},"Blutgruppen, die Benutzern zugewiesen werden, wenn sie noch nicht festgelegt sind.",[244,692,694],{"id":693},"funktionen","Funktionen",[240,696,697,698,701],{},"Einige Plugin-Integrationen hängen von den ",[265,699,700],{},"Functions","-Definitionen in den Konfigurationsdateien ab. Diese Funktionen dienen als Integrationspunkte für Sprachsysteme, Inventarsysteme, Duty-Prüfungen und ähnliches framework-spezifisches Verhalten.",[240,703,704],{},"Stellen Sie sicher, dass die erforderlichen Funktionen für die Ressourcen implementiert sind, die Ihr Server verwendet.",[240,706,707],{},"Nachfolgend finden Sie Beispiele für client- und serverseitige Funktionen.",[320,709,323],{"id":710},"client-seite-1",[240,712,713,714,717,718,721],{},"Wenn Sie ",[265,715,716],{},"pma-voice"," verwenden, implementieren Sie ",[265,719,720],{},"SetRadioFrequency"," in Ihrem clientseitigen Skript. Diese Funktion ist dafür verantwortlich, die Funkfrequenz des Spielers zu setzen.",[723,724,729],"pre",{"className":725,"code":726,"language":727,"meta":728,"style":728},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Funkfrequenz einstellen\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- Dies ist für pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[265,730,731,740,771,777,809,816,833,851,857],{"__ignoreMap":728},[732,733,736],"span",{"class":734,"line":735},"line",1,[732,737,739],{"class":738},"sHwdD","-- Funkfrequenz einstellen\n",[732,741,743,747,750,754,758,761,765,768],{"class":734,"line":742},2,[732,744,746],{"class":745},"sTEyZ","Functions.",[732,748,720],{"class":749},"s2Zo4",[732,751,753],{"class":752},"sMK4o"," =",[732,755,757],{"class":756},"s7zQu"," function",[732,759,760],{"class":752},"(",[732,762,764],{"class":763},"sHdIc","frequency",[732,766,767],{"class":738}," --[[number]]",[732,769,770],{"class":745},")\n",[732,772,774],{"class":734,"line":773},3,[732,775,776],{"class":738},"    -- Dies ist für pma-voice\n",[732,778,780,783,786,789,792,795,798,800,803,806],{"class":734,"line":779},4,[732,781,782],{"class":752},"    local",[732,784,785],{"class":745}," currentChannel ",[732,787,788],{"class":752},"=",[732,790,791],{"class":745}," exports[",[732,793,794],{"class":752},"'",[732,796,716],{"class":797},"sfazB",[732,799,794],{"class":752},[732,801,802],{"class":745},"]:",[732,804,805],{"class":749},"getRadioChannel",[732,807,808],{"class":745},"()\n",[732,810,812],{"class":734,"line":811},5,[732,813,815],{"emptyLinePlaceholder":814},true,"\n",[732,817,819,822,824,827,830],{"class":734,"line":818},6,[732,820,821],{"class":756},"    if",[732,823,785],{"class":745},[732,825,826],{"class":752},"~=",[732,828,829],{"class":745}," frequency ",[732,831,832],{"class":756},"then\n",[732,834,836,839,841,843,846,848],{"class":734,"line":835},7,[732,837,838],{"class":749},"        TriggerEvent",[732,840,760],{"class":745},[732,842,794],{"class":752},[732,844,845],{"class":797},"tgiann-radio:t",[732,847,794],{"class":752},[732,849,850],{"class":745},", frequency)\n",[732,852,854],{"class":734,"line":853},8,[732,855,856],{"class":756},"    end\n",[732,858,860],{"class":734,"line":859},9,[732,861,862],{"class":756},"end\n",[320,864,415],{"id":865},"server-seite-1",[240,867,713,868,268,870,717,872,875],{},[265,869,267],{},[265,871,271],{},[265,873,874],{},"CheckIfPlayerHidden"," in Ihrem serverseitigen Skript. Diese Funktion prüft, ob ein Spieler basierend auf seinem Duty-Status und dem erforderlichen Tracking-Gegenstand im Inventar verborgen sein soll.",[723,877,879],{"className":725,"code":878,"language":727,"meta":728,"style":728},"-- Spieler-Tracker - Versteckt-Funktion überprüfen\nFunctions.CheckIfPlayerHidden = function(xPlayer)\n    if Config.Framework == 'esx' then\n        -- ESX\n        return not xPlayer.job.onDuty or (Config.Tracking.Item and not xPlayer.getInventoryItem(Config.Tracking.Item))\n    elseif Config.Framework == 'qbcore' then\n        -- QBCore\n        return not xPlayer.PlayerData.job.onduty or (Config.Tracking.Item and not exports['qb-inventory']:HasItem(xPlayer.PlayerData.source, Config.Tracking.Item))\n    else\n        -- Fallback\n        return false\n    end\nend\n",[265,880,881,886,903,927,932,987,1006,1011,1080,1085,1091,1099,1104],{"__ignoreMap":728},[732,882,883],{"class":734,"line":735},[732,884,885],{"class":738},"-- Spieler-Tracker - Versteckt-Funktion überprüfen\n",[732,887,888,890,892,894,896,898,901],{"class":734,"line":742},[732,889,746],{"class":745},[732,891,874],{"