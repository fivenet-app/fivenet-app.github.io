55],{},[301,346,347],{},[211,348,349],{},"Config.PostalCommand",[301,351,352],{},[211,353,354],{},"'plz'",[301,356,357],{},"Befehl, um die Postleitzahl auf der Karte des Spielers zu markieren.",[266,359,361],{"id":360},"server-seite","Server-Seite",[186,363,364,365,275],{},"Die serverseitige Konfiguration befindet sich in ",[211,366,243],{},[277,368,369,379],{},[280,370,371],{},[283,372,373,375,377],{},[286,374,288],{},[286,376,291],{},[286,378,294],{},[296,380,381,400,414,428,443,457,471,486,501,516,530,545,559,574,593,608,622],{},[283,382,383,387,392],{},[301,384,385],{},[211,386,240],{},[301,388,389],{},[211,390,391],{},"'esx'",[301,393,394,395,214,397,399],{},"Das verwendete Framework. Kann ",[211,396,213],{},[211,398,217],{}," sein.",[283,401,402,406,411],{},[301,403,404],{},[211,405,248],{},[301,407,408],{},[211,409,410],{},"'demo.fivenet.app:443'",[301,412,413],{},"Der FiveNet-Hostname, muss den Port enthalten, wenn nicht 443, erfordert HTTPS.",[283,415,416,420,425],{},[301,417,418],{},[211,419,255],{},[301,421,422],{},[211,423,424],{},"'YOUR_SYNC_API_TOKEN'",[301,426,427],{},"Der API-Token für FiveNet.",[283,429,430,435,440],{},[301,431,432],{},[211,433,434],{},"Config.API.Insecure",[301,436,437],{},[211,438,439],{},"false",[301,441,442],{},"Ob unsichere Verbindungen erlaubt sind.",[283,444,445,450,454],{},[301,446,447],{},[211,448,449],{},"Config.TrackCharIDs",[301,451,452],{},[211,453,324],{},[301,455,456],{},"Ob die letzte Charakter-ID aufgezeichnet werden soll.",[283,458,459,464,468],{},[301,460,461],{},[211,462,463],{},"Config.Tracking.Enable",[301,465,466],{},[211,467,324],{},[301,469,470],{},"Aktivieren oder Deaktivieren des Spieler-Trackings.",[283,472,473,478,483],{},[301,474,475],{},[211,476,477],{},"Config.Tracking.Jobs",[301,479,480],{},[211,481,482],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[301,484,485],{},"Jobs, die verfolgt werden.",[283,487,488,493,498],{},[301,489,490],{},[211,491,492],{},"Config.Tracking.Item",[301,4