214,225],"ul",{},[205,215,216,217,224],{},"Laden Sie den ",[218,219,223],"a",{"href":220,"rel":221},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[222],"nofollow","FiveM-Plugin-Code"," von GitHub herunter.",[205,226,227],{},"Verwenden Sie die neueste Version, um Kompatibilitätsprobleme mit neueren FiveNet-Releases zu vermeiden.",[205,229,230,233],{},[208,231,232],{},"Plugin installieren",[212,234,235,243],{},[205,236,237,238,242],{},"Legen Sie die Plugin-Dateien im ",[239,240,241],"code",{},"resources","-Verzeichnis Ihres FiveM-Servers ab.",[205,244,245,246,249],{},"Stellen Sie sicher, dass der Ressourcenordner ",[239,247,248],{},"fivenet"," heißt, sofern Sie Ihre Serverkonfiguration nicht bewusst auf einen anderen Namen anpassen.",[251,252,253,266,281],"callout",{},[190,254,255,258,259,265],{},[208,256,257],{},"Hinweis:"," Aktuell müssen Sie die ",[208,260,261,264],{},[239,262,263],{},"yarn","-Builder-Systemressource"," patchen, damit das FiveNet-Plugin funktioniert. Dies ist eine temporäre Übergangslösung, bis FiveM offiziell auf eine neuere Node.js-Version umstellt.",[190,267,268,269,272,273,276,277,280],{},"Aktualisieren Sie in ",[239,270,271],{},"yarn\u002Fyarn_builder.js"," die an ",[239,274,275],{},"yarn install"," übergebenen Argumente, sodass das Flag ",[239,278,279],{},"--ignore-engines"," enthalten ist. Dadurch kann der Plugin-Build Engine-Prüfungen umgehen, die nicht zu Ihrer FiveM-Umgebung passen.",[282,283,288],"pre",{"className":284,"code":285,"language":286,"meta":287,"style":287},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scrip