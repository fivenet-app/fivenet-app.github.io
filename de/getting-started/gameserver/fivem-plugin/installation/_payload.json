02Fmain\u002Ffivem\u002Ffivenet",[282],"nofollow","FiveM-Plugin-Code"," von GitHub herunter.",[265,286,287],{},"Verwenden Sie die neueste Version, um Kompatibilitätsprobleme mit neueren FiveNet-Releases zu vermeiden.",[265,289,290,293],{},[268,291,292],{},"Plugin installieren",[272,294,295,303],{},[265,296,297,298,302],{},"Legen Sie die Plugin-Dateien im ",[299,300,301],"code",{},"resources","-Verzeichnis Ihres FiveM-Servers ab.",[265,304,305,306,309],{},"Stellen Sie sicher, dass der Ressourcenordner ",[299,307,308],{},"fivenet"," heißt, sofern Sie Ihre Serverkonfiguration nicht bewusst auf einen anderen Namen anpassen.",[311,312,313,326,341],"callout",{},[250,314,315,318,319,325],{},[268,316,317],{},"Hinweis:"," Aktuell müssen Sie die ",[268,320,321,324],{},[299,322,323],{},"yarn","-Builder-Systemressource"," patchen, damit das FiveNet-Plugin funktioniert. Dies ist eine temporäre Übergangslösung, bis FiveM offiziell auf eine neuere Node.js-Version umstellt.",[250,327,328,329,332,333,336,337,340],{},"Aktualisieren Sie in ",[299,330,331],{},"yarn\u002Fyarn_builder.js"," die an ",[299,334,335],{},"yarn install"," übergebenen Argumente, sodass das Flag ",[299,338,339],{},"--ignore-engines"," enthalten ist. Dadurch kann der Plugin-Build Engine-Prüfungen umgehen, die nicht zu Ihrer FiveM-Umgebung passen.",[342,343,348],"pre",{"className":344,"code":345,"language":346,"meta":347,"style":347},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[299,349,350,359,373,379,385,391,401,411,417,423],{"__ignoreMap":347},[351,352,355],"span",{"class":353,"line":354},"line",1,[351,356,358],{"class":357},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[351,360,362,366,370],{"class":353,"line":361},2,[351,363,365],{"class":364},"sMK4o","@@",[351,367,369],{"class":368},"sTEyZ"," -43,7 +43,7 ",[351,371,372],{"class":364},"@@\n",[351,374,376],{"class":353,"line":375},3,[351,377,378],{"class":368},"            currentBuildingModule = resourceName;\n",[351,380,382],{"class":353,"line":381},4,[351,383,384],{"class":368},"            const proc = child_process.fork(\n",[351,386,388],{"class":353,"line":387},5,[351,389,390],{"class":368},"                require.resolve('.\u002Fyarn_cli.js'),\n",[351,392,394,397],{"class":353,"line":393},6,[351,395,396],{"class":364},"-",[351,398,400],{"class":399},"swJcz","               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[351,402,404,407],{"class":353,"line":403},7,[351,405,406],{"class":364},"+",[351,408,410],{"class":409},"sfazB","               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[351,412,414],{"class":353,"line":413},8,[351,415,416],{"class":368},"                {\n",[351,418,420],{"class":353,"line":419},9,[351,421,422],{"class":368},"                    cwd: path.resolve(GetResourcePath(resourceName)),\n",[351,424,426],{"class":353,"line":425},10,[351,427,428],{"