"," enthalten ist. Dadurch kann der Plugin-Build Engine-Prüfungen umgehen, die nicht zu Ihrer FiveM-Umgebung passen.",[298,299,304],"pre",{"className":300,"code":301,"language":302,"meta":303,"style":303},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[255,305,306,315,329,335,341,347,357,367,373,379],{"__ignoreMap":303},[307,308,311],"span",{"class":309,"line":310},"line",1,[307,312,314],{"class":313},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[307,316,318,322,326],{"class":309,"line":317},2,[307,319,321],{"class":320},"sMK4o","@@",[307,323,325],{"class":324},"sTEyZ"," -43,7 +43,7 ",[307,327,328],{"class":320},"@@\n",[307,330,332],{"class":309,"line":331},3,[307,333,334],{"class":324},"            currentBuildingModule = resourceName;\n",[307,336,338],{"class":309,"line":337},4,[307,339,340],{"class":324},"            const proc = child_process.fork(\n",[307,342,344],{"class":309,"line":343},5,[307,345,346],{"class":324},"                require.resolve('.\u002Fyarn_cli.js'),\n",[307,348,350,353],{"class":309,"line":349},6,[307,351,352],{"class":320},"-",[307,354,356],{"cla