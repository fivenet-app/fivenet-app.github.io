e temporäre Übergangslösung, bis FiveM offiziell auf eine neuere Node.js-Version umstellt.",[239,316,317,318,321,322,325,326,329],{},"Aktualisieren Sie in ",[288,319,320],{},"yarn\u002Fyarn_builder.js"," die an ",[288,323,324],{},"yarn install"," übergebenen Argumente, sodass das Flag ",[288,327,328],{},"--ignore-engines"," enthalten ist. Dadurch kann der Plugin-Build Engine-Prüfungen umgehen, die nicht zu Ihrer FiveM-Umgebung passen.",[331,332,337],"pre",{"className":333,"code":334,"language":335,"meta":336,"style":336},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[288,338,339,348,362,368,374,380,390,400,406,412],{"__ignoreMap":336},[340,341,344],"span",{"class":342,"line":343},"line",1,[340,345,347],{"class":346},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[340,349,351,355,359],{"class":342,"line":350},2,[340,352,354],{"class":353},"sMK4o","@@",[340,356,358],{"class":357},"sTEyZ"," -43,7 +43,7 ",[340,360,361],{"class":353},"@@\n",[340,363,365],{"class":342,"line":364},3,[340,366,367],{"class":357},"            currentBuildingModule = resourceName;\n",[340,369,371],{"clas