n":218},"Design Docs","\u002Fdesign","9.design\u002F1.index",[219,221,225,229,232,236,240],{"title":220,"path":216,"stem":217},"Designs",{"title":222,"path":223,"stem":224},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":226,"path":227,"stem":228},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":170,"path":230,"stem":231},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":233,"path":234,"stem":235},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":237,"path":238,"stem":239},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":241,"path":242,"stem":243},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":245,"title":52,"body":246,"description":252,"extension":389,"links":390,"meta":391,"navigation":392,"path":393,"redirect":390,"seo":394,"stem":395,"__hash__":396},"content_de\u002Fde\u002F1.getting-started\u002F4.installation\u002F2.cloud.md",{"type":247,"value":248,"toc":379},"minimark",[249,253,256,261,290,294,305,308,312,327,331,372,376],[250,251,252],"p",{},"FiveNet Cloud ist heute als verwaltete Hosting-Option für Communities verfügbar, die möchten, dass wir FiveNet für sie betreiben und warten.",[250,254,255],{},"Der Dienst wird von ZerBytes UG (haftungsbeschränkt) gehostet.",[257,258,260],"h3",{"id":259},"warum-fivenet-cloud","Warum FiveNet Cloud?",[262,263,264,272,278,284],"ul",{},[265,266,267,271],"li",{},[268,269,270],"strong",{},"Verwaltetes Hosting",": Wir betreiben und warten Ihre FiveNet-Instanz für Sie.",[265,273,274,277],{},[268,275,276],{},"Weniger Betriebsaufwand",": Sie müssen keine eigene Docker- oder Kubernetes-Umgebung für FiveNet aufbauen und pflegen.",[265,279,280,283],{},[268,281,282],{},"Fortlaufende Updates",": Wir halten Ihre FiveNet-Instanz aktuell, sobald neue Releases verfügbar sind.",[265,285,286,289],{},[268,287,288],{},"Direkter Support",": Cloud-Kunden können sich für Onboarding- und Betriebsfragen über Discord-Support-Tickets an uns wenden.",[257,291,293],{"id":292},"was-sie-weiterhin-bereitstellen-müssen","Was Sie weiterhin bereitstellen müssen",[262,295,296,299,302],{},[265,297,298],{},"Zugriff auf die Gameserver-Datenbank, die FiveNet verwenden soll.",[265,300,301],{},"Die erforderliche Plugin-Integration auf Ihrem Gameserver.",[265,303,304],{},"Alle server-spezifischen Konfigurationen, die Ihre Community und Ihr Framework benötigen.",[250,306,307],{},"FiveNet Cloud reduziert den Infrastrukturaufwand auf Ihrer Seite, aber Sie müssen es weiterhin mit Ihrer Gameserver-Umgebung verbinden.",[257,309,311],{"id":310},"erste-schritte","Erste Schritte",[313,314,315,318,321,324],"ol",{},[265,316,317],{},"Treten Sie dem FiveNet-Discord bei.",[265,319,320],{},"Erstellen Sie ein Support-Ticket für FiveNet Cloud.",[265,322,323],{},"Teilen Sie die für Ihre Einrichtung benötigten Details mit, z. B. Ihre Community, Ihre Gameserver-Umgebung und die Datenbankanbindung.",[265,325,326],{},"Wir begleiten Sie durch das Onboarding und die verbleibenden Einrichtungsschritte.",[257,328,330],{"id":329},"faqs","FAQs",[332,333,336,344,351,358,365],"card-group",{"className":334},[335],"sm:grid-cols-1",[337,338,341],"card",{"icon":339,"title":340},"i-mdi-database","Was passiert mit meinen Daten?",[250,342,343],{},"Ihre Gameserver-Datenbank muss für FiveNet erreichbar sein. Wenn Sie später zu einer selbstgehosteten Instanz wechseln, können Sie die Anhangsdaten, z. B. Avatare, anfordern.",[337,345,348],{"icon":346,"title":347},"i-mdi-currency-usd-off","Gibt es eine kostenlose Version?",[250,349,350],{},"Derzeit gibt es keine kostenlose Version von FiveNet Cloud.",[337,352,355],{"icon":353,"title":354},"i-mdi-cloud-upload","Wie migriere ich von selbstgehostet zu Cloud?",[250,356,357],{},"Eine vollständige Migration ist nicht erforderlich. Da Ihre FiveNet-Daten, wie Bürger und Dokumente, an Ihre Datenbank gebunden bleiben, besteht der wichtigste zusätzliche Schritt darin, bei Bedarf die Anhangsdaten zu übernehmen.",[337,359,362],{"icon":360,"title":361},"i-mdi-cloud-download","Wie migriere ich von Cloud zu selbstgehostet?",[250,363,364],{},"Da FiveNet-Daten wie Bürger und Dokumente in Ihrer Datenbank gespeichert sind, benötigen Sie hauptsächlich eine Kopie der Anhangsdaten für Ihre selbstgehostete Instanz. Das FiveNet-Cloud-Team kann Sie dabei unterstützen.",[337,366,369],{"icon":367,"title":368},"i-mdi-tools","Benötige ich trotzdem technische Einrichtung auf meiner Seite?",[250,370,371],{},"Ja. FiveNet Cloud nimmt Ihnen den Großteil der Infrastrukturarbeit ab, aber Sie müssen weiterhin den Datenbankzugriff bereitstellen und die erforderliche Plugin-Integration für Ihren Gameserver abschließen.",[257,373,375],{"id":374},"nächster-schritt","Nächster Schritt",[250,377,378],{},"Treten Sie dem FiveNet-Discord bei und erstellen Sie ein Cloud-Support-Ticket, um mit FiveNet Cloud zu starten. Unser Team hilft Ihnen gern beim Onboarding, bei Einrichtungsfragen und bei der Migrationsplanung.",{"title":380,"searchDepth":381,"depth":381,"links":382},"",2,[383,385,386,387,388],{"id":259,"depth":384,"text":260},3,{"id":292,"depth":384,"text":293},{"id":310,"depth":384,"text":311},{"id":329,"depth":384,"text":330},{"id":374,"depth":384,"text":375},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Finstallation\u002Fcloud",{"title":52,"description":252},"de\u002F1.getting-started\u002F4.installation\u002F2.cloud","9vMMCTwrYoCqK_revHelhTiQ1V826NGGXsYIe0lm2Zc",1795668797922,"327ba70d-3fd6-46b8-a994-eb9ed570f162"]