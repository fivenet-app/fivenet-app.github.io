":169,"children":170},"Development","\u002Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":41,"body":219,"description":225,"extension":362,"links":363,"meta":364,"navigation":365,"path":366,"redirect":363,"seo":367,"stem":368,"__hash__":369},"content_de\u002Fde\u002F1.getting-started\u002F4.installation\u002F2.cloud.md",{"type":220,"value":221,"toc":352},"minimark",[222,226,229,234,263,267,278,281,285,300,304,345,349],[223,224,225],"p",{},"FiveNet Cloud ist heute als verwaltete Hosting-Option für Communities verfügbar, die möchten, dass wir FiveNet für sie betreiben und warten.",[223,227,228],{},"Der Dienst wird von ZerBytes UG (haftungsbeschränkt) gehostet.",[230,231,233],"h3",{"id":232},"warum-fivenet-cloud","Warum FiveNet Cloud?",[235,236,237,245,251,257],"ul",{},[238,239,240,244],"li",{},[241,242,243],"strong",{},"Verwaltetes Hosting",": Wir betreiben und warten Ihre FiveNet-Instanz für Sie.",[238,246,247,250],{},[241,248,249],{},"Weniger Betriebsaufwand",": Sie müssen keine eigene Docker- oder Kubernetes-Umgebung für FiveNet aufbauen und pflegen.",[238,252,253,256],{},[241,254,255],{},"Fortlaufende Updates",": Wir halten Ihre FiveNet-Instanz aktuell, sobald neue Releases verfügbar sind.",[238,258,259,262],{},[241,260,261],{},"Direkter Support",": Cloud-Kunden können sich für Onboarding- und Betriebsfragen über Discord-Support-Tickets an uns wenden.",[230,264,266],{"id":265},"was-sie-weiterhin-bereitstellen-müssen","Was Sie weiterhin bereitstellen müssen",[235,268,269,272,275],{},[238,270,271],{},"Zugriff auf die Gameserver-Datenbank, die FiveNet verwenden soll.",[238,273,274],{},"Die erforderliche Plugin-Integration auf Ihrem Gameserver.",[238,276,277],{},"Alle server-spezifischen Konfigurationen, die Ihre Community und Ihr Framework benötigen.",[223,279,280],{},"FiveNet Cloud reduziert den Infrastrukturaufwand auf Ihrer Seite, aber Sie müssen es weiterhin mit Ihrer Gameserver-Umgebung verbinden.",[230,282,284],{"id":283},"erste-schritte","Erste Schritte",[286,287,288,291,294,297],"ol",{},[238,289,290],{},"Treten Sie dem FiveNet-Discord bei.",[238,292,293],{},"Erstellen Sie ein Support-Ticket für FiveNet Cloud.",[238,295,296],{},"Teilen Sie die für Ihre Einrichtung benötigten Details mit, z. B. Ihre Community, Ihre Gameserver-Umgebung und die Datenbankanbindung.",[238,298,299],{},"Wir begleiten Sie durch das Onboarding und die verbleibenden Einrichtungsschritte.",[230,301,303],{"id":302},"faqs","FAQs",[305,306,309,317,324,331,338],"card-group",{"className":307},[308],"sm:grid-cols-1",[310,311,314],"card",{"icon":312,"title":313},"i-mdi-database","Was passiert mit meinen Daten?",[223,315,316],{},"Ihre Gameserver-Datenbank muss für FiveNet erreichbar sein. Wenn Sie später zu einer selbstgehosteten Instanz wechseln, können Sie die Anhangsdaten, z. B. Avatare, anfordern.",[310,318,321],{"icon":319,"title":320},"i-mdi-currency-usd-off","Gibt es eine kostenlose Version?",[223,322,323],{},"Derzeit gibt es keine kostenlose Version von FiveNet Cloud.",[310,325,328],{"icon":326,"title":327},"i-mdi-cloud-upload","Wie migriere ich von selbstgehostet zu Cloud?",[223,329,330],{},"Eine vollständige Migration ist nicht erforderlich. Da Ihre FiveNet-Daten, wie Bürger und Dokumente, an Ihre Datenbank gebunden bleiben, besteht der wichtigste zusätzliche Schritt darin, bei Bedarf die Anhangsdaten zu übernehmen.",[310,332,335],{"icon":333,"title":334},"i-mdi-cloud-download","Wie migriere ich von Cloud zu selbstgehostet?",[223,336,337],{},"Da FiveNet-Daten wie Bürger und Dokumente in Ihrer Datenbank gespeichert sind, benötigen Sie hauptsächlich eine Kopie der Anhangsdaten für Ihre selbstgehostete Instanz. Das FiveNet-Cloud-Team kann Sie dabei unterstützen.",[310,339,342],{"icon":340,"title":341},"i-mdi-tools","Benötige ich trotzdem technische Einrichtung auf meiner Seite?",[223,343,344],{},"Ja. FiveNet Cloud nimmt Ihnen den Großteil der Infrastrukturarbeit ab, aber Sie müssen weiterhin den Datenbankzugriff bereitstellen und die erforderliche Plugin-Integration für Ihren Gameserver abschließen.",[230,346,348],{"id":347},"nächster-schritt","Nächster Schritt",[223,350,351],{},"Treten Sie dem FiveNet-Discord bei und erstellen Sie ein Cloud-Support-Ticket, um mit FiveNet Cloud zu starten. Unser Team hilft Ihnen gern beim Onboarding, bei Einrichtungsfragen und bei der Migrationsplanung.",{"title":353,"searchDepth":354,"depth":354,"links":355},"",2,[356,358,359,360,361],{"id":232,"depth":357,"text":233},3,{"id":265,"depth":357,"text":266},{"id":283,"depth":357,"text":284},{"id":302,"depth":357,"text":303},{"id":347,"depth":357,"text":348},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Finstallation\u002Fcloud",{"title":41,"description":225},"de\u002F1.getting-started\u002F4.installation\u002F2.cloud","9vMMCTwrYoCqK_revHelhTiQ1V826NGGXsYIe0lm2Zc",[371,376],{"title":372,"path":373,"stem":374,"description":375,"children":-1},"Installationsmethoden","\u002Fde\u002Fgetting-started\u002Finstallation\u002Fmethods","de\u002F1.getting-started\u002F4.installation\u002F1.methods","Wählen Sie den Installationsweg, der zu Ihrer Umgebung passt, egal ob Sie verwaltetes Hosting mit FiveNet Cloud oder eine selbstgehostete Bereitstellung mit Docker oder Kubernetes möchten.",{"title":377,"path":378,"stem":379,"description":380,"children":-1},"Verwendung von Docker","\u002Fde\u002Fgetting-started\u002Finstallation\u002Fcontainer-docker","de\u002F1.getting-started\u002F4.installation\u002F3.container-docker","Stellen Sie FiveNet mit Docker Engine und dem Docker-Compose-Plugin auf einem einzelnen Server bereit.",1789005936645]