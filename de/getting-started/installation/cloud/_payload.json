"\u002Fuser-guides\u002Fmailer","3.user-guides\u002F6.mailer",{"title":167,"path":168,"stem":169},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":171,"path":172,"stem":173},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":175,"path":176,"stem":177},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":179,"path":180,"stem":181},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":183,"path":184,"stem":185,"children":186},"Development","\u002Fdevelopment","8.development\u002F1.index",[187,188,192,196,200],{"title":183,"path":184,"stem":185},{"title":189,"path":190,"stem":191},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":193,"path":194,"stem":195},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":197,"path":198,"stem":199},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":171,"path":201,"stem":202},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":204,"path":205,"stem":206,"children":207},"Design Docs","\u002Fdesign","9.design\u002F1.index",[208,210,214,218,221,225,229],{"title":209,"path":205,"stem":206},"Designs",{"title":211,"path":212,"stem":213},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":215,"path":216,"stem":217},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":159,"path":219,"stem":220},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":222,"path":223,"stem":224},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":226,"path":227,"stem":228},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":41,"body":235,"description":241,"extension":378,"links":379,"meta":380,"navigation":381,"path":382,"redirect":379,"seo":383,"stem":384,"__hash__":385},"content_de\u002Fde\u002F1.getting-started\u002F4.installation\u002F2.cloud.md",{"type":236,"value":237,"toc":368},"minimark",[238,242,245,250,279,283,294,297,301,316,320,361,365],[239,240,241],"p",{},"FiveNet Cloud ist heute als verwaltete Hosting-Option für Communities verfügbar, die möchten, dass wir FiveNet für sie betreiben und warten.",[239,243,244],{},"Der Dienst wird von ZerBytes UG (haftungsbeschränkt) gehostet.",[246,247,249],"h3",{"id":248},"warum-fivenet-cloud","Warum FiveNet Cloud?",[251,252,253,261,267,273],"ul",{},[254,255,256,260],"li",{},[257,258,259],"strong",{},"Verwaltetes Hosting",": Wir betreiben und warten Ihre FiveNet-Instanz für Sie.",[254,262,263,266],{},[257,264,265],{},"Weniger Betriebsaufwand",": Sie müssen keine eigene Docker- oder Kubernetes-Umgebung für FiveNet aufbauen und pflegen.",[254,268,269,272],{},[257,270,271],{},"Fortlaufende Updates",": Wir halten Ihre FiveNet-Instanz aktuell, sobald neue Releases verfügbar sind.",[254,274,275,278],{},[257,276,277],{},"Direkter Support",": Cloud-Kunden können sich für Onboarding- und Betriebsfragen über Discord-Support-Tickets an uns wenden.",[246,280,282],{"id":281},"was-sie-weiterhin-bereitstellen-müssen","Was Sie weiterhin bereitstellen müssen",[251,284,285,288,291],{},[254,286,287],{},"Zugriff auf die Gameserver-Datenbank, die FiveNet verwenden soll.",[254,289,290],{},"Die erforderliche Plugin-Integration auf Ihrem Gameserver.",[254,292,293],{},"Alle server-spezifischen Konfigurationen, die Ihre Community und Ihr Framework benötigen.",[239,295,296],{},"FiveNet Cloud reduziert den Infrastrukturaufwand auf Ihrer Seite, aber Sie müssen es weiterhin mit Ihrer Gameserver-Umgebung verbinden.",[246,298,300],{"id":299},"erste-schritte","Erste Schritte",[302,303,304,307,310,313],"ol",{},[254,305,306],{},"Treten Sie dem FiveNet-Discord bei.",[254,308,309],{},"Erstellen Sie ein Support-Ticket für FiveNet Cloud.",[254,311,312],{},"Teilen Sie die für Ihre Einrichtung benötigten Details mit, z. B. Ihre Community, Ihre Gameserver-Umgebung und die Datenbankanbindung.",[254,314,315],{},"Wir begleiten Sie durch das Onboarding und die verbleibenden Einrichtungsschritte.",[246,317,319],{"id":318},"faqs","FAQs",[321,322,325,333,340,347,354],"card-group",{"className":323},[324],"sm:grid-cols-1",[326,327,330],"card",{"icon":328,"title":329},"i-mdi-database","Was passiert mit meinen Daten?",[239,331,332],{},"Ihre Gameserver-Datenbank muss für FiveNet erreichbar sein. Wenn Sie später zu einer selbstgehosteten Instanz wechseln, können Sie die Anhangsdaten, z. B. Avatare, anfordern.",[326,334,337],{"icon":335,"title":336},"i-mdi-currency-usd-off","Gibt es eine kostenlose Version?",[239,338,339],{},"Derzeit gibt es keine kostenlose Version von FiveNet Cloud.",[326,341,344],{"icon":342,"title":343},"i-mdi-cloud-upload","Wie migriere ich von selbstgehostet zu Cloud?",[239,345,346],{},"Eine vollständige Migration ist nicht erforderlich. Da Ihre FiveNet-Daten, wie Bürger und Dokumente, an Ihre Datenbank gebunden bleiben, besteht der wichtigste zusätzliche Schritt darin, bei Bedarf die Anhangsdaten zu übernehmen.",[326,348,351],{"icon":349,"title":350},"i-mdi-cloud-download","Wie migriere ich von Cloud zu selbstgehostet?",[239,352,353],{},"Da FiveNet-Daten wie Bürger und Dokumente in Ihrer Datenbank gespeichert sind, benötigen Sie hauptsächlich eine Kopie der Anhangsdaten für Ihre selbstgehostete Instanz. Das FiveNet-Cloud-Team kann Sie dabei unterstützen.",[326,355,358],{"icon":356,"title":357},"i-mdi-tools","Benötige ich trotzdem technische Einrichtung auf meiner Seite?",[239,359,360],{},"Ja. FiveNet Cloud nimmt Ihnen den Großteil der Infrastrukturarbeit ab, aber Sie müssen weiterhin den Datenbankzugriff bereitstellen und die erforderliche Plugin-Integration für Ihren Gameserver abschließen.",[246,362,364],{"id":363},"nächster-schritt","Nächster Schritt",[239,366,367],{},"Treten Sie dem FiveNet-Discord bei und erstellen Sie ein Cloud-Support-Ticket, um mit FiveNet Cloud zu starten. Unser Team hilft Ihnen gern beim Onboarding, bei Einrichtungsfragen und bei der Migrationsplanung.",{"title":369,"searchDepth":370,"depth":370,"links":371},"",2,[372,374,375,376,377],{"id":248,"depth":373,"text":249},3,{"id":281,"depth":373,"text":282},{"id":299,"depth":373,"text":300},{"id":318,"depth":373,"text":319},{"id":363,"depth":373,"text":364},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Finstallation\u002Fcloud",{"title":41,"description":241},"de\u002F1.getting-started\u002F4.installation\u002F2.cloud","9vMMCTwrYoCqK_revHelhTiQ1V826NGGXsYIe0lm2Zc",[387,392],{"title":388,"path":389,"stem":390,"description":391,"children":-1},"Installationsmethoden","\u002Fde\u002Fgetting-started\u002Finstallation\u002Fmethods","de\u002F1.getting-started\u002F4.installation\u002F1.methods","Wählen Sie den Installationsweg, der zu Ihrer Umgebung passt, egal ob Sie verwaltetes Hosting mit FiveNet Cloud oder eine selbstgehostete Bereitstellung mit Docker oder Kubernetes möchten.",{"title":393,"path":394,"stem":395,"description":396,"children":-1},"Verwendung von Docker","\u002Fde\u002Fgetting-started\u002Finstallation\u002Fcontainer-docker","de\u002F1.getting-started\u002F4.installation\u002F3.container-docker","Stellen Sie FiveNet mit Docker Engine und dem Docker-Compose-Plugin auf einem einzelnen Server bereit.",1789079053108]