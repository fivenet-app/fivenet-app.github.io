stem":216,"children":217},"Design Docs","\u002Fdesign","9.design\u002F1.index",[218,220,224,228,231,235,239],{"title":219,"path":215,"stem":216},"Designs",{"title":221,"path":222,"stem":223},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":225,"path":226,"stem":227},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":169,"path":229,"stem":230},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":232,"path":233,"stem":234},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":236,"path":237,"stem":238},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":240,"path":241,"stem":242},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":244,"title":245,"body":246,"description":252,"extension":759,"links":760,"meta":761,"navigation":762,"path":763,"redirect":760,"seo":764,"stem":765,"__hash__":766},"content_de\u002Fde\u002F1.getting-started\u002F4.installation\u002F3.container-docker.md","Verwendung von Docker",{"type":247,"value":248,"toc":745},"minimark",[249,253,262,267,270,279,287,290,322,329,336,347,357,360,396,403,412,426,430,438,455,459,465,475,479,482,508,512,515,541,544,548,565,569,572,713,716,720,728,733,741],[250,251,252],"p",{},"Stellen Sie FiveNet mit Docker Engine und dem Docker-Compose-Plugin auf einem einzelnen Server bereit.",[250,254,255,256,261],{},"Prüfen Sie vor Beginn die ",[257,258,260],"a",{"href":259},"..\u002Frequirements","Anforderungen"," und stellen Sie sicher, dass Datenbank, NATS-Server, Storage, Domain und Reverse-Proxy bereit sind.",[263,264,266],"h2",{"id":265},"_1-docker-engine-und-docker-compose-installieren","1. Docker Engine und Docker Compose installieren",[250,268,269],{},"Sie benötigen Docker Engine als Container-Laufzeitumgebung und das Docker-Compose-Plugin, um FiveNet einfach mit Containern auszuführen.",[250,271,272,273,278],{},"Bitte verwenden Sie eine der vielen im Internet verfügbaren Anleitungen, um Docker Engine und Docker Compose auf Ihrem Server zu installieren, z. B. ",[257,274,275],{"href":275,"rel":276},"https:\u002F\u002Fdocs.docker.com\u002Fengine\u002Finstall\u002F",[277],"nofollow",".",[250,280,281,282,286],{},"Abhängig vom Betriebssystem Ihres Servers stellen Sie sicher, dass der Docker-Daemon mit ",[283,284,285],"code",{},"systemctl start docker"," gestartet wird.",[250,288,289],{},"Um zu überprüfen, ob Docker und das Docker-Compose-Plugin bereit sind, können Sie die folgenden Befehle verwenden:",[291,292,297],"pre",{"className":293,"code":294,"language":295,"meta":296,"style":296},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","docker version\ndocker compose version\n","bash","",[283,298,299,312],{"__ignoreMap":296},[300,301,304,308],"span",{"class":302,"line":303},"line",1,[300,305,307],{"class":306},"sBMFI","docker",[300,309,311],{"class":310},"sfazB"," version\n",[300,313,315,317,320],{"class":302,"line":314},2,[300,316,307],{"class":306},[300,318,319],{"class":310}," compose",[300,321,311],{"class":310},[250,323,324,325,328],{},"Sie können nun mit der Vorbereitung der Datei ",[283,326,327],{},"docker-compose.yaml"," für Ihre Umgebung fortfahren.",[263,330,332,333,335],{"id":331},"_2-docker-composeyaml-vorbereiten","2. ",[283,334,327],{}," vorbereiten",[337,338,339],"callout",{},[250,340,341,342,278],{},"Container-Images sind verfügbar im ",[257,343,346],{"href":344,"rel":345},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Ffivenet\u002Fpkgs\u002Fcontainer\u002Ffivenet",[277],"GHCR.io fivenet-app\u002Ffivenet-Registry",[250,348,349,350,356],{},"Verwenden Sie die Beispieldatei ",[257,351,354],{"href":352,"rel":353},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Ffivenet\u002Fblob\u002Fmain\u002Fdocker-compose.yaml",[277],[283,355,327],{}," als Ausgangspunkt.",[250,358,359],{},"Prüfen Sie die Beispieldatei und passen Sie sie an Ihre Umgebung an, bevor Sie den Stack starten. Achten Sie dabei insbesondere auf:",[361,362,363,387,390,393],"ul",{},[364,365,366,367,372,373,377,378],"li",{},"die Image-Tags, die Sie verwenden möchten (z.B. ein ",[257,368,371],{"href":369,"rel":370},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Ffivenet\u002Freleases",[277],"Release"," oder eine ",[257,374,376],{"href":344,"rel":375},[277],"Entwicklungsversion",")\n",[361,379,380],{},[364,381,382,383,386],{},"Verwenden Sie für produktive Umgebungen ein bestimmtes stabiles Release-Tag. Vermeiden Sie das veränderliche ",[283,384,385],{},"latest","-Tag.",[364,388,389],{},"Umgebungsvariablen und eingebundene Dateien",[364,391,392],{},"Datenbank-, NATS- und andere Service-Verbindungseinstellungen",[364,394,395],{},"Domain- oder Reverse-Proxy-bezogene Einstellungen, falls Sie FiveNet extern bereitstellen",[250,397,398,399,402],{},"Falls Sie bereits einen Docker-NGINX-Reverse-Proxy oder eine ähnliche Lösung verwenden, um Ihre Container-Anwendungen im Internet verfügbar zu machen, können Sie den ",[283,400,401],{},"nginx-proxy","-Container aus der Beispieldatei entfernen oder auskommentieren.\nWenn Sie den Docker-NGINX-Reverse-Proxy verwenden, stellen Sie sicher, dass die Umgebungsvariablen der einzelnen Container zu Ihrer gewünschten Domain oder Subdomain passen.",[337,404,405],{},[250,406,407,408,278],{},"Um das FiveNet-Container-Image selbst zu erstellen, lesen Sie zunächst die ",[257,409,411],{"href":410},"..\u002F..\u002F..\u002Fdevelopment\u002F","Entwicklungsanforderungen",[250,413,414,415,417,418,421,422,425],{},"Falls Sie den NATS-Server aus der Standard-",[283,416,327],{}," verwenden, nutzen Sie den Namen des Compose-Dienstes als Hostnamen, z. B. ",[283,419,420],{},"url: \"nats:\u002F\u002Ffivenet:fivenet_topsecret@nats:4222\"",". Verwenden Sie innerhalb des FiveNet-Containers nicht ",[283,423,424],{},"localhost","; dies verweist auf den FiveNet-Container selbst.",[263,427,429],{"id":428},"_21-fivenet-konfiguration-vorbereiten","2.1. FiveNet-Konfiguration vorbereiten",[337,431,435],{"color":432,"icon":433,"to":434},"secondary","i-mdi-head-idea","https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Ffivenet\u002Fblob\u002Fmain\u002Fconfig.example.yaml",[250,436,437],{},"Stellen Sie sicher, dass Sie die Beispielkonfigurationsdatei (hier klicken) verwenden und diese nach Bedarf anpassen.",[250,439,440,441,445,446,449,450,454],{},"Folgen Sie der Anleitung ",[257,442,444],{"href":443},"\u002Fde\u002Fgetting-started\u002Fconfiguration\u002Fconfigure","FiveNet konfigurieren",", um eine funktionierende ",[283,447,448],{},"config.yaml"," zu erstellen. Für einzelne Optionen können Sie anschließend die ",[257,451,453],{"href":452},"\u002Fde\u002Fgetting-started\u002Freference\u002Fconfig-reference","Konfigurationsdatei-Referenz"," verwenden.",[263,456,458],{"id":457},"_22-dbsync-konfiguration-vorbereiten","2.2. DBSync-Konfiguration vorbereiten",[337,460,462],{"color":432,"icon":433,"to":461},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Ffivenet\u002Fblob\u002Fmain\u002Fdbsync.example.yaml",[250,463,464],{},"Verwenden Sie die Beispieldatei für die DBSync-Konfiguration (hier klicken) und passen Sie sie nach Bedarf an.",[250,466,440,467,445,471,474],{},[257,468,470],{"href":469},"\u002Fde\u002Fgetting-started\u002Fconfiguration\u002Fdbsync","DBSync installieren und konfigurieren",[283,472,473],{},"dbsync.yaml"," zu erstellen.",[263,476,478],{"id":477},"_3-fivenet-ausführen","3. FiveNet ausführen",[250,480,481],{},"Laden Sie die neuesten Container-Images herunter und starten Sie die Server-, DBSync-, Worker- und Discord-Container:",[291,483,485],{"className":293,"code":484,"language":295,"meta":296,"style":296},"docker compose pull\ndocker compose up -d\n",[283,486,487,496],{"__ignoreMap":296},[300,488,489,491,493],{"class":302,"line":303},[300,490,307],{"class":306},[300,492,319],{"class":310},[300,494,495],{"class":310}," pull\n",[300,497,498,500,502,505],{"class":302,"line":314},[300,499,307],{"class":306},[300,501,319],{"class":310},[300,503,504],{"class":310}," up",[300,506,507],{"class":310}," -d\n",[263,509,511],{"id":510},"_4-bereitstellung-überprüfen","4. Bereitstellung überprüfen",[250,513,514],{},"Nachdem die Container laufen, prüfen Sie, ob der Stack korrekt gestartet wurde:",[291,516,518],{"className":293,"code":517,"language":295,"meta":296,"style":296},"docker compose ps\ndocker compose logs --tail=100\n",[283,519,520,529],{"__ignoreMap":296},[300,521,522,524,526],{"class":302,"line":303},[300,523,307],{"class":306},[300,525,319],{"class":310},[300,527,528],{"class":310}," ps\n",[300,530,531,533,535,538],{"class":302,"line":314},[300,532,307],{"class":306},[300,534,319],{"class":310},[300,536,537],{"class":310}," logs",[300,539,540],{"class":310}," --tail=100\n",[250,542,543],{},"Stellen Sie sicher, dass die FiveNet-Container gesund sind und die Anwendung über Ihre konfigurierte Domain, Ihren Reverse-Proxy oder Ihren lokalen Zugriffsweg erreichbar ist.",[263,545,547],{"id":546},"_5-empfehlungen-für-reverse-proxys","5. Empfehlungen für Reverse-Proxys",[250,549,550,551,556,557,560,561,564],{},"Falls Sie noch keinen Reverse-Proxy verwenden, um FiveNet bereitzustellen, ziehen Sie eine Lösung wie ",[257,552,555],{"href":553,"rel":554},"https:\u002F\u002Fgithub.com\u002Fnginx-proxy\u002Fnginx-proxy",[277],"nginx-proxy\u002Fnginx-proxy"," in Betracht, um den FiveNet-Server (",[283,558,559],{},"\u002F",") und den Iconify-API-Container (",[283,562,563],{},"\u002Fapi\u002Ficons",") sicher bereitzustellen.",[263,566,568],{"id":567},"_51-traefik-als-reverse-proxy-konfigurieren","5.1. Traefik als Reverse-Proxy konfigurieren",[250,570,571],{},"Falls Sie Traefik als Reverse-Proxy bevorzugen, folgen Sie diesen Schritten, um es für FiveNet zu konfigurieren:",[573,574,575,588,594,615,707],"ol",{},[364,576,577,581,582,587],{},[578,579,580],"strong",{},"Traefik installieren",": Befolgen Sie die ",[257,583,586],{"href":584,"rel":585},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002Fgetting-started\u002Finstallation\u002F",[277],"Traefik-Dokumentation"," für Installationsanweisungen.",[364,589,590,593],{},[578,591,592],{},"Traefik starten",": Führen Sie Traefik zusammen mit Ihren FiveNet-Containern mit Docker Compose aus.",[364,595,596,581,599,604,605],{},[578,597,598],{},"HTTPS\u002FTLS-Setup",[257,600,603],{"href":601,"rel":602},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002Fhttps\u002Ftls\u002F",[277],"Traefik HTTPS\u002FTLS-Setup-Dokumentation",", um sichere Verbindungen zu konfigurieren.",[361,606,607],{},[364,608,609,610,278],{},"Stellen Sie sicher, dass GRPC\u002FH2C-Unterstützung für den Dienst aktiviert ist. Weitere Informationen finden Sie unter ",[257,611,614],{"href":612,"rel":613},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002Fuser-guides\u002Fgrpc\u002F#with-http-h2c",[277],"Traefik GRPC mit HTTP (h2c)",[364,616,617,620,621,624,625,627,628],{},[578,618,619],{},"Container beschriften",": Fügen Sie die folgenden Labels zum ",[578,622,623],{},"FiveNet-Server-Container"," in Ihrer Datei ",[283,626,327],{}," hinzu:",[291,629,633],{"className":630,"code":631,"language":632,"meta":296,"style":296},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","labels:\n  - \"traefik.enable=true\"\n  - \"traefik.http.routers.fivenet.rule=Host(`your-domain.com`)\"\n  - \"traefik.http.routers.fivenet.entrypoints=websecure\"\n  - \"traefik.http.routers.fivenet.tls.certresolver=myresolver\"\n  - \"traefik.http.services.fivenet.loadbalancer.server.scheme=h2c\"\n","yaml",[283,634,635,645,659,671,683,695],{"__ignoreMap":296},[300,636,637,641],{"class":302,"line":303},[300,638,640],{"class":639},"swJcz","labels",[300,642,644],{"class":643},"sMK4o",":\n",[300,646,647,650,653,656],{"class":302,"line":314},[300,648,649],{"class":643},"  -",[300,651,652],{"class":643}," \"",[300,654,655],{"class":310},"traefik.enable=true",[300,657,658],{"class":643},"\"\n",[300,660,662,664,666,669],{"class":302,"line":661},3,[300,663,649],{"class":643},[300,665,652],{"class":643},[300,667,668],{"class":310},"traefik.http.routers.fivenet.rule=Host(`your-domain.com`)",[300,670,658],{"class":643},[300,672,674,676,678,681],{"class":302,"line":673},4,[300,675,649],{"class":643},[300,677,652],{"class":643},[300,679,680],{"class":310},"traefik.http.routers.fivenet.entrypoints=websecure",[300,682,658],{"class":643},[300,684,686,688,690,693],{"class":302,"line":685},5,[300,687,649],{"class":643},[300,689,652],{"class":643},[300,691,692],{"class":310},"traefik.http.routers.fivenet.tls.certresolver=myresolver",[300,694,658],{"class":643},[300,696,698,700,702,705],{"class":302,"line":697},6,[300,699,649],{"class":643},[300,701,652],{"class":643},[300,703,704],{"class":310},"traefik.http.services.fivenet.loadbalancer.server.scheme=h2c",[300,706,658],{"class":643},[364,708,709,712],{},[578,710,711],{},"Konfiguration überprüfen",": Stellen Sie sicher, dass Ihre Domain auf die IP des Servers zeigt und dass Traefik den Datenverkehr korrekt an die FiveNet-Container weiterleitet.",[250,714,715],{},"Dieses Setup ermöglicht es Ihnen, FiveNet sicher über das Internet mit Traefik zugänglich zu machen.",[263,717,719],{"id":718},"_6-schritte-nach-der-installation","6. Schritte nach der Installation",[250,721,722,723,727],{},"Führen Sie jetzt die ",[257,724,726],{"href":725},"post-install-steps","Ersteinrichtung"," aus.",[729,730,732],"h3",{"id":731},"fehlerbehebung","Fehlerbehebung",[250,734,735,736,740],{},"Falls Sie während der containerisierten Installation auf Probleme stoßen, wie z. B. Datenbank-Collation-Unstimmigkeiten, überprüfen Sie die Seite ",[257,737,739],{"href":738},"\u002Fde\u002Fgetting-started\u002Ftroubleshooting\u002Finstallation-issues","Datenbank- und Installationsfehlerbehebung"," für Lösungen.",[742,743,744],"style",{},"html pre