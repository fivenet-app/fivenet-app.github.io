,{"class":243}," namespace",[233,288,289],{"class":243}," fivenet\n",[202,291,293,294,297],{"id":292},"_3-aktuelle-valuesyaml-abrufen","3. Aktuelle ",[230,295,296],{},"values.yaml"," abrufen",[190,299,300,301,303],{},"Laden Sie die Standard-",[230,302,296],{},"-Datei für das Helm-Chart herunter, um Ihre Bereitstellung zu konfigurieren:",[223,305,307],{"className":225,"code":306,"language":227,"meta":228,"style":228},"helm show values fivenet\u002Ffivenet > values.yaml\n",[230,308,309],{"__ignoreMap":228},[233,310,311,313,316,319,322,326],{"class":235,"line":236},[233,312,240],{"class":239},[233,314,315],{"class":243}," show",[233,317,318],{"class":243}," values",[233,320,321],{"class":243}," fivenet\u002Ffivenet",[233,323,325],{"class":324},"sMK4o"," >",[233,327,328],{"class":243}," values.yaml\n",[202,330,332,333,335],{"id":331},"_4-valuesyaml-konfigurieren","4. ",[230,334,296],{}," konfigurieren",[190,337,338,339,341,342,345,346,350,351,355,356,359],{},"Bearbeiten Sie die ",[230,340,296],{},"-Datei entsprechend Ihren Bereitstellungsanforderungen. Details zum Abschnitt ",[230,343,344],{},".fivenet.config"," finden Sie auf der ",[194,347,349],{"href":348},"..\u002Fconfiguration\u002Fconfig-reference#must-set-config-options","Konfigurationsreferenzseite",", insbesondere im Abschnitt ",[352,353,354],"strong",{},"\"Must Set Config Options\""," und in der Referenzliste oben, um eine funktionierende ",[230,357,358],{},"config.yaml"," für FiveNet zu erstellen.",[190,361,362],{},"Prüfen Sie mindestens die FiveNet-Konfiguration, Secrets, Persistenz und wie die Bereitstellung in Ihrem Cluster erreichbar sein soll.",[202,364,366],{"id":365},"_5-fivenet-installieren-oder-aktualisieren","5. FiveNet installieren oder aktualisieren",[190,368,369,370,372],{},"Deployen oder aktualisieren Sie FiveNet in Ihrem Kubernetes-Cluster mit der konfigurierten ",[230,371,296],{},"-Datei:",[223,374,376],{"className":225,"code":375,"language":227,"meta":228,"style":228},"helm upgrade --install 