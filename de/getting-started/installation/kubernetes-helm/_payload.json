,397,401,407,447,451,454,487,501,505,513,518,526],[224,225,226,227,234],"p",{},"Für die Installation auf Kubernetes ist ein Helm-Chart in unserem Charts-Repository verfügbar. Der Quellcode des Charts ist auf ",[228,229,233],"a",{"href":230,"rel":231},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fcharts",[232],"nofollow","GitHub fivenet-app\u002Fcharts"," verfügbar.",[236,237,239],"h2",{"id":238},"_0-voraussetzungen","0. Voraussetzungen",[224,241,242,243,248],{},"Diese Anleitung setzt voraus, dass Sie über einen funktionierenden Kubernetes-Cluster und einen installierten Helm-Client verfügen. Falls Sie noch keinen Kubernetes-Cluster eingerichtet haben, lesen Sie bitte die ",[228,244,247],{"href":245,"rel":246},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fsetup\u002F",[232],"Kubernetes-Installationsanleitung",".\nSie können jeden Kubernetes-Cluster verwenden, einschließlich lokaler Cluster wie Minikube oder KinD, oder Cloud-Anbieter wie GKE, EKS oder AKS.",[236,250,252],{"id":251},"_1-helm-chart-repository-hinzufügen","1. Helm-Chart-Repository hinzufügen",[224,254,255],{},"Fügen Sie das FiveNet-Helm-Chart-Repository zu Ihrem Helm-Client hinzu:",[257,258,263],"pre",{"className":259,"code":260,"language":261,"meta":262,"style":262},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[264,265,266,288],"code",{"__ignoreMap":262},[267,268,271,275,279,282,285],"span",{"class":269,"line":270},"line",1,[267,272,274],{"class":273},"sBMFI","helm",[267,276,278],{"class":277},"sfazB"," repo",[267,280,281],{"class":277}," add",[267,283,284],{"class":277}," fivenet",[267,286,287],{"class":277}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[267,289,291,293,295],{"class":269,"line":290},2,[267,292,274],{"class":273},[267,294,278],{"class":277},[267,296,297],{"class":277}," update\n",[236,299,301],{"id":300},"_2-namespace-erstellen","2. Namespace erstellen",[224,303,304],{},"Erstellen Sie einen eigenen Namespace für FiveNet, falls Sie noch keinen haben:",[257,306,308],{"className":259,"code":307,"language":261,"meta":262,"style":262},"kubectl create namespace fivenet\n",[264,309,310],{"__ignoreMap":262},[267,311,312,315,318,321],{"class":269,"line":270},[267,313,314],{"class":273},"kubectl",[267,316,317],{"class":277}," create",[267,319,320],{"class":277}," namespace",[267,322,323],{"class":277}," fivenet\n",[236,325,327,328,331],{"id":326},"_3-aktuelle-valuesyaml-abrufen","3. Aktuelle ",[264,329,330],{},"values.yaml"," abrufen",[224,333,334,335,337],{},"Laden Sie die Standard-",[264,336,330],{},"-Datei für das Helm-Chart herunter, um Ihre Bereitstellung zu konfigurieren:",[257,339,341],{"className":259,"code":340,"language":261,"meta":262,"style":262},"helm show values fivenet\u002Ffivenet > values.yaml\n",[264,342,343],{"__ignoreMap":262},[267,344,345,347,350,353,356,360],{"class":269,"line":270},[267,346,274],{"class":273},[267,348,349],{"class":277}," show",[267,351,352],{"class":277}," values",[267,354,355],{"class":277}," fivenet\u002Ffivenet",[267,357,359],{"class":358},"sMK4o"," >",[267,361,362],{"class":277}," values.yaml\n",[236,364,366,367,369],{"id":365},"_4-valuesyaml-konfigurieren","4. ",[264,368,330],{}," konfigurieren",[224,371,372,373,375,376,379,380,384,385,389,390,393],{},"Bearbeiten Sie die ",[264,374,330],{},"-Datei entsprechend Ihren Bereitstellungsanforderungen. Details zum Abschnitt ",[264,377,378],{},".fivenet.config"," finden Sie auf der ",[228,381,383],{"href":382},"..\u002Fconfiguration\u002Fconfig-reference#must-set-config-options","Konfigurationsreferenzseite",", insbesondere im Abschnitt ",[386,387,388],"strong",{},"\"Must Set Config Options\""," und in der Referenzliste oben, um eine funktionierende ",[264,391,392],{},"config.yaml"," für FiveNet zu erstellen.",[224,395,396],{},"Prüfen Sie mindestens die FiveNet-Konfiguration, Secrets, Persistenz und wie die Bereitstellung in Ihrem Cluster erreichbar sein soll.",[236,398,400],{"id":399},"_5-fivenet-installieren-oder-aktualisieren","5. FiveNet installieren oder aktualisieren",[224,402,403,404,406],{},"Deployen oder aktualisieren Sie FiveNet in Ihrem Kubernetes-Cluster mit der konfigurierten ",[264,405,330],{},"-Datei:",[257,408,410],{"className":259,"code":409,"language":261,"meta":262,"style":262},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[264,411,412,430,439],{"__ignoreMap":262},[267,413,414,416,419,422,424,426],{"class":269,"line":270},[267,415,274],{"class":273},[267,417,418],{"class":277}," upgrade",[267,420,421],{"class":277}," --install",[267,423,284],{"class":277},[267,425,355],{"class":277},[267,427,429],{"class":428},"sTEyZ"," \\\n",[267,431,432,435,437],{"class":269,"line":290},[267,433,434],{"class":277},"  --namespace",[267,436,284],{"class":277},[267,438,429],{"class":428},[267,440,442,445],{"class":269,"line":441},3,[267,443,444],{"class":277},"  -f",[267,446,362],{"class":277},[236,448,450],{"id":449},"_6-bereitstellung-überprüfen","6. Bereitstellung überprüfen",[224,452,453],{},"Nachdem das Helm-Release installiert wurde, prüfen Sie, ob die Workloads korrekt starten:",[257,455,457],{"className":259,"code":456,"language":261,"meta":262,"style":262},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[264,458,459,474],{"__ignoreMap":262},[267,460,461,463,466,469,472],{"class":269,"line":270},[267,462,314],{"class":273},[267,464,465],{"class":277}," get",[267,467,468],{"class":277}," pods",[267,470,471],{"class":277}," -n",[267,473,323],{"class":277},[267,475,476,478,481,483,485],{"class":269,"line":290},[267,477,274],{"class":273},[267,479,480],{"class":277}," status",[267,482,284],{"class":277},[267,484,471],{"class":277},[267,486,323],{"class":277},[224,488,489,490,492,493,496,497,500],{},"Stellen Sie sicher, dass FiveNet extern erreichbar ist, wie in Ihrer ",[264,491,330],{}," konfigurier