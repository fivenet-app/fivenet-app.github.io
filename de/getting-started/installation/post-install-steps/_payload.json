324],{},"license",[306,326,327,328,262,331,262,334,262,337,340],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[259,329,330],{},"char*:",[259,332,333],{},"license:",[259,335,336],{},"steam:",[259,338,339],{},"discord:",").",[291,342,343,348],{},[306,344,345],{},[259,346,347],{},"reg_token",[306,349,350],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[291,352,353,358],{},[306,354,355],{},[259,356,357],{},"groups",[306,359,360,361,364],{},"Ein JSON-String-Array, z. B. ",[259,362,363],{},"[\"admin\"]"," (Liste von Gruppen).",[366,367,368],"blockquote",{},[240,369,370,374],{},[371,372,373],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[376,377],"br",{},[371,379,380],{},"Beispielabfrage:",[382,383,388],"pre",{"className":384,"code":385,"language":386,"meta":387,"style":387},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[259,389,390],{"__ignoreMap":387},[391,392,395,399,403,406,409,413,415,417,419,421,423,425,427,429,431,433,435,437,439,441,443,446,449,451,453,455,458,461,463,465,467,470,472,474,476,478,480],"span",{"class":393,"line":394},"line",1,[391,396,398],{"class":397},"sbssI","INSERT INTO",[391,400,402],{"class":401},"sMK4o"," `",[391,404,282],{"class":405},"sfazB",[391,407,408],{"class":401},"`",[391,410,412],{"class":411},"sTEyZ"," (",[391,414,408],{"class":401},[391,416,310],{"class":405},[391,418,408],{"class":401},[391,420,262],{"class":411},[391,422,408],{"class":401},[391,424,324],{"class":405},[391,426,408],{"class":401},[391,428,262],{"class":411},[391,430,408],{"class":401},[391,432,347],{"class":405},[391,434,408],{"class":401},[391,436,262],{"class":411},[391,438,408],{"class":401},[391,440,357],{"class":405},[391,442,408],{"class":401},[391,444,445],{"class":411},") ",[391,447,448],{"class":397},"VALUES",[391,450,412],{"class":411},[391,452,316],{"class":397},[391,454,262],{"class":411},[391,456,457],{"class":401},"'",[391,459,460],{"class":405},"YOUR_LICENSE_HERE",[391,462,457],{"class":401},[391,464,262],{"class":411},[391,466,457],{"class":401},[391,468,469],{"class":405},"123456",[391,471,457],{"class":401},[391,473,262],{"class":411},[391,475,457],{"class":401},[391,477,363],{"class":405},[391,479,457],{"class":401},[391,481,482],{"class":411},");\n",[255,484,485],{},"Öffnen Sie Ihre FiveNet-Instanz in Ihrem Browser, navigieren Sie zur Registrierungsseite und verwenden Sie den Registrierungstoken, um Ihr Konto zu erstellen.",[255,487,488,489,491,492,495,496,498,499,502],{},"Nach der Registrierung melden Sie sich bei FiveNet an. Wenn der Wert ",[259,490,324],{}," korrekt ist, sollten Sie alle Charaktere (",[259,493,494],{},"users","-Tabelle) sehen, die mit der ",[259,497,324],{},"\u002F",[259,500,501],{},"identifier"," verknüpft sind.",[244,504,506],{"id":505},"_2-das-fivenet-plugin-auf-ihrem-gameserver-installieren","2. Das FiveNet-Plugin auf Ihrem Gameserver installieren",[240,508,509],{},"Um FiveNet mit Ihrem Gameserver zu verbinden:",[511,512,513,522],"ul",{},[255,514,515,516,521],{},"Laden Sie den ",[264,517,520],{"href":518,"rel":519},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[268],"FiveM-Plugin-Code"," von GitHub herunter.",[255,523,524],{},"Installieren und konfigurieren Sie das Plugin auf Ihrem FiveM-Server.",[526,527,528,533],"callout",{},[240,529,530],{},[371,531,532],{},"Wichtig:",[511,534,535,542],{},[255,536,537,538,541],{},"Lesen Sie die Datei ",[259,539,540],{},"README.md"," des Plugins, das Sie installieren, und folgen Sie den Anweisungen, um eine optimale Einrichtung sicherzustellen.",[255,543,544],{},"Fügen Sie Event-Trigger zu Ihren ESX-Plugins hinzu, wie erforderlich. Nicht alle von FiveNet gesammelten Events sind im Standard-ESX-Plugin-Code verfügbar.",[240,546,547,548,552],{},"Weitere Details und eine Schritt-für-Schritt-Anleitung finden Sie in der ",[264,549,551],{"href":550},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","Plugin-Installationsdokumentation",".",[244,554,556],{"id":555},"_3-konfigurieren-sie-ihr-fivenet","3. Konfigurieren Sie Ihr FiveNet",[240,558,559,560,563,564,567,568,571],{},"Wenn Sie mit ausgewähltem Charakter angemeldet sind, müssen Sie den Superuser-Modus aktivieren können (gesteuert über die Konfigurationsoptionen ",[259,561,562],{},"auth.configAdminGroups"," und ",[259,565,566],{},"auth.configAdminUsers",") und zu Ihren \"FiveNet-Einstellungen\" navigieren (",[259,569,570],{},"\u002Fsettings\u002Fsettings"," URL-Pfad).",[240,573,574],{},"Gehen Sie dort jeden Tab durch und konfigurieren Sie ihn passend zu den Einstellungen, Jobs und dem Roleplay Ihres Servers.",[240,576,577],{},"Zu den wichtigsten Einstellungen, die Sie hier vornehmen sollten, gehören:",[252,579,580,588],{},[255,581,582,583],{},"Tab \"Berufe & Tracker\"\n",[511,584,585],{},[255,586,587],{},"Stellen Sie sicher, dass Sie den korrekten arbeitslosen Job und die passende Stufe auswählen.",[255,589,590,591],{},"Tab \"Website\"\n",[511,592,593],{},[255,594,595],{},"Stellen Sie sicher, dass Sie die URLs zu den Datenschutz- und Impressumsseiten Ihres Gameservers eintragen.",[597,598,599],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration