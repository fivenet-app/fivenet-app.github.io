:54,"__hash__":577},"content_de\u002Fde\u002F1.getting-started\u002F4.installation\u002F6.post-install-steps.md",{"type":203,"value":204,"toc":566},"minimark",[205,209,214,217,469,473,476,491,511,519,523,538,541,544,562],[206,207,208],"p",{},"Führen Sie die Ersteinrichtung durch und verbinden Sie Ihren Gameserver, nachdem der FiveNet-Server gestartet ist.",[210,211,213],"h2",{"id":212},"_1-erstes-konto-manuell-erstellen","1. Erstes Konto manuell erstellen",[206,215,216],{},"Falls noch kein Konto existiert, erstellen Sie das erste Konto direkt in der Datenbank:",[218,219,220,243,449,452],"ol",{},[221,222,223,224,228,229,236,237,242],"li",{},"Öffnen Sie Ihr MySQL-Verwaltungstool oder Datenbank-UI, zum Beispiel ",[225,226,227],"code",{},"mysql",", ",[230,231,235],"a",{"href":232,"rel":233},"https:\u002F\u002Fdbeaver.io\u002F",[234],"nofollow","DBeaver"," oder ",[230,238,241],{"href":239,"rel":240},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[234],"PHPMyAdmin",", und verbinden Sie sich mit der Datenbank, die von FiveNet oder Ihrem Gameserver verwendet wird.",[221,244,245,246,249,250,331,341,344,347],{},"Navigieren Sie zur Tabelle ",[225,247,248],{},"fivenet_accounts"," und erstellen Sie einen neuen Eintrag mit den folgenden Werten:",[251,252,253,266],"table",{},[254,255,256],"thead",{},[257,258,259,263],"tr",{},[260,261,262],"th",{},"Feld",[260,264,265],{},"Beschreibung des Werts",[267,268,269,284,307,317],"tbody",{},[257,270,271,277],{},[272,273,274],"td",{},[225,275,276],{},"enabled",[272,278,279,280,283],{},"Auf ",[225,281,282],{},"1"," setzen, um das Konto zu aktivieren.",[257,285,286,291],{},[272,287,288],{},[225,289,290],{},"license",[272,292,293,294,228,297,228,300,228,303,306],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[225,295,296],{},"char*:",[225,298,299],{},"license:",[225,301,302],{},"steam:",[225,304,305],{},"discord:",").",[257,308,309,314],{},[272,310,311],{},[225,312,313],{},"reg_token",[272,315,316],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[257,318,319,324],{},[272,320,321],{},[225,322,323],{},"groups",[272,325,326,327,330],{},"Ein JSON-String-Array, z. B. ",[225,328,329],{},"[\"admin\"]"," (Liste von Gruppen).",[332,333,334],"blockquote",{},[206,335,336,340],{},[337,338,339],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[342,343],"br",{},[337,345,346],{},"Beispielabfrage:",[348,349,354],"pre",{"className":350,"code":351,"language":352,"meta":353,"style":353},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[225,355,356],{"__ignoreMap":353},[357,358,361,365,369,372,375,379,381,383,385,387,389,391,393,395,397,399,401,403,405,407,409,412,415,417,419,421,424,427,429,431,433,436,438,440,442,444,446],"span",{"class":359,"line":360},"line",1,[357,362,364],{"class":363},"sbssI","INSERT INTO",[357,366,368],{"class":367},"sMK4o"," `",[357,370,248],{"class":371},"sfazB",[357,373,374],{"class":367},"`",[357,376,378],{"class":377},"sTEyZ"," (",[357,380,374],{"class":367},[357,382,276],{"class":371},[357,384,374],{"class":367},[357,386,228],{"class":377},[357,388,374],{"class":367},[357,390,290],{"class":371},[357,392,374],{"class":367},[357,394,228],{"class":377},[357,396,374],{"class":367},[357,398,313],{"class":371},[357,400,374],{"class":367},[357,402,228],{"class":377},[357,404,374],{"class":367},[357,406,323],{"class":371},[357,408,374],{"class":367},[357,410,411],{"class":377},") ",[357,413,414],{"class":363},"VALUES",[357,416,378],{"class":377},[357,418,282],{"class":363},[357,420,228],{"class":377},[357,422,423],{"class":367},"'",[357,425,426],{"class":371},"YOUR_LICENSE_HERE",[357,428,423],{"class":367},[357,430,228],{"class":377},[357,432,423],{"class":367},[357,434,435],{"class":371},"123456",[357,437,423],{"class":367},[357,439,228],{"class":377},[357,441,423],{"class":367},[357,443,329],{"class":371},[357,445,423],{"class":367},[357,447,448],{"class":377},");\n",[221,450,451],{},"Öffnen Sie Ihre FiveNet-Instanz in Ihrem Browser, navigieren Sie zur Registrierungsseite und verwenden Sie den Registrierungstoken, um Ihr Konto zu erstellen.",[221,453,454,455,457,458,461,462,464,465,468],{},"Nach der Registrierung melden Sie sich bei FiveNet an. Wenn der Wert ",[225,456,290],{}," korrekt ist, sollten Sie alle Charaktere (",[225,459,460],{},"users","-Tabelle) sehen, die mit der ",[225,463,290],{},"\u002F",[225,466,467],{},"identifier"," verknüpft sind.",[210,470,472],{"id":471},"_2-das-fivenet-plugin-auf-ihrem-gameserver-installieren","2. Das FiveNet-Plugin auf Ihrem Gameserver installieren",[206,474,475],{},"Um FiveNet mit Ihrem Gameserver zu verbinden:",[477,478,479,488],"ul",{},[221,480,481,482,487],{},"Laden Sie den ",[230,483,486],{"href":484,"rel":485},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[234],"FiveM-Plugin-Code"," von GitHub herunter.",[221,489,490],{},"Installieren und konfigurieren Sie das Plugin auf Ihrem FiveM-Server.",[492,493,494,499],"callout",{},[206,495,496],{},[337,497,498],{},"Wichtig:",[477,500,501,508],{},[221,502,503,504,507],{},"Lesen Sie die Datei ",[225,505,506],{},"README.md"," des Plugins, das Sie installieren, und folgen Sie den Anweisungen, um eine optimale Einrichtung sicherzustellen.",[221,509,510],{},"Fügen Sie Event-Trigger zu Ihren ESX-Plugins hinzu, wie erforderlich. Nicht alle von FiveNet gesammelten Events sind im Standard-ESX-Plugin-Code verfügbar.",[206,512,513,514,518],{},"Weitere Details und eine Schritt-für-Schritt-Anleitung finden Sie in der ",[230,515,517],{"href":516},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","Plugin-Installationsdokumentation",".",[210,520,522],{"id":521},"_3-konfigurieren-sie-ihr-fivenet","3. Konfigurieren Sie Ihr FiveNet",[206,524,525,526,529,530,533,534,537],{},"Wenn Sie mit ausgewähltem Charakter angemeldet sind, müssen Sie den Superuser-Modus aktivieren können (gesteuert über die Konfigurationsoptionen ",[225,527,528],{},"auth.configAdminGroups"," und ",[225,531,532],{},"auth.configAdminUsers",") und zu Ihren \"FiveNet-Einstellungen\" navigieren (",[225,535,536],{},"\u002Fsettings\u002Fsettings"," URL-Pfad).",[206,539,540],{},"Gehen Sie dort jeden Tab durch und konfigurieren Sie ihn passend zu den Einstellungen, Jobs und dem Roleplay Ihres Servers.",[206,542,543],{},"Zu den wichtigsten Einstellungen, die Sie hier vornehmen sollten, gehören:",[218,545,546,554],{},[221,547,548,549],{},"Tab \"Berufe & Tracker\"\n",[477,550,551],{},[221,552,553],{},"Stellen Sie sicher, dass Sie den korrekten arbeitslosen Job und die passende Stufe auswählen.",[221,555,556,557],{},"Tab \"Website\"\n",[477,558,559],{},[221,560,561],{},"Stellen Sie sicher, dass Sie die URLs zu den Datenschutz- und Impressumsseiten Ihres Gameservers eintragen.",[563,564,565],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);f