:285},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[279],"PHPMyAdmin",", und verbinden Sie sich mit der Datenbank, die von FiveNet oder Ihrem Gameserver verwendet wird.",[266,289,290,291,294,295,376,386,389,392],{},"Navigieren Sie zur Tabelle ",[270,292,293],{},"fivenet_accounts"," und erstellen Sie einen neuen Eintrag mit den folgenden Werten:",[296,297,298,311],"table",{},[299,300,301],"thead",{},[302,303,304,308],"tr",{},[305,306,307],"th",{},"Feld",[305,309,310],{},"Beschreibung des Werts",[312,313,314,329,352,362],"tbody",{},[302,315,316,322],{},[317,318,319],"td",{},[270,320,321],{},"enabled",[317,323,324,325,328],{},"Auf ",[270,326,327],{},"1"," setzen, um das Konto zu aktivieren.",[302,330,331,336],{},[317,332,333],{},[270,334,335],{},"license",[317,337,338,339,273,342,273,345,273,348,351],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[270,340,341],{},"char*:",[270,343,344],{},"license:",[270,346,347],{},"steam:",[270,349,350],{},"discord:",").",[302,353,354,359],{},[317,355,356],{},[270,357,358],{},"reg_token",[317,360,361],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[302,363,364,369],{},[317,365,366],{},[270,367,368],{},"groups",[317,370,371,372,375],{},"Ein JSON-String-Array, z. B. ",[270,373,374],{},"[\"admin\"]"," (Liste von Gruppen).",[377,378,379],"blockquote",{},[251,380,381,385],{},[382,383,384],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[387,388],"br",{},[382,390,391],{},"Beispielabfrage:",[393,394,399],"pre",{"className":395,"code":396,"language":397,"meta":398,"style":398},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[270,400,401],{"__ignoreMap":398},[402,403,406,410,414,417,420,424,426,428,430,432,434,436,438,440,442,444,446,448,450,452,454,457,460,462,464,466,469,472,474,476,478,481,483,485,487,489,491],"span",{"class":404,"line":405},"line",1,[402,407,409],{"class":408},"sbssI","INSERT INTO",[402,411,413],{"class":412},"sMK4o"," `",[402,415,293],{"class":416},"sfazB",[402,418,419],{"class":412},"`",[402,421,423],{"class":422},"sTEyZ"," (",[402,425,419],{"class":412},[402,427,321],{"class":416},[402,429,419],{"class":412},[402,431,273],{"class":422},[402,433,419],{"class":412},[402,435,335],{"class":416},[402,437,419],{"class":412},[402,439,273],{"class":422},[402,441,419],{"class":412},[402,443,358],{"class":416},[402,445,419],{"class":412},[402,447,273],{"class":422},[402,449,419],{"class":412},[402,451,368],{"class":416},[402,453,419],{"class":412},[402,455,456],{"class":422},") ",[402,458,459],{"class":408},"VALUES",[402,461,423],{"class":422},[402,463,327],{"class":408},[402,465,273],{"class":422},[402,467,468],{"class":412},"'",[402,470,471],{"class":416},"YOUR_LICENSE_HERE",[402,473,468],{"class":412},[402,475,273],{"class":422},[402,477,468],{"class":412},[402,479,480],{"class":416},"123456",[402,482,468],{"class":412},[402,484,273],{"class":422},[402,486,468],{"class":412},[402,488,374],{"class":416},[402,490,468],{"class":412},[402,492,493],{"class":422},");\n",[266,495,496],{},"Öffnen Sie Ihre FiveNet-Instanz in Ihrem Browser, navigieren Sie zur Registrierungsseite und verwenden Sie den Registrierungstoken, um Ihr Konto zu erstellen.",[266,498,499,500,502,503,506,507,509,510,513],{},"Nach der Registrierung melden Sie sich bei FiveNet an. Wenn der Wert ",[270,501,335],{}," korrekt ist, sollten Sie alle Charaktere (",[270,504,505],{},"users","-Tabelle) sehen, die mit der ",[270,508,335],{},"\u002F",[270,511,512],{},"identifier"," verknüpft sind.",[255,515,517],{"id":516},"_2-das-fivenet-plugin-auf-ihrem-gameserver-installieren","2. Das FiveNet-Plugin auf Ihrem Gameserver installieren",[251,519,520],{},"Um FiveNet mit Ihrem Gameserver zu verbinden:",[522,523,524,533],"ul",{},[266,525,526,527,532],{},"Laden Sie den ",[275,528,531],{"href":529,"rel":530},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[279],"FiveM-Plugin-Code"," von GitHub herunter.",[266,534,535],{},"Installieren und konfigurieren Sie das Plugin auf Ihrem FiveM-Server.",[537,538,539,544],"callout",{},[251,540,541],{},[382,542,543],{},"Wichtig:",[522,545,546,553],{},[266,547,548,549,552],{},"Lesen Sie die Datei ",[270,550,551],{},"README.md"," des Plugins, das Sie installieren, und folgen Sie den Anweisungen, um eine optimale Einrichtung sicherzustellen.",[266,554,555],{},"Fügen Sie Event-Trigger zu Ihren ESX-Plugins hinzu, wie erforderlich. Nicht alle von FiveNet gesammelten Events sind im Standard-ESX-Plugin-Code verfügbar.",[251,557,558,559,563],{},"Weitere Details und eine Schritt-für-Schritt-Anleitung finden Sie in der ",[275,560,562],{"href":561},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","Plugin-Installationsdokumentation",".",[255,565,567],{"id":566},"_3-konfigurieren-sie-ihr-fivenet","3. Konfigurieren Sie Ihr FiveNet",[251,569,570,571,574,575,578,579,582],{},"Wenn Sie mit ausgewähltem Charakter angemeldet sind, müssen Sie den Superuser-Modus aktivieren können (gesteuert über die Konfigurationsoptionen ",[270,572,573],{},"auth.configAdminGroups"," und ",[270,576,577],{},"auth.configAdminUsers",") und zu Ihren \"FiveNet-Einstellungen\" navigieren (",[270,580,581],{},"\u002Fsettings\u002Fsettings"," URL-Pfad).",[251,584,585],{},"Gehen Sie dort jeden Tab durch und konfigurieren Sie ihn passend zu den Einstellungen, Jobs und dem Roleplay Ihres Servers.",[251,587,588],{},"Zu den wichtigsten Einstellungen, die Sie hier vornehmen sollten, gehören:",[263,590,591,599],{},[266,592,593,594],{},"Tab \"Berufe & Tracker\"\n",[522,595,596],{},[266,597,598],{},"Stellen Sie sicher, dass Sie den korrekten arbeitslosen Job und die passende Stufe auswählen.",[266,600,601,602],{},"Tab \"Website\"\n",[522,603,604],{},[266,605,606],{},"Stellen Sie sicher, dass Sie die URLs zu den Datenschutz- und Impressumsseiten Ihres Gameservers eintragen.",[608,609,610],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":398,"searchDepth":612,"depth":612,"links":613},2,[614,615,616],{"id":257,"depth":612,