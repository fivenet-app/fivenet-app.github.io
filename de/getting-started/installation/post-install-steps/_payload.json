3,220,221,226],"li",{},"Öffnen Sie Ihr MySQL-Verwaltungstool oder Datenbank-UI, zum Beispiel ",[209,210,211],"code",{},"mysql",", ",[214,215,219],"a",{"href":216,"rel":217},"https:\u002F\u002Fdbeaver.io\u002F",[218],"nofollow","DBeaver"," oder ",[214,222,225],{"href":223,"rel":224},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[218],"PHPMyAdmin",", und verbinden Sie sich mit der Datenbank, die von FiveNet oder Ihrem Gameserver verwendet wird.",[205,228,229,230,233,234,315,325,328,331],{},"Navigieren Sie zur Tabelle ",[209,231,232],{},"fivenet_accounts"," und erstellen Sie einen neuen Eintrag mit den folgenden Werten:",[235,236,237,250],"table",{},[238,239,240],"thead",{},[241,242,243,247],"tr",{},[244,245,246],"th",{},"Feld",[244,248,249],{},"Beschreibung des Werts",[251,252,253,268,291,301],"tbody",{},[241,254,255,261],{},[256,257,258],"td",{},[209,259,260],{},"enabled",[256,262,263,264,267],{},"Auf ",[209,265,266],{},"1"," setzen, um das Konto zu aktivieren.",[241,269,270,275],{},[256,271,272],{},[209,273,274],{},"license",[256,276,277,278,212,281,212,284,212,287,290],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[209,279,280],{},"char*:",[209,282,283],{},"license:",[209,285,286],{},"steam:",[209,288,289],{},"discord:",").",[241,292,293,298],{},[256,294,295],{},[209,296,297],{},"reg_token",[256,299,300],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[241,302,303,308],{},[256,304,305],{},[209,306,307],{},"groups",[256,309,310,311,314],{},"Ein JSON-String-Array, z. B. ",[209,312,313],{},"[\"admin\"]"," (Liste von Gruppen).",[316,317,318],"blockquote",{},[190,319,320,324],{},[321,322,323],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[326,327],"br",{},[321,329,330],{},"Beispielabfrage:",[332,333,338],"pre",{"className":334,"code":335,"language":336,"meta":337,"style":337},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[209,339,340],{"__ignoreMap":337},[341,342,345,349,353,356,359,363,365,367,369,371,373,375,377,379,381,383,385,387,389,391,393,396,399,401,403,405,408,411,413,415,417,420,422,424,426,428,430],"span",{"class":343,"line":344},"line",1,[341,346,348],{"class":347},"sbssI","INSERT INTO",[341,350,352],{"class":351},"sMK4o"," `",[341,354,232],{"class":355},"sfazB",[341,357,358],{"class":351},"`",[341,360,362],{"class":361},"sTEyZ"," (",[341,364,358],{"class":351},[341,366,260],{"class":355},[341,368,358],{"class":351},[341,370,212],{"class":361},[341,372,358],{"class":351},[341,374,274],{"class":355},[341,376,358],{"class":351},[341,378,212],{"class":361},[341,380,358],{"class":351},[341,382,297],{"class":355},[341,384,358],{"class":351},[341,386,212],{"class":361},[341,388,358],{"class":351},[341,390,307],{"class":355},[341,392,358],{"class":351},[341,394,395],{"class":361},") ",[341,397,398],{"class":347},"VALUES",[341,400,362],{"class":361},[341,402,266],{"class":347},[341,404,212],{"class":361},[341,406,407],{"class":351},"'",[341,409,410],{"class":355},"YOUR_LICENSE_HERE",[341,412,407],{"class":351},[341,414,212],{"class":361},[341,416,407],{"class":351},[341,418,419],{"class":355},"123456",[341,421,407],{"class":351},[341,423,212],{"class":361},[341,425,407],{"class":351},[341,427,313],{"class":355},[341,429,407],{"class":351},[341,431,432],{"class":361},");\n",[205,434,435],{},"Öffnen Sie Ihre FiveNet-Instanz in Ihrem Browser, navigieren Sie zur Registrierungsseite und verwenden Sie den Registrierungstoken, um Ihr Konto zu erstellen.",[205,437,438,439,441,442,445,446,448,449,452],{},"Nach der Registrierung melden Sie sich bei FiveNet an. Wenn der Wert ",[209,440,274],{}," korrekt ist, sollten Sie alle Charaktere (",[209,443,444],{},"users","-Tabelle) sehen, die mit der ",[209,447,274],{},"\u002F",[209,450,451],{},"identifier"," verknüpft sind.",[194,454,456],{"id":455},"_2-das-fivenet-plugin-auf-ihrem-gameserver-installieren","2. Das FiveNet-Plugin auf Ihrem Gameserver installieren",[190,458,459],{},"Um FiveNet mit Ihrem Gameserver zu verbinden:",[461,462,463,472],"ul",{},[205,464,465,466,471],{},"Laden Sie den ",[214,467,470],{"href":468,"rel":469},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[218],"FiveM-Plugin-Code"," von GitHub herunter.",[205,473,474],{},"Installieren und konfigurieren Sie das Plugin auf Ihrem FiveM-Server.",[476,477,478,483],"callout",{},[190,479,480],{},[321,481,482],{},"Wichtig:",[461,484,485,492],{},[205,486,487,488,491],{},"Lesen Sie die Datei ",[209,489,490],{},"README.md"," des Plugins, das Sie installieren, und folgen Sie den Anweisungen, um eine optimale Einrichtung sicherzustellen.",[205,493,494],{},"Fügen Sie Event-Trigger zu Ihren ESX-Plugins hinzu, wie erforderlich. Nicht alle von FiveNet gesammelten Events sind im Standard-ESX-Plugin-Code verfügbar.",[190,496,497,498,502],{},"Weitere Details und eine Schritt-für-Schritt-Anleitung finden Sie in der ",[214,499,501],{"href":500},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","Plugin-Installationsdokumentation",".",[194,504,506],{"id":505},"_3-konfigurieren-sie-ihr-fivenet","3. Konfigurieren Sie Ihr FiveNet",[190,508,509,510,513,514,517,518,521],{},"Wenn Sie mit ausgewähltem Charakter angemeldet sind, müssen Sie den Superuser-Modus aktivieren können (gesteuert über die Konfigurationsoptionen ",[209,511,512],{},"auth.configAdminGroups"," und ",[209,515,516],{},"auth.configAdminUsers",") und zu Ihren \"FiveNet-Einstellungen\" navigieren (",[209,519,520],{},"\u002Fsettings\u002Fsettings"," URL-Pfad).",[190,523,524],{},"Gehen Sie dort jeden Tab durch und konfigurieren Sie ihn passend zu den Einstellungen, Jobs und dem Roleplay Ihres Servers.",[190,526,527],{},"Zu den wichtigsten Einstellungen, die Sie hier vornehmen sollten, gehören:",[202,529,530,538],{},[205,531,532,533],{},"Tab \