,562,580],[224,225,226],"p",{},"Führen Sie nach der Installation von FiveNet die erste Kontoeinrichtung durch und verbinden Sie Ihren Gameserver.",[228,229,231],"h2",{"id":230},"_1-erstes-konto-manuell-erstellen","1. Erstes Konto manuell erstellen",[224,233,234],{},"Falls noch kein Konto existiert, erstellen Sie das erste Konto direkt in der Datenbank:",[236,237,238,261,467,470],"ol",{},[239,240,241,242,246,247,254,255,260],"li",{},"Öffnen Sie Ihr MySQL-Verwaltungstool oder Datenbank-UI, zum Beispiel ",[243,244,245],"code",{},"mysql",", ",[248,249,253],"a",{"href":250,"rel":251},"https:\u002F\u002Fdbeaver.io\u002F",[252],"nofollow","DBeaver"," oder ",[248,256,259],{"href":257,"rel":258},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[252],"PHPMyAdmin",", und verbinden Sie sich mit der Datenbank, die von FiveNet oder Ihrem Gameserver verwendet wird.",[239,262,263,264,267,268,349,359,362,365],{},"Navigieren Sie zur Tabelle ",[243,265,266],{},"fivenet_accounts"," und erstellen Sie einen neuen Eintrag mit den folgenden Werten:",[269,270,271,284],"table",{},[272,273,274],"thead",{},[275,276,277,281],"tr",{},[278,279,280],"th",{},"Feld",[278,282,283],{},"Beschreibung des Werts",[285,286,287,302,325,335],"tbody",{},[275,288,289,295],{},[290,291,292],"td",{},[243,293,294],{},"enabled",[290,296,297,298,301],{},"Auf ",[243,299,300],{},"1"," setzen, um das Konto zu aktivieren.",[275,303,304,309],{},[290,305,306],{},[243,307,308],{},"license",[290,310,311,312,246,315,246,318,246,321,324],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[243,313,314],{},"char*:",[243,316,317],{},"license:",[243,319,320],{},"steam:",[243,322,323],{},"discord:",").",[275,326,327,332],{},[290,328,329],{},[243,330,331],{},"reg_token",[290,333,334],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[275,336,337,342],{},[290,338,339],{},[243,340,341],{},"groups",[290,343,344,345,348],{},"Ein JSON-String-Array, z. B. ",[243,346,347],{},"[\"admin\"]"," (Liste von Gruppen).",[350,351,352],"blockquote",{},[224,353,354,358],{},[355,356,357],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[360,361],"br",{},[355,363,364],{},"Beispielabfrage:",[366,367,372],"pre",{"className":368,"code":369,"language":370,"meta":371,"style":371},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[243,373,374],{"__ignoreMap":371},[375,376,379,383,387,390,393,397,399,401,403,405,407,409,411,413,415,417,419,421,423,425,427,430,433,435,437,439,442,445,447,449,451,454,456,458,460,462,464],"span",{"class":377,"line":378},"line",1,[375,380,382],{"class":381},"sbssI","INSERT INTO",[375,384,386],{"class":385},"sMK4o"," `",[375,388,266],{"class":389},"sfazB",[375,391,392],{"class":385},"`",[375,394,396],{"class":395},"sTEyZ"," (",[375,398,392],{"class":385},[375,400,294],{"class":389},[375,402,392],{"class":385},[375,404,246],{"class":395},[375,406,392],{"class":385},[375,408,308],{"class":389},[375,410,392],{"class":385},[375,412,246],{"class":395},[375,414,392],{"class":385},[375,416,331],{"class":389},[375,418,392],{"class":385},[375,420,246],{"class":395},[375,422,392],{"class":385},[375,424,341],{"class":389},[375,426,392],{"class":385},[375,428,429],{"class":395},") ",[375,431,432],{"class":381},"VALUES",[375,434,396],{"class":395},[375,436,300],{"class":381},[375,438,246],{"class":395},[375,440,441],{"class":385},"'",[375,443,444],{"class":389},"YOUR_LICENSE_HERE",[375,446,441],{"class":385},[375,448,246],{"class":395},[375,450,441],{"class":385},[375,452,453],{"class":389},"123456",[375,455,441],{"class":385},[375,457,246],{"class":395},[375,459,441],{"class":385},[375,461,347],{"class":389},[375,463,441],{"class":385},[375,465,466],{"class":395},");\n",[239,468,469],{},"Öffnen Sie Ihre FiveNet-Instanz in Ihrem Browser, navigieren Sie zur Registrierungsseite und verwenden Sie den Registrierungstoken, um Ihr Konto zu erstellen.",[239,471,472,473,475,476,479,480,482,483,486],{},"Nach der Registrierung melden Sie sich bei FiveNet an. Wenn der Wert ",[243,474,308],{}," korrekt ist, sollten Sie alle Charaktere (",[243,477,478],{},"users","-Tabelle) sehen, die mit der ",[243,481,308],{},"\u002F",[243,484,485],{},"identifier"," verknüpft sind.",[228,488,490],{"id":489},"_2-das-fivenet-plugin-auf-ihrem-gameserver-installieren","2. Das FiveNet-Plugin auf Ihrem Gameserver installieren",[224,492,493],{},"Um FiveNet mit Ihrem Gameserver zu verbinden:",[495,496,497,506],"ul",{},[239,498,499,500,505],{},"Laden Sie den ",[248,501,504],{"href":502,"rel":503},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[252],"FiveM-Plugin-Code"," von GitHub herunter.",[239,507,508],{},"Installieren und konfigurieren Sie das Plugin auf Ihrem FiveM-Server.",[510,511,512,517],"callout",{},[224,513,514],{},[355,515,516],{},"Wichtig:",[495,518,519,526],{},[239,520,521,522,525],{},"Lesen Sie die Datei ",[243,523,524],{},"README.md"," des Plugins, das Sie installieren, und folgen Sie den Anweisungen, um eine optimale Einrichtung sicherzustellen.",[239,527,528],{},"Fügen Sie Event-Trigger zu Ihren ESX-Plugins hinzu, wie erforderlich. Nicht alle von FiveNet gesammelten Events sind im Standard-ESX-Plugin-Code verfügbar.",[224,530,531,532,536],{},"Weitere Details und eine Schritt-für-Schritt-Anleitung finden Sie in der ",[248,533,535],{"href":534},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","Plugin-Installationsdokumentation",".",[228,538,540],{"id":539},"_3-konfigurieren-sie-ihr-fivenet","3. Konfigurieren Sie Ihr FiveNet",[224,542,543,544,547,548,551,552,555],{},"Wenn Sie mit ausgewähltem Charakter angemeldet sind, müssen Sie den Superuser-Modus aktivieren können (gesteuert über die Konfigurationsoptionen ",[243,545,546],{},"auth.configAdminGroups"," und ",[243,549,550],{},"auth.configAdminUsers",") und zu Ihren \"FiveNet-Einstellungen\" navigieren (",[243,553,554],{},"\u002Fsettings\u002Fsettings"," URL-Pfad).",[224,557,558],{},"Gehen Sie dort jeden Tab durch und konfigurieren Sie ihn passend zu den Einstellungen, Jobs und dem Roleplay Ihres Servers.",[224,560,561],{},"Zu den wichtigsten Einstellungen, die Sie hier vornehmen sollten, gehören:",[236,563,564,572],{},[239,565,566,567],{},"Tab \"Berufe & Tracker\"\n",[495,568,569],{},[239,570,571],{},"Stellen Sie sicher, dass Sie den korrekten arbeitslosen Job und die passende Stufe auswählen.",[239,573,574,575],{},"Tab \"Website\"\n",[495,576,577],{},[239,578,579],{},"Stellen Sie sicher, dass Sie die URLs zu den Datenschutz- und Impressumsseiten Ihres Gameservers eintragen.",[581,582,583],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shik