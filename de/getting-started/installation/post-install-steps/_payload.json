2,"rel":213},"https:\u002F\u002Fdbeaver.io\u002F",[214],"nofollow","DBeaver"," oder ",[210,218,221],{"href":219,"rel":220},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[214],"PHPMyAdmin",", und verbinden Sie sich mit der Datenbank, die von FiveNet oder Ihrem Gameserver verwendet wird.",[201,224,225,226,229,230,311,321,324,327],{},"Navigieren Sie zur Tabelle ",[205,227,228],{},"fivenet_accounts"," und erstellen Sie einen neuen Eintrag mit den folgenden Werten:",[231,232,233,246],"table",{},[234,235,236],"thead",{},[237,238,239,243],"tr",{},[240,241,242],"th",{},"Feld",[240,244,245],{},"Beschreibung des Werts",[247,248,249,264,287,297],"tbody",{},[237,250,251,257],{},[252,253,254],"td",{},[205,255,256],{},"enabled",[252,258,259,260,263],{},"Auf ",[205,261,262],{},"1"," setzen, um das Konto zu aktivieren.",[237,265,266,271],{},[252,267,268],{},[205,269,270],{},"license",[252,272,273,274,208,277,208,280,208,283,286],{},"Ihre In-Game-Kennung\u002FLizenz ohne Präfix (z.B. ",[205,275,276],{},"char*:",[205,278,279],{},"license:",[205,281,282],{},"steam:",[205,284,285],{},"discord:",").",[237,288,289,294],{},[252,290,291],{},[205,292,293],{},"reg_token",[252,295,296],{},"Ein 6-stelliger Registrierungstoken für die Kontoerstellung.",[237,298,299,304],{},[252,300,301],{},[205,302,303],{},"groups",[252,305,306,307,310],{},"Ein JSON-String-Array, z. B. ",[205,308,309],{},"[\"admin\"]"," (Liste von Gruppen).",[312,313,314],"blockquote",{},[186,315,316,320],{},[317,318,319],"strong",{},"Hinweis:"," Lassen Sie alle anderen Felder unverändert.",[322,323],"br",{},[317,325,326],{},"Beispielabfrage:",[328,329,334],"pre",{"className":330,"code":331,"language":332,"meta":333,"style":333},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[205,335,336],{"__ignoreMap":333},[337,338,341,345,349,352,3