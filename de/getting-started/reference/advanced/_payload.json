nt_de\u002Fde\u002F1.getting-started\u002F7.reference\u002Fadvanced.md",{"type":203,"value":204,"toc":556},"minimark",[205,209,214,217,246,255,260,302,306,316,319,330,339,342,349,352,363,372,375,382,385,392,396,399,402,406,552],[206,207,208],"p",{},"Nutzen Sie diese Seite, wenn Ihre FiveNet-Einrichtung über die Basisinstallation und die erforderlichen Konfigurationsoptionen hinausgeht.",[210,211,213],"h2",{"id":212},"häufige-erweiterte-themen","Häufige erweiterte Themen",[206,215,216],{},"Die häufigsten erweiterten Konfigurationsbereiche sind:",[218,219,220,228,234,240],"ul",{},[221,222,223,227],"li",{},[224,225,226],"strong",{},"Trusted Proxies",", wenn FiveNet hinter NGINX, Traefik, Cloudflare oder einem anderen Reverse-Proxy läuft.",[221,229,230,233],{},[224,231,232],{},"Object Storage",", wenn Uploads in S3-kompatiblem Storage statt im lokalen Dateisystem gespeichert werden sollen.",[221,235,236,239],{},[224,237,238],{},"OAuth2-Provider",", wenn Benutzer sich über externe Identitätsanbieter authentifizieren sollen.",[221,241,242,245],{},[224,243,244],{},"Tracing und Observability"," für Debugging, Performance-Analysen und verteiltes Request-Tracing.",[206,247,248,249,254],{},"Für die wichtigsten Optionsnamen und Konfigurationspfade siehe die ",[250,251,253],"a",{"href":252},".\u002Fconfig-reference","Konfigurationsreferenz",".",[256,257,259],"h3",{"id":258},"hinweise-zu-tracing","Hinweise zu Tracing",[218,261,262,270,277,295],{},[221,263,264,265,269],{},"Setzen Sie ",[266,267,268],"code",{},"enabled: true"," erst, wenn ein funktionierender OTLP-Endpunkt vorhanden ist.",[221,271,272,273,276],{},"Verwenden Sie in Produktion einen niedrigen ",[266,274,275],{},"ratio","-Wert, sofern Sie nicht bewusst mehr Traffic sampeln möchten.",[221,278,279,280,283,284,287,288,291,292,254],{},"Halten Sie den Wert von ",[266,281,282],{},"environment"," passend zur Umgebung, in der FiveNet läuft, zum Beispiel ",[266,285,286],{},"development",", ",[266,289,290],{},"staging"," oder ",[266,293,294],{},"production",[221,296,297,298,301],{},"Nutzen Sie ",[266,299,300],{},"attributes",", um zusätzliche Metadaten anzuhängen, die das Identifizieren von Traces in Ihrer Observability-Plattform erleichtern.",[210,303,305],{"id":304},"reverse-proxy-und-trusted-proxies","Reverse-Proxy und Trusted Proxies",[206,307,308,309,312,313,254],{},"Wenn FiveNet hinter einem oder mehreren Reverse-Proxys bereitgestellt wird, prüfen Sie die Option ",[266,310,311],{},"http.trustedProxies"," in Ihrer ",[266,314,315],{},"config.yaml",[206,317,318],{},"Das ist besonders wichtig, wenn:",[218,320,321,324,327],{},[221,322,323],{},"Client-IP-Adressen korrekt erhalten bleiben sollen",[221,325,326],{},"FiveNet hinter NGINX, Traefik oder Cloudflare läuft",[221,328,329],{},"Sie auf weitergereichte Header aus vertrauenswürdiger Infrastruktur angewiesen sind",[206,331,332,333,336,337,254],{},"Siehe die ",[250,334,253],{"href":335},".\u002Fconfig-reference#http"," für die Einstellung ",[266,338,311],{},[210,340,232],{"id":341},"object-storage",[206,343,344,345,348],{},"Standardmäßig speichert FiveNet Uploads im lokalen Dateisystem. Für skalierbareres oder extern verwaltetes Storage können Sie über die ",[266,346,347],{},"storage","-Konfiguration auf S3-kompatibles Object Storage umstellen.",[206,350,351],{},"Das ist besonders nützlich, wenn Sie:",[218,353,354,357,360],{},[221,355,356],{},"mehrere Instanzen betreiben",[221,358,359],{},"Cloud-Infrastruktur verwenden",[221,361,362],{},"hochgeladene Dateien außerhalb des Anwendungshosts speichern möchten",[206,364,332,365,336,368,371],{},[250,366,253],{"href":367},".\u002Fconfig-reference#storage",[266,369,370],{},"storage.type"," und zugehörige Storage-Optionen.",[210,373,238],{"id":374},"oauth2-provider",[206,376,377,378,381],{},"FiveNet kann über die Konfiguration ",[266,379,380],{},"oauth2.providers"," mit externen Authentifizierungsanbietern integriert werden.",[206,383,384],{},"Nutzen Sie dies, wenn Benutzer sich über Systeme wie Discord oder einen anderen OAuth2- oder OpenID-Connect-Anbieter anmelden sollen, anstatt nur lokale Authentifizierungsabläufe zu verwenden.",[206,386,332,387,336,390,254],{},[250,388,253],{"href":389},".\u002Fconfig-reference#oauth2",[266,391,380],{},[210,393,395],{"id":394},"tracing","Tracing",[206,397,398],{},"FiveNet unterstützt OpenTelemetry-basiertes Tracing für die Server- und Worker-Komponenten. Damit können Sie Request-Flows, Hintergrundverarbeitung und Performance-Engpässe in komplexeren Umgebungen analysieren.",[206,400,401],{},"Tracing wird in der Regel nur benötigt, wenn Sie bereits einen Observability-Stack betreiben oder komplexere Probleme untersuchen.",[256,403,405],{"id":404},"beispielkonfiguration-für-tracing","Beispielkonfiguration für Tracing",[407,408,413],"pre",{"className":409,"code":410,"language":411,"meta":412,"style":412},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","otlp:\n  enabled: false\n  # otlptracegrpc oder otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP-Tracing-Endpunkt-URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"dev\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[266,414,415,428,441,448,466,472,487,497,508,523,535,543],{"__ignoreMap":412},[416,417,420,424],"span",{"class":418,"line":419},"line",1,[416,421,423],{"class":422},"swJcz","otlp",[416,425,427],{"class":426},"sMK4o",":\n",[416,429,431,434,437],{"class":418,"line":430},2,[416,432,433],{"class":422},"  enabled",[416,435,436],{"class":426},":",[416,438,440],{"class":439},"sfNiH"," false\n",[416,442,444],{"class":418,"line":443},3,[416,445,447],{"class":446},"sHwdD","  # otlptracegrpc oder otlptracehttp\n",[416,449,451,454,456,459,463],{"class":418,"line":450},4,[416,452,453],{"class":422},"  type",[416,455,436],{"class":426},[416,457,458],{"class":426}," \"",[416,460,462],{"class":461},"sfazB","otlptracegrpc",[416,464,465],{"class