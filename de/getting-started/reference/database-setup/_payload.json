__":574},"content_de\u002Fde\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md",{"type":203,"value":204,"toc":561},"minimark",[205,209,214,226,229,243,247,250,316,319,342,346,363,366,387,390,408,414,418,421,424,432,435,439,453,538,545,549,557],[206,207,208],"p",{},"Verstehen Sie die Datenbank-Standards, die FiveNet erwartet, und wie Sie häufige migrationsbezogene Kollationsprobleme vermeiden.",[210,211,213],"h2",{"id":212},"zeichensatz-und-kollation","Zeichensatz und Kollation",[206,215,216,217,221,222,225],{},"Stellen Sie sicher, dass ",[218,219,220],"strong",{},"Zeichensatz"," und ",[218,223,224],{},"Kollation"," Ihrer Datenbank, Tabellen und Spalten konsistent sind.",[206,227,228],{},"Kollationsfehler gehören zu den häufigsten Gründen, warum Datenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[230,231,232],"callout",{},[206,233,234,235,239,240],{},"Empfohlene Kollation: ",[236,237,238],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[236,241,242],{},"utf8mb4",[210,244,246],{"id":245},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[206,248,249],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[251,252,257],"pre",{"className":253,"code":254,"language":255,"meta":256,"style":256},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql","",[236,258,259,283,303],{"__ignoreMap":256},[260,261,264,268,272,276,279],"span",{"class":262,"line":263},"line",1,[260,265,267],{"class":266},"sbssI","USE",[260,269,271],{"class":270},"sMK4o"," `",[260,273,275],{"class":274},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[260,277,278],{"class":270},"`",[260,280,282],{"class":281},"sTEyZ",";\n",[260,284,286,289,292,295,297,299,301],{"class":262,"line":285},2,[260,287,288],{"class":281},"SHOW ",[260,290,291],{"class":266},"CREATE",[260,293,294],{"class":266}," DATABASE",[260,296,271],{"class":270},[260,298,275],{"class":274},[260,300,278],{"class":270},[260,302,282],{"class":281},[260,304,306,308,311,314],{"class":262,"line":305},3,[260,307,288],{"class":281},[260,309,310],{"class":266},"TABLE",[260,312,313],{"class":266}," STATUS",[260,315,282],{"class":281},[206,317,318],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[251,320,322],{"className":253,"code":321,"language":255,"meta":256,"style":256},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[236,323,324],{"__ignoreMap":256},[260,325,326,328,330,333,335,338,340],{"class":262,"line":263},[260,327,288],{"class":281},[260,329,291],{"class":266},[260,331,332],{"class":266}," TABLE",[260,334,271],{"class":270},[260,336,337],{"class":274},"__IHRE_TABELLEN_NAME_HIER__",[260,339,278],{"class":270},[260,341,282],{"class":281},[210,343,345],{"id":344},"kollationskonflikte-beheben","Kollationskonflikte beheben",[206,347,348,349,351,352,354,355,362],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[236,350,242],{},"\u002F",[236,353,238],{}," in MySQL 5.5 finden Sie auf ",[356,357,361],"a",{"href":358,"rel":359},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[360],"nofollow","Database Administrators Stack Exchange",".",[206,364,365],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[251,367,369],{"className":253,"code":368,"language":255,"meta":256,"style":256},"SET foreign_key_checks = 0;\n",[236,370,371],{"__ignoreMap":256},[260,372,373,376,379,382,385],{"class":262,"line":263},[260,374,375],{"class":266},"SET",[260,377,378],{"class":281}," foreign_key_checks ",[260,380,381],{"class":270},"=",[260,383,384],{"class":266}," 0",[260,386,282],{"class":281},[206,388,389],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[251,391,393],{"className":253,"code":392,"language":255,"meta":256,"style":256},"SET foreign_key_checks = 1;\n",[236,394,395],{"__ignoreMap":256},[260,396,397,399,401,403,406],{"class":262,"line":263},[260,398,375],{"class":266},[260,400,378],{"class":281},[260,402,381],{"class":270},[260,404,405],{"class":266}," 1",[260,407,282],{"class":281},[409,410,411],"warning",{},[206,412,413],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[210,415,417],{"id":416},"dsn-kollation","DSN-Kollation",[206,419,420],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[206,422,423],{},"Beispiel:",[251,425,430],{"className":426,"code":428,"language":429,"meta":256},[427],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[236,431,428],{"__ignoreMap":256},[206,433,434],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[210,436,438],{"id":437},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[206,440,441,442,445,446,221,449,452],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[236,443,444],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[236,447,448],{},"password",[236,450,451],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[251,454,456],{"className":253,"code":455,"language":255,"meta":256,"style":256},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[236,457,458,496],{"__ignoreMap":256},[260,459,460,462,465,468,471,474,477,480,482,485,488,490,492,494],{"class":262,"line":263},[260,461,29