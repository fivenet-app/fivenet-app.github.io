","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":235,"body":236,"description":242,"extension":604,"links":605,"meta":606,"navigation":607,"path":608,"redirect":605,"seo":609,"stem":610,"__hash__":611},"content_de\u002Fde\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md","Datenbankeinrichtung",{"type":237,"value":238,"toc":596},"minimark",[239,243,248,260,263,277,281,284,350,353,376,380,397,400,421,424,442,448,452,455,458,466,469,473,487,572,580,584,592],[240,241,242],"p",{},"Verstehen Sie die Datenbank-Standards, die FiveNet erwartet, und wie Sie häufige migrationsbezogene Kollationsprobleme vermeiden.",[244,245,247],"h2",{"id":246},"zeichensatz-und-kollation","Zeichensatz und Kollation",[240,249,250,251,255,256,259],{},"Stellen Sie sicher, dass ",[252,253,254],"strong",{},"Zeichensatz"," und ",[252,257,258],{},"Kollation"," Ihrer Datenbank, Tabellen und Spalten konsistent sind.",[240,261,262],{},"Kollationsfehler gehören zu den häufigsten Gründen, warum Datenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[264,265,266],"callout",{},[240,267,268,269,273,274],{},"Empfohlene Kollation: ",[270,271,272],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[270,275,276],{},"utf8mb4",[244,278,280],{"id":279},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[240,282,283],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[285,286,291],"pre",{"className":287,"code":288,"language":289,"meta":290,"style":290},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql","",[270,292,293,317,337],{"__ignoreMap":290},[294,295,298,302,306,310,313],"span",{"class":296,"line":297},"line",1,[294,299,301],{"class":300},"sbssI","USE",[294,303,305],{"class":304},"sMK4o"," `",[294,307,309],{"class":308},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[294,311,312],{"class":304},"`",[294,314,316],{"class":315},"sTEyZ",";\n",[294,318,320,323,326,329,331,333,335],{"class":296,"line":319},2,[294,321,322],{"class":315},"SHOW ",[294,324,325],{"class":300},"CREATE",[294,327,328],{"class":300}," DATABASE",[294,330,305],{"class":304},[294,332,309],{"class":308},[294,334,312],{"class":304},[294,336,316],{"class":315},[294,338,340,342,345,348],{"class":296,"line":339},3,[294,341,322],{"class":315},[294,343,344],{"class":300},"TABLE",[294,346,347],{"class":300}," STATUS",[294,349,316],{"class":315},[240,351,352],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[285,354,356],{"className":287,"code":355,"language":289,"meta":290,"style":290},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[270,357,358],{"__ignoreMap":290},[294,359,360,362,364,367,369,372,374],{"class":296,"line":297},[294,361,322],{"class":315},[294,363,325],{"class":300},[294,365,366],{"class":300}," TABLE",[294,368,305],{"class":304},[294,370,371],{"class":308},"__IHRE_TABELLEN_NAME_HIER__",[294,373,312],{"class":304},[294,375,316],{"class":315},[244,377,379],{"id":378},"kollationskonflikte-beheben","Kollationskonflikte beheben",[240,381,382,383,385,386,388,389,396],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[270,384,276],{},"\u002F",[270,387,272],{}," in MySQL 5.5 finden Sie auf ",[390,391,395],"a",{"href":392,"rel":393},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[394],"nofollow","Database Administrators Stack Exchange",".",[240,398,399],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[285,401,403],{"className":287,"code":402,"language":289,"meta":290,"style":290},"SET foreign_key_checks = 0;\n",[270,404,405],{"__ignoreMap":290},[294,406,407,410,413,416,419],{"class":296,"line":297},[294,408,409],{"class":300},"SET",[294,411,412],{"class":315}," foreign_key_checks ",[294,414,415],{"class":304},"=",[294,417,418],{"class":300}," 0",[294,420,316],{"class":315},[240,422,423],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[285,425,427],{"className":287,"code":426,"language":289,"meta":290,"style":290},"SET foreign_key_checks = 1;\n",[270,428,429],{"__ignoreMap":290},[294,430,431,433,435,437,440],{"class":296,"line":297},[294,432,409],{"class":300},[294,434,412],{"class":315},[294,436,415],{"class":304},[294,438,439],{"class":300}," 1",[294,441,316],{"class":315},[443,444,445],"warning",{},[240,446,447],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[244,449,451],{"id":450},"dsn-kollation","DSN-Kollation",[240,453,454],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[240,456,457],{},"Beispiel:",[285,459,464],{"className":460,"code":462,"language":463,"meta":290},[461],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[270,465,462],{"__ignoreMap":290},[240,467,468],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[244,470,472],{"id":471},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[240,474,475,476,479,480,255,483,486],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[270,477,478],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[270,481,482],{},"password",[270,484,485],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[285,488,490],{"className":287,"code":489,"language":289,"meta":290,"style":290},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[270,491,492,530],{"__ignoreMap":290},[294,493,494,496,499,502,505,508,511,514,516,519,522,524,526,528],{"class":296,"line":297},[294,495,325],{"class":300},[294,497,498],{"class":300}," USER",[294,500,501],{"class":315}," '",[294,503,478],{"class":504},"s2Zo4",[294,506,507],{"class":315},"'@",[294,509,510],{"class":304},"'",[294,512,513],{"class":308},"%",[294,515,510],{"class":304},[294,517,518],{"class":315}," IDENTIFIED ",[294,520,521],{"class":300},"BY",[294,523,501],{"class":304},[294,525,482],{"class":308},[294,527,510],{"class":304},[294,529,316],{"class":315},[294,531,532,535,538,541,543,545,547,549,552,555,557,559,561,564,566,568,570],{"class":296,"line":319},[294,533,534],{"class":300},"GRANT",[294,536,537],{"class":315}," ALL PRIVILEGES ",[294,539,540],{"class":300},"ON",[294,542,305],{"class":304},[294,544,485],{"class":308},[294,546,312],{"class":304},[294,548,396],{"class":315},[294,550,551],{"class":304},"*",[294,553,554],{"class":300}," TO",[294,556,501],{"class":304},[294,558,478],{"class":308},[294,560,510],{"class":304},[294,562,563],{"class":315},"@",[294,565,510],{"class":304},[294,567,513],{"class":308},[294,569,510],{"class":304},[294,571,316],{"class":315},[240,573,574,575,579],{},"Für einen separaten DBSync-Quellbenutzer reicht in der Regel Lesezugriff aus. Siehe ",[390,576,578],{"href":577},"\u002Fde\u002Fgetting-started\u002Fconfiguration\u002Fdbsync","DBSync"," für ein Beispiel eines dedizierten Nur-Lese-Benutzers.",[244,581,583],{"id":582},"empfohlene-werkzeuge","Empfohlene Werkzeuge",[240,585,586,591],{},[390,587,590],{"href":588,"rel":589},"https:\u002F\u002Fdbeaver.io\u002F",[394],"DBeaver"," ist ein gutes allgemeines Datenbankverwaltungswerkzeug, wenn Sie lieber mit einer grafischen Oberfläche Schemas, Kollationen und Daten prüfen mö