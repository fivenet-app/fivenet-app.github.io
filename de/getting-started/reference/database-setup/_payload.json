nd Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":226,"path":227,"stem":228},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":170,"path":230,"stem":231},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":233,"path":234,"stem":235},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":237,"path":238,"stem":239},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":241,"path":242,"stem":243},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":245,"title":246,"body":247,"description":253,"extension":614,"links":615,"meta":616,"navigation":617,"path":618,"redirect":615,"seo":619,"stem":620,"__hash__":621},"content_de\u002Fde\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md","Datenbankeinrichtung",{"type":248,"value":249,"toc":606},"minimark",[250,254,259,271,274,288,292,295,360,363,386,390,407,410,431,434,452,458,462,465,468,476,479,483,497,582,590,594,602],[251,252,253],"p",{},"Verstehen Sie die Datenbank-Standards, die FiveNet erwartet, und wie Sie häufige migrationsbezogene Kollationsprobleme vermeiden.",[255,256,258],"h2",{"id":257},"zeichensatz-und-kollation","Zeichensatz und Kollation",[251,260,261,262,266,267,270],{},"Stellen Sie sicher, dass ",[263,264,265],"strong",{},"Zeichensatz"," und ",[263,268,269],{},"Kollation"," Ihrer Datenbank, Tabellen und Spalten konsistent sind.",[251,272,273],{},"Kollationsfehler gehören zu den häufigsten Gründen, warum Datenbankmigrationen von FiveNet fehlschlagen, insbesondere nach dem Umzug von Datenbanken zwischen Servern oder dem Import älterer Dumps.",[275,276,277],"callout",{},[251,278,279,280,284,285],{},"Empfohlene Kollation: ",[281,282,283],"code",{},"utf8mb4_unicode_ci","\nEmpfohlener Zeichensatz: ",[281,286,287],{},"utf8mb4",[255,289,291],{"id":290},"aktuelle-datenbankeinstellungen-prüfen","Aktuelle Datenbankeinstellungen prüfen",[251,293,294],{},"Verwenden Sie die folgenden Abfragen, um den aktuellen Zeichensatz und die aktuelle Kollation zu prüfen:",[296,297,301],"pre",{"className":298,"code":299,"language":300,"meta":13,"style":13},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW CREATE DATABASE `__IHRE_DATENBANK_NAME_HIER__`;\nSHOW TABLE STATUS;\n","sql",[281,302,303,327,347],{"__ignoreMap":13},[304,305,308,312,316,320,323],"span",{"class":306,"line":307},"line",1,[304,309,311],{"class":310},"sbssI","USE",[304,313,315],{"class":314},"sMK4o"," `",[304,317,319],{"class":318},"sfazB","__IHRE_DATENBANK_NAME_HIER__",[304,321,322],{"class":314},"`",[304,324,326],{"class":325},"sTEyZ",";\n",[304,328,330,333,336,339,341,343,345],{"class":306,"line":329},2,[304,331,332],{"class":325},"SHOW ",[304,334,335],{"class":310},"CREATE",[304,337,338],{"class":310}," DATABASE",[304,340,315],{"class":314},[304,342,319],{"class":318},[304,344,322],{"class":314},[304,346,326],{"class":325},[304,348,350,352,355,358],{"class":306,"line":349},3,[304,351,332],{"class":325},[304,353,354],{"class":310},"TABLE",[304,356,357],{"class":310}," STATUS",[304,359,326],{"class":325},[251,361,362],{},"Wenn Sie zusätzlich die Kollation einzelner Spalten prüfen möchten, sehen Sie sich die Tabellendefinition direkt an:",[296,364,366],{"className":298,"code":365,"language":300,"meta":13,"style":13},"SHOW CREATE TABLE `__IHRE_TABELLEN_NAME_HIER__`;\n",[281,367,368],{"__ignoreMap":13},[304,369,370,372,374,377,379,382,384],{"class":306,"line":307},[304,371,332],{"class":325},[304,373,335],{"class":310},[304,375,376],{"class":310}," TABLE",[304,378,315],{"class":314},[304,380,381],{"class":318},"__IHRE_TABELLEN_NAME_HIER__",[304,383,322],{"class":314},[304,385,326],{"class":325},[255,387,389],{"id":388},"kollationskonflikte-beheben","Kollationskonflikte beheben",[251,391,392,393,395,396,398,399,406],{},"Eine nützliche Anleitung zum Konvertieren von Tabellen auf ",[281,394,287],{},"\u002F",[281,397,283],{}," in MySQL 5.5 finden Sie auf ",[400,401,405],"a",{"href":402,"rel":403},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[404],"nofollow","Database Administrators Stack Exchange",".",[251,408,409],{},"Bevor Sie die erzeugten Umwandlungsabfragen ausführen, deaktivieren Sie die Fremdschlüsselprüfung:",[296,411,413],{"className":298,"code":412,"language":300,"meta":13,"style":13},"SET foreign_key_checks = 0;\n",[281,414,415],{"__ignoreMap":13},[304,416,417,420,423,426,429],{"class":306,"line":307},[304,418,419],{"class":310},"SET",[304,421,422],{"class":325}," foreign_key_checks ",[304,424,425],{"class":314},"=",[304,427,428],{"class":310}," 0",[304,430,326],{"class":325},[251,432,433],{},"Nach Abschluss der Umwandlung aktivieren Sie sie wieder:",[296,435,437],{"className":298,"code":436,"language":300,"meta":13,"style":13},"SET foreign_key_checks = 1;\n",[281,438,439],{"__ignoreMap":13},[304,440,441,443,445,447,450],{"class":306,"line":307},[304,442,419],{"class":310},[304,444,422],{"class":325},[304,446,425],{"class":314},[304,448,449],{"class":310}," 1",[304,451,326],{"class":325},[453,454,455],"warning",{},[251,456,457],{},"Das Deaktivieren von Fremdschlüsselprüfungen kann zu Problemen mit der Datenintegrität führen, wenn es nicht sorgfältig gehandhabt wird. Gehen Sie vorsichtig vor.",[255,459,461],{"id":460},"dsn-kollation","DSN-Kollation",[251,463,464],{},"Die Kollation in Ihrer FiveNet-Datenbank-DSN sollte zu der Kollation passen, die Ihr Datenbankserver und Ihre Tabellen verwenden.",[251,466,467],{},"Beispiel:",[296,469,474],{"className":470,"code":472,"language":473,"meta":13},[471],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[281,475,472],{"__ignoreMap":13},[251,477,478],{},"Wenn Ihre DSN eine andere Kollation als die tatsächliche Datenbank verwendet, können Migrationen oder Abfragen fehlschlagen.",[255,480,482],{"id":481},"erstellen-eines-datenbankbenutzers","Erstellen eines Datenbankbenutzers",[251,484,485,486,489,490,266,493,496],{},"Unten finden Sie Beispielabfragen, um einen Datenbankbenutzer namens ",[281,487,488],{},"fivenet"," mit vollem Zugriff auf eine bestimmte Datenbank zu erstellen. Ersetzen Sie ",[281,491,492],{},"password",[281,494,495],{},"datenbank_name"," vor der Verwendung durch Ihre tatsächlichen Werte.",[296,498,500],{"className":298,"code":499,"language":300,"meta":13,"style":13},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `datenbank_name`.* TO 'fivenet'@'%';\n",[281,501,502,540],{"__ignoreMap":13},[304,503,504,506,509,512,515,518,521,524,526,529,532,534,536,538],{"class":306,"line":307},[304,505,335],{"class":310},[304,507,508],{"class":310}," USER",[304,510,511],{"class":325}," '",[304,513,488],{"class":514},"s2Zo4",[304,516,517],{"class":325},"'@",[304,519,520],{"class":314},"'",[304,522,523],{"class":318},"%",[304,525,520],{"class":314},[304,527,528],{"class":325}," IDENTIFIED ",[304,530,531],{"class":310},"BY",[304,533,511],{"class":314},[304,535,492],{"class":318},[304,537,520],{"class":314},[304,539,326],{"class":325},[304,541,542,545,548,551,553,555,557,559,562,565,567,569,571,574,576,578,580],{"class":306,"line":329},[304,543,544],{"class":310},"GRANT",[304,546,547],{"class":325}," ALL PRIVILEGES ",[304,549,550],{"class":310},"ON",[304,552,315],{"class":314},[304,554,495],{"class":318},[304,556,322],{"class":314},[304,558,406],{"class":325},[304,560,561],{"class":314},"*",[304,563,564],{"class":310}," TO",[304,566,511],{"class":314},[304,568,488],{"class":318},[304,570,520],{"class":314},[304,572,573],{"class":325},"@",[304,575,520],{"class":314},[304,577,523],{"class":318},[304,579,520],{"class":314},[304,581,326],{"class":325},[251,583,584,585,589],{},"Für einen separaten DBSync-Quellbenutzer reicht in d