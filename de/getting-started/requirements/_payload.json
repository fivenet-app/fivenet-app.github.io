iler","de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164,"children":165},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[166,167,171],{"title":162,"path":163,"stem":164},{"title":168,"path":169,"stem":170},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":172,"stem":173},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":175,"path":176,"stem":177,"children":178},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[179],{"title":175,"path":176,"stem":177},{"id":181,"title":19,"body":182,"description":415,"extension":424,"links":425,"meta":426,"navigation":427,"path":20,"redirect":425,"seo":428,"stem":21,"__hash__":429},"content_de\u002Fde\u002F1.getting-started\u002F2.requirements.md",{"type":183,"value":184,"toc":414},"minimark",[185,196,201,234,238,271,275,285,299,303,341,345,400,404],[186,187,188],"callout",{},[189,190,191,195],"p",{},[192,193,194],"strong",{},"Kurzfassung:"," Sie benötigen einen aktuellen MySQL 8.4+\u002FMariaDB 11.4+ Datenbankserver, einen NATS-Nachrichtenwarteschlangen-Server 2.11.3+ und einen Reverse-Proxy. (Sie benötigen ungefähr einen Server mit mindestens einem halben CPU-Kern, 512 MB RAM und 1 GB Speicherplatz.)",[197,198,200],"h2",{"id":199},"mysql-basierter-datenbankserver","MySQL-basierter Datenbankserver",[202,203,204,226],"ul",{},[205,206,207,214,215,220,221],"li",{},[208,209,213],"a",{"href":210,"rel":211},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002F",[212],"nofollow","MySQL 8.4+"," oder ",[208,216,219],{"href":217,"rel":218},"https:\u002F\u002Fmariadb.com\u002Fkb\u002Fen\u002Fwhat-is-mariadb-114\u002F",[212],"MariaDB 11.4+"," Version oder höher sollten kompatibel sein (beide genannten Versionen sind LTS-Versionen).\n",[202,222,223],{},[205,224,225],{},"Ältere Versionen könnten noch funktionieren, wir bieten jedoch keinen Support oder keine Garantie für die Kompatibilität mit diesen.",[205,227,228,233],{},[208,229,232],{"href":230,"rel":231},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002Ffulltext-search.html",[212],"Volltextsuche"," muss verfügbar sein (die meisten Standardinstallationen haben sie verfügbar\u002Finstalliert).",[197,235,237],{"id":236},"nats-nachrichtenwarteschlangen-server","NATS-Nachrichtenwarteschlangen-Server",[202,239,240,255,263],{},[205,241,242,247,248],{},[208,243,246],{"href":244,"rel":245},"https:\u002F\u002Fnats.io\u002F",[212],"NATS-Server"," muss installiert und entweder als Einzelserver oder Cluster ausgeführt werden.\n",[202,249,250],{},[205,251,252],{},[192,253,254],{},"Mindestens Version 2.11.3+ des NATS-Servers ist erforderlich.",[205,256,257,262],{},[208,258,261],{"href":259,"rel":260},"https:\u002F\u002Fdocs.nats.io\u002Fnats-concepts\u002Fjetstream",[212],"JetStream"," muss aktiviert sein.",[205,264,265,270],{},[208,266,269],{"href":267,"rel":268},"https:\u002F\u002Fdocs.nats.io\u002Frunning-a-nats-service\u002Fconfiguration#jetstream-server-settings",[212],"JetStream-Speicher im Arbeitsspeicher"," muss mit mindestens 10-20 MB verfügbarem Speicherplatz aktiviert sein.",[197,272,274],{"id":273},"speicher","Speicher",[189,276,277,278,214,281,284],{},"Entweder ",[192,279,280],{},"lokaler Speicher (Verzeichnis)",[192,282,283],{},"S3-Bucket-Speicher"," wird unterstützt.",[202,286,287,290],{},[205,288,289],{},"Der Speicher wird für Avatare, Fraktions-\u002FJob-Logos und Datei-Uploads verwendet.",[205,291,292,293,298],{},"Falls Sie einen S3-Bucket verwenden, müssen Sie mindestens Lese- und Schreibzugriff auf den Bucket haben, ",[208,294,297],{"href":295,"rel":296},"https:\u002F\u002Fdocs.aws.amazon.com\u002FIAM\u002Flatest\u002FUserGuide\u002Freference_policies_examples_s3_rw-bucket.html",[212],"Beispiel AWS S3-Richtlinie",".",[197,300,302],{"id":301},"domainsubdomain","Domain\u002FSubdomain",[202,304,305,318,338],{},[205,306,307,308,312,313],{},"Die Domain\u002FSubdomain muss öffentlich zugänglich sein (z.B. ",[309,310,311],"code",{},"https:\u002F\u002Ffivenet.example.com",").\n",[202,314,315],{},[205,316,317],{},"Sie muss auf den Server\u002FReverse-Proxy zeigen, auf dem Sie FiveNet ausführen (im Fall von z.B. Docker sollte dies Ihr Container-Reverse-Proxy sein, bei Kubernetes-Helm-Installation der Ingress-Controller).",[205,319,320,321],{},"Ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.\n",[202,322,323,326,329],{},[205,324,325],{},"Im Fall von Cloudflare-Tunneln benötigen Sie kein Zertifikat, da Cloudflare HTTPS\u002FSSL vor dem Tunnel terminiert.",[205,327,328],{},"Im Fall eines Reverse-Proxys benötigen Sie ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.",[205,330,331,332,337],{},"Sie können ",[208,333,336],{"href":334,"rel":335},"https:\u002F\u002Fletsencrypt.org\u002F",[212],"Let's Encrypt"," verwenden, um ein kostenloses Zertifikat zu erhalten.",[205,339,340],{},"Wenn Sie DBSync verwenden, wird empfohlen, eine separate Subdomain zu konfigurieren, die den GRPC-Verkehr vom FiveNet-Plugin und der DBSync-Komponente verarbeitet.",[197,342,344],{"id":343},"reverse-proxy","Reverse Proxy",[202,346,347,374,377,380],{},[205,348,349,350],{},"Der Reverse Proxy muss HTTP2 und WebSockets unterstützen. DBSync und das FiveNet-Plugin erfordern GRPC.\n",[202,351,352],{},[205,353,354,355,360,361,364,365,368,369,298],{},"Für ",[208,356,359],{"href":357,"rel":358},"https:\u002F\u002Fwww.nginx.com\u002F",[212],"NGINX"," stellen Sie sicher, dass ",[309,362,363],{},"http2"," in der ",[309,366,367],{},"listen","-Direktive aktiviert ist und verwenden Sie das ",[208,370,373],{"href":371,"rel":372},"https:\u002F\u002Fnginx.org\u002Fen\u002Fdocs\u002Fhttp\u002Fwebsocket.html",[212],"ausführliche WebSocket-Beispiel von hier",[205,375,376],{},"Es wird empfohlen, zwei Subdomains zu verwenden, eine für die FiveNet-Webanwendung und eine andere für den DBSync\u002FPlugin-GRPC-Verkehr.",[205,378,379],{},"Der Reverse Proxy muss HTTPS\u002FSSL terminieren, bevor der Datenverkehr an den FiveNet-Server gesendet wird.",[205,381,382,383],{},"Bekannte Reverse Proxies, die funktionieren, sind:\n",[202,384,385,390,397],{},[205,386,387],{},[208,388,359],{"href":357,"rel":389},[212],[205,391,392,298],{},[208,393,396],{"href":394,"rel":395},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002F",[212],"Traefik",[205,398,399],{},"Andere könnten funktionieren, wurden jedoch nicht getestet.",[197,401,403],{"id":402},"optionale-anforderungen","Optionale Anforderungen",[202,405,406],{},[205,407,408,409,413],{},"Tracing: OpenTelemetry-basiertes Tracing ist für die FiveNet-Server- und Worker-Komponenten verfügbar, siehe ",[208,410,412],{"href":411},"configuration\u002Fadvanced#tracing","Tracing"," unten. Tracing kann helfen, Leistungsprobleme zu diagnostizieren und das Systemverhalten zu überwachen.",{"title":415,"searchDepth":416,"depth":416,"links":417},"",2,[418,419,420,421,422,423],{"id":199,"depth":416,"text":200},{"id":236,"depth":416,"text":237},{"id":273,"depth":416,"text":274},{"id":301,"depth":416,"text":302},{"id":343,"depth":416,"text":344},{"id":402,"depth":416,"text":403},"md",null,{},true,{"title":19,"description":415},"fs1fqRLJaqbeGegcIce8m7BzmLwVHi3I04h-pIlaakE",[431,433],{"title":15,"path":16,"stem":17,"description":432,"children":-1},"Entdecken Sie die Funktionen von FiveNet mit unserer Demo-Instanz:",{"title":23,"path":24,"stem":25,"description":434,"children":-1},"Diese Seite beschreibt die Komponenten von FiveNet und wie sie miteinander interagieren.",1787913096572]