design\u002Fdata-separation-management",{"title":225,"path":226,"stem":227},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":169,"path":229,"stem":230},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":232,"path":233,"stem":234},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":236,"path":237,"stem":238},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":240,"path":241,"stem":242},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":244,"title":245,"body":246,"description":479,"extension":488,"links":489,"meta":490,"navigation":491,"path":492,"redirect":489,"seo":493,"stem":494,"__hash__":495},"content_de\u002Fde\u002F1.getting-started\u002F2.requirements.md","Anforderungen",{"type":247,"value":248,"toc":478},"minimark",[249,260,265,298,302,335,339,349,363,367,405,409,464,468],[250,251,252],"callout",{},[253,254,255,259],"p",{},[256,257,258],"strong",{},"Kurzfassung:"," Sie benötigen einen aktuellen MySQL 8.4+\u002FMariaDB 11.4+ Datenbankserver, einen NATS-Nachrichtenwarteschlangen-Server 2.11.3+ und einen Reverse-Proxy. (Sie benötigen ungefähr einen Server mit mindestens einem halben CPU-Kern, 512 MB RAM und 1 GB Speicherplatz.)",[261,262,264],"h2",{"id":263},"mysql-basierter-datenbankserver","MySQL-basierter Datenbankserver",[266,267,268,290],"ul",{},[269,270,271,278,279,284,285],"li",{},[272,273,277],"a",{"href":274,"rel":275},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002F",[276],"nofollow","MySQL 8.4+"," oder ",[272,280,283],{"href":281,"rel":282},"https:\u002F\u002Fmariadb.com\u002Fkb\u002Fen\u002Fwhat-is-mariadb-114\u002F",[276],"MariaDB 11.4+"," Version oder höher sollten kompatibel sein (beide genannten Versionen sind LTS-Versionen).\n",[266,286,287],{},[269,288,289],{},"Ältere Versionen könnten noch funktionieren, wir bieten jedoch keinen Support oder keine Garantie für die Kompatibilität mit diesen.",[269,291,292,297],{},[272,293,296],{"href":294,"rel":295},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002Ffulltext-search.html",[276],"Volltextsuche"," muss verfügbar sein (die meisten Standardinstallationen haben sie verfügbar\u002Finstalliert).",[261,299,301],{"id":300},"nats-nachrichtenwarteschlangen-server","NATS-Nachrichtenwarteschlangen-Server",[266,303,304,319,327],{},[269,305,306,311,312],{},[272,307,310],{"href":308,"rel":309},"https:\u002F\u002Fnats.io\u002F",[276],"NATS-Server"," muss installiert und entweder als Einzelserver oder Cluster ausgeführt werden.\n",[266,313,314],{},[269,315,316],{},[256,317,318],{},"Mindestens Version 2.11.3+ des NATS-Servers ist erforderlich.",[269,320,321,326],{},[272,322,325],{"href":323,"rel":324},"https:\u002F\u002Fdocs.nats.io\u002Fnats-concepts\u002Fjetstream",[276],"JetStream"," muss aktiviert sein.",[269,328,329,334],{},[272,330,333],{"href":331,"rel":332},"https:\u002F\u002Fdocs.nats.io\u002Frunning-a-nats-service\u002Fconfiguration#jetstream-server-settings",[276],"JetStream-Speicher im Arbeitsspeicher"," muss mit mindestens 10-20 MB verfügbarem Speicherplatz aktiviert sein.",[261,336,338],{"id":337},"speicher","Speicher",[253,340,341,342,278,345,348],{},"Entweder ",[256,343,344],{},"lokaler Speicher (Verzeichnis)",[256,346,347],{},"S3-Bucket-Speicher"," wird unterstützt.",[266,350,351,354],{},[269,352,353],{},"Der Speicher wird für Avatare, Fraktions-\u002FJob-Logos und Datei-Uploads verwendet.",[269,355,356,357,362],{},"Falls Sie einen S3-Bucket verwenden, müssen Sie mindestens Lese- und Schreibzugriff auf den Bucket haben, ",[272,358,361],{"href":359,"rel":360},"https:\u002F\u002Fdocs.aws.amazon.com\u002FIAM\u002Flatest\u002FUserGuide\u002Freference_policies_examples_s3_rw-bucket.html",[276],"Beispiel AWS S3-Richtlinie",".",[261,364,366],{"id":365},"domainsubdomain","Domain\u002FSubdomain",[266,368,369,382,402],{},[269,370,371,372,376,377],{},"Die Domain\u002FSubdomain muss öffentlich zugänglich sein (z.B. ",[373,374,375],"code",{},"https:\u002F\u002Ffivenet.example.com",").\n",[266,378,379],{},[269,380,381],{},"Sie muss auf den Server\u002FReverse-Proxy zeigen, auf dem Sie FiveNet ausführen (im Fall von z.B. Docker sollte dies Ihr Container-Reverse-Proxy sein, bei Kubernetes-Helm-Installation der Ingress-Controller).",[269,383,384,385],{},"Ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.\n",[266,386,387,390,393],{},[269,388,389],{},"Im Fall von Cloudflare-Tunneln benötigen Sie kein Zertifikat, da Cloudflare HTTPS\u002FSSL vor dem Tunnel terminiert.",[269,391,392],{},"Im Fall eines Reverse-Proxys benötigen Sie ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.",[269,394,395,396,401],{},"Sie können ",[272,397,400],{"href":398,"rel":399},"https:\u002F\u002Fletsencrypt.org\u002F",[276],"Let's Encrypt"," verwenden, um ein kostenloses Zertifikat zu erhalten.",[269,403,404],{},"Wenn Sie DBSync verwenden, wird empfohlen, eine separate Subdomain zu konfigurieren, die den GRPC-Verkehr vom FiveNet-Plugin und der DBSync-Komponente verarbeitet.",[261,406,408],{"id":407},"reverse-proxy","Reverse Proxy",[266,410,411,438,441,444],{},[269,412,413,414],{},"Der Reverse Proxy muss HTTP2 und WebSockets unterstützen. DBSync und das FiveNet-Plugin erfordern GRPC.\n",[266,415,416],{},[269,417,418,419,424,425,428,429,432,433,362],{},"Für ",[272,420,423],{"href":421,"rel":422},"https:\u002F\u002Fwww.nginx.com\u002F",[276],"NGINX"," stellen Sie sicher, dass ",[373,426,427],{},"http2"," in der ",[373,430,431],{},"listen","-Direktive aktiviert ist und verwenden Sie das ",[272,434,437],{"href":435,"rel":436},"https:\u002F\u002Fnginx.org\u002Fen\u002Fdocs\u002Fhttp\u002Fwebsocket.html",[276],"ausführliche WebSocket-Beispiel von hier",[269,439,440],{},"Es wird empfohlen, zwei Subdomains zu verwenden, eine für die FiveNet-Webanwendung und eine andere für den DBSync\u002FPlugin-GRPC-Verkehr.",[269,442,443],{},"Der Reverse Proxy muss HTTPS\u002FSSL terminieren, bevor der Datenverkehr an den FiveNet-Server gesendet wird.",[269,445,446,447],{},"Bekannte Reverse Proxies, die funktionieren, sind:\n",[266,448,449,454,461],{},[269,450,451],{},[272,452,423],{"href":421,"rel":453},[276],[269,455,456,362],{},[272,457,460],{"href":458,"rel":459},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002F",[276],"Traefik",[269,462,463],{},"Andere könnten funktionieren, wurden jedoch nicht getestet.",[261,465,467],{"id":466},"optionale-anforderungen","Optionale Anforderungen",[266,469,470],{},[269,471,472,473,477],{},"Tracing: OpenTelemetry-basiertes Tracing ist für die FiveNet-Server- und Worker-Komponenten verfügbar, siehe ",[272,474,476],{"href":475},"\u002Fde\u002Fgetting-started\u002Freference\u002Fadvanced#tracing","Tracing"," unten. Tracing kann helfen, Leistungsprobleme zu diagnostizieren und das Systemverhalten zu überwachen.",{"title":479,"searchDepth":480,"depth":480,"links":481},"",2,[482,483,484,485,486,487],{"id":263,"depth":480,"text":264},{"id":300,"depth":480,"text":301},{"id":337,"depth":480,"text":338},{"id":365,"depth":480,"text":366},{"id":407,"depth":480,"text":408},{"id":466,"depth":480,"text":467},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Frequirements",{"title":245,"description":479},"de\u002F1.getting-started\u002F2.requirements","lKF0PBsPC3dVRqVsl03qevxCYYjMIwdk2n-2A8DMLxQ",1795714537400,"3d638de7-68c8-4e60-9c0d-5c8dc7f2f7e2"]