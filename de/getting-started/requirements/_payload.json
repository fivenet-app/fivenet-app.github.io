,"stem":171},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":173,"path":174,"stem":175},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":177,"path":178,"stem":179},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":181,"stem":182},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":184,"path":185,"stem":186,"children":187},"Design Docs","\u002Fdesign","9.design\u002F1.index",[188,190,194,198,201,205,209],{"title":189,"path":185,"stem":186},"Designs",{"title":191,"path":192,"stem":193},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":195,"path":196,"stem":197},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":199,"stem":200},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":202,"path":203,"stem":204},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":206,"path":207,"stem":208},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":210,"path":211,"stem":212},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":214,"title":215,"body":216,"description":449,"extension":458,"links":459,"meta":460,"navigation":461,"path":462,"redirect":459,"seo":463,"stem":464,"__hash__":465},"content_de\u002Fde\u002F1.getting-started\u002F2.requirements.md","Anforderungen",{"type":217,"value":218,"toc":448},"minimark",[219,230,235,268,272,305,309,319,333,337,375,379,434,438],[220,221,222],"callout",{},[223,224,225,229],"p",{},[226,227,228],"strong",{},"Kurzfassung:"," Sie benötigen einen aktuellen MySQL 8.4+\u002FMariaDB 11.4+ Datenbankserver, einen NATS-Nachrichtenwarteschlangen-Server 2.11.3+ und einen Reverse-Proxy. (Sie benötigen ungefähr einen Server mit mindestens einem halben CPU-Kern, 512 MB RAM und 1 GB Speicherplatz.)",[231,232,234],"h2",{"id":233},"mysql-basierter-datenbankserver","MySQL-basierter Datenbankserver",[236,237,238,260],"ul",{},[239,240,241,248,249,254,255],"li",{},[242,243,247],"a",{"href":244,"rel":245},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002F",[246],"nofollow","MySQL 8.4+"," oder ",[242,250,253],{"href":251,"rel":252},"https:\u002F\u002Fmariadb.com\u002Fkb\u002Fen\u002Fwhat-is-mariadb-114\u002F",[246],"MariaDB 11.4+"," Version oder höher sollten kompatibel sein (beide genannten Versionen sind LTS-Versionen).\n",[236,256,257],{},[239,258,259],{},"Ältere Versionen könnten noch funktionieren, wir bieten jedoch keinen Support oder keine Garantie für die Kompatibilität mit diesen.",[239,261,262,267],{},[242,263,266],{"href":264,"rel":265},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002Ffulltext-search.html",[246],"Volltextsuche"," muss verfügbar sein (die meisten Standardinstallationen haben sie verfügbar\u002Finstalliert).",[231,269,271],{"id":270},"nats-nachrichtenwarteschlangen-server","NATS-Nachrichtenwarteschlangen-Server",[236,273,274,289,297],{},[239,275,276,281,282],{},[242,277,280],{"href":278,"rel":279},"https:\u002F\u002Fnats.io\u002F",[246],"NATS-Server"," muss installiert und entweder als Einzelserver oder Cluster ausgeführt werden.\n",[236,283,284],{},[239,285,286],{},[226,287,288],{},"Mindestens Version 2.11.3+ des NATS-Servers ist erforderlich.",[239,290,291,296],{},[242,292,295],{"href":293,"rel":294},"https:\u002F\u002Fdocs.nats.io\u002Fnats-concepts\u002Fjetstream",[246],"JetStream"," muss aktiviert sein.",[239,298,299,304],{},[242,300,303],{"href":301,"rel":302},"https:\u002F\u002Fdocs.nats.io\u002Frunning-a-nats-service\u002Fconfiguration#jetstream-server-settings",[246],"JetStream-Speicher im Arbeitsspeicher"," muss mit mindestens 10-20 MB verfügbarem Speicherplatz aktiviert sein.",[231,306,308],{"id":307},"speicher","Speicher",[223,310,311,312,248,315,318],{},"Entweder ",[226,313,314],{},"lokaler Speicher (Verzeichnis)",[226,316,317],{},"S3-Bucket-Speicher"," wird unterstützt.",[236,320,321,324],{},[239,322,323],{},"Der Speicher wird für Avatare, Fraktions-\u002FJob-Logos und Datei-Uploads verwendet.",[239,325,326,327,332],{},"Falls Sie einen S3-Bucket verwenden, müssen Sie mindestens Lese- und Schreibzugriff auf den Bucket haben, ",[242,328,331],{"href":329,"rel":330},"https:\u002F\u002Fdocs.aws.amazon.com\u002FIAM\u002Flatest\u002FUserGuide\u002Freference_policies_examples_s3_rw-bucket.html",[246],"Beispiel AWS S3-Richtlinie",".",[231,334,336],{"id":335},"domainsubdomain","Domain\u002FSubdomain",[236,338,339,352,372],{},[239,340,341,342,346,347],{},"Die Domain\u002FSubdomain muss öffentlich zugänglich sein (z.B. ",[343,344,345],"code",{},"https:\u002F\u002Ffivenet.example.com",").\n",[236,348,349],{},[239,350,351],{},"Sie muss auf den Server\u002FReverse-Proxy zeigen, auf dem Sie FiveNet ausführen (im Fall von z.B. Docker sollte dies Ihr Container-Reverse-Proxy sein, bei Kubernetes-Helm-Installation der Ingress-Controller).",[239,353,354,355],{},"Ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.\n",[236,356,357,360,363],{},[239,358,359],{},"Im Fall von Cloudflare-Tunneln benötigen Sie kein Zertifikat, da Cloudflare HTTPS\u002FSSL vor dem Tunnel terminiert.",[239,361,362],{},"Im Fall eines Reverse-Proxys benötigen Sie ein gültiges HTTPS-Zertifikat für Ihre Domain\u002FSubdomain.",[239,364,365,366,371],{},"Sie können ",[242,367,370],{"href":368,"rel":369},"https:\u002F\u002Fletsencrypt.org\u002F",[246],"Let's Encrypt"," verwenden, um ein kostenloses Zertifikat zu erhalten.",[239,373,374],{},"Wenn Sie DBSync verwenden, wird empfohlen, eine separate Subdomain zu konfigurieren, die den GRPC-Verkehr vom FiveNet-Plugin und der DBSync-Komponente verarbeitet.",[231,376,378],{"id":377},"reverse-proxy","Reverse Proxy",[236,380,381,408,411,414],{},[239,382,383,384],{},"Der Reverse Proxy muss HTTP2 und WebSockets unterstützen. DBSync und das FiveNet-Plugin erfordern GRPC.\n",[236,385,386],{},[239,387,388,389,394,395,398,399,402,403,332],{},"Für ",[242,390,393],{"href":391,"rel":392},"https:\u002F\u002Fwww.nginx.com\u002F",[246],"NGINX"," stellen Sie sicher, dass ",[343,396,397],{},"http2"," in der ",[343,400,401],{},"listen","-Direktive aktiviert ist und verwenden Sie das ",[242,404,407],{"href":405,"rel":406},"https:\u002F\u002Fnginx.org\u002Fen\u002Fdocs\u002Fhttp\u002Fwebsocket.html",[246],"ausführliche WebSocket-Beispiel von hier",[239,409,410],{},"Es wird empfohlen, zwei Subdomains zu verwenden, eine für die FiveNet-Webanwendung und eine andere für den DBSync\u002FPlugin-GRPC-Verkehr.",[239,412,413],{},"Der Reverse Proxy muss HTTPS\u002FSSL terminieren, bevor der Datenverkehr an den FiveNet-Server gesendet wird.",[239,415,416,417],{},"Bekannte Reverse Proxies, die funktionieren, sind:\n",[236,418,419,424,431],{},[239,420,421],{},[242,422,393],{"href":391,"rel":423},[246],[239,425,426,332],{},[242,427,430],{"href":428,"rel":429},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002F",[246],"Traefik",[239,432,433],{},"Andere könnten funktionieren, wurden jedoch nicht getestet.",[231,435,437],{"id":436},"optionale-anforderungen","Optionale Anforderungen",[236,439,440],{},[239,441,442,443,447],{},"Tracing: OpenTelemetry-basiertes Tracing ist für die FiveNet-Server- und Worker-Komponenten verfügbar, siehe ",[242,444,446],{"href":445},"configuration\u002Fadvanced#tracing","Tracing"," unten. Tracing kann helfen, Leistungsprobleme zu diagnostizieren und das Systemverhalten zu überwachen.",{"title":449,"searchDepth":450,"depth":450,"links":451},"",2,[452,453,454,455,456,457],{"id":233,"depth":450,"text":234},{"id":270,"depth":450,"text":271},{"id":307,"depth":450,"text":308},{"id":335,"depth":450,"text":336},{"id":377,"depth":450,"text":378},{"id":436,"depth":450,"text":437},"md",null,{},true,"\u002Fde\u002Fgetting-started\u002Frequirements",{"title":215,"description":449},"de\u002F1.getting-started\u002F2.requirements","fs1fqRLJaqbeGegcIce8m7BzmLwVHi3I04h-pIlaakE",[467,471],{"title":16,"path":468,"stem":469,"description":470,"children":-1},"\u002Fde\u002Fgetting-started\u002Fdemo","de\u002F1.getting-started\u002F2.demo","Entdecken Sie die Funktionen von FiveNet mit unserer Demo-Instanz:",{"title":472,"path":473,"stem":474,"description":475,"children":-1},"Komponenten","\u002Fde\u002Fgetting-started\u002Fcomponents","de\u002F1.getting-started\u002F3.components","Diese Seite beschreibt die Komponenten von FiveNet und wie sie miteinander interagieren.",1788096963154]