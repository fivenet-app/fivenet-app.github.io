iler","de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":166,"path":167,"stem":168,"children":169},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[170,171,175],{"title":166,"path":167,"stem":168},{"title":172,"path":173,"stem":174},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":176,"stem":177},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":179,"path":180,"stem":181,"children":182},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[183],{"title":179,"path":180,"stem":181},{"id":185,"title":27,"body":186,"description":542,"extension":543,"links":544,"meta":545,"navigation":546,"path":28,"redirect":544,"seo":547,"stem":29,"__hash__":548},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md",{"type":187,"value":188,"toc":534},"minimark",[189,203,206,222,227,230,240,243,249,269,275,295,299,302,308,311,317,336,342,346,349,356,359,367,370,374,392,396,399,411,414,418,530],[190,191,192,193,197,198,202],"p",{},"FiveNet verwendet ",[194,195,196],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[199,200,201],"code",{},"1.2.3",".",[190,204,205],{},"In der Regel sehen Sie eine dieser beiden Formen:",[207,208,209,216],"ul",{},[210,211,212,213],"li",{},"Release-Version: ",[199,214,215],{},"v2026.3.1",[210,217,218,219],{},"Entwicklungs-Version: ",[199,220,221],{},"v2026.3.1-55-g07bf5c8e5",[223,224,226],"h2",{"id":225},"release-version","Release-Version",[190,228,229],{},"Eine vollständige Release-Version sieht so aus:",[231,232,238],"pre",{"className":233,"code":235,"language":236,"meta":237},[234],"language-text","v2026.3.1\n","text","",[199,239,235],{"__ignoreMap":237},[190,241,242],{},"Dieses Format ist:",[231,244,247],{"className":245,"code":246,"language":236,"meta":237},[234],"vYYYY.M.P\n",[199,248,246],{"__ignoreMap":237},[207,250,251,257,263],{},[210,252,253,256],{},[199,254,255],{},"YYYY"," = Veröffentlichungsjahr",[210,258,259,262],{},[199,260,261],{},"M"," = Veröffentlichungsmonat",[210,264,265,268],{},[199,266,267],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[190,270,271,272,274],{},"Im Beispiel ",[199,273,215],{}," bedeutet das:",[207,276,277,283,289],{},[210,278,279,282],{},[199,280,281],{},"2026"," steht für das Jahr 2026",[210,284,285,288],{},[199,286,287],{},"3"," steht für März",[210,290,291,294],{},[199,292,293],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[223,296,298],{"id":297},"entwicklungs-version","Entwicklungs-Version",[190,300,301],{},"Eine Entwicklungs-Version sieht so aus:",[231,303,306],{"className":304,"code":305,"language":236,"meta":237},[234],"v2026.3.1-55-g07bf5c8e5\n",[199,307,305],{"__ignoreMap":237},[190,309,310],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[231,312,315],{"className":313,"code":314,"language":236,"meta":237},[234],"vYYYY.M.P-COMMITS-gHASH\n",[199,316,314],{"__ignoreMap":237},[207,318,319,324,330],{},[210,320,321,323],{},[199,322,215],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[210,325,326,329],{},[199,327,328],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[210,331,332,335],{},[199,333,334],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[190,337,338,339,341],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[199,340,215],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[223,343,345],{"id":344},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[190,347,348],{},"Nicht unbedingt.",[190,350,351,352,355],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[194,353,354],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[190,357,358],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[207,360,361,364],{},[210,362,363],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[210,365,366],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[190,368,369],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[223,371,373],{"id":372},"kurze-beispiele","Kurze Beispiele",[207,375,376,381],{},[210,377,378,380],{},[199,379,215],{},"\nDas erste getaggte Release aus dem März 2026.",[210,382,383,385,386,388,389,202],{},[199,384,221],{},"\nEin Build 55 Commits nach ",[199,387,215],{},", basierend auf dem Commit ",[199,390,391],{},"07bf5c8e5",[223,393,395],{"id":394},"zusammenfassung","Zusammenfassung",[190,397,398],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[400,401,403],"callout",{"icon":402},"i-mdi-information-outline",[190,404,405,407,408,410],{},[199,406,215],{}," ist ein getaggtes Release, während ",[199,409,221],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[412,413],"hr",{},[223,415,417],{"id":416},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[419,420,421,460,494,512],"code-group",{},[231,422,427],{"className":423,"code":424,"filename":425,"language":426,"meta":237,"style":237},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[199,428,429,438],{"__ignoreMap":237},[430,431,434],"span",{"class":432,"line":433},"line",1,[430,435,437],{"class":436},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[430,439,441,445,449,452,455,457],{"class":432,"line":440},2,[430,442,444],{"class":443},"sBMFI","docker",[430,446,448],{"class":447},"sfazB"," compose",[430,450,451],{"class":447}," exec",[430,453,454],{"class":447}," fivenet",[430,456,454],{"class":447},[430,458,459],{"class":447}," --version\n",[231,461,464],{"className":423,"code":462,"filename":463,"language":426,"meta":237,"style":237},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[199,465,466,471,488],{"__ignoreMap":237},[430,467,468],{"class":432,"line":433},[430,469,470],{"class":436},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[430,472,473,476,478,481,484,486],{"class":432,"line":440},[430,474,475],{"class":443},"kubectl",[430,477,451],{"class":447},[430,479,480],{"class":447}," deployment\u002Ffivenet",[430,482,483],{"class":447}," --",[430,485,454],{"class":447},[430,487,459],{"class":447},[430,489,491],{"class":432,"line":490},3,[430,492,493],{"class":436},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[231,495,498],{"className":423,"code":496,"filename":497,"language":426,"meta":237,"style":237},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[199,499,500,505],{"__ignoreMap":237},[430,501,502],{"class":432,"line":433},[430,503,504],{"class":436},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[430,506,507,510],{"class":432,"line":440},[430,508,509],{"class":443},"fivenet",[430,511,459],{"class":447},[231,513,516],{"className":423,"code":514,"filename":515,"language":426,"meta":237,"style":237},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[199,517,518,523],{"__ignoreMap":237},[430,519,520],{"class":432,"line":433},[430,521,522],{"class":436},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[430,524,525,528],{"class":432,"line":440},[430,526,527],{"class":443},"fivenet.exe",[430,529,459],{"class":447},[531,532,533],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--s