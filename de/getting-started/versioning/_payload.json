ng-started\u002F3.versioning.md",{"type":203,"value":204,"toc":550},"minimark",[205,219,222,238,243,246,256,259,265,285,291,311,315,318,324,327,333,352,358,362,365,372,375,383,386,390,408,412,415,427,430,434,546],[206,207,208,209,213,214,218],"p",{},"FiveNet verwendet ",[210,211,212],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[215,216,217],"code",{},"1.2.3",".",[206,220,221],{},"In der Regel sehen Sie eine dieser beiden Formen:",[223,224,225,232],"ul",{},[226,227,228,229],"li",{},"Release-Version: ",[215,230,231],{},"v2026.3.1",[226,233,234,235],{},"Entwicklungs-Version: ",[215,236,237],{},"v2026.3.1-55-g07bf5c8e5",[239,240,242],"h2",{"id":241},"release-version","Release-Version",[206,244,245],{},"Eine vollständige Release-Version sieht so aus:",[247,248,254],"pre",{"className":249,"code":251,"language":252,"meta":253},[250],"language-text","v2026.3.1\n","text","",[215,255,251],{"__ignoreMap":253},[206,257,258],{},"Dieses Format ist:",[247,260,263],{"className":261,"code":262,"language":252,"meta":253},[250],"vYYYY.M.P\n",[215,264,262],{"__ignoreMap":253},[223,266,267,273,279],{},[226,268,269,272],{},[215,270,271],{},"YYYY"," = Veröffentlichungsjahr",[226,274,275,278],{},[215,276,277],{},"M"," = Veröffentlichungsmonat",[226,280,281,284],{},[215,282,283],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[206,286,287,288,290],{},"Im Beispiel ",[215,289,231],{}," bedeutet das:",[223,292,293,299,305],{},[226,294,295,298],{},[215,296,297],{},"2026"," steht für das Jahr 2026",[226,300,301,304],{},[215,302,303],{},"3"," steht für März",[226,306,307,310],{},[215,308,309],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[239,312,314],{"id":313},"entwicklungs-version","Entwicklungs-Version",[206,316,317],{},"Eine Entwicklungs-Version sieht so aus:",[247,319,322],{"className":320,"code":321,"language":252,"meta":253},[250],"v2026.3.1-55-g07bf5c8e5\n",[215,323,321],{"__ignoreMap":253},[206,325,326],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[247,328,331],{"className":329,"code":330,"language":252,"meta":253},[250],"vYYYY.M.P-COMMITS-gHASH\n",[215,332,330],{"__ignoreMap":253},[223,334,335,340,346],{},[226,336,337,339],{},[215,338,231],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[226,341,342,345],{},[215,343,344],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[226,347,348,351],{},[215,349,350],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[206,353,354,355,357],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[215,356,231],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[239,359,361],{"id":360},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[206,363,364],{},"Nicht unbedingt.",[206,366,367,368,371],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[210,369,370],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[206,373,374],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[223,376,377,380],{},[226,378,379],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[226,381,382],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[206,384,385],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[239,387,389],{"id":388},"kurze-beispiele","Kurze Beispiele",[223,391,392,397],{},[226,393,394,396],{},[215,395,231],{},"\nDas erste getaggte Release aus dem März 2026.",[226,398,399,401,402,404,405,218],{},[215,400,237],{},"\nEin Build 55 Commits nach ",[215,403,231],{},", basierend auf dem Commit ",[215,406,407],{},"07bf5c8e5",[239,409,411],{"id":410},"zusammenfassung","Zusammenfassung",[206,413,414],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[416,417,419],"callout",{"icon":418},"i-mdi-information-outline",[206,420,421,423,424,426],{},[215,422,231],{}," ist ein getaggtes Release, während ",[215,425,237],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[428,429],"hr",{},[239,431,433],{"id":432},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[435,436,437,476,510,528],"code-group",{},[247,438,443],{"className":439,"code":440,"filename":441,"language":442,"meta":253,"style":253},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[215,444,445,454],{"__ignoreMap":253},[446,447,450],"span",{"class":448,"line":449},"line",1,[446,451,453],{"class":452},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[446,455,457,461,465,468,471,473],{"class":448,"line":456},2,[446,458,460],{"class":459},"sBMFI","docker",[446,462,464],{"class":463},"sfazB"," compose",[446,466,467],{"class":463}," exec",[446,469,470],{"class":463}," fivenet",[446,472,470],{"class":463},[446,474,475],{"class":463}," --version\n",[247,477,480],{"className":439,"code":478,"filename":479,"language":442,"meta":253,"style":253},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[215,481,482,487,504],{"__ignoreMap":253},[446,483,484],{"class":448,"line":449},[446,485,486],{"class":452},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[446,488,489,492,494,497,500,502],{"class":448,"line":456},[446,490,491],{"class":459},"kubectl",[446,493,467],{"class":463},[446,495,496],{"class":463}," deployment\u002Ffivenet",[446,498,499],{"class":463}," --",[446,501,470],{"class":463},[446,503,475],{"class":463},[446,505,507],{"class":448,"line":506},3,[446,508,509],{"class":452},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[247,511,514],{"className":439,"code":512,"filename":513,"language":442,"meta":253,"style":253},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[215,515,516,521],{"__ignoreMap":253},[446,517,518],{"class":448,"line":449},[446,519,520],{"class":452},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[446,522,523,526],{"class":448,"line":456},[446,524,525],{"class":459},"fivenet",[446,527,475],{"class":463},[247,529,532],{"className":439,"code":530,"filename":531,"language":442,"meta":253,"style":253},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[215,533,534,539],{"__ignoreMap":253},[446,535,536],{"class":448,"line":449},[446,537,538],{"class":452},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[446,540,541,544],{"class":448,"line":456},[446,542,543],{"class":459},"fivenet.exe",[446,545,475],{"class":463},[547,548,549],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, ht