iler","3.user-guides\u002F6.mailer",{"title":167,"path":168,"stem":169},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":171,"path":172,"stem":173},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":175,"path":176,"stem":177},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":179,"path":180,"stem":181},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":183,"path":184,"stem":185,"children":186},"Development","\u002Fdevelopment","8.development\u002F1.index",[187,188,192,196,200],{"title":183,"path":184,"stem":185},{"title":189,"path":190,"stem":191},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":193,"path":194,"stem":195},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":197,"path":198,"stem":199},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":171,"path":201,"stem":202},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":204,"path":205,"stem":206,"children":207},"Design Docs","\u002Fdesign","9.design\u002F1.index",[208,210,214,218,221,225,229],{"title":209,"path":205,"stem":206},"Designs",{"title":211,"path":212,"stem":213},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":215,"path":216,"stem":217},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":159,"path":219,"stem":220},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":222,"path":223,"stem":224},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":226,"path":227,"stem":228},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":235,"body":236,"description":592,"extension":593,"links":594,"meta":595,"navigation":596,"path":597,"redirect":594,"seo":598,"stem":599,"__hash__":600},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md","Versionierung",{"type":237,"value":238,"toc":584},"minimark",[239,253,256,272,277,280,290,293,299,319,325,345,349,352,358,361,367,386,392,396,399,406,409,417,420,424,442,446,449,461,464,468,580],[240,241,242,243,247,248,252],"p",{},"FiveNet verwendet ",[244,245,246],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[249,250,251],"code",{},"1.2.3",".",[240,254,255],{},"In der Regel sehen Sie eine dieser beiden Formen:",[257,258,259,266],"ul",{},[260,261,262,263],"li",{},"Release-Version: ",[249,264,265],{},"v2026.3.1",[260,267,268,269],{},"Entwicklungs-Version: ",[249,270,271],{},"v2026.3.1-55-g07bf5c8e5",[273,274,276],"h2",{"id":275},"release-version","Release-Version",[240,278,279],{},"Eine vollständige Release-Version sieht so aus:",[281,282,288],"pre",{"className":283,"code":285,"language":286,"meta":287},[284],"language-text","v2026.3.1\n","text","",[249,289,285],{"__ignoreMap":287},[240,291,292],{},"Dieses Format ist:",[281,294,297],{"className":295,"code":296,"language":286,"meta":287},[284],"vYYYY.M.P\n",[249,298,296],{"__ignoreMap":287},[257,300,301,307,313],{},[260,302,303,306],{},[249,304,305],{},"YYYY"," = Veröffentlichungsjahr",[260,308,309,312],{},[249,310,311],{},"M"," = Veröffentlichungsmonat",[260,314,315,318],{},[249,316,317],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[240,320,321,322,324],{},"Im Beispiel ",[249,323,265],{}," bedeutet das:",[257,326,327,333,339],{},[260,328,329,332],{},[249,330,331],{},"2026"," steht für das Jahr 2026",[260,334,335,338],{},[249,336,337],{},"3"," steht für März",[260,340,341,344],{},[249,342,343],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[273,346,348],{"id":347},"entwicklungs-version","Entwicklungs-Version",[240,350,351],{},"Eine Entwicklungs-Version sieht so aus:",[281,353,356],{"className":354,"code":355,"language":286,"meta":287},[284],"v2026.3.1-55-g07bf5c8e5\n",[249,357,355],{"__ignoreMap":287},[240,359,360],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[281,362,365],{"className":363,"code":364,"language":286,"meta":287},[284],"vYYYY.M.P-COMMITS-gHASH\n",[249,366,364],{"__ignoreMap":287},[257,368,369,374,380],{},[260,370,371,373],{},[249,372,265],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[260,375,376,379],{},[249,377,378],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[260,381,382,385],{},[249,383,384],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[240,387,388,389,391],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[249,390,265],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[273,393,395],{"id":394},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[240,397,398],{},"Nicht unbedingt.",[240,400,401,402,405],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[244,403,404],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[240,407,408],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[257,410,411,414],{},[260,412,413],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[260,415,416],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[240,418,419],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[273,421,423],{"id":422},"kurze-beispiele","Kurze Beispiele",[257,425,426,431],{},[260,427,428,430],{},[249,429,265],{},"\nDas erste getaggte Release aus dem März 2026.",[260,432,433,435,436,438,439,252],{},[249,434,271],{},"\nEin Build 55 Commits nach ",[249,437,265],{},", basierend auf dem Commit ",[249,440,441],{},"07bf5c8e5",[273,443,445],{"id":444},"zusammenfassung","Zusammenfassung",[240,447,448],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[450,451,453],"callout",{"icon":452},"i-mdi-information-outline",[240,454,455,457,458,460],{},[249,456,265],{}," ist ein getaggtes Release, während ",[249,459,271],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[462,463],"hr",{},[273,465,467],{"id":466},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[469,470,471,510,544,562],"code-group",{},[281,472,477],{"className":473,"code":474,"filename":475,"language":476,"meta":287,"style":287},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[249,478,479,488],{"__ignoreMap":287},[480,481,484],"span",{"class":482,"line":483},"line",1,[480,485,487],{"class":486},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[480,489,491,495,499,502,505,507],{"class":482,"line":490},2,[480,492,494],{"class":493},"sBMFI","docker",[480,496,498],{"class":497},"sfazB"," compose",[480,500,501],{"class":497}," exec",[480,503,504],{"class":497}," fivenet",[480,506,504],{"class":497},[480,508,509],{"class":497}," --version\n",[281,511,514],{"className":473,"code":512,"filename":513,"language":476,"meta":287,"style":287},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[249,515,516,521,538],{"__ignoreMap":287},[480,517,518],{"class":482,"line":483},[480,519,520],{"class":486},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[480,522,523,526,528,531,534,536],{"class":482,"line":490},[480,524,525],{"class":493},"kubectl",[480,527,501],{"class":497},[480,529,530],{"class":497}," deployment\u002Ffivenet",[480,532,533],{"class":497}," --",[480,535,504],{"class":497},[480,537,509],{"class":497},[480,539,541],{"class":482,"line":540},3,[480,542,543],{"class":486},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[281,545,548],{"className":473,"code":546,"filename":547,"language":476,"meta":287,"style":287},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[249,549,550,555],{"__ignoreMap":287},[480,551,552],{"class":482,"line":483},[480,553,554],{"class":486},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[480,556,557,560],{"class":482,"line":490},[480,558,559],{"class":493},"fivenet",[480,561,509],{"class":497},[281,563,566],{"className":473,"code":564,"filename":565,"language":476,"meta":287,"style":287},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[249,567,568,573],{"__ignoreMap":287},[480,569,570],{"class":482,"line":483},[480,571,572],{"class":486},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[480,574,575,578],{"class":482,"line":490},[4