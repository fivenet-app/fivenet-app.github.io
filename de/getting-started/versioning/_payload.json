220,"path":216,"stem":217},"Designs",{"title":222,"path":223,"stem":224},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":226,"path":227,"stem":228},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":170,"path":230,"stem":231},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":233,"path":234,"stem":235},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":237,"path":238,"stem":239},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":241,"path":242,"stem":243},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":245,"title":246,"body":247,"description":603,"extension":604,"links":605,"meta":606,"navigation":607,"path":608,"redirect":605,"seo":609,"stem":610,"__hash__":611},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md","Versionierung",{"type":248,"value":249,"toc":595},"minimark",[250,264,267,283,288,291,301,304,310,330,336,356,360,363,369,372,378,397,403,407,410,417,420,428,431,435,453,457,460,472,475,479,591],[251,252,253,254,258,259,263],"p",{},"FiveNet verwendet ",[255,256,257],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[260,261,262],"code",{},"1.2.3",".",[251,265,266],{},"In der Regel sehen Sie eine dieser beiden Formen:",[268,269,270,277],"ul",{},[271,272,273,274],"li",{},"Release-Version: ",[260,275,276],{},"v2026.3.1",[271,278,279,280],{},"Entwicklungs-Version: ",[260,281,282],{},"v2026.3.1-55-g07bf5c8e5",[284,285,287],"h2",{"id":286},"release-version","Release-Version",[251,289,290],{},"Eine vollständige Release-Version sieht so aus:",[292,293,299],"pre",{"className":294,"code":296,"language":297,"meta":298},[295],"language-text","v2026.3.1\n","text","",[260,300,296],{"__ignoreMap":298},[251,302,303],{},"Dieses Format ist:",[292,305,308],{"className":306,"code":307,"language":297,"meta":298},[295],"vYYYY.M.P\n",[260,309,307],{"__ignoreMap":298},[268,311,312,318,324],{},[271,313,314,317],{},[260,315,316],{},"YYYY"," = Veröffentlichungsjahr",[271,319,320,323],{},[260,321,322],{},"M"," = Veröffentlichungsmonat",[271,325,326,329],{},[260,327,328],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[251,331,332,333,335],{},"Im Beispiel ",[260,334,276],{}," bedeutet das:",[268,337,338,344,350],{},[271,339,340,343],{},[260,341,342],{},"2026"," steht für das Jahr 2026",[271,345,346,349],{},[260,347,348],{},"3"," steht für März",[271,351,352,355],{},[260,353,354],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[284,357,359],{"id":358},"entwicklungs-version","Entwicklungs-Version",[251,361,362],{},"Eine Entwicklungs-Version sieht so aus:",[292,364,367],{"className":365,"code":366,"language":297,"meta":298},[295],"v2026.3.1-55-g07bf5c8e5\n",[260,368,366],{"__ignoreMap":298},[251,370,371],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[292,373,376],{"className":374,"code":375,"language":297,"meta":298},[295],"vYYYY.M.P-COMMITS-gHASH\n",[260,377,375],{"__ignoreMap":298},[268,379,380,385,391],{},[271,381,382,384],{},[260,383,276],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[271,386,387,390],{},[260,388,389],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[271,392,393,396],{},[260,394,395],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[251,398,399,400,402],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[260,401,276],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[284,404,406],{"id":405},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[251,408,409],{},"Nicht unbedingt.",[251,411,412,413,416],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[255,414,415],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[251,418,419],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[268,421,422,425],{},[271,423,424],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[271,426,427],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[251,429,430],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[284,432,434],{"id":433},"kurze-beispiele","Kurze Beispiele",[268,436,437,442],{},[271,438,439,441],{},[260,440,276],{},"\nDas erste getaggte Release aus dem März 2026.",[271,443,444,446,447,449,450,263],{},[260,445,282],{},"\nEin Build 55 Commits nach ",[260,448,276],{},", basierend auf dem Commit ",[260,451,452],{},"07bf5c8e5",[284,454,456],{"id":455},"zusammenfassung","Zusammenfassung",[251,458,459],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[461,462,464],"callout",{"icon":463},"i-mdi-information-outline",[251,465,466,468,469,471],{},[260,467,276],{}," ist ein getaggtes Release, während ",[260,470,282],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[473,474],"hr",{},[284,476,478],{"id":477},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[480,481,482,521,555,573],"code-group",{},[292,483,488],{"className":484,"code":485,"filename":486,"language":487,"meta":298,"style":298},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[260,489,490,499],{"__ignoreMap":298},[491,492,495],"span",{"class":493,"line":494},"line",1,[491,496,498],{"class":497},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[491,500,502,506,510,513,516,518],{"class":493,"line":501},2,[491,503,505],{"class":504},"sBMFI","docker",[491,507,509],{"class":508},"sfazB"," compose",[491,511,512],{"class":508}," exec",[491,514,515],{"class":508}," fivenet",[491,517,515],{"class":508},[491,519,520],{"class":508}," --version\n",[292,522,525],{"className":484,"code":523,"filename":524,"language":487,"meta":298,"style":298},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[260,526,527,532,549],{"__ignoreMap":298},[491,528,529],{"class":493,"line":494},[491,530,531],{"class":497},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[491,533,534,537,539,542,545,547],{"class":493,"line":501},[491,535,536],{"class":504},"kubectl",[491,538,512],{"class":508},[491,540,541],{"class":508}," deployment\u002Ffivenet",[491,543,544],{"class":508}," --",[491,546,515],{"class":508},[491,548,520],{"class":508},[491,550,552],{"class":493,"line":551},3,[491,553,554],{"class":497},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[292,556,559],{"className":484,"code":557,"filename":558,"language":487,"meta":298,"style":298},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[260,560,561,566],{"__ignoreMap":298},[491,562,563],{"class":493,"line":494},[491,564,565],{"class":497},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[491,567,568,571],{"class":493,"line":501},[491,569,570],{"class":504},"fivenet",[491,572,520],{"class":508},[292,574,577],{"className":484,"code":575,"filename":576,"language":487,"meta":298,"style":298},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[260,578,579,584],{"__ignoreMap":298},[491,580,581],{"class":493,"line":494},[491,582,583],{"class":497},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[491,585,586,589],{"class":493,"line":501},[491,587,588],{"class":504},"fivenet.exe",[491,590,520],{"class":508},[592,593,594],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki