elopment","\u002Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":219,"body":220,"description":576,"extension":577,"links":578,"meta":579,"navigation":580,"path":581,"redirect":578,"seo":582,"stem":583,"__hash__":584},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md","Versionierung",{"type":221,"value":222,"toc":568},"minimark",[223,237,240,256,261,264,274,277,283,303,309,329,333,336,342,345,351,370,376,380,383,390,393,401,404,408,426,430,433,445,448,452,564],[224,225,226,227,231,232,236],"p",{},"FiveNet verwendet ",[228,229,230],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[233,234,235],"code",{},"1.2.3",".",[224,238,239],{},"In der Regel sehen Sie eine dieser beiden Formen:",[241,242,243,250],"ul",{},[244,245,246,247],"li",{},"Release-Version: ",[233,248,249],{},"v2026.3.1",[244,251,252,253],{},"Entwicklungs-Version: ",[233,254,255],{},"v2026.3.1-55-g07bf5c8e5",[257,258,260],"h2",{"id":259},"release-version","Release-Version",[224,262,263],{},"Eine vollständige Release-Version sieht so aus:",[265,266,272],"pre",{"className":267,"code":269,"language":270,"meta":271},[268],"language-text","v2026.3.1\n","text","",[233,273,269],{"__ignoreMap":271},[224,275,276],{},"Dieses Format ist:",[265,278,281],{"className":279,"code":280,"language":270,"meta":271},[268],"vYYYY.M.P\n",[233,282,280],{"__ignoreMap":271},[241,284,285,291,297],{},[244,286,287,290],{},[233,288,289],{},"YYYY"," = Veröffentlichungsjahr",[244,292,293,296],{},[233,294,295],{},"M"," = Veröffentlichungsmonat",[244,298,299,302],{},[233,300,301],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[224,304,305,306,308],{},"Im Beispiel ",[233,307,249],{}," bedeutet das:",[241,310,311,317,323],{},[244,312,313,316],{},[233,314,315],{},"2026"," steht für das Jahr 2026",[244,318,319,322],{},[233,320,321],{},"3"," steht für März",[244,324,325,328],{},[233,326,327],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[257,330,332],{"id":331},"entwicklungs-version","Entwicklungs-Version",[224,334,335],{},"Eine Entwicklungs-Version sieht so aus:",[265,337,340],{"className":338,"code":339,"language":270,"meta":271},[268],"v2026.3.1-55-g07bf5c8e5\n",[233,341,339],{"__ignoreMap":271},[224,343,344],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[265,346,349],{"className":347,"code":348,"language":270,"meta":271},[268],"vYYYY.M.P-COMMITS-gHASH\n",[233,350,348],{"__ignoreMap":271},[241,352,353,358,364],{},[244,354,355,357],{},[233,356,249],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[244,359,360,363],{},[233,361,362],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[244,365,366,369],{},[233,367,368],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[224,371,372,373,375],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[233,374,249],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[257,377,379],{"id":378},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[224,381,382],{},"Nicht unbedingt.",[224,384,385,386,389],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[228,387,388],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[224,391,392],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[241,394,395,398],{},[244,396,397],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[244,399,400],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[224,402,403],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[257,405,407],{"id":406},"kurze-beispiele","Kurze Beispiele",[241,409,410,415],{},[244,411,412,414],{},[233,413,249],{},"\nDas erste getaggte Release aus dem März 2026.",[244,416,417,419,420,422,423,236],{},[233,418,255],{},"\nEin Build 55 Commits nach ",[233,421,249],{},", basierend auf dem Commit ",[233,424,425],{},"07bf5c8e5",[257,427,429],{"id":428},"zusammenfassung","Zusammenfassung",[224,431,432],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[434,435,437],"callout",{"icon":436},"i-mdi-information-outline",[224,438,439,441,442,444],{},[233,440,249],{}," ist ein getaggtes Release, während ",[233,443,255],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[446,447],"hr",{},[257,449,451],{"id":450},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[453,454,455,494,528,546],"code-group",{},[265,456,461],{"className":457,"code":458,"filename":459,"language":460,"meta":271,"style":271},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[233,462,463,472],{"__ignoreMap":271},[464,465,468],"span",{"class":466,"line":467},"line",1,[464,469,471],{"class":470},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[464,473,475,479,483,486,489,491],{"class":466,"line":474},2,[464,476,478],{"class":477},"sBMFI","docker",[464,480,482],{"class":481},"sfazB"," compose",[464,484,485],{"class":481}," exec",[464,487,488],{"class":481}," fivenet",[464,490,488],{"class":481},[464,492,493],{"class":481}," --version\n",[265,495,498],{"className":457,"code":496,"filename":497,"language":460,"meta":271,"style":271},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[233,499,500,505,522],{"__ignoreMap":271},[464,501,502],{"class":466,"line":467},[464,503,504],{"class":470},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[464,506,507,510,512,515,518,520],{"class":466,"line":474},[464,508,509],{"class":477},"kubectl",[464,511,485],{"class":481},[464,513,514],{"class":481}," deployment\u002Ffivenet",[464,516,517],{"class":481}," --",[464,519,488],{"class":481},[464,521,493],{"class":481},[464,523,525],{"class":466,"line":524},3,[464,526,527],{"class":470},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[265,529,532],{"className":457,"code":530,"filename":531,"language":460,"meta":271,"style":271},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[233,533,534,539],{"__ignoreMap":271},[464,535,536],{"class":466,"line":467},[464,537,538],{"class":470},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[464,540,541,544],{"class":466,"line":474},[464,542,543],{"class":477},"fivenet",[464,545,493],{"class":481},[265,547,550],{"className":457,"code":548,"filename":549,"language":460,"meta":271,"style":271},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[233,551,552,557],{"__ignoreMap":271},[464,553,554],{"class":466,"line":467},[464,555,556],{"class":470},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[464,558,559,562],{"class":466,"line":474},[464,560,561],{"class":477},"fivenet.exe",[464,563,493],{"class":481},[565,566,567],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki spa