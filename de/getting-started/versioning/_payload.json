","de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164,"children":165},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[166,167,171],{"title":162,"path":163,"stem":164},{"title":168,"path":169,"stem":170},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":172,"stem":173},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":175,"path":176,"stem":177,"children":178},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[179],{"title":175,"path":176,"stem":177},{"id":181,"title":27,"body":182,"description":538,"extension":539,"links":540,"meta":541,"navigation":542,"path":28,"redirect":540,"seo":543,"stem":29,"__hash__":544},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md",{"type":183,"value":184,"toc":530},"minimark",[185,199,202,218,223,226,236,239,245,265,271,291,295,298,304,307,313,332,338,342,345,352,355,363,366,370,388,392,395,407,410,414,526],[186,187,188,189,193,194,198],"p",{},"FiveNet verwendet ",[190,191,192],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[195,196,197],"code",{},"1.2.3",".",[186,200,201],{},"In der Regel sehen Sie eine dieser beiden Formen:",[203,204,205,212],"ul",{},[206,207,208,209],"li",{},"Release-Version: ",[195,210,211],{},"v2026.3.1",[206,213,214,215],{},"Entwicklungs-Version: ",[195,216,217],{},"v2026.3.1-55-g07bf5c8e5",[219,220,222],"h2",{"id":221},"release-version","Release-Version",[186,224,225],{},"Eine vollständige Release-Version sieht so aus:",[227,228,234],"pre",{"className":229,"code":231,"language":232,"meta":233},[230],"language-text","v2026.3.1\n","text","",[195,235,231],{"__ignoreMap":233},[186,237,238],{},"Dieses Format ist:",[227,240,243],{"className":241,"code":242,"language":232,"meta":233},[230],"vYYYY.M.P\n",[195,244,242],{"__ignoreMap":233},[203,246,247,253,259],{},[206,248,249,252],{},[195,250,251],{},"YYYY"," = Veröffentlichungsjahr",[206,254,255,258],{},[195,256,257],{},"M"," = Veröffentlichungsmonat",[206,260,261,264],{},[195,262,263],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[186,266,267,268,270],{},"Im Beispiel ",[195,269,211],{}," bedeutet das:",[203,272,273,279,285],{},[206,274,275,278],{},[195,276,277],{},"2026"," steht für das Jahr 2026",[206,280,281,284],{},[195,282,283],{},"3"," steht für März",[206,286,287,290],{},[195,288,289],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[219,292,294],{"id":293},"entwicklungs-version","Entwicklungs-Version",[186,296,297],{},"Eine Entwicklungs-Version sieht so aus:",[227,299,302],{"className":300,"code":301,"language":232,"meta":233},[230],"v2026.3.1-55-g07bf5c8e5\n",[195,303,301],{"__ignoreMap":233},[186,305,306],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[227,308,311],{"className":309,"code":310,"language":232,"meta":233},[230],"vYYYY.M.P-COMMITS-gHASH\n",[195,312,310],{"__ignoreMap":233},[203,314,315,320,326],{},[206,316,317,319],{},[195,318,211],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[206,321,322,325],{},[195,323,324],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[206,327,328,331],{},[195,329,330],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[186,333,334,335,337],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[195,336,211],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[219,339,341],{"id":340},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[186,343,344],{},"Nicht unbedingt.",[186,346,347,348,351],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[190,349,350],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[186,353,354],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[203,356,357,360],{},[206,358,359],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[206,361,362],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[186,364,365],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[219,367,369],{"id":368},"kurze-beispiele","Kurze Beispiele",[203,371,372,377],{},[206,373,374,376],{},[195,375,211],{},"\nDas erste getaggte Release aus dem März 2026.",[206,378,379,381,382,384,385,198],{},[195,380,217],{},"\nEin Build 55 Commits nach ",[195,383,211],{},", basierend auf dem Commit ",[195,386,387],{},"07bf5c8e5",[219,389,391],{"id":390},"zusammenfassung","Zusammenfassung",[186,393,394],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[396,397,399],"callout",{"icon":398},"i-mdi-information-outline",[186,400,401,403,404,406],{},[195,402,211],{}," ist ein getaggtes Release, während ",[195,405,217],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[408,409],"hr",{},[219,411,413],{"id":412},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[415,416,417,456,490,508],"code-group",{},[227,418,423],{"className":419,"code":420,"filename":421,"language":422,"meta":233,"style":233},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[195,424,425,434],{"__ignoreMap":233},[426,427,430],"span",{"class":428,"line":429},"line",1,[426,431,433],{"class":432},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[426,435,437,441,445,448,451,453],{"class":428,"line":436},2,[426,438,440],{"class":439},"sBMFI","docker",[426,442,444],{"class":443},"sfazB"," compose",[426,446,447],{"class":443}," exec",[426,449,450],{"class":443}," fivenet",[426,452,450],{"class":443},[426,454,455],{"class":443}," --version\n",[227,457,460],{"className":419,"code":458,"filename":459,"language":422,"meta":233,"style":233},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[195,461,462,467,484],{"__ignoreMap":233},[426,463,464],{"class":428,"line":429},[426,465,466],{"class":432},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[426,468,469,472,474,477,480,482],{"class":428,"line":436},[426,470,471],{"class":439},"kubectl",[426,473,447],{"class":443},[426,475,476],{"class":443}," deployment\u002Ffivenet",[426,478,479],{"class":443}," --",[426,481,450],{"class":443},[426,483,455],{"class":443},[426,485,487],{"class":428,"line":486},3,[426,488,489],{"class":432},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[227,491,494],{"className":419,"code":492,"filename":493,"language":422,"meta":233,"style":233},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[195,495,496,501],{"__ignoreMap":233},[426,497,498],{"class":428,"line":429},[426,499,500],{"class":432},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[426,502,503,506],{"class":428,"line":436},[426,504,505],{"class":439},"fivenet",[426,507,455],{"class":443},[227,509,512],{"className":419,"code":510,"filename":511,"language":422,"meta":233,"style":233},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[195,513,514,519],{"__ignoreMap":233},[426,515,516],{"class":428,"line":429},[426,517,518],{"class":432},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[426,520,521,524],{"class":428,"line":436},[426,522,523],{"class":439},"fivenet.exe",[426,525,455],{"class":443},[527,528,529],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-sty