em":171},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":173,"path":174,"stem":175},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":177,"path":178,"stem":179},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":181,"stem":182},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":184,"path":185,"stem":186,"children":187},"Design Docs","\u002Fdesign","9.design\u002F1.index",[188,190,194,198,201,205,209],{"title":189,"path":185,"stem":186},"Designs",{"title":191,"path":192,"stem":193},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":195,"path":196,"stem":197},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":199,"stem":200},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":202,"path":203,"stem":204},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":206,"path":207,"stem":208},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":210,"path":211,"stem":212},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":214,"title":215,"body":216,"description":572,"extension":573,"links":574,"meta":575,"navigation":576,"path":577,"redirect":574,"seo":578,"stem":579,"__hash__":580},"content_de\u002Fde\u002F1.getting-started\u002F3.versioning.md","Versionierung",{"type":217,"value":218,"toc":564},"minimark",[219,233,236,252,257,260,270,273,279,299,305,325,329,332,338,341,347,366,372,376,379,386,389,397,400,404,422,426,429,441,444,448,560],[220,221,222,223,227,228,232],"p",{},"FiveNet verwendet ",[224,225,226],"strong",{},"CalVer"," als Versionsschema. Das bedeutet, dass die Versionsnummer auf dem Veröffentlichungsdatum basiert und nicht auf einer klassischen semantischen Version wie ",[229,230,231],"code",{},"1.2.3",".",[220,234,235],{},"In der Regel sehen Sie eine dieser beiden Formen:",[237,238,239,246],"ul",{},[240,241,242,243],"li",{},"Release-Version: ",[229,244,245],{},"v2026.3.1",[240,247,248,249],{},"Entwicklungs-Version: ",[229,250,251],{},"v2026.3.1-55-g07bf5c8e5",[253,254,256],"h2",{"id":255},"release-version","Release-Version",[220,258,259],{},"Eine vollständige Release-Version sieht so aus:",[261,262,268],"pre",{"className":263,"code":265,"language":266,"meta":267},[264],"language-text","v2026.3.1\n","text","",[229,269,265],{"__ignoreMap":267},[220,271,272],{},"Dieses Format ist:",[261,274,277],{"className":275,"code":276,"language":266,"meta":267},[264],"vYYYY.M.P\n",[229,278,276],{"__ignoreMap":267},[237,280,281,287,293],{},[240,282,283,286],{},[229,284,285],{},"YYYY"," = Veröffentlichungsjahr",[240,288,289,292],{},[229,290,291],{},"M"," = Veröffentlichungsmonat",[240,294,295,298],{},[229,296,297],{},"P"," = Patch- oder Revisionsnummer für diesen Monat",[220,300,301,302,304],{},"Im Beispiel ",[229,303,245],{}," bedeutet das:",[237,306,307,313,319],{},[240,308,309,312],{},[229,310,311],{},"2026"," steht für das Jahr 2026",[240,314,315,318],{},[229,316,317],{},"3"," steht für März",[240,320,321,324],{},[229,322,323],{},"1"," steht für das erste veröffentlichte Release in diesem Monat",[253,326,328],{"id":327},"entwicklungs-version","Entwicklungs-Version",[220,330,331],{},"Eine Entwicklungs-Version sieht so aus:",[261,333,336],{"className":334,"code":335,"language":266,"meta":267},[264],"v2026.3.1-55-g07bf5c8e5\n",[229,337,335],{"__ignoreMap":267},[220,339,340],{},"Sie basiert auf derselben Release-Version, enthält aber zusätzlich angehängte Git-Metadaten:",[261,342,345],{"className":343,"code":344,"language":266,"meta":267},[264],"vYYYY.M.P-COMMITS-gHASH\n",[229,346,344],{"__ignoreMap":267},[237,348,349,354,360],{},[240,350,351,353],{},[229,352,245],{}," = das nächstgelegene Release-Tag, auf dem der Build basiert",[240,355,356,359],{},[229,357,358],{},"55"," = der Build enthält 55 Commits nach diesem Tag",[240,361,362,365],{},[229,363,364],{},"g07bf5c8e5"," = der kurze Git-Commit-Hash der exakten Quellcode-Revision",[220,367,368,369,371],{},"Praktisch bedeutet das, dass der Build aus Code erstellt wurde, der neuer ist als das Release ",[229,370,245],{},", aber noch nicht als nächstes vollständiges Release veröffentlicht wurde.",[253,373,375],{"id":374},"bedeutet-dev-automatisch-instabil","Bedeutet \"Dev\" automatisch instabil?",[220,377,378],{},"Nicht unbedingt.",[220,380,381,382,385],{},"Eine Entwicklungs-Version bedeutet lediglich, dass der Build aus einem Commit zwischen zwei getaggten Releases erstellt wurde. Das bedeutet ",[224,383,384],{},"nicht"," automatisch, dass der Build kaputt, unsicher oder für den Produktionseinsatz ungeeignet ist.",[220,387,388],{},"Der Hauptunterschied liegt in der Versionskennzeichnung:",[237,390,391,394],{},[240,392,393],{},"Eine Release-Version ist ein getaggtes, vollständiges Release.",[240,395,396],{},"Eine Entwicklungs-Version ist ein Build von einem bestimmten Git-Commit nach dem letzten getaggten Release.",[220,398,399],{},"Da der Commit-Hash enthalten ist, lassen sich Entwicklungs-Versionen oft sogar leichter auf den exakten Quellcode zurückführen.",[253,401,403],{"id":402},"kurze-beispiele","Kurze Beispiele",[237,405,406,411],{},[240,407,408,410],{},[229,409,245],{},"\nDas erste getaggte Release aus dem März 2026.",[240,412,413,415,416,418,419,232],{},[229,414,251],{},"\nEin Build 55 Commits nach ",[229,417,245],{},", basierend auf dem Commit ",[229,420,421],{},"07bf5c8e5",[253,423,425],{"id":424},"zusammenfassung","Zusammenfassung",[220,427,428],{},"Wenn Sie sich nur eine Sache merken, dann diese:",[430,431,433],"callout",{"icon":432},"i-mdi-information-outline",[220,434,435,437,438,440],{},[229,436,245],{}," ist ein getaggtes Release, während ",[229,439,251],{}," ein neuerer Build von einem bestimmten Git-Commit nach diesem Release ist. Eine Entwicklungs-Version ist nicht automatisch instabil.",[442,443],"hr",{},[253,445,447],{"id":446},"so-prüfen-sie-ihre-version","So prüfen Sie Ihre Version",[449,450,451,490,524,542],"code-group",{},[261,452,457],{"className":453,"code":454,"filename":455,"language":456,"meta":267,"style":267},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[229,458,459,468],{"__ignoreMap":267},[460,461,464],"span",{"class":462,"line":463},"line",1,[460,465,467],{"class":466},"sHwdD","# Setzt voraus, dass Sie sich im Verzeichnis mit Ihrer docker-compose.yml \u002F docker-compose.yaml befinden\n",[460,469,471,475,479,482,485,487],{"class":462,"line":470},2,[460,472,474],{"class":473},"sBMFI","docker",[460,476,478],{"class":477},"sfazB"," compose",[460,480,481],{"class":477}," exec",[460,483,484],{"class":477}," fivenet",[460,486,484],{"class":477},[460,488,489],{"class":477}," --version\n",[261,491,494],{"className":453,"code":492,"filename":493,"language":456,"meta":267,"style":267},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n","Kubernetes",[229,495,496,501,518],{"__ignoreMap":267},[460,497,498],{"class":462,"line":463},[460,499,500],{"class":466},"# Setzt voraus, dass FiveNet mit Helm bereitgestellt wurde und kubectl mit Ihrem Cluster sowie dem FiveNet-App-Namespace verbunden ist\n",[460,502,503,506,508,511,514,516],{"class":462,"line":470},[460,504,505],{"class":473},"kubectl",[460,507,481],{"class":477},[460,509,510],{"class":477}," deployment\u002Ffivenet",[460,512,513],{"class":477}," --",[460,515,484],{"class":477},[460,517,489],{"class":477},[460,519,521],{"class":462,"line":520},3,[460,522,523],{"class":466},"# Pruefen Sie zusaetzlich den in Ihren Helm-Values verwendeten image.tag, um zu sehen, welche Image-Version aktuell genutzt wird\n",[261,525,528],{"className":453,"code":526,"filename":527,"language":456,"meta":267,"style":267},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\nfivenet --version\n","Binary (Linux)",[229,529,530,535],{"__ignoreMap":267},[460,531,532],{"class":462,"line":463},[460,533,534],{"class":466},"# Setzt voraus, dass sich das fivenet-Binary in Ihrem PATH befindet\n",[460,536,537,540],{"class":462,"line":470},[460,538,539],{"class":473},"fivenet",[460,541,489],{"class":477},[261,543,546],{"className":453,"code":544,"filename":545,"language":456,"meta":267,"style":267},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\nfivenet.exe --version\n","Binary (Windows)",[229,547,548,553],{"__ignoreMap":267},[460,549,550],{"class":462,"line":463},[460,551,552],{"class":466},"# Setzt voraus, dass sich die fivenet.exe in Ihrem PATH befindet\n",[460,554,555,558],{"class":462,"line":470},[460,556,557],{"class":473},"fivenet.exe",[460,559,489],{"class":477},[561,562,563],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-wei