u002F3.documents\u002Findex.md",{"type":203,"value":204,"toc":274},"minimark",[205,213,217,220],[206,207,208],"p",{},[209,210],"img",{"alt":211,"src":212},"Feature Dokumente","\u002Fimages\u002Fscreenshots\u002Ffeatures-documents.webp",[214,215,11],"h2",{"id":216},"funktionen",[206,218,219],{},"Die Dokumentenfunktion hilft dabei, Dokumente effizient zu verwalten und zu organisieren. Wichtige Funktionen sind:",[221,222,223,235,238,241,252,263],"ul",{},[224,225,226,227],"li",{},"Suchen und Filtern von Dokumenten basierend auf verschiedenen Kriterien:",[221,228,229,232],{},[224,230,231],{},"Suche nach Dokumentname, Kategorie oder Status.",[224,233,234],{},"Die Dokumentaktivität zeigt die Änderungshistorie an.",[224,236,237],{},"Erstellen, Bearbeiten und Löschen von Dokumenten.",[224,239,240],{},"Hinzufügen von Kommentaren zu Dokumenten.",[224,242,243,244],{},"Dokumentvorlagen mit Anforderungen für Bürger, Fahrzeuge und Dokumente:",[221,245,246,249],{},[224,247,248],{},"Vorlagen erstellen und verwalten.",[224,250,251],{},"Anforderungen für verknüpfte Entitäten definieren, damit Vorlagen mehr als statische Textblöcke sind.",[224,253,254,255],{},"Dokumentkategorien für eine bessere Organisation:",[221,256,257,260],{},[224,258,259],{},"Kategorien erstellen und verwalten.",[224,261,262],{},"Dokumente bestimmten Kategorien zuweisen.",[224,264,265,266],{},"Verknüpfen von Dokumenten mit Bürgern und Referenzieren anderer Dokumente innerhalb des Systems:",[221,267,268,271],{},[224,269,270],{},"Verknüpfungen zwischen Entitäten für besseren Kontext.",[224,272,273],{},"Referenzen auf andere Dokumente innerhalb des Systems.",{"title":275,"searchDepth":276,"depth":276,"links":277},"",2,[278],{"id":216,"depth":276,"text":11},"md",null,{},true,{"title":136,"description":275},"So8j-nN4nQ3sdPEL9lwuKIj4R-I54UZyMvafN9zbuHE",[286,287],{"title":132,"path":133,"stem":134,"description":275,"children":-1},{"title":142,"path":143,"stem":144,"description":288,"children":-1},"Vorlagen machen die Dokumenterstellung schneller und einheitlicher.\nIn FiveNet verwenden Vorlagen HTML plus Golang-Templating, um dynamische Daten einzufügen.",1789078108294]