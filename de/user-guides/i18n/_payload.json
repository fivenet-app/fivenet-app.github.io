,332,333],{},"Nach Synchronisierung und Release ist die neue Sprache in der Anwendung verfügbar.",[243,335,336],{},"Bei Problemen erstellen Sie bitte ein GitHub-Issue oder fragen Sie auf dem FiveNet-Discord-Server nach.",[259,338],{},[340,341,345,353],"card",{"target":342,"title":343,"to":344},"_blank","FiveNet nutzt POEditor für Übersetzungen","https:\u002F\u002Fpoeditor.com\u002F",[224,346,347,348,352],{},"Vielen Dank an ",[253,349,351],{"href":344,"rel":350},[271],"POEditor"," für die Bereitstellung eines kostenlosen Übersetzungsprojekts für das FiveNet Projekt!",[224,354,355],{},[230,356],{"alt":357,"src":358,":width":359,":zoom":360,"align":361},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":363,"searchDepth":364,"depth":364,"links":365},"",2,[366,367],{"id":237,"depth":364,"text":238},{"id":263,"depth":364,"text":256,"children":368},[369],{"id":277,"depth":370,"text":278},3,"md",null,{},true,"\u002Fde\u002Fuser-guides\u002Fi18n",{"title":219,"description":226},"de\u002F3.user-guides\u002F8.i18n","g4_ztQLOBj0Sv39F4bOPbgoIRiF65c9Gu-ZsEL1hUF8",[380,385],{"title":381,"path":382,"stem":383,"description":384,"children":-1},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings","Erfahren Sie, wie Sie Einstellungen in FiveNet konfigurieren und verwalten, einschließlich Job-Eigenschaften, Rollen, Berechtigungen und appweiten Konfigurationen.",{"title":386,"path":387,"stem":388,"description":363,"children":-1},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",1788895641584]