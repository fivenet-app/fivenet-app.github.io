n.md",{"type":203,"value":204,"toc":344},"minimark",[205,209,216,221,231,240,243,246,256,261,319,321],[206,207,208],"p",{},"FiveNet unterstützt mehrere Sprachen.",[206,210,211],{},[212,213],"img",{"alt":214,"src":215},"Feature i18n","\u002Fimages\u002Fscreenshots\u002Ffeatures-i18n.webp",[217,218,220],"h2",{"id":219},"aktuelle-liste-der-sprachen","Aktuelle Liste der Sprachen",[222,223,224,228],"ul",{},[225,226,227],"li",{},"Deutsch",[225,229,230],{},"Englisch",[206,232,233,234,239],{},"Wenn Sie eine weitere Sprache hinzufügen möchten, lesen Sie den Abschnitt ",[235,236,238],"a",{"href":237},"#mitwirken","Mitwirken",".",[241,242],"hr",{},[217,244,238],{"id":245},"mitwirken",[206,247,248,249,255],{},"Wir freuen uns über Beiträge zur Verbesserung oder Erweiterung der Sprachunterstützung. Wenn Sie eine Sprache beitragen oder Übersetzungen korrigieren möchten, erstellen Sie ein Issue im FiveNet-GitHub-Projekt oder treten Sie direkt über ",[235,250,254],{"href":251,"rel":252},"https:\u002F\u002Fpoeditor.com\u002Fjoin\u002Fproject\u002Fhszo85uo3K",[253],"nofollow","FiveNets POEditor-Projektlink"," bei.",[257,258,260],"h3",{"id":259},"so-fügen-sie-eine-neue-sprache-hinzu","So fügen Sie eine neue Sprache hinzu",[262,263,264,267,292,305,308],"ol",{},[225,265,266],{},"Erstellen Sie ein Issue im FiveNet-GitHub-Projekt, um die gewünschte neue Sprache zu besprechen.",[225,268,269,270],{},"Fügen Sie im Issue folgende Informationen hinzu:\n",[222,271,272,280,286],{},[225,273,274,275,279],{},"Sprachname (zum Beispiel ",[276,277,278],"code",{},"Französisch",")",[225,281,282,283,279],{},"Sprachcode (zum Beispiel ",[276,284,285],{},"fr",[225,287,288,289,279],{},"Sprachsymbol (zum Beispiel ",[276,290,291],{},"i-flagpack-fr",[225,293,294,295],{},"Nach Freigabe wird die Sprache in POEditor angelegt.\n",[222,296,297],{},[225,298,299,300,304],{},"Anschließend können Sie ein POEditor-Konto erstellen und über ",[235,301,303],{"href":251,"rel":302},[253],"den Projektlink"," beitreten.",[225,306,307],{},"Sie können dann beginnen, die Strings im POEditor-Projekt zu übersetzen.",[225,309,310,311],{},"Entwickler synchronisieren die Übersetzungen von POEditor regelmäßig mit dem FiveNet-Projekt.\n",[222,312,313,316],{},[225,314,315],{},"Nach Synchronisierung und Release ist die neue Sprache in der Anwendung verfügbar.",[225,317,318],{},"Bei Problemen erstellen Sie bitte ein GitHub-Issue oder fragen Sie auf dem FiveNet-Discord-Server nach.",[241,320],{},[322,323,327,335],"card",{"target":324,"title":325,"to":326},"_blank","FiveNet nutzt POEditor für Übersetzungen","https:\u002F\u002Fpoeditor.com\u002F",[206,328,329,330,334],{},"Vielen Dank an ",[235,331,333],{"href":326,"rel":332},[253],"POEditor"," für die Bereitstellung eines kostenlosen Übersetzungsprojekts für das FiveNet Projekt!",[206,336,337],{},[212,338],{"alt":339,"src":340,":width":341,":zoom":342,"align":343},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":345,"searchDepth":346,"depth":346,"links":347},"",2,[348,349],{"id":219,"depth":346,"text":220},{"id":245,"depth":346,"text":238,"children":350},[351],{"id":259,"depth":352,"text":260},3,"md",null,{},true,{"title":170,"description":208},"g4_ztQLOBj0Sv39F4bOPbgoIRiF65c9Gu-ZsEL1hUF8",[360,362],{"title":166,"path":167,"stem":168,"description":361,"children":-1},"Erfahren Sie, wie Sie Einstellungen in FiveNet konfigurieren und verwalten, einschließlich Job-Eigenschaften, Rollen, Berechtigungen und appweiten Konfigurationen.",{"title":174,"path":175,"stem":176,"description":345,"children":-1},1789078106731]