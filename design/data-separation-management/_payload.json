"de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164,"children":165},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[166,167,171],{"title":162,"path":163,"stem":164},{"title":168,"path":169,"stem":170},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":172,"stem":173},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":175,"path":176,"stem":177,"children":178},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[179],{"title":175,"path":176,"stem":177},{"id":181,"title":182,"body":183,"description":438,"extension":439,"links":440,"meta":441,"navigation":442,"path":443,"redirect":440,"seo":444,"stem":445,"__hash__":446},"content_en\u002F9.design\u002Fdata-separation-management.md","Improving Data Separation and Management for Users and Citizens",{"type":184,"value":185,"toc":430},"minimark",[186,194,199,209,213,257,261,329,333],[187,188,189,193],"p",{},[190,191,192],"strong",{},"Status",": Implemented",[195,196,198],"h2",{"id":197},"glossary","Glossary",[200,201,202,206],"ul",{},[203,204,205],"li",{},"User - An user account that can log into FiveNet.",[203,207,208],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[195,210,212],{"id":211},"problems","Problems",[200,214,215,236,254],{},[203,216,217,218,221,222],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[190,219,220],{},"or more"," groups to an user. This is currently not really supported.\n",[200,223,224],{},[203,225,226,227,231,232,235],{},"In case of ESX an user can only have one group assigned via the ",[228,229,230],"code",{},"users"," table ",[228,233,234],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[203,237,238,239],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[200,240,241,247],{},[203,242,243,244,246],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[228,245,230],{}," .",[203,248,249,250,253],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[228,251,252],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[203,255,256],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[195,258,260],{"id":259},"goals","Goals",[200,262,263,287,309],{},[203,264,265,266],{},"Citizens - Info\u002FData Changes\n",[200,267,268,271,279],{},[203,269,270],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[203,272,273,274],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[200,275,276],{},[203,277,278],{},"A clear distinction between primary and secondary jobs is needed.",[203,280,281,282],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[200,283,284],{},[203,285,286],{},"A clear distinction between primary and secondary phone numbers is needed.",[203,288,289,290],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[200,291,292,303,306],{},[203,293,294,295],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[200,296,297,300],{},[203,298,299],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[203,301,302],{},"Ability to set citizen information based on permission levels.",[203,304,305],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[203,307,308],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[203,310,311,312,315,316,319,320],{},"Improve performance of account to citizens lookup by not having to use ",[228,313,314],{},"WHERE ","identifier",[228,317,318],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[200,321,322],{},[203,323,324,325,328],{},"An ",[228,326,327],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[195,330,332],{"id":331},"solutions","Solutions",[200,334,335,419],{},[203,336,337,338,340,341],{},"Changing the ",[228,339,252],{}," table structure.\n",[200,342,343,354,376],{},[203,344,345,346,349,350,353],{},"Adding a ",[228,347,348],{},"deleted_at"," column to be able to soft-delete users, with a ",[228,351,352],{},"deleted_reason"," field.",[203,355,356,357,359,360,363,364,367,368,371,372,375],{},"The current \"singular\" columns (",[228,358,234],{},", ",[228,361,362],{},"job",", and ",[228,365,366],{},"phone_number",") will be kept as they are, a prefix of ",[228,369,370],{},"active_"," or ",[228,373,374],{},"primary_"," might be added to clarify their purpose.",[203,377,378,379,359,382,363,385,388,389,371,392,395,396],{},"Adding new (plural named) columns for ",[228,380,381],{},"groups",[228,383,384],{},"jobs",[228,386,387],{},"phone_numbers"," that are of type ",[228,390,391],{},"JSON",[228,393,394],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[200,397,398],{},[203,399,400,401,359,404,359,407,410,411],{},"Or even seperate tables for each of them, e.g., ",[228,402,403],{},"fivenet_user_groups",[228,405,406],{},"fivenet_user_jobs",[228,408,409],{},"fivenet_user_phone_numbers",".\n",[200,412,413],{},[203,414,415,416,418],{},"These tables would have a foreign key to the ",[228,417,252],{}," table and store multiple entries per user.",[203,420,421,422],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[200,423,424,427],{},[203,425,426],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[203,428,429],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":431,"searchDepth":432,"depth":432,"links":433},"",2,[434,435,436,437],{"id":197,"depth":432,"text":198},{"id":211,"depth":432,"text":212},{"id":259,"depth":432,"text":260},{"id":331,"depth":432,"text":332},"Status: Implemented","md",null,{},true,"\u002Fdesign\u002Fdata-separation-management",{"title":182,"description":438},"9.design\u002Fdata-separation-management","nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",[448,453],{"title":449,"path":450,"stem":451,"description":452,"children":-1},"Designs","\u002Fdesign","9.design\u002F1.index","Welcome to the design section of the project. Here you will find design-related documentation.",{"title":454,"path":455,"stem":456,"description":438,"children":-1},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",1787913109880]