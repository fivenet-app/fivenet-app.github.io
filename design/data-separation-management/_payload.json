des\u002F3.documents\u002Ftemplates",{"title":146,"path":147,"stem":148},"Jobs","\u002Fde\u002Fuser-guides\u002Fjobs","de\u002F3.user-guides\u002F3.jobs",{"title":150,"path":151,"stem":152},"Kalender","\u002Fde\u002Fuser-guides\u002Fcalendar","de\u002F3.user-guides\u002F4.calendar",{"title":154,"path":155,"stem":156},"Livemap","\u002Fde\u002Fuser-guides\u002Flivemap","de\u002F3.user-guides\u002F5.livemap",{"title":158,"path":159,"stem":160},"Einsatzzentrale","\u002Fde\u002Fuser-guides\u002Fcentrum","de\u002F3.user-guides\u002F6.centrum",{"title":162,"path":163,"stem":164},"Mailer","\u002Fde\u002Fuser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":166,"path":167,"stem":168},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":170,"path":171,"stem":172},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":174,"path":175,"stem":176},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":178,"path":179,"stem":180},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":182,"path":183,"stem":184,"children":185},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[186,187,191],{"title":182,"path":183,"stem":184},{"title":188,"path":189,"stem":190},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":170,"path":192,"stem":193},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":195,"path":196,"stem":197,"children":198},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[199],{"title":195,"path":196,"stem":197},{"id":201,"title":202,"body":203,"description":458,"extension":459,"links":460,"meta":461,"navigation":462,"path":463,"redirect":460,"seo":464,"stem":465,"__hash__":466},"content_en\u002F9.design\u002Fdata-separation-management.md","Improving Data Separation and Management for Users and Citizens",{"type":204,"value":205,"toc":450},"minimark",[206,214,219,229,233,277,281,349,353],[207,208,209,213],"p",{},[210,211,212],"strong",{},"Status",": Implemented",[215,216,218],"h2",{"id":217},"glossary","Glossary",[220,221,222,226],"ul",{},[223,224,225],"li",{},"User - An user account that can log into FiveNet.",[223,227,228],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[215,230,232],{"id":231},"problems","Problems",[220,234,235,256,274],{},[223,236,237,238,241,242],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[210,239,240],{},"or more"," groups to an user. This is currently not really supported.\n",[220,243,244],{},[223,245,246,247,251,252,255],{},"In case of ESX an user can only have one group assigned via the ",[248,249,250],"code",{},"users"," table ",[248,253,254],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[223,257,258,259],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[220,260,261,267],{},[223,262,263,264,266],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[248,265,250],{}," .",[223,268,269,270,273],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[248,271,272],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[223,275,276],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[215,278,280],{"id":279},"goals","Goals",[220,282,283,307,329],{},[223,284,285,286],{},"Citizens - Info\u002FData Changes\n",[220,287,288,291,299],{},[223,289,290],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[223,292,293,294],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[220,295,296],{},[223,297,298],{},"A clear distinction between primary and secondary jobs is needed.",[223,300,301,302],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[220,303,304],{},[223,305,306],{},"A clear distinction between primary and secondary phone numbers is needed.",[223,308,309,310],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[220,311,312,323,326],{},[223,313,314,315],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[220,316,317,320],{},[223,318,319],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[223,321,322],{},"Ability to set citizen information based on permission levels.",[223,324,325],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[223,327,328],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[223,330,331,332,335,336,339,340],{},"Improve performance of account to citizens lookup by not having to use ",[248,333,334],{},"WHERE ","identifier",[248,337,338],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[220,341,342],{},[223,343,344,345,348],{},"An ",[248,346,347],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[215,350,352],{"id":351},"solutions","Solutions",[220,354,355,439],{},[223,356,357,358,360,361],{},"Changing the ",[248,359,272],{}," table structure.\n",[220,362,363,374,396],{},[223,364,365,366,369,370,373],{},"Adding a ",[248,367,368],{},"deleted_at"," column to be able to soft-delete users, with a ",[248,371,372],{},"deleted_reason"," field.",[223,375,376,377,379,380,383,384,387,388,391,392,395],{},"The current \"singular\" columns (",[248,378,254],{},", ",[248,381,382],{},"job",", and ",[248,385,386],{},"phone_number",") will be kept as they are, a prefix of ",[248,389,390],{},"active_"," or ",[248,393,394],{},"primary_"," might be added to clarify their purpose.",[223,397,398,399,379,402,383,405,408,409,391,412,415,416],{},"Adding new (plural named) columns for ",[248,400,401],{},"groups",[248,403,404],{},"jobs",[248,406,407],{},"phone_numbers"," that are of type ",[248,410,411],{},"JSON",[248,413,414],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[220,417,418],{},[223,419,420,421,379,424,379,427,430,431],{},"Or even seperate tables for each of them, e.g., ",[248,422,423],{},"fivenet_user_groups",[248,425,426],{},"fivenet_user_jobs",[248,428,429],{},"fivenet_user_phone_numbers",".\n",[220,432,433],{},[223,434,435,436,438],{},"These tables would have a foreign key to the ",[248,437,272],{}," table and store multiple entries per user.",[223,440,441,442],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[220,443,444,447],{},[223,445,446],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[223,448,449],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":451,"searchDepth":452,"depth":452,"links":453},"",2,[454,455,456,457],{"id":217,"depth":452,"text":218},{"id":231,"depth":452,"text":232},{"id":279,"depth":452,"text":280},{"id":351,"depth":452,"text":352},"Status: Implemented","md",null,{},true,"\u002Fdesign\u002Fdata-separation-management",{"title":202,"description":458},"9.design\u002Fdata-separation-management","nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",[468,473],{"title":469,"path":470,"stem":471,"description":472,"children":-1},"Designs","\u002Fdesign","9.design\u002F1.index","Welcome to the design section of the project. Here you will find design-related documentation.",{"title":474,"path":475,"stem":476,"description":458,"children":-1},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",1789078115527]