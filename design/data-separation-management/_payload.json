er","3.user-guides\u002F6.mailer",{"title":167,"path":168,"stem":169},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":171,"path":172,"stem":173},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":175,"path":176,"stem":177},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":179,"path":180,"stem":181},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":183,"path":184,"stem":185,"children":186},"Development","\u002Fdevelopment","8.development\u002F1.index",[187,188,192,196,200],{"title":183,"path":184,"stem":185},{"title":189,"path":190,"stem":191},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":193,"path":194,"stem":195},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":197,"path":198,"stem":199},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":171,"path":201,"stem":202},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":204,"path":205,"stem":206,"children":207},"Design Docs","\u002Fdesign","9.design\u002F1.index",[208,210,214,218,221,225,229],{"title":209,"path":205,"stem":206},"Designs",{"title":211,"path":212,"stem":213},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":215,"path":216,"stem":217},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":159,"path":219,"stem":220},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":222,"path":223,"stem":224},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":226,"path":227,"stem":228},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":211,"body":235,"description":490,"extension":491,"links":492,"meta":493,"navigation":494,"path":212,"redirect":492,"seo":495,"stem":213,"__hash__":496},"content_en\u002F9.design\u002Fdata-separation-management.md",{"type":236,"value":237,"toc":482},"minimark",[238,246,251,261,265,309,313,381,385],[239,240,241,245],"p",{},[242,243,244],"strong",{},"Status",": Implemented",[247,248,250],"h2",{"id":249},"glossary","Glossary",[252,253,254,258],"ul",{},[255,256,257],"li",{},"User - An user account that can log into FiveNet.",[255,259,260],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[247,262,264],{"id":263},"problems","Problems",[252,266,267,288,306],{},[255,268,269,270,273,274],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[242,271,272],{},"or more"," groups to an user. This is currently not really supported.\n",[252,275,276],{},[255,277,278,279,283,284,287],{},"In case of ESX an user can only have one group assigned via the ",[280,281,282],"code",{},"users"," table ",[280,285,286],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[255,289,290,291],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[252,292,293,299],{},[255,294,295,296,298],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[280,297,282],{}," .",[255,300,301,302,305],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[280,303,304],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[255,307,308],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[247,310,312],{"id":311},"goals","Goals",[252,314,315,339,361],{},[255,316,317,318],{},"Citizens - Info\u002FData Changes\n",[252,319,320,323,331],{},[255,321,322],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[255,324,325,326],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[252,327,328],{},[255,329,330],{},"A clear distinction between primary and secondary jobs is needed.",[255,332,333,334],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[252,335,336],{},[255,337,338],{},"A clear distinction between primary and secondary phone numbers is needed.",[255,340,341,342],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[252,343,344,355,358],{},[255,345,346,347],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[252,348,349,352],{},[255,350,351],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[255,353,354],{},"Ability to set citizen information based on permission levels.",[255,356,357],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[255,359,360],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[255,362,363,364,367,368,371,372],{},"Improve performance of account to citizens lookup by not having to use ",[280,365,366],{},"WHERE ","identifier",[280,369,370],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[252,373,374],{},[255,375,376,377,380],{},"An ",[280,378,379],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[247,382,384],{"id":383},"solutions","Solutions",[252,386,387,471],{},[255,388,389,390,392,393],{},"Changing the ",[280,391,304],{}," table structure.\n",[252,394,395,406,428],{},[255,396,397,398,401,402,405],{},"Adding a ",[280,399,400],{},"deleted_at"," column to be able to soft-delete users, with a ",[280,403,404],{},"deleted_reason"," field.",[255,407,408,409,411,412,415,416,419,420,423,424,427],{},"The current \"singular\" columns (",[280,410,286],{},", ",[280,413,414],{},"job",", and ",[280,417,418],{},"phone_number",") will be kept as they are, a prefix of ",[280,421,422],{},"active_"," or ",[280,425,426],{},"primary_"," might be added to clarify their purpose.",[255,429,430,431,411,434,415,437,440,441,423,444,447,448],{},"Adding new (plural named) columns for ",[280,432,433],{},"groups",[280,435,436],{},"jobs",[280,438,439],{},"phone_numbers"," that are of type ",[280,442,443],{},"JSON",[280,445,446],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[252,449,450],{},[255,451,452,453,411,456,411,459,462,463],{},"Or even seperate tables for each of them, e.g., ",[280,454,455],{},"fivenet_user_groups",[280,457,458],{},"fivenet_user_jobs",[280,460,461],{},"fivenet_user_phone_numbers",".\n",[252,464,465],{},[255,466,467,468,470],{},"These tables would have a foreign key to the ",[280,469,304],{}," table and store multiple entries per user.",[255,472,473,474],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[252,475,476,479],{},[255,477,478],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[255,480,481],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":483,"searchDepth":484,"depth":484,"links":485},"",2,[486,487,488,489],{"id":249,"depth":484,"text":250},{"id":263,"depth":484,"text":264},{"id":311,"depth":484,"text":312},{"id":383,"depth":484,"text":384},"Status: Implemented","md",null,{},true,{"title":211,"description":490},"nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",[498,500],{"title":209,"path":205,"stem":206,"description":499,"children":-1},"Welcome to the design section of the project. Here you will find design-related documentation.",{"title":215,"path":216,"stem":217,"description":490,"children":-1},1789079044527]