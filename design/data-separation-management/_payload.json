63,"stem":164},"Calendar","\u002Fuser-guides\u002Fcalendar","3.user-guides\u002F4.calendar",{"title":166,"path":167,"stem":168},"Livemap","\u002Fuser-guides\u002Flivemap","3.user-guides\u002F5.livemap",{"title":170,"path":171,"stem":172},"Dispatch Center","\u002Fuser-guides\u002Fcentrum","3.user-guides\u002F6.centrum",{"title":174,"path":175,"stem":176},"Mailer","\u002Fuser-guides\u002Fmailer","3.user-guides\u002F6.mailer",{"title":178,"path":179,"stem":180},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":182,"path":183,"stem":184},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":186,"path":187,"stem":188},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":190,"path":191,"stem":192},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":194,"path":195,"stem":196,"children":197},"Development","\u002Fdevelopment","8.development\u002F1.index",[198,199,203,207,211],{"title":194,"path":195,"stem":196},{"title":200,"path":201,"stem":202},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":204,"path":205,"stem":206},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":208,"path":209,"stem":210},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":182,"path":212,"stem":213},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":215,"path":6,"stem":7,"children":216},"Design Docs",[217,218,222,223,226,230,234],{"title":5,"path":6,"stem":7},{"title":219,"path":220,"stem":221},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":10,"path":11,"stem":12},{"title":170,"path":224,"stem":225},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":227,"path":228,"stem":229},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":231,"path":232,"stem":233},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":235,"path":236,"stem":237},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":239,"title":219,"body":240,"description":13,"extension":495,"links":496,"meta":497,"navigation":498,"path":220,"redirect":496,"seo":499,"stem":221,"__hash__":500},"content_en\u002F9.design\u002Fdata-separation-management.md",{"type":241,"value":242,"toc":487},"minimark",[243,251,256,266,270,314,318,386,390],[244,245,246,250],"p",{},[247,248,249],"strong",{},"Status",": Implemented",[252,253,255],"h2",{"id":254},"glossary","Glossary",[257,258,259,263],"ul",{},[260,261,262],"li",{},"User - An user account that can log into FiveNet.",[260,264,265],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[252,267,269],{"id":268},"problems","Problems",[257,271,272,293,311],{},[260,273,274,275,278,279],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[247,276,277],{},"or more"," groups to an user. This is currently not really supported.\n",[257,280,281],{},[260,282,283,284,288,289,292],{},"In case of ESX an user can only have one group assigned via the ",[285,286,287],"code",{},"users"," table ",[285,290,291],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[260,294,295,296],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[257,297,298,304],{},[260,299,300,301,303],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[285,302,287],{}," .",[260,305,306,307,310],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[285,308,309],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[260,312,313],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[252,315,317],{"id":316},"goals","Goals",[257,319,320,344,366],{},[260,321,322,323],{},"Citizens - Info\u002FData Changes\n",[257,324,325,328,336],{},[260,326,327],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[260,329,330,331],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[257,332,333],{},[260,334,335],{},"A clear distinction between primary and secondary jobs is needed.",[260,337,338,339],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[257,340,341],{},[260,342,343],{},"A clear distinction between primary and secondary phone numbers is needed.",[260,345,346,347],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[257,348,349,360,363],{},[260,350,351,352],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[257,353,354,357],{},[260,355,356],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[260,358,359],{},"Ability to set citizen information based on permission levels.",[260,361,362],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[260,364,365],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[260,367,368,369,372,373,376,377],{},"Improve performance of account to citizens lookup by not having to use ",[285,370,371],{},"WHERE ","identifier",[285,374,375],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[257,378,379],{},[260,380,381,382,385],{},"An ",[285,383,384],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[252,387,389],{"id":388},"solutions","Solutions",[257,391,392,476],{},[260,393,394,395,397,398],{},"Changing the ",[285,396,309],{}," table structure.\n",[257,399,400,411,433],{},[260,401,402,403,406,407,410],{},"Adding a ",[285,404,405],{},"deleted_at"," column to be able to soft-delete users, with a ",[285,408,409],{},"deleted_reason"," field.",[260,412,413,414,416,417,420,421,424,425,428,429,432],{},"The current \"singular\" columns (",[285,415,291],{},", ",[285,418,419],{},"job",", and ",[285,422,423],{},"phone_number",") will be kept as they are, a prefix of ",[285,426,427],{},"active_"," or ",[285,430,431],{},"primary_"," might be added to clarify their purpose.",[260,434,435,436,416,439,420,442,445,446,428,449,452,453],{},"Adding new (plural named) columns for ",[285,437,438],{},"groups",[285,440,441],{},"jobs",[285,443,444],{},"phone_numbers"," that are of type ",[285,447,448],{},"JSON",[285,450,451],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[257,454,455],{},[260,456,457,458,416,461,416,464,467,468],{},"Or even seperate tables for each of them, e.g., ",[285,459,460],{},"fivenet_user_groups",[285,462,463],{},"fivenet_user_jobs",[285,465,466],{},"fivenet_user_phone_numbers",".\n",[257,469,470],{},[260,471,472,473,475],{},"These tables would have a foreign key to the ",[285,474,309],{}," table and store multiple entries per user.",[260,477,478,479],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[257,480,481,484],{},[260,482,483],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[260,485,486],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":488,"searchDepth":489,"depth":489,"links":490},"",2,[491,492,493,494],{"id":254,"depth":489,"text":255},{"id":268,"depth":489,"text":269},{"id":316,"depth":489,"text":317},{"id":388,"depth":489,"text":389},"md",null,{},true,{"title":219,"description":13},"nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",1795714535248,"3d638de7-68c8-4e60-9c0d-5c8dc7f2f7e2"]