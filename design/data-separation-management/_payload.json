":171},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":173,"path":174,"stem":175},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":177,"path":178,"stem":179},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":181,"stem":182},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":184,"path":185,"stem":186,"children":187},"Design Docs","\u002Fdesign","9.design\u002F1.index",[188,190,194,198,201,205,209],{"title":189,"path":185,"stem":186},"Designs",{"title":191,"path":192,"stem":193},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":195,"path":196,"stem":197},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":199,"stem":200},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":202,"path":203,"stem":204},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":206,"path":207,"stem":208},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":210,"path":211,"stem":212},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":214,"title":191,"body":215,"description":470,"extension":471,"links":472,"meta":473,"navigation":474,"path":192,"redirect":472,"seo":475,"stem":193,"__hash__":476},"content_en\u002F9.design\u002Fdata-separation-management.md",{"type":216,"value":217,"toc":462},"minimark",[218,226,231,241,245,289,293,361,365],[219,220,221,225],"p",{},[222,223,224],"strong",{},"Status",": Implemented",[227,228,230],"h2",{"id":229},"glossary","Glossary",[232,233,234,238],"ul",{},[235,236,237],"li",{},"User - An user account that can log into FiveNet.",[235,239,240],{},"Citizen - A roleplay character that is optionally linked to an user account (e.g., might be \"unlinked\" if an user doesn't create a FiveNet account).",[227,242,244],{"id":243},"problems","Problems",[232,246,247,268,286],{},[235,248,249,250,253,254],{},"Some servers that might have expanded the ESX framework or are even using a different framework, might have different ways to assign one ",[222,251,252],{},"or more"," groups to an user. This is currently not really supported.\n",[232,255,256],{},[235,257,258,259,263,264,267],{},"In case of ESX an user can only have one group assigned via the ",[260,261,262],"code",{},"users"," table ",[260,265,266],{},"group"," column. This also binds the permissions to the char itself and not to the whole \"account.\"",[235,269,270,271],{},"This continues for some other (common) data, e.g., jobs, phone numbers.\n",[232,272,273,279],{},[235,274,275,276,278],{},"Some chars might have more than one job, e.g., ModernV, people can have what you can call a \"primary\" job and a \"secondary\" job (technically even more), that are simply set in the ",[260,277,262],{}," .",[235,280,281,282,285],{},"Multiple phone numbers are also not supported, as ESX only supports one phone number per char which the current ",[260,283,284],{},"fivenet_user"," table is based on. There seems to be some phone plugins that allow multiple phone numbers.",[235,287,288],{},"Sidenote: Being able to give an user superuser access or even allowing permissions to be given to users of a job and\u002For \"globally.\"",[227,290,292],{"id":291},"goals","Goals",[232,294,295,319,341],{},[235,296,297,298],{},"Citizens - Info\u002FData Changes\n",[232,299,300,303,311],{},[235,301,302],{},"Multiple Groups - Allowing multiple groups to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.",[235,304,305,306],{},"Multiple Jobs - Allow multiple jobs to be assigned to a citizen via DBSync from gameserver db and\u002For admin UI.\n",[232,307,308],{},[235,309,310],{},"A clear distinction between primary and secondary jobs is needed.",[235,312,313,314],{},"Multiple Phone Numbers - Allow multiple phone numbers to be assigned to a citizen.\n",[232,315,316],{},[235,317,318],{},"A clear distinction between primary and secondary phone numbers is needed.",[235,320,321,322],{},"Creating\u002FEditing\u002FDeleting Citizens\n",[232,323,324,335,338],{},[235,325,326,327],{},"Creating a citizen with incomplete or all information should be possible manually via the admin UI\n",[232,328,329,332],{},[235,330,331],{},"Could be made accessible via permissions in the future for, e.g., hardcore roleplay servers that have staff manually \"adding\" new users via an airport.",[235,333,334],{},"Ability to set citizen information based on permission levels.",[235,336,337],{},"Ability to edit \"citizens\" in the FiveNet database (preferably with a way to reset back to \"original\" (from gameserver) state).",[235,339,340],{},"Ability to delete \"citizens\" from the FiveNet database (without \"deleting\" them from the gameserver database).",[235,342,343,344,347,348,351,352],{},"Improve performance of account to citizens lookup by not having to use ",[260,345,346],{},"WHERE ","identifier",[260,349,350],{}," LIKE '%_IDENTIFIER_HERE_'"," queries.\n",[232,353,354],{},[235,355,356,357,360],{},"An ",[260,358,359],{},"user"," entry will be linked to the account ID directly instead of having to search for it via the identifier pattern matching.",[227,362,364],{"id":363},"solutions","Solutions",[232,366,367,451],{},[235,368,369,370,372,373],{},"Changing the ",[260,371,284],{}," table structure.\n",[232,374,375,386,408],{},[235,376,377,378,381,382,385],{},"Adding a ",[260,379,380],{},"deleted_at"," column to be able to soft-delete users, with a ",[260,383,384],{},"deleted_reason"," field.",[235,387,388,389,391,392,395,396,399,400,403,404,407],{},"The current \"singular\" columns (",[260,390,266],{},", ",[260,393,394],{},"job",", and ",[260,397,398],{},"phone_number",") will be kept as they are, a prefix of ",[260,401,402],{},"active_"," or ",[260,405,406],{},"primary_"," might be added to clarify their purpose.",[235,409,410,411,391,414,395,417,420,421,403,424,427,428],{},"Adding new (plural named) columns for ",[260,412,413],{},"groups",[260,415,416],{},"jobs",[260,418,419],{},"phone_numbers"," that are of type ",[260,422,423],{},"JSON",[260,425,426],{},"LONGTEXT"," (required for compatibility with MariaDB).\n",[232,429,430],{},[235,431,432,433,391,436,391,439,442,443],{},"Or even seperate tables for each of them, e.g., ",[260,434,435],{},"fivenet_user_groups",[260,437,438],{},"fivenet_user_jobs",[260,440,441],{},"fivenet_user_phone_numbers",".\n",[232,444,445],{},[235,446,447,448,450],{},"These tables would have a foreign key to the ",[260,449,284],{}," table and store multiple entries per user.",[235,452,453,454],{},"Updating the FiveNet admin UI to support the new functionalities.\n",[232,455,456,459],{},[235,457,458],{},"Adding interfaces for managing multiple groups, jobs, and phone numbers.",[235,460,461],{},"Adding interfaces for creating, editing, and deleting \"citizens.\"",{"title":463,"searchDepth":464,"depth":464,"links":465},"",2,[466,467,468,469],{"id":229,"depth":464,"text":230},{"id":243,"depth":464,"text":244},{"id":291,"depth":464,"text":292},{"id":363,"depth":464,"text":364},"Status: Implemented","md",null,{},true,{"title":191,"description":470},"nhZJqpsWewH4ho3pOPqKqjmLDTk1MmYhsPxHeo4WnnU",[478,480],{"title":189,"path":185,"stem":186,"description":479,"children":-1},"Welcome to the design section of the project. Here you will find design-related documentation.",{"title":195,"path":196,"stem":197,"description":470,"children":-1},1788472974938]