ifications",{"type":204,"value":205,"toc":400},"minimark",[206,214,219,232,237,270,274,277,297,301,304,315,319,369,373,396],[207,208,209,213],"p",{},[210,211,212],"strong",{},"Status",": Implemented",[215,216,218],"h2",{"id":217},"what-is-a-qualifications","What is a Qualifications?",[220,221,222,226,229],"ul",{},[223,224,225],"li",{},"An access level protected entity with a \"public\" (as in \"anyone can see\") facing name and description.",[223,227,228],{},"A training\u002Fmodule that someone has been \"granted\" or has succcessfully taken the test for.",[223,230,231],{},"A qualification can require certain prerequisites. A prerequisite can be a job rank, other successful qualification.",[233,234,236],"h3",{"id":235},"what-elements-are-needed","What elements are needed?",[220,238,239,250,253,256],{},[223,240,241,242],{},"Qualification: Holds all basic infos about the qualification.\n",[220,243,244,247],{},[223,245,246],{},"Access: Holds the access levels to the qualification.",[223,248,249],{},"Requirements: Requirements to be able to take the qualification. -> Don't deny the access to the qualification like access, but are required to send a request or to take the qualification.",[223,251,252],{},"Requests: List of user requests to take the test for the qualification.",[223,254,255],{},"Results: A \"mapping\" of score of an user test.",[223,257,258,259],{},"Tests: Test progress of (started) tests from users.\n",[220,260,261,264,267],{},[223,262,263],{},"Info\u002FConfig of the Test: E.g., how many questions need to be right to pass, how much time do they have, etc.",[223,265,266],{},"Test Questions: Questions for the qualification tests.",[223,268,269],{},"User Test Answers: Answered questions \"waiting for approval\" by a \"trainer\".",[233,271,273],{"id":272},"access-levels","Access Levels",[207,275,276],{},"Similarily structured to documents access levels.",[220,278,279,282,285,288,291,294],{},[223,280,281],{},"Blocked.",[223,283,284],{},"View.",[223,286,287],{},"Request.",[223,289,290],{},"Take.",[223,292,293],{},"Grade.",[223,295,296],{},"Edit.",[215,298,300],{"id":299},"exams","Exams",[207,302,303],{},"3 modes for a qualification with an exam:",[220,305,306,309,312],{},[223,307,308],{},"Disabled.",[223,310,311],{},"Request needed.",[223,313,314],{},"Enabled.",[233,316,318],{"id":317},"flow-request-needed","Flow - Request needed",[320,321,322],"mermaid",{},[323,324,328],"pre",{"className":325,"code":326,"language":320,"meta":327,"style":327},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sequenceDiagram\nUser->>+Qualification: Send Request\nApprover-->Qualification: Approve Request\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover->>Exam: Create Result\n","",[329,330,331,339,345,351,357,363],"code",{"__ignoreMap":327},[332,333,336],"span",{"class":334,"line":335},"line",1,[332,337,338],{},"sequenceDiagram\n",[332,340,342],{"class":334,"line":341},2,[332,343,344],{},"User->>+Qualification: Send Request\n",[332,346,348],{"class":334,"line":347},3,[332,349,350],{},"Approver-->Qualification: Approve Request\n",[332,352,354],{"class":334,"line":353},4,[332,355,356],{},"User-->Exam: Take exam\n",[332,358,360],{"class":334,"line":359},5,[332,361,362],{},"User->>Exam: Submit exam response\n",[332,364,366],{"class":334,"line":365},6,[332,367,368],{},"Approver->>Exam: Create Result\n",[233,370,372],{"id":371},"flow-enabled","Flow - Enabled",[320,374,375],{},[323,376,378],{"className":325,"code":377,"language":320,"meta":327,"style":327},"sequenceDiagram\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover->>Exam: Create Result\n",[329,379,380,384,388,392],{"__ignoreMap":327},[332,381,382],{"class":334,"line":335},[332,383,338],{},[332,385,386],{"class":334,"line":341},[332,387,356],{},[332,389,390],{"class":334,"line":347},[332,391,362],{},[332,393,394],{"class":334,"line":353},[332,395,368],{},[397,398,399],"style",{},"html .light .shiki s