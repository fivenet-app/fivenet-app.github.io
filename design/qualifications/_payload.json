002Femployee-management","9.design\u002Femployee-management",{"title":5,"path":6,"stem":7},{"title":234,"path":235,"stem":236},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":238,"title":234,"body":239,"description":8,"extension":446,"links":9,"meta":447,"navigation":448,"path":235,"redirect":9,"seo":449,"stem":236,"__hash__":450},"content_en\u002F9.design\u002Fqualifications.md",{"type":240,"value":241,"toc":436},"minimark",[242,250,255,268,273,306,310,313,333,337,340,351,355,405,409,432],[243,244,245,249],"p",{},[246,247,248],"strong",{},"Status",": Implemented",[251,252,254],"h2",{"id":253},"what-is-a-qualifications","What is a Qualifications?",[256,257,258,262,265],"ul",{},[259,260,261],"li",{},"An access level protected entity with a \"public\" (as in \"anyone can see\") facing name and description.",[259,263,264],{},"A training\u002Fmodule that someone has been \"granted\" or has succcessfully taken the test for.",[259,266,267],{},"A qualification can require certain prerequisites. A prerequisite can be a job rank, other successful qualification.",[269,270,272],"h3",{"id":271},"what-elements-are-needed","What elements are needed?",[256,274,275,286,289,292],{},[259,276,277,278],{},"Qualification: Holds all basic infos about the qualification.\n",[256,279,280,283],{},[259,281,282],{},"Access: Holds the access levels to the qualification.",[259,284,285],{},"Requirements: Requirements to be able to take the qualification. -> Don't deny the access to the qualification like access, but are required to send a request or to take the qualification.",[259,287,288],{},"Requests: List of user requests to take the test for the qualification.",[259,290,291],{},"Results: A \"mapping\" of score of an user test.",[259,293,294,295],{},"Tests: Test progress of (started) tests from users.\n",[256,296,297,300,303],{},[259,298,299],{},"Info\u002FConfig of the Test: E.g., how many questions need to be right to pass, how much time do they have, etc.",[259,301,302],{},"Test Questions: Questions for the qualification tests.",[259,304,305],{},"User Test Answers: Answered questions \"waiting for approval\" by a \"trainer\".",[269,307,309],{"id":308},"access-levels","Access Levels",[243,311,312],{},"Similarily structured to documents access levels.",[256,314,315,318,321,324,327,330],{},[259,316,317],{},"Blocked.",[259,319,320],{},"View.",[259,322,323],{},"Request.",[259,325,326],{},"Take.",[259,328,329],{},"Grade.",[259,331,332],{},"Edit.",[251,334,336],{"id":335},"exams","Exams",[243,338,339],{},"3 modes for a qualification with an exam:",[256,341,342,345,348],{},[259,343,344],{},"Disabled.",[259,346,347],{},"Request needed.",[259,349,350],{},"Enabled.",[269,352,354],{"id":353},"flow-request-needed","Flow - Request needed",[356,357,358],"mermaid",{},[359,360,364],"pre",{"className":361,"code":362,"language":356,"meta":363,"style":363},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sequenceDiagram\nUser->>+Qualification: Send Request\nApprover-->Qualification: Approve Request\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover->>Exam: Create Result\n","",[365,366,367,375,381,387,393,399],"code",{"__ignoreMap":363},[368,369,372],"span",{"class":370,"line":371},"line",1,[368,373,374],{},"sequenceDiagram\n",[368,376,378],{"class":370,"line":377},2,[368,379,380],{},"User->>+Qualification: Send Request\n",[368,382,384],{"class":370,"line":383},3,[368,385,386],{},"Approver-->Qualification: Approve Request\n",[368,388,390],{"class":370,"line":389},4,[368,391,392],{},"User-->Exam: Take exam\n",[368,394,396],{"class":370,"line":395},5,[368,397,398],{},"User->>Exam: Submit exam response\n",[368,400,402],{"class":370,"line":401},6,[368,403,404],{},"Approver->>Exam: Create Result\n",[269,406,408],{"id":407},"flow-enabled","Flow - Enabled",[356,410,411],{},[359,412,414],{"className":361,"code":413,"language":356,"meta":363,"style":363},"sequenceDiagra