[200,218,219,230,233,236],{},[203,220,221,222],{},"Qualification: Holds all basic infos about the qualification.\n",[200,223,224,227],{},[203,225,226],{},"Access: Holds the access levels to the qualification.",[203,228,229],{},"Requirements: Requirements to be able to take the qualification. -> Don't deny the access to the qualification like access, but are required to send a request or to take the qualification.",[203,231,232],{},"Requests: List of user requests to take the test for the qualification.",[203,234,235],{},"Results: A \"mapping\" of score of an user test.",[203,237,238,239],{},"Tests: Test progress of (started) tests from users.\n",[200,240,241,244,247],{},[203,242,243],{},"Info\u002FConfig of the Test: E.g., how many questions need to be right to pass, how much time do they have, etc.",[203,245,246],{},"Test Questions: Questions for the qualification tests.",[203,248,249],{},"User Test Answers: Answered questions \"waiting for approval\" by a \"trainer\".",[213,251,253],{"id":252},"access-levels","Access Levels",[187,255,256],{},"Similarily structured to documents access levels.",[200,258,259,262,265,268,271,274],{},[203,260,261],{},"Blocked.",[203,263,264],{},"View.",[203,266,267],{},"Request.",[203,269,270],{},"Take.",[203,272,273],{},"Grade.",[203,275,276],{},"Edit.",[195,278,280],{"id":279},"exams","Exams",[187,282,283],{},"3 modes for a qualification with an exam:",[200,285,286,289,292],{},[203,287,288],{},"Disabled.",[203,290,291],{},"Request needed.",[203,293,294],{},"Enabled.",[213,296,298],{"id":297},"flow-request-needed","Flow - Request needed",[300,301,302],"mermaid",{},[303,304,308],"pre",{"className":305,"code":306,"language":300,"meta":307,"style":307},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sequenceDiagram\nUser->>+Qualification: Send Request\nApprover-->Qualification: Approve Request\nUser-->Exam: Take exam\nUser->>Exam: Submit exam response\nApprover->>Exam: Create Result\n