218,223,224],{},"i18n\u002Flocales\u002Ffr\u002Ffr.json"," for French).",[208,227,228,229,232],{},"Copy the contents of an existing language file (e.g., ",[218,230,231],{},"en\u002Fen.json",") into the new language's folder.",[208,234,235],{},"Translate the messages\u002Fvalues into the new language.",[208,237,238,239,242,243,246,247,368,371,372,375,376,378,379,382,383,386,387,390],{},"Add the new language to the ",[218,240,241],{},"i18n.locales"," array in the ",[218,244,245],{},"nuxt.config.ts"," file.",[248,249,254],"pre",{"className":250,"code":251,"language":252,"meta":253,"style":253},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n    name: 'French',\n    code: 'fr',\n    language: 'fr',\n    files: ['fr\u002Ffr.json'],\n    icon: 'i-flagpack-fr',\n},\n","ts","",[218,255,256,265,288,305,321,345,362],{"__ignoreMap":253},[257,258,261],"span",{"class":259,"line":260},"line",1,[257,262,264],{"class":263},"sMK4o","{\n",[257,266,268,272,275,278,282,285],{"class":259,"line":267},2,[257,269,271],{"class":270},"sBMFI","    name",[257,273,274],{"class":263},":",[257,276,277],{"class":263}," '",[257,279,281],{"class":280},"sfazB","French",[257,283,284],{"class":263},"'",[257,286,287],{"class":263},",\n",[257,289,291,294,296,298,301,303],{"class":259,"line":290},3,[257,292,293],{"class":270},"    code",[257,295,274],{"class":263},[257,297,277],{"class":263},[257,299,300],{"class":280},"fr",[257,302,284],{"class":263},[257,304,287],{"class":263},[257,306,308,311,313,315,317,319],{"class":259,"line":307},4,[257,309,310],{"class":270},"    language",[257,312,274],{"class":263},[257,314,277],{"class":263},[257,316,300],{"class":280},[257,318,284],{"class":263},[257,320,287],{"class":263},[257,322,324,327,329,333,335,338,340,343],{"class":259,"line":323},5,[257,325,326],{"class":270},"    files",[257,328,274],{"class":263},[257,330,332],{"class":331},"swJcz"," [",[257,334,284],{"class":263},[257,336,337],{"class":280},"fr\u0