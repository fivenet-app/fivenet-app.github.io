ign\u002Fdispatch-center",{"title":227,"path":228,"stem":229},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":231,"path":232,"stem":233},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":235,"path":236,"stem":237},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":239,"title":32,"body":240,"description":642,"extension":643,"links":644,"meta":645,"navigation":324,"path":33,"redirect":644,"seo":646,"stem":34,"__hash__":647},"content_en\u002F1.getting-started\u002F3.components.md",{"type":241,"value":242,"toc":625},"minimark",[243,247,252,385,389,394,397,401,404,408,411,419,423,426,430,434,437,441,444,448,452,455,458,462,621],[244,245,246],"p",{},"This page gives you a quick overview of the main FiveNet components and how data moves between them.",[248,249,251],"h2",{"id":250},"simplified-architecture","Simplified Architecture",[253,254,255],"mermaid",{},[256,257,261],"pre",{"className":258,"code":259,"language":253,"meta":260,"style":260},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[262,263,264,272,278,284,290,295,301,307,313,319,326,332,338,343,349,355,361,367,373,379],"code",{"__ignoreMap":260},[265,266,269],"span",{"class":267,"line":268},"line",1,[265,270,271],{},"---\n",[265,273,275],{"class":267,"line":274},2,[265,276,277],{},"config:\n",[265,279,281],{"class":267,"line":280},3,[265,282,283],{},"  theme: dark\n",[265,285,287],{"class":267,"line":286},4,[265,288,289],{},"  layout: elk\n",[265,291,293],{"class":267,"line":292},5,[265,294,271],{},[265,296,298],{"class":267,"line":297},6,[265,299,300],{},"flowchart TD\n",[265,302,304],{"class":267,"line":303},7,[265,305,306],{},"    User -->|Browser| FiveNet\n",[265,308,310],{"class":267,"line":309},8,[265,311,312],{},"    User --> Gameserver\n",[265,314,316],{"class":267,"line":315},9,[265,317,318],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[265,320,322],{"class":267,"line":321},10,[265,323,325],{"emptyLinePlaceholder":324},true,"\n",[265,327,329],{"class":267,"line":328},11,[265,330,331],{},"    FiveNet --> MySQL\n",[265,333,335],{"class":267,"line":334},12,[265,336,337],{},"    FiveNet --> NATS\n",[265,339,341],{"class":267,"line":340},13,[265,342,325],{"emptyLinePlaceholder":324},[265,344,346],{"class":267,"line":345},14,[265,347,348],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[265,350,352],{"class":267,"line":351},15,[265,353,354],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[265,356,358],{"class":267,"line":357},16,[265,359,360],{},"    DBSync -->|gRPC| FiveNet\n",[265,362,364],{"class":267,"line":363},17,[265,365,366],{},"    DBSync --> MySQL2\n",[265,368,370],{"class":267,"line":369},18,[265,371,372],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[265,374,376],{"class":267,"line":375},19,[265,377,378],{},"    MySQL[(MySQL)]\n",[265,380,382],{"class":267,"line":381},20,[265,383,384],{},"    NATS[(NATS)]\n",[248,386,388],{"id":387},"core-components","Core Components",[390,391,393],"h3",{"id":392},"fivenet-server","FiveNet Server",[244,395,396],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[390,398,400],{"id":399},"fivenet-worker","FiveNet Worker",[244,402,403],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[390,405,407],{"id":406},"fivenet-dbsync","FiveNet DBSync",[244,409,410],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[244,412,413,414,418],{},"It does ",[415,416,417],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[390,420,422],{"id":421},"fivenet-discord-bot","FiveNet Discord Bot",[244,424,425],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[248,427,429],{"id":428},"supporting-services","Supporting Services",[390,431,433],{"id":432},"nats-message-queue","NATS Message Queue",[244,435,436],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[390,438,440],{"id":439},"mysql-database-server","MySQL Database Server",[244,442,443],{},"MySQL or MariaDB stores the main FiveNet application data.",[248,445,447],{"id":446},"gameserver-integration","Gameserver Integration",[390,449,451],{"id":450},"fivenet-plugin","FiveNet Plugin",[244,453,454],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[244,456,457],{},"If enabled, it also sends player locations for the live map.",[248,459,461],{"id":460},"full-architecture","Full Architecture",[253,463,464],{},[256,465,467],{"className":258,"code":466,"language":253,"meta":260,"style":260},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[262,468,469,473,477,481,485,489,493,498,503,508,513,518,523,528,533,538,543,547,552,557,562,568,574,580,586,592,598,604,610,615],{"__ignoreMap":260},[265,470,471],{"class":267,"line":268},[265,472,271],{},[265,474,475],{"class":267,"line":274},[265,476,277],{},[265,478,479],{"class":267,"line":280},[265,480,283],{},[265,482,483],{"class":267,"line":286},[265,484,289],{},[265,486,487],{"class":267,"line":292},[265,488,271],{},[265,490,491],{"class":267,"line":297},[265,492,300],{},[265,494,495],{"class":267,"line":303},[265,496,497],{}," subgraph FiveNet[\"FiveNet\"]\n",[265,499,500],{"class":267,"line":309},[265,501,502],{},"        DiscordBot[\"FiveNet Discord Bot\"]\n",[265,504,505],{"class":267,"line":315},[265,506,507],{},"        Server[\"FiveNet Server\"]\n",[265,509,510],{"class":267,"line":321},[265,511,512],{},"        Worker[\"FiveNet Worker\"]\n",[265,514,515],{"class":267,"line":328},[265,516,517],{},"        NATS[\"NATS Message Queue\"]\n",[265,519,520],{"class":267,"line":334},[265,521,522],{},"        MYSQL[\"MySQL Database Server\"]\n",[265,524,525],{"class":267,"line":340},[265,526,527],{},"  end\n",[265,529,530],{"class":267,"line":345},[265,531,532],{}," subgraph Gameserver[\"Gameserver\"]\n",[265,534,535],{"class":267,"line":351},[265,536,537],{},"        Plugin[\"FiveNet Plugin\"]\n",[265,539,540],{"class":267,"line":357},[265,541,542],{},"        DBSync[\"FiveNet DBSync\"]\n",[265,544,545],{"class":267,"line":363},[265,546,527],{},[265,548,549],{"class":267,"line":369},[265,550,551],{},"    User(\"User\") -- HTTP --> Server\n",[265,553,554],{"class":267,"line":375},[265,555,556],{},"    User -. Websocket .- Server\n",[265,558,559],{"class":267,"line":381},[265,560,561]