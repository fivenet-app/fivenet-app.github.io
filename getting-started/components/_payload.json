ponents.md","Components",{"type":204,"value":205,"toc":588},"minimark",[206,210,215,348,352,357,360,364,367,371,374,382,386,389,393,397,400,404,407,411,415,418,421,425,584],[207,208,209],"p",{},"This page gives you a quick overview of the main FiveNet components and how data moves between them.",[211,212,214],"h2",{"id":213},"simplified-architecture","Simplified Architecture",[216,217,218],"mermaid",{},[219,220,224],"pre",{"className":221,"code":222,"language":216,"meta":223,"style":223},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[225,226,227,235,241,247,253,258,264,270,276,282,289,295,301,306,312,318,324,330,336,342],"code",{"__ignoreMap":223},[228,229,232],"span",{"class":230,"line":231},"line",1,[228,233,234],{},"---\n",[228,236,238],{"class":230,"line":237},2,[228,239,240],{},"config:\n",[228,242,244],{"class":230,"line":243},3,[228,245,246],{},"  theme: dark\n",[228,248,250],{"class":230,"line":249},4,[228,251,252],{},"  layout: elk\n",[228,254,256],{"class":230,"line":255},5,[228,257,234],{},[228,259,261],{"class":230,"line":260},6,[228,262,263],{},"flowchart TD\n",[228,265,267],{"class":230,"line":266},7,[228,268,269],{},"    User -->|Browser| FiveNet\n",[228,271,273],{"class":230,"line":272},8,[228,274,275],{},"    User --> Gameserver\n",[228,277,279],{"class":230,"line":278},9,[228,280,281],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[228,283,285],{"class":230,"line":284},10,[228,286,288],{"emptyLinePlaceholder":287},true,"\n",[228,290,292],{"class":230,"line":291},11,[228,293,294],{},"    FiveNet --> MySQL\n",[228,296,298],{"class":230,"line":297},12,[228,299,300],{},"    FiveNet --> NATS\n",[228,302,304],{"class":230,"line":303},13,[228,305,288],{"emptyLinePlaceholder":287},[228,307,309],{"class":230,"line":308},14,[228,310,311],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[228,313,315],{"class":230,"line":314},15,[228,316,317],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[228,319,321],{"class":230,"line":320},16,[228,322,323],{},"    DBSync -->|gRPC| FiveNet\n",[228,325,327],{"class":230,"line":326},17,[228,328,329],{},"    DBSync --> MySQL2\n",[228,331,333],{"class":230,"line":332},18,[228,334,335],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[228,337,339],{"class":230,"line":338},19,[228,340,341],{},"    MySQL[(MySQL)]\n",[228,343,345],{"class":230,"line":344},20,[228,346,347],{},"    NATS[(NATS)]\n",[211,349,351],{"id":350},"core-components","Core Components",[353,354,356],"h3",{"id":355},"fivenet-server","FiveNet Server",[207,358,359],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[353,361,363],{"id":362},"fivenet-worker","FiveNet Worker",[207,365,366],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[353,368,370],{"id":369},"fivenet-dbsync","FiveNet DBSync",[207,372,373],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[207,375,376,377,381],{},"It does ",[378,379,380],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[353,383,385],{"id":384},"fivenet-discord-bot","FiveNet Discord Bot",[207,387,388],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[211,390,392],{"id":391},"supporting-services","Supporting Services",[353,394,396],{"id":395},"nats-message-queue","NATS Message Queue",[207,398,399],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[353,401,403],{"id":402},"mysql-database-server","MySQL Database Server",[207,405,406],{},"MySQL or MariaDB stores the main FiveNet application data.",[211,408,410],{"id":409},"gameserver-integration","Gameserver Integration",[353,412,414],{"id":413},"fivenet-plugin","FiveNet Plugin",[207,416,417],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[207,419,420],{},"If enabled, it also sends player locations for the live map.",[211,422,424],{"id":423},"full-architecture","Full Architecture",[216,426,427],{},[219,428,430],{"className":221,"code":429,"language":216,"meta":223,"style":223},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[225,431,432,436,440,444,448,452,456,461,466,471,476,481,486,491,496,501,506,510,515,520,525,531,537,543,549,555,561,567,573,578],{"__ignoreMap":223},[228,433,434],{"class":230,"line":231},[228,435,234],{},[228,437,438],{"class":230,"line":237},[228,439,240],{},[228,441,442],{"class":230,"line":243},[228,443,246],{},[228,445,446],{"clas