path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":24,"body":235,"description":637,"extension":638,"links":639,"meta":640,"navigation":319,"path":25,"redirect":639,"seo":641,"stem":26,"__hash__":642},"content_en\u002F1.getting-started\u002F3.components.md",{"type":236,"value":237,"toc":620},"minimark",[238,242,247,380,384,389,392,396,399,403,406,414,418,421,425,429,432,436,439,443,447,450,453,457,616],[239,240,241],"p",{},"This page gives you a quick overview of the main FiveNet components and how data moves between them.",[243,244,246],"h2",{"id":245},"simplified-architecture","Simplified Architecture",[248,249,250],"mermaid",{},[251,252,256],"pre",{"className":253,"code":254,"language":248,"meta":255,"style":255},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[257,258,259,267,273,279,285,290,296,302,308,314,321,327,333,338,344,350,356,362,368,374],"code",{"__ignoreMap":255},[260,261,264],"span",{"class":262,"line":263},"line",1,[260,265,266],{},"---\n",[260,268,270],{"class":262,"line":269},2,[260,271,272],{},"config:\n",[260,274,276],{"class":262,"line":275},3,[260,277,278],{},"  theme: dark\n",[260,280,282],{"class":262,"line":281},4,[260,283,284],{},"  layout: elk\n",[260,286,288],{"class":262,"line":287},5,[260,289,266],{},[260,291,293],{"class":262,"line":292},6,[260,294,295],{},"flowchart TD\n",[260,297,299],{"class":262,"line":298},7,[260,300,301],{},"    User -->|Browser| FiveNet\n",[260,303,305],{"class":262,"line":304},8,[260,306,307],{},"    User --> Gameserver\n",[260,309,311],{"class":262,"line":310},9,[260,312,313],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[260,315,317],{"class":262,"line":316},10,[260,318,320],{"emptyLinePlaceholder":319},true,"\n",[260,322,324],{"class":262,"line":323},11,[260,325,326],{},"    FiveNet --> MySQL\n",[260,328,330],{"class":262,"line":329},12,[260,331,332],{},"    FiveNet --> NATS\n",[260,334,336],{"class":262,"line":335},13,[260,337,320],{"emptyLinePlaceholder":319},[260,339,341],{"class":262,"line":340},14,[260,342,343],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[260,345,347],{"class":262,"line":346},15,[260,348,349],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[260,351,353],{"class":262,"line":352},16,[260,354,355],{},"    DBSync -->|gRPC| FiveNet\n",[260,357,359],{"class":262,"line":358},17,[260,360,361],{},"    DBSync --> MySQL2\n",[260,363,365],{"class":262,"line":364},18,[260,366,367],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[260,369,371],{"class":262,"line":370},19,[260,372,373],{},"    MySQL[(MySQL)]\n",[260,375,377],{"class":262,"line":376},20,[260,378,379],{},"    NATS[(NATS)]\n",[243,381,383],{"id":382},"core-components","Core Components",[385,386,388],"h3",{"id":387},"fivenet-server","FiveNet Server",[239,390,391],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[385,393,395],{"id":394},"fivenet-worker","FiveNet Worker",[239,397,398],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[385,400,402],{"id":401},"fivenet-dbsync","FiveNet DBSync",[239,404,405],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[239,407,408,409,413],{},"It does ",[410,411,412],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[385,415,417],{"id":416},"fivenet-discord-bot","FiveNet Discord Bot",[239,419,420],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[243,422,424],{"id":423},"supporting-services","Supporting Services",[385,426,428],{"id":427},"nats-message-queue","NATS Message Queue",[239,430,431],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[385,433,435],{"id":434},"mysql-database-server","MySQL Database Server",[239,437,438],{},"MySQL or MariaDB stores the main FiveNet application data.",[243,440,442],{"id":441},"gameserver-integration","Gameserver Integration",[385,444,446],{"id":445},"fivenet-plugin","FiveNet Plugin",[239,448,449],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[239,451,452],{},"If enabled, it also sends player locations for the live map.",[243,454,456],{"id":455},"full-architecture","Full Architecture",[248,458,459],{},[251,460,462],{"className":253,"code":461,"language":248,"meta":255,"style":255},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[257,463,464,468,472,476,480,484,4