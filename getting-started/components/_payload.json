\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[205,206,207,215,221,227,233,238,244,250,256,262,269,275,281,286,292,298,304,310,316,322],"code",{"__ignoreMap":203},[208,209,212],"span",{"class":210,"line":211},"line",1,[208,213,214],{},"---\n",[208,216,218],{"class":210,"line":217},2,[208,219,220],{},"config:\n",[208,222,224],{"class":210,"line":223},3,[208,225,226],{},"  theme: dark\n",[208,228,230],{"class":210,"line":229},4,[208,231,232],{},"  layout: elk\n",[208,234,236],{"class":210,"line":235},5,[208,237,214],{},[208,239,241],{"class":210,"line":240},6,[208,242,243],{},"flowchart TD\n",[208,245,247],{"class":210,"line":246},7,[208,248,249],{},"    User -->|Browser| FiveNet\n",[208,251,253],{"class":210,"line":252},8,[208,254,255],{},"    User --> Gameserver\n",[208,257,259],{"class":210,"line":258},9,[208,260,261],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[208,263,265],{"class":210,"line":264},10,[208,266,268],{"emptyLinePlaceholder":267},true,"\n",[208,270,272],{"class":210,"line":271},11,[208,273,274],{},"    FiveNet --> MySQL\n",[208,276,278],{"class":210,"line":277},12,[208,279,280],{},"    FiveNet --> NATS\n",[208,282,284],{"class":210,"line":283},13,[208,285,268],{"emptyLinePlaceholder":267},[208,287,289],{"class":210,"line":288},14,[208,290,291],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[208,293,295],{"class":210,"line":294},15,[208,296,297],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[208,299,301],{"class":210,"line":300},16,[208,302,303],{},"    DBSync -->|gRPC| FiveNet\n",[208,305,307],{"class":210,"line":306},17,[208,308,309],{},"    DBSync --> MySQL2\n",[208,311,313],{"class":210,"line":312},18,[208,314,315],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[208,317,319],{"class":210,"line":318},19,[208,320,321],{},"    MySQL[(MySQL)]\n",[208,323,325],{"class":210,"line":324},20,[208,326,327],{},"    NATS[(NATS)]\n",[191,329,331],{"id":330},"core-components","Core Components",[333,334,336],"h3",{"id":335},"fivenet-server","FiveNet Server",[187,338,339],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[333,341,343],{"id":342},"fivenet-worker","FiveNet Worker",[187,345,346],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[333,348,350],{"id":349},"fivenet-dbsync","FiveNet DBSync",[187,352,353],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[187,355,356,357,361],{},"It does ",[358,359,360],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[333,363,365],{"id":364},"fivenet-discord-bot","FiveNet Discord Bot",[187,367,368],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[191,370,372],{"id":371},"supporting-services","Supporting Services",[333,374,376],{"id":375},"nats-message-queue","NATS Message Queue",[187,378,379],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[333,381,383],{"id":382},"mysql-database-server","MySQL Database Server",[187,385,386],{},"MySQL or MariaDB stores the main FiveNet application data.",[191,388,390],{"id":389},"gameserver-integration","Gameserver Integration",[333,392,394],{"id":393},"fivenet-plugin","FiveNet Plugin",[187,396,397],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[187,399,400],{},"If enabled, it also sends player locations for the live map.",[191,402,404],{"id":403},"full-architecture","Full Architecture",[196,406,407],{},[199,408,410],{"className":201,"code":409,"language":196,"meta":203,"style":203},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[205,411,412,416,420,424,428,432,436,441,446,451,456,461,466,471,476,481,486,490,495,500,505,511,517,523,529,535,541,547,553,558],{"__ignoreMap":203},[208,413,414],{"class":210,"line":211},[208,415,214],{},[208,417,418],{"class":210,"line":217},[208,419,220],{},[208,421,422],{"class":210,"line":223},[208,423,226],{},[208,425,426],{"class":210,"line":229},[208,427,232],{},[208,429,430],{"class":210,"line":235},[208,431,214],{},[208,433,434],{"class":210,"line":240},[208,435,243],{},[208,437,438],{"class":210,"line":246},[208,439,440],{}," subgraph FiveNet[\"FiveNet\"]\n",[208,442,443],{"class":210,"line":252},[208,444,445],{},"        DiscordBot[\"FiveNet Discord Bot\"]\n",[208,447,448],{"class":210,"line":258},[208,449,450],{},"        Server[\"FiveNet Server\"]\n",[208,452,453],{"class":210,"line":264},[208,454,455],{},"        Worker[\"FiveNet Worker\"]\n",[208,457,458],{"class":210,"line":271},[208,459,460],{},"        NATS[\"NATS Message Queue\"]\n",[208,462,463],{"class":210,"line":277},[208,464,465],{},"        MYSQL[\"MySQL Database Server\"]\n",[208,467,468],{"class":210,"line":283},[208,469,470],