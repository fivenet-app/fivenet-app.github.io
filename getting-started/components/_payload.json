231,232,236],"pre",{"className":233,"code":234,"language":228,"meta":235,"style":235},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[237,238,239,247,253,259,265,270,276,282,288,294,301,307,313,318,324,330,336,342,348,354],"code",{"__ignoreMap":235},[240,241,244],"span",{"class":242,"line":243},"line",1,[240,245,246],{},"---\n",[240,248,250],{"class":242,"line":249},2,[240,251,252],{},"config:\n",[240,254,256],{"class":242,"line":255},3,[240,257,258],{},"  theme: dark\n",[240,260,262],{"class":242,"line":261},4,[240,263,264],{},"  layout: elk\n",[240,266,268],{"class":242,"line":267},5,[240,269,246],{},[240,271,273],{"class":242,"line":272},6,[240,274,275],{},"flowchart TD\n",[240,277,279],{"class":242,"line":278},7,[240,280,281],{},"    User -->|Browser| FiveNet\n",[240,283,285],{"class":242,"line":284},8,[240,286,287],{},"    User --> Gameserver\n",[240,289,291],{"class":242,"line":290},9,[240,292,293],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[240,295,297],{"class":242,"line":296},10,[240,298,300],{"emptyLinePlaceholder":299},true,"\n",[240,302,304],{"class":242,"line":303},11,[240,305,306],{},"    FiveNet --> MySQL\n",[240,308,310],{"class":242,"line":309},12,[240,311,312],{},"    FiveNet --> NATS\n",[240,314,316],{"class":242,"line":315},13,[240,317,300],{"emptyLinePlaceholder":299},[240,319,321],{"class":242,"line":320},14,[240,322,323],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[240,325,327],{"class":242,"line":326},15,[240,328,329],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[240,331,333],{"class":242,"line":332},16,[240,334,335],{},"    DBSync -->|gRPC| FiveNet\n",[240,337,339],{"class":242,"line":338},17,[240,340,341],{},"    DBSync --> MySQL2\n",[240,343,345],{"class":242,"line":344},18,[240,346,347],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[240,349,351],{"class":242,"line":350},19,[240,352,353],{},"    MySQL[(MySQL)]\n",[240,355,357],{"class":242,"line":356},20,[240,358,359],{},"    NATS[(NATS)]\n",[223,361,363],{"id":362},"core-components","Core Components",[365,366,368],"h3",{"id":367},"fivenet-server","FiveNet Server",[219,370,371],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[365,373,375],{"id":374},"fivenet-worker","FiveNet Worker",[219,377,378],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[365,380,382],{"id":381},"fivenet-dbsync","FiveNet DBSync",[219,384,385],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[219,387,388,389,393],{},"It does ",[390,391,392],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[365,395,397],{"id":396},"fivenet-discord-bot","FiveNet Discord Bot",[219,399,400],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[223,402,404],{"id":403},"supporting-services","Supporting Services",[365,406,408],{"id":407},"nats-message-queue","NATS Message Queue",[219,410,411],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[365,413,415],{"id":414},"mysql-database-server","MySQL Database Server",[219,417,418],{},"MySQL or MariaDB stores the main FiveNet application data.",[223,420,422],{"id":421},"gameserver-integration","Gameserver Integration",[365,424,426],{"id":425},"fivenet-plugin","FiveNet Plugin",[219,428,429],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[219,431,432],{},"If enabled, it also sends player locations for the live map.",[223,434,436],{"id":435},"full-architecture","Full Architecture",[228,438,439],{},[231,440,442],{"className":233,"code":441,"language":228,"meta":235,"style":235},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[237,443,444,448,452,456,460,464,468,473,478,483,488,493,498,503,508,513,518,522,527,532,537,543,549,555,561,567,573,579,585,590],{"__ignoreMap":235},[240,445,446],{"class":242,"line":243},[240,447,246],{},[240,449,450],{"class":242,"line":249},[240,451,252],{},[240,453,454],{"class":242,"line":255},[240,455,258],{},[240,457,458],{"class":242,"line":261},[240,459,264],{},[240,461,462],{"class":242,"line":267},[240,463,246],{},[240,465,466],{"class":242,"line":272},[240,467,275],{},[240,469,470],{"class":242,"line":278},[240,471,472],{}," subgraph FiveNet[\"FiveNet\"]\n",[240,474,475],{"class":242,"line":284},[240,476,477],{},"        DiscordBot[\"FiveNet Discord Bot\"]\n",[240,479,480],{"class":242,"line":290},[240,481,482],{},"       