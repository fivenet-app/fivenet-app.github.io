  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[209,210,211,219,225,231,237,242,248,254,260,266,273,279,285,290,296,302,308,314,320,326],"code",{"__ignoreMap":207},[212,213,216],"span",{"class":214,"line":215},"line",1,[212,217,218],{},"---\n",[212,220,222],{"class":214,"line":221},2,[212,223,224],{},"config:\n",[212,226,228],{"class":214,"line":227},3,[212,229,230],{},"  theme: dark\n",[212,232,234],{"class":214,"line":233},4,[212,235,236],{},"  layout: elk\n",[212,238,240],{"class":214,"line":239},5,[212,241,218],{},[212,243,245],{"class":214,"line":244},6,[212,246,247],{},"flowchart TD\n",[212,249,251],{"class":214,"line":250},7,[212,252,253],{},"    User -->|Browser| FiveNet\n",[212,255,257],{"class":214,"line":256},8,[212,258,259],{},"    User --> Gameserver\n",[212,261,263],{"class":214,"line":262},9,[212,264,265],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[212,267,269],{"class":214,"line":268},10,[212,270,272],{"emptyLinePlaceholder":271},true,"\n",[212,274,276],{"class":214,"line":275},11,[212,277,278],{},"    FiveNet --> MySQL\n",[212,280,282],{"class":214,"line":281},12,[212,283,284],{},"    FiveNet --> NATS\n",[212,286,288],{"class":214,"line":287},13,[212,289,272],{"emptyLinePlaceholder":271},[212,291,293],{"class":214,"line":292},14,[212,294,295],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[212,297,299],{"class":214,"line":298},15,[212,300,301],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[212,303,305],{"class":214,"line":304},16,[212,306,307],{},"    DBSync -->|gRPC| FiveNet\n",[212,309,311],{"class":214,"line":310},17,[212,312,313],{},"    DBSync --> MySQL2\n",[212,315,317],{"class":214,"line":316},18,[212,318,319],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[212,321,323],{"class":214,"line":322},19,[212,324,325],{},"    MySQL[(MySQL)]\n",[212,327,329],{"class":214,"line":328},20,[212,330,331],{},"    NATS[(NATS)]\n",[195,333,335],{"id":334},"core-components","Core Components",[337,338,340],"h3",{"id":339},"fivenet-server","FiveNet Server",[191,342,343],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[337,345,347],{"id":346},"fivenet-worker","FiveNet Worker",[191,349,350],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[337,352,354],{"id":353},"fivenet-dbsync","FiveNet DBSync",[191,356,357],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[191,359,360,361,365],{},"It does ",[362,363,364],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[337,367,369],{"id":368},"fivenet-discord-bot","FiveNet Discord Bot",[191,371,372],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[195,374,376],{"id":375},"supporting-services","Supporting Services",[337,378,380],{"id":379},"nats-message-queue","NATS Message Queue",[191,382,383],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[337,385,387],{"id":386},"mysql-database-server","MySQL Database Server",[191,389,390],{},"MySQL or MariaDB stores the main FiveNet application data.",[195,392,394],{"id":393},"gameserver-integration","Gameserver Integration",[337,396,398],{"id":397},"fivenet-plugin","FiveNet Plugin",[191,400,401],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[191,403,404],{},"If enabled, it also sends player locations for the live map.",[195,406,408],{"id":407},"full-architecture","Full Architecture",[200,410,411],{},[203,412,414],{"className":205,"code":413,"language":200,"meta":207,"style":207},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[209,415,416,420,424,428,432,436,440,445,450,455,460,465,470,475,480,485,490,494,499,504,509,515,521,527,533,539,545,551,557,562],{"__ignoreMap":207},[212,417,418],{"class":214,"line":215},[212,419,218],{},[212,421,422],{"class":214,"line":221},[212,423,224],{},[212,425,426],{"class":214,"line":227},[212,427,230],{},[212,429,430],{"class":214,"line":233},[212,431,236],{},[212,433,434],{"class":214,"line":239},[212,435,218],{},[212,437,438],{"class":214,"line":244},[212,439,247],{},[212,441,442],{"class":214,"line":250},[212,443,444],{}," subgraph FiveNet[\"FiveNet\"]\n",[212,446,447],{"class":214,"line":256},[212,448,449],{},"        DiscordBot[\"FiveNet Discord Bot\"]\n",[212,451,452],{"class":214,"line":262},[212,453,454],{},"        Server[\"FiveNet Server\"]\n",[212,456,457],{"class":214,"line":268},[212,458,459],{},"        Worker[\"FiveNet Worker\"]\n",[212,461,462],{"class":214,"line":275},[212,463,464],{},"        NATS[\"NATS Message Queue\"]\n",[212,466,467],{"class":214,"line":281},[212,468,469],{},"        MYSQL[\"MySQL Database Server\"]\n",[212,471,472],{"class":214,"line":287},[212,473,474],{},"  end\n",[212,476,477],{"class":214,"line":292},[212,478,479],{}," subgraph Gameserver[\"Gameserver\"]\n",[212,481,482],{"class":214,"line":298},[212,483,484],{},"        Plugin[\"FiveNet Plugin\"]\n",[212,486,487],{"class":214,"line":304},[212,488,489],{},"        DBSync[\"FiveNet DBSync\"]\n",[212,491,492],{"class":214,"line":310},[212,493,474],{},[212,495,496],{"class":214,"line":316},[212,497,498],{},"    User(\"User\") -- HTTP --> Server\n",[212,500,501],{"class":214,"line":322},[212,502,503],{},"    User -. Websocket .- Server\n",[212,505,506],{"class":214,"line":328},[212,507,508],{},"    Server -- MySQL --- MYSQL\n",[212,510,512],{"class":214,"line":511},21,[212,513,514],{},"    Worker -- MySQL --- MYSQL\n",[212,516,518],{"class":214,"line":517},22,[212,519,520],{},"    DiscordBot -- MySQL --- MYSQL\n",[212,522,524],{"class":214,"line":523},23,[212,525,526],{},"    Server -- NATS --- NATS\n",[212,528,530],{"class":214,"line":529},24,[212,531,532],{},"    Worker -- NATS --- NATS\n",[212,534,536],{"class":214,"line":535},25,[212,537,538],{},"    DiscordBot -- NATS --- NATS\n",[212,540,542],{"class":214,"line":541},26,[212,543,544],{},"    Plugin -- HTTP --> Server\n",[212,546,548],{"class":214,"line":547},27,[212,549,550],{},"    DBSync -- GRPC ---> Server\n",[212,552,554],{"class":214,"line":553},28,[212,555,556],{},"    DBSync \u003C-. GRPC Stream ..-> Server\n",[212,558,560],{"class":214,"line":559},29,[212,561,272],{"emptyLinePlaceholder":271},[212,563,565],{"class":214,"line":564},30,[212,566,567],{},"    User -- NUI Callbacks --> Plugin\n",[569,570,571],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.lig