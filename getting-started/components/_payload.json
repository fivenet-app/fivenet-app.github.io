and how data moves between them.",[227,228,230],"h2",{"id":229},"simplified-architecture","Simplified Architecture",[232,233,234],"mermaid",{},[235,236,240],"pre",{"className":237,"code":238,"language":232,"meta":239,"style":239},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n    User -->|Browser| FiveNet\n    User --> Gameserver\n    Gameserver --->|HTTP \u002F gRPC| FiveNet\n\n    FiveNet --> MySQL\n    FiveNet --> NATS\n\n    FiveNet[\"FiveNet (Server, Worker)\"]\n    Gameserver[\"Gameserver (Plugin)\"]\n    DBSync -->|gRPC| FiveNet\n    DBSync --> MySQL2\n    Gameserver \u003C--> MySQL2[(MySQL)]\n    MySQL[(MySQL)]\n    NATS[(NATS)]\n","",[241,242,243,251,257,263,269,274,280,286,292,298,305,311,317,322,328,334,340,346,352,358],"code",{"__ignoreMap":239},[244,245,248],"span",{"class":246,"line":247},"line",1,[244,249,250],{},"---\n",[244,252,254],{"class":246,"line":253},2,[244,255,256],{},"config:\n",[244,258,260],{"class":246,"line":259},3,[244,261,262],{},"  theme: dark\n",[244,264,266],{"class":246,"line":265},4,[244,267,268],{},"  layout: elk\n",[244,270,272],{"class":246,"line":271},5,[244,273,250],{},[244,275,277],{"class":246,"line":276},6,[244,278,279],{},"flowchart TD\n",[244,281,283],{"class":246,"line":282},7,[244,284,285],{},"    User -->|Browser| FiveNet\n",[244,287,289],{"class":246,"line":288},8,[244,290,291],{},"    User --> Gameserver\n",[244,293,295],{"class":246,"line":294},9,[244,296,297],{},"    Gameserver --->|HTTP \u002F gRPC| FiveNet\n",[244,299,301],{"class":246,"line":300},10,[244,302,304],{"emptyLinePlaceholder":303},true,"\n",[244,306,308],{"class":246,"line":307},11,[244,309,310],{},"    FiveNet --> MySQL\n",[244,312,314],{"class":246,"line":313},12,[244,315,316],{},"    FiveNet --> NATS\n",[244,318,320],{"class":246,"line":319},13,[244,321,304],{"emptyLinePlaceholder":303},[244,323,325],{"class":246,"line":324},14,[244,326,327],{},"    FiveNet[\"FiveNet (Server, Worker)\"]\n",[244,329,331],{"class":246,"line":330},15,[244,332,333],{},"    Gameserver[\"Gameserver (Plugin)\"]\n",[244,335,337],{"class":246,"line":336},16,[244,338,339],{},"    DBSync -->|gRPC| FiveNet\n",[244,341,343],{"class":246,"line":342},17,[244,344,345],{},"    DBSync --> MySQL2\n",[244,347,349],{"class":246,"line":348},18,[244,350,351],{},"    Gameserver \u003C--> MySQL2[(MySQL)]\n",[244,353,355],{"class":246,"line":354},19,[244,356,357],{},"    MySQL[(MySQL)]\n",[244,359,361],{"class":246,"line":360},20,[244,362,363],{},"    NATS[(NATS)]\n",[227,365,367],{"id":366},"core-components","Core Components",[369,370,372],"h3",{"id":371},"fivenet-server","FiveNet Server",[223,374,375],{},"The server provides the HTTP API and serves the frontend assets, such as JavaScript, CSS, and map tiles.",[369,377,379],{"id":378},"fivenet-worker","FiveNet Worker",[223,381,382],{},"The worker handles background jobs such as dispatch assignment, expiration handling, cleanup tasks, and similar asynchronous work.",[369,384,386],{"id":385},"fivenet-dbsync","FiveNet DBSync",[223,388,389],{},"DBSync synchronizes persistent gameserver data, such as characters and vehicles, into FiveNet.",[223,391,392,393,397],{},"It does ",[394,395,396],"strong",{},"not"," handle live activity data like player locations or in-game events. That data is sent by the FiveNet plugin.",[369,399,401],{"id":400},"fivenet-discord-bot","FiveNet Discord Bot",[223,403,404],{},"The Discord bot can synchronize user groups and faction job-related user information with Discord servers.",[227,406,408],{"id":407},"supporting-services","Supporting Services",[369,410,412],{"id":411},"nats-message-queue","NATS Message Queue",[223,414,415],{},"NATS is used for communication between FiveNet components, notifications, and other internal messaging.",[369,417,419],{"id":418},"mysql-database-server","MySQL Database Server",[223,421,422],{},"MySQL or MariaDB stores the main FiveNet application data.",[227,424,426],{"id":425},"gameserver-integration","Gameserver Integration",[369,428,430],{"id":429},"fivenet-plugin","FiveNet Plugin",[223,432,433],{},"The gameserver plugin sends live activities and events from the gameserver to FiveNet, such as promotions, demotions, and other gameplay-related changes.",[223,435,436],{},"If enabled, it also sends player locations for the live map.",[227,438,440],{"id":439},"full-architecture","Full Architecture",[232,442,443],{},[235,444,446],{"className":237,"code":445,"language":232,"meta":239,"style":239},"---\nconfig:\n  theme: dark\n  layout: elk\n---\nflowchart TD\n subgraph FiveNet[\"FiveNet\"]\n        DiscordBot[\"FiveNet Discord Bot\"]\n        Server[\"FiveNet Server\"]\n        Worker[\"FiveNet Worker\"]\n        NATS[\"NATS Message Queue\"]\n        MYSQL[\"MySQL Database Server\"]\n  end\n subgraph Gameserver[\"Gameserver\"]\n        Plugin[\"FiveNet Plugin\"]\n        DBSync[\"FiveNet DBSync\"]\n  end\n    User(\"User\") -- HTTP --> Server\n    User -. Websocket .- Server\n    Server -- MySQL --- MYSQL\n    Worker -- MySQL --- MYSQL\n    DiscordBot -- MySQL --- MYSQL\n    Server -- NATS --- NATS\n    Worker -- NATS --- NATS\n    DiscordBot -- NATS --- NATS\n    Plugin -- HTTP --> Server\n    DBSync -- GRPC ---> Server\n    DBSync \u003C-. GRPC Stream ..-> Server\n\n    User -- NUI Callbacks --> Plugin\n",[241,447,448,452,456,460,464,468,472,477,482,487,492,497,502,507,512,517,522,526,531,536,541,547,553,559,565,571,577,583,589,594],{"__ignoreMap":239},[244,449,450],{"class":246,"line":247},[244,451,250],{},[244,453,454],{"class":246,"line":253},[244,455,256],{},[244,457,458],{"class":246,"line":259},[244,459,262],{},[244,461,462],{"class":246,"line":265},[244,463,268],{},[244,465,466],{"class":246,"line":271},[244,467,250],{},[244,469,470],{"class":246,"line":276},[244,471,279],{},[244,473,474],{"class":246,"line":282},[244,475,476],{}," subgraph FiveNet[\"FiveNet\"]\n",[244,478,479],{"class":2