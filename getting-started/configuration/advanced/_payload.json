hildren":170},"Development","\u002Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":79,"body":219,"description":581,"extension":582,"links":583,"meta":584,"navigation":585,"path":80,"redirect":583,"seo":586,"stem":81,"__hash__":587},"content_en\u002F1.getting-started\u002F5.configuration\u002F7.advanced.md",{"type":220,"value":221,"toc":570},"minimark",[222,226,231,234,263,271,276,318,322,332,335,346,356,360,367,370,381,389,393,399,402,408,412,415,418,422,566],[223,224,225],"p",{},"Use this page when your FiveNet setup goes beyond the basic installation and required configuration options.",[227,228,230],"h2",{"id":229},"common-advanced-topics","Common Advanced Topics",[223,232,233],{},"The most common advanced configuration areas are:",[235,236,237,245,251,257],"ul",{},[238,239,240,244],"li",{},[241,242,243],"strong",{},"Trusted proxies"," when FiveNet runs behind NGINX, Traefik, Cloudflare, or another reverse proxy.",[238,246,247,250],{},[241,248,249],{},"Object storage"," when uploads should be stored in S3-compatible storage instead of the local filesystem.",[238,252,253,256],{},[241,254,255],{},"OAuth2 providers"," when users should be able to authenticate through external identity providers.",[238,258,259,262],{},[241,260,261],{},"Tracing and observability"," for debugging, performance analysis, and distributed request tracing.",[223,264,265,266,270],{},"For the most important option names and config paths, see the ",[267,268,63],"a",{"href":269},".\u002Fconfig-reference",".",[272,273,275],"h3",{"id":274},"tracing-notes","Tracing Notes",[235,277,278,286,293,311],{},[238,279,280,281,285],{},"Set ",[282,283,284],"code",{},"enabled: true"," only after you have a working OTLP endpoint.",[238,287,288,289,292],{},"Use a low ",[282,290,291],{},"ratio"," value in production unless you explicitly want to sample more traffic.",[238,294,295,296,299,300,303,304,307,308,270],{},"Keep the ",[282,297,298],{},"environment"," value aligned with the environment where FiveNet runs, such as ",[282,301,302],{},"development",", ",[282,305,306],{},"staging",", or ",[282,309,310],{},"production",[238,312,313,314,317],{},"Use ",[282,315,316],{},"attributes"," to attach additional metadata that helps identify traces in your observability platform.",[227,319,321],{"id":320},"reverse-proxy-and-trusted-proxies","Reverse Proxy and Trusted Proxies",[223,323,324,325,328,329,270],{},"If FiveNet is deployed behind one or more reverse proxies, review the ",[282,326,327],{},"http.trustedProxies"," option in your ",[282,330,331],{},"config.yaml",[223,333,334],{},"This is especially important when:",[235,336,337,340,343],{},[238,338,339],{},"client IP addresses should be preserved correctly",[238,341,342],{},"FiveNet is running behind NGINX, Traefik, or Cloudflare",[238,344,345],{},"you rely on forwarded headers from trusted infrastructure",[223,347,348,349,352,353,355],{},"See the ",[267,350,63],{"href":351},".\u002Fconfig-reference#commonly-adjusted-options"," for the ",[282,354,327],{}," setting.",[227,357,359],{"id":358},"object-storage","Object Storage",[223,361,362,363,366],{},"By default, FiveNet stores uploads on the local filesystem. For more scalable or externally managed storage, you can switch to S3-compatible object storage through the ",[282,364,365],{},"storage"," configuration.",[223,368,369],{},"This is commonly useful when:",[235,371,372,375,378],{},[238,373,374],{},"running multiple instances",[238,376,377],{},"using cloud infrastructure",[238,379,380],{},"keeping uploaded files outside the application host",[223,382,348,383,352,385,388],{},[267,384,63],{"href":351},[282,386,387],{},"storage.type"," setting and related storage options.",[227,390,392],{"id":391},"oauth2-providers","OAuth2 Providers",[223,394,395,396,366],{},"FiveNet can be integrated with external authentication providers through the ",[282,397,398],{},"oauth2.providers",[223,400,401],{},"Use this when users should sign in through systems such as Discord or another OAuth2 or OpenID Connect provider instead of relying only on local authentication flows.",[223,403,348,404,352,406,355],{},[267,405,63],{"href":351},[282,407,398],{},[227,409,411],{"id":410},"tracing","Tracing",[223,413,414],{},"FiveNet supports OpenTelemetry-based tracing for the server and worker components. This can help you inspect request flow, background processing, and performance bottlenecks in more advanced environments.",[223,416,417],{},"Tracing is usually only needed when you already have an observability stack in place or when you are troubleshooting more complex issues.",[272,419,421],{"id":420},"example-tracing-configuration","Example Tracing Configuration",[423,424,429],"pre",{"className":425,"code":426,"language":427,"meta":428,"style":428},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc or otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP tracing endpoint URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"production\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[282,430,431,443,456,463,481,487,502,512,523,537,549,557],{"__ignoreMap":428},[432,433,436,439],"span",{"class":434,"line":435},"line",1,[432,437,410],{"class":438},"swJcz",[432,440,442],{"class":441},"sMK4o",":\n",[432,444,446,449,452],{"class":434,"line":445},2,[432,447,448],{"class":438},"  enabled",[432,450,451],{"class":441},":",[432,453,455],{"class":454},"sfNiH"," false\n",[432,457,459],{"class":434,"line":458},3,[432,460,462],{"class":461},"sHwdD","  # otlptracegrpc or otlptracehttp\n",[432,464,466,469,471,474,478],{"class":434,"line":465},4,[432,467,468],{"class":438},"  type",[432,470,451],{"class":441},[432,472,473],{"class":441}," \"",[432,475,477],{"class":476},"sfazB","otlptracegrpc",[432,479,480],{"class":441},"\"\n",[432,482,484],{"class":434,"line":483},5,[432,485,486],{"class":461},"  # OTLP tracing endpoint URL\n",[432,488,490,493,495,497,500],{"class":434,"line":489},6,[432,491,492],{"class":438},"  url",[432,494,451],{"class":441},[432,496,473],{"class":441},[432,498,499],{"class":476},"https:\u002F\u002Fexample.com:4317",[432,501,480],{"class":441},[432,503,505,508,510],{"class":434,"line":504},7,[432,506,507],{"class":438},"  insecure",[432,509,451],{"class":441},[432,511,455],{"class":454},[432,513,515,518,520],{"class":434,"line":514},8,[432,516,517],{"class":438},"  timeout",[432,519,451],{"class":441},[432,521,522],{"class":476}," 10s\n",[432,524,526,529,531,533,535],{"class":434,"line":525},9,[432,527,528],{"class":438},"  environment",[432,530,451],{"class":441},[432,532,473],{"class":441},[432,534,310],{"class":476},[432,536,480],{"class":441},[432,538,540,543,545],{"class":434,"line":539},10,[432,541,542],{"class":438},"  ratio",[432,544,451],{"class":441},[432,546,548],{"class":547},"sbssI"," 0.1\n",[432,550,552,555],{"class":434,"line":551},11,[432,553,554],{"class":438},"  attributes",[432,556,442],{"class":441},[432,558,560,563],{"class":434,"line":559},12,[432,561,562],{"class":441},"    -",[432,564,565],{"class":476}," service.name=fivenet-server\n",[567,568,569],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span 