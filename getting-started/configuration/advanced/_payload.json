ser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":166,"path":167,"stem":168,"children":169},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[170,171,175],{"title":166,"path":167,"stem":168},{"title":172,"path":173,"stem":174},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":176,"stem":177},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":179,"path":180,"stem":181,"children":182},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[183],{"title":179,"path":180,"stem":181},{"id":185,"title":186,"body":187,"description":550,"extension":551,"links":552,"meta":553,"navigation":554,"path":555,"redirect":552,"seo":556,"stem":557,"__hash__":558},"content_en\u002F1.getting-started\u002F5.configuration\u002F7.advanced.md","Advanced Configuration",{"type":188,"value":189,"toc":539},"minimark",[190,194,199,202,231,240,245,287,291,301,304,315,325,329,336,339,350,358,362,368,371,377,381,384,387,391,535],[191,192,193],"p",{},"Use this page when your FiveNet setup goes beyond the basic installation and required configuration options.",[195,196,198],"h2",{"id":197},"common-advanced-topics","Common Advanced Topics",[191,200,201],{},"The most common advanced configuration areas are:",[203,204,205,213,219,225],"ul",{},[206,207,208,212],"li",{},[209,210,211],"strong",{},"Trusted proxies"," when FiveNet runs behind NGINX, Traefik, Cloudflare, or another reverse proxy.",[206,214,215,218],{},[209,216,217],{},"Object storage"," when uploads should be stored in S3-compatible storage instead of the local filesystem.",[206,220,221,224],{},[209,222,223],{},"OAuth2 providers"," when users should be able to authenticate through external identity providers.",[206,226,227,230],{},[209,228,229],{},"Tracing and observability"," for debugging, performance analysis, and distributed request tracing.",[191,232,233,234,239],{},"For the most important option names and config paths, see the ",[235,236,238],"a",{"href":237},".\u002Fconfig-reference","Config File Reference",".",[241,242,244],"h3",{"id":243},"tracing-notes","Tracing Notes",[203,246,247,255,262,280],{},[206,248,249,250,254],{},"Set ",[251,252,253],"code",{},"enabled: true"," only after you have a working OTLP endpoint.",[206,256,257,258,261],{},"Use a low ",[251,259,260],{},"ratio"," value in production unless you explicitly want to sample more traffic.",[206,263,264,265,268,269,272,273,276,277,239],{},"Keep the ",[251,266,267],{},"environment"," value aligned with the environment where FiveNet runs, such as ",[251,270,271],{},"development",", ",[251,274,275],{},"staging",", or ",[251,278,279],{},"production",[206,281,282,283,286],{},"Use ",[251,284,285],{},"attributes"," to attach additional metadata that helps identify traces in your observability platform.",[195,288,290],{"id":289},"reverse-proxy-and-trusted-proxies","Reverse Proxy and Trusted Proxies",[191,292,293,294,297,298,239],{},"If FiveNet is deployed behind one or more reverse proxies, review the ",[251,295,296],{},"http.trustedProxies"," option in your ",[251,299,300],{},"config.yaml",[191,302,303],{},"This is especially important when:",[203,305,306,309,312],{},[206,307,308],{},"client IP addresses should be preserved correctly",[206,310,311],{},"FiveNet is running behind NGINX, Traefik, or Cloudflare",[206,313,314],{},"you rely on forwarded headers from trusted infrastructure",[191,316,317,318,321,322,324],{},"See the ",[235,319,238],{"href":320},".\u002Fconfig-reference#commonly-adjusted-options"," for the ",[251,323,296],{}," setting.",[195,326,328],{"id":327},"object-storage","Object Storage",[191,330,331,332,335],{},"By default, FiveNet stores uploads on the local filesystem. For more scalable or externally managed storage, you can switch to S3-compatible object storage through the ",[251,333,334],{},"storage"," configuration.",[191,337,338],{},"This is commonly useful when:",[203,340,341,344,347],{},[206,342,343],{},"running multiple instances",[206,345,346],{},"using cloud infrastructure",[206,348,349],{},"keeping uploaded files outside the application host",[191,351,317,352,321,354,357],{},[235,353,238],{"href":320},[251,355,356],{},"storage.type"," setting and related storage options.",[195,359,361],{"id":360},"oauth2-providers","OAuth2 Providers",[191,363,364,365,335],{},"FiveNet can be integrated with external authentication providers through the ",[251,366,367],{},"oauth2.providers",[191,369,370],{},"Use this when users should sign in through systems such as Discord or another OAuth2 or OpenID Connect provider instead of relying only on local authentication flows.",[191,372,317,373,321,375,324],{},[235,374,238],{"href":320},[251,376,367],{},[195,378,380],{"id":379},"tracing","Tracing",[191,382,383],{},"FiveNet supports OpenTelemetry-based tracing for the server and worker components. This can help you inspect request flow, background processing, and performance bottlenecks in more advanced environments.",[191,385,386],{},"Tracing is usually only needed when you already have an observability stack in place or when you are troubleshooting more complex issues.",[241,388,390],{"id":389},"example-tracing-configuration","Example Tracing Configuration",[392,393,398],"pre",{"className":394,"code":395,"language":396,"meta":397,"style":397},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc or otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP tracing endpoint URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"production\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[251,399,400,412,425,432,450,456,471,481,492,506,518,526],{"__ignoreMap":397},[401,402,405,408],"span",{"class":403,"line":404},"line",1,[401,406,379],{"class":407},"swJcz",[401,409,411],{"class":410},"sMK4o",":\n",[401,413,415,418,421],{"class":403,"line":414},2,[401,416,417],{"class":407},"  enabled",[401,419,420],{"class":410},":",[401,422,424],{"class":423},"sfNiH"," false\n",[401,426,428],{"class":403,"line":427},3,[401,429,431],{"class":430},"sHwdD","  # otlptracegrpc or otlptracehttp\n",[401,433,435,438,440,443,447],{"class":403,"line":434},4,[401,436,437],{"class":407},"  type",[401,439,420],{"class":410},[401,441,442],{"class":410}," \"",[401,444,446],{"class":445},"sfazB","otlptracegrpc",[401,448,449],{"class":410},"\"\n",[401,451,453],{"class":403,"line":452},5,[401,454,455],{"class":430},"  # OTLP tracing endpoint URL\n",[401,457,459,462,464,466,469],{"class":403,"line":458},6,[401,460,461],{"class":407},"  url",[401,463,420],{"class":410},[401,465,442],{"class":410},[401,467,468],{"class":445},"https:\u002F\u002Fexample.com:4317",[401,470,449],{"class":410},[401,472,474,477,479],{"class":403,"line":473},7,[401,475,476],{"class":407},"  insecure",[401,478,420],{"class":410},[401,480,424],{"class":423},[401,482,484,487,489],{"class":403,"line":483},8,[401,485,486],{"class":407},"  timeout",[401,488,420],{"class":410},[401,490,491],{"class":445}," 10s\n",[401,493,495,498,500,502,504],{"class":403,"line":494},9,[401,496,497],{"class":407},"  environment",[401,499,420],{"class":410},[401,501,442],{"class":410},[401,503,279],{"class":445},[401,505,449],{"class":410},[401,507,509,512,514],{"class":403,"line":508},10,[401,510,511],{"class":407},"  ratio",[401,513,420],{"class":410},[401,515,517],{"class":516},"sbssI"," 0.1\n",[401,519,521,524],{"class":403,"line":520},11,[401,522,523],{"class":407},"  attributes",[401,525,411],{"class":410},[401,527,529,532],{"class":403,"line":528},12,[401,530,531],{"class":410},"    -",[401,533,534],{"class":445}," service.name=fivenet-server\n",[536,537,538],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-defau