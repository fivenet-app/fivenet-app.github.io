guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164,"children":165},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[166,167,171],{"title":162,"path":163,"stem":164},{"title":168,"path":169,"stem":170},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":172,"stem":173},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":175,"path":176,"stem":177,"children":178},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[179],{"title":175,"path":176,"stem":177},{"id":181,"title":182,"body":183,"description":546,"extension":547,"links":548,"meta":549,"navigation":550,"path":551,"redirect":548,"seo":552,"stem":553,"__hash__":554},"content_en\u002F1.getting-started\u002F5.configuration\u002F7.advanced.md","Advanced Configuration",{"type":184,"value":185,"toc":535},"minimark",[186,190,195,198,227,236,241,283,287,297,300,311,321,325,332,335,346,354,358,364,367,373,377,380,383,387,531],[187,188,189],"p",{},"Use this page when your FiveNet setup goes beyond the basic installation and required configuration options.",[191,192,194],"h2",{"id":193},"common-advanced-topics","Common Advanced Topics",[187,196,197],{},"The most common advanced configuration areas are:",[199,200,201,209,215,221],"ul",{},[202,203,204,208],"li",{},[205,206,207],"strong",{},"Trusted proxies"," when FiveNet runs behind NGINX, Traefik, Cloudflare, or another reverse proxy.",[202,210,211,214],{},[205,212,213],{},"Object storage"," when uploads should be stored in S3-compatible storage instead of the local filesystem.",[202,216,217,220],{},[205,218,219],{},"OAuth2 providers"," when users should be able to authenticate through external identity providers.",[202,222,223,226],{},[205,224,225],{},"Tracing and observability"," for debugging, performance analysis, and distributed request tracing.",[187,228,229,230,235],{},"For the most important option names and config paths, see the ",[231,232,234],"a",{"href":233},".\u002Fconfig-reference","Config File Reference",".",[237,238,240],"h3",{"id":239},"tracing-notes","Tracing Notes",[199,242,243,251,258,276],{},[202,244,245,246,250],{},"Set ",[247,248,249],"code",{},"enabled: true"," only after you have a working OTLP endpoint.",[202,252,253,254,257],{},"Use a low ",[247,255,256],{},"ratio"," value in production unless you explicitly want to sample more traffic.",[202,259,260,261,264,265,268,269,272,273,235],{},"Keep the ",[247,262,263],{},"environment"," value aligned with the environment where FiveNet runs, such as ",[247,266,267],{},"development",", ",[247,270,271],{},"staging",", or ",[247,274,275],{},"production",[202,277,278,279,282],{},"Use ",[247,280,281],{},"attributes"," to attach additional metadata that helps identify traces in your observability platform.",[191,284,286],{"id":285},"reverse-proxy-and-trusted-proxies","Reverse Proxy and Trusted Proxies",[187,288,289,290,293,294,235],{},"If FiveNet is deployed behind one or more reverse proxies, review the ",[247,291,292],{},"http.trustedProxies"," option in your ",[247,295,296],{},"config.yaml",[187,298,299],{},"This is especially important when:",[199,301,302,305,308],{},[202,303,304],{},"client IP addresses should be preserved correctly",[202,306,307],{},"FiveNet is running behind NGINX, Traefik, or Cloudflare",[202,309,310],{},"you rely on forwarded headers from trusted infrastructure",[187,312,313,314,317,318,320],{},"See the ",[231,315,234],{"href":316},".\u002Fconfig-reference#commonly-adjusted-options"," for the ",[247,319,292],{}," setting.",[191,322,324],{"id":323},"object-storage","Object Storage",[187,326,327,328,331],{},"By default, FiveNet stores uploads on the local filesystem. For more scalable or externally managed storage, you can switch to S3-compatible object storage through the ",[247,329,330],{},"storage"," configuration.",[187,333,334],{},"This is commonly useful when:",[199,336,337,340,343],{},[202,338,339],{},"running multiple instances",[202,341,342],{},"using cloud infrastructure",[202,344,345],{},"keeping uploaded files outside the application host",[187,347,313,348,317,350,353],{},[231,349,234],{"href":316},[247,351,352],{},"storage.type"," setting and related storage options.",[191,355,357],{"id":356},"oauth2-providers","OAuth2 Providers",[187,359,360,361,331],{},"FiveNet can be integrated with external authentication providers through the ",[247,362,363],{},"oauth2.providers",[187,365,366],{},"Use this when users should sign in through systems such as Discord or another OAuth2 or OpenID Connect provider instead of relying only on local authentication flows.",[187,368,313,369,317,371,320],{},[231,370,234],{"href":316},[247,372,363],{},[191,374,376],{"id":375},"tracing","Tracing",[187,378,379],{},"FiveNet supports OpenTelemetry-based tracing for the server and worker components. This can help you inspect request flow, background processing, and performance bottlenecks in more advanced environments.",[187,381,382],{},"Tracing is usually only needed when you already have an observability stack in place or when you are troubleshooting more complex issues.",[237,384,386],{"id":385},"example-tracing-configuration","Example Tracing Configuration",[388,389,394],"pre",{"className":390,"code":391,"language":392,"meta":393,"style":393},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tracing:\n  enabled: false\n  # otlptracegrpc or otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP tracing endpoint URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"production\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[247,395,396,408,421,428,446,452,467,477,488,502,514,522],{"__ignoreMap":393},[397,398,401,404],"span",{"class":399,"line":400},"line",1,[397,402,375],{"class":403},"swJcz",[397,405,407],{"class":406},"sMK4o",":\n",[397,409,411,414,417],{"class":399,"line":410},2,[397,412,413],{"class":403},"  enabled",[397,415,416],{"class":406},":",[397,418,420],{"class":419},"sfNiH"," false\n",[397,422,424],{"class":399,"line":423},3,[397,425,427],{"class":426},"sHwdD","  # otlptracegrpc or otlptracehttp\n",[397,429,431,434,436,439,443],{"class":399,"line":430},4,[397,432,433],{"class":403},"  type",[397,435,416],{"class":406},[397,437,438],{"class":406}," \"",[397,440,442],{"class":441},"sfazB","otlptracegrpc",[397,444,445],{"class":406},"\"\n",[397,447,449],{"class":399,"line":448},5,[397,450,451],{"class":426},"  # OTLP tracing endpoint URL\n",[397,453,455,458,460,462,465],{"class":399,"line":454},6,[397,456,457],{"class":403},"  url",[397,459,416],{"class":406},[397,461,438],{"class":406},[397,463,464],{"class":441},"https:\u002F\u002Fexample.com:4317",[397,466,445],{"class":406},[397,468,470,473,475],{"class":399,"line":469},7,[397,471,472],{"class":403},"  insecure",[397,474,416],{"class":406},[397,476,420],{"class":419},[397,478,480,483,485],{"class":399,"line":479},8,[397,481,482],{"class":403},"  timeout",[397,484,416],{"class":406},[397,486,487],{"class":441}," 10s\n",[397,489,491,494,496,498,500],{"class":399,"line":490},9,[397,492,493],{"class":403},"  environment",[397,495,416],{"class":406},[397,497,438],{"class":406},[397,499,275],{"class":441},[397,501,445],{"class":406},[397,503,505,508,510],{"class":399,"line":504},10,[397,506,507],{"class":403},"  ratio",[397,509,416],{"class":406},[397,511,513],{"class":512},"sbssI"," 0.1\n",[397,515,517,520],{"class":399,"line":516},11,[397,518,519],{"class":403},"  attributes",[397,521,407],{"class":406},[397,523,525,528],{"class":399,"line":524},12,[397,526,527],{"class":406},"    -",[397,529,530],{"class":441}," service.name=fivenet-server\n",[532,533,534],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-d