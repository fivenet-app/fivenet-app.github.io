layer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":63,"body":235,"description":872,"extension":873,"links":874,"meta":875,"navigation":528,"path":64,"redirect":874,"seo":876,"stem":65,"__hash__":877},"content_en\u002F1.getting-started\u002F5.configuration\u002F2.configure.md",{"type":236,"value":237,"toc":859},"minimark",[238,242,249,254,257,281,284,291,294,319,329,333,336,414,417,424,428,431,434,502,505,581,584,588,595,621,627,631,637,663,673,677,680,721,724,728,731,770,779,783,786,812,821,825,828,845,855],[239,240,241],"p",{},"Use this guide after choosing a deployment method and before setting up DBSync or the FiveM plugin. It covers the minimum configuration required for a working FiveNet installation.",[239,243,244,245,248],{},"For every option and its default value, see the ",[246,247,97],"a",{"href":98},". The example file in the FiveNet repository remains the source of truth for the complete configuration.",[250,251,253],"h2",{"id":252},"before-you-begin","Before You Begin",[239,255,256],{},"Make sure you have:",[258,259,260,264,267,270,273],"ul",{},[261,262,263],"li",{},"A supported MySQL or MariaDB database.",[261,265,266],{},"A NATS server with JetStream enabled.",[261,268,269],{},"A public HTTPS URL for FiveNet, or a plan for exposing it through a reverse proxy.",[261,271,272],{},"A storage location for uploads, either a persistent local directory or S3-compatible storage.",[261,274,275,276,280],{},"The FiveNet ",[277,278,279],"code",{},"config.example.yaml"," file from the same release as the FiveNet image or binary you are deploying.",[239,282,283],{},"If you are using Docker or Helm, follow the deployment guide first so you know where the configuration file is mounted and which services are available by their internal hostnames.",[250,285,287,288],{"id":286},"_1-create-configyaml","1. Create ",[277,289,290],{},"config.yaml",[239,292,293],{},"Copy the example file and keep it with the deployment files. Do not edit the example file in place:",[295,296,301],"pre",{"className":297,"code":298,"language":299,"meta":300,"style":300},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cp config.example.yaml config.yaml\n","bash","",[277,302,303],{"__ignoreMap":300},[304,305,308,312,316],"span",{"class":306,"line":307},"line",1,[304,309,311],{"class":310},"sBMFI","cp",[304,313,315],{"class":314},"sfazB"," config.example.yaml",[304,317,318],{"class":314}," config.yaml\n",[239,320,321,322,324,325,328],{},"For containerized deployments, mount the completed ",[277,323,290],{}," into the location expected by the deployment template. FiveNet searches for the file in the current working directory and then in ",[277,326,327],{},"\u002Fconfig",".",[250,330,332],{"id":331},"_2-configure-the-public-url","2. Configure the Public URL",[239,334,335],{},"Set the URL users will open in their browser:",[295,337,341],{"className":338,"code":339,"language":340,"meta":300,"style":300},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","http:\n  publicURL: \"https:\u002F\u002Ffivenet.example.com\"\n  origins:\n    - \"https:\u002F\u002Ffivenet.example.com\"\n  sessions:\n    domain: \"fivenet.example.com\"\n","yaml",[277,342,343,353,371,379,391,399],{"__ignoreMap":300},[304,344,345,349],{"class":306,"line":307},[304,346,348],{"class":347},"swJcz","http",[304,350,352],{"class":351},"sMK4o",":\n",[304,354,356,359,362,365,368],{"class":306,"line":355},2,[304,357,358],{"class":347},"  publicURL",[304,360,361],{"class":351},":",[304,363,364],{"class":351}," \"",[304,366,367],{"class":314},"https:\u002F\u002Ffivenet.example.com",[304,369,370],{"class":351},"\"\n",[304,372,374,377],{"class":306,"line":373},3,[304,375,376],{"class":347},"  origins",[304,378,352],{"class":351},[304,380,382,385,387,389],{"class":306,"line":381},4,[304,383,384],{"class":351},"    -",[304,386,364],{"class":351},[304,388,367],{"class":314},[304,390,370],{"class":351},[304,392,394,397],{"class":306,"line":393},5,[304,395,396],{"class":347},"  sessions",[304,398,352],{"class":351},[304,400,402,405,407,409,412],{"class":306,"line":401},6,[304,403,404],{"class":347},"    domain",[304,406,361],{"class":351},[304,408,364],{"class":351},[304,410,411],{"class":314},"fivenet.example.com",[304,413,370],{"class":351},[239,415,416],{},"The URL, browser origin, and session domain must match the domain used by your reverse proxy. If you use a separate hostname for API or plugin traffic, add that origin where required by your deployment.",[239,418,419,420,423],{},"Review ",[277,421,422],{},"http.trustedProxies"," when FiveNet is behind NGINX, Traefik, Cloudflare, or another proxy. Only list proxy addresses or networks you control.",[250,425,427],{"id":426},"_3-generate-and-store-secrets","3. Generate and Store Secrets",[239,429,430],{},"Generate unique values for the application secret, session cookie secret, and JWT secret. Keep them stable after deployment and do not commit them to a public repository.",[239,432,433],{},"For example, generate a value using the command for your operating system:",[435,436,437,458],"code-group",{},[295,438,441],{"className":297,"code":439,"filename":440,"language":299,"meta":300,"style":300},"openssl rand -base64 32\n","Linux \u002F macOS",[277,442,443],{"__ignoreMap":300},[304,444,445,448,451,454],{"class":306,"line":307},[304,446,447],{"class":310},"openssl",[304,449,450],{"class":314}," rand",[304,452,453],{"class":314}," -base64",[304,455,457],{"class":456},"sbssI"," 32\n",[295,459,464],{"className":460,"code":461,"filename":462,"language":463,"meta":300,"style":300},"language-powershell shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))\n","Windows","powershell",[277,465,466],{"__ignoreMap":300},[304,467,468,471,475,478,482,485,488,490,493,496,499],{"class":306,"line":307},[304,469,470],{"class":351},"[",[304,472,474],{"class":473},"spNyl","Convert",[304,476,477],{"class":351},"]",[304,479,481],{"class":480},"sTEyZ","::ToBase64String",[304,483,484],{"class":351},"([",[304,486,487],{"class":473},"Security.Cryptography.RandomNumberGenerator",[304,489,477],{"class":351},[304,491,492],{"class":480},"::GetBytes",[304,494,495],{"class":351},"(",[304,497,498],{"class":456},"32",[304,500,501],{"class":351},"))\n",[239,503,504],{},"Set the generated values in the corresponding options:",[295,506,508],{"className":338,"code":507,"language":340,"meta":300,"style":300},"secret: \"CHANGE_ME\"\n\nhttp:\n  sessions:\n    cookieSecret: \"CHANGE_ME\"\n\njwt:\n  secret: \"CHANGE_ME\"\n",[277,509,510,524,530,536,542,555,559,567],{"__ignoreMap":300},[304,511,512,515,517,519,522],{"class":306,"line":307},[304,513,514],{"class":347},"secret",[304,516,361],{"class":351},[304,518,364],{"class":351},[304,520,521],{"class":314},"CHANGE_ME",[304,523,370],{"class":351},[304,525,526],{"class":306,"line":355},[304,527,529],{"emptyLinePlaceholder":528},true,"\n",[304,531,532,534],{"class":306,"line":373},[304,533,348],{"class":347},[304,535,352],{"class":351},[304,537,538,540],{"class":306,"line":381},[304,539,396],{"class":347},[304,541,352],{"class":351},[304,543,544,547,549,551,553],{"class":306,"line":393},[304,545,546],{"class":347},"    cookieSecret",[304,548,361],{"class":351},[304,550,364],{"class":351},[304,552,521],{"class":314},[304,554,370],{"class":351},[304,556,557],{"class":306,"line":401},[304,558,529],{"emptyLinePlaceholder":528},[304,560,562,565],{"class":306,"line":561},7,[304,563,564],{"class":347},"jwt",[304,566,352],{"class":351},[304,568,570,573,575,577,579],{"class":306,"line":569},8,[304,571,572],{"class":347},"  secret",[304,574,361],{"class":351},[304,576,364],{"class":351},[304,578,521],{"class":314},[304,580,370],{"class":351},[239,582,583],{},"Changing these values later can invalidate sessions or tokens. Treat sync API tokens as secrets as well.",[250,585,587],{"id":586},"_4-configure-the-fivenet-database","4. Configure the FiveNet Database",[239,589,590,591,594],{},"Set ",[277,592,593],{},"database.dsn"," to the MySQL or MariaDB database used by FiveNet:",[295,596,598],{"className":338,"code":597,"language":340,"meta":300,"style":300},"database:\n  dsn: \"DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\"\n",[277,599,600,607],{"__ignoreMap":300},[304,601,602,605],{"class":306,"line":307},[304,603,604],{"class":347},"database",[304,606,352],{"class":351},[304,608,609,612,614,616,619],{"class":306,"line":355},[304,610,611],{"class":347},"  dsn",[304,613,361],{"class":351},[304,615,364],{"class":351},[304,617,618],{"class":314},"DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin",[304,620,370],{"class":351},[239,622,623,624,626],{},"Use a database user with the permissions required for FiveNet migrations and normal operation. The configured collation should match the database and tables. See ",[246,625,101],{"href":102}," if migrations report collation or foreign-key errors.",[250,628,630],{"id":629},"_5-configure-nats","5. Configure NATS",[239,632,590,633,636],{},[277,634,635],{},"nats.url"," to the NATS server and make sure JetStream is enabled:",[295,638,640],{"className":338,"code":639,"language":340,"meta":300,"style":300},"nats:\n  url: \"nats:\u002F\u002FUSER:PASSWORD@NATS_HOST:4222\"\n",[277,641,642,649],{"__ignoreMap":300},[304,643,644,647],{"class":306,"line":307},[304,645,646],{"class":347},"nats",[304,648,352],{"class":351},[304,650,651,654,656,658,661],{"class":306,"line":355},[304,652,653],{"class":347},"  url",[304,655,361],{"class":351},[304,657,364],{"class":351},[304,659,660],{"class":314},"nats:\u002F\u002FUSER:PASSWORD@NATS_HOST:4222",[304,662,370],{"class":351},[239,664,665,666,668,669,672],{},"When FiveNet runs in Docker Compose, use the NATS service name as the hostname, such as ",[277,667,646],{},", rather than ",[277,670,671],{},"localhost",". When FiveNet runs in Kubernetes, use the NATS Service DNS name.",[250,674,676],{"id":675},"_6-enable-the-sync-api","6. Enable the Sync API",[239,678,679],{},"DBSync and the FiveM plugin use the Sync API. Enable it and create at least one long, unique token:",[295,681,683],{"className":338,"code":682,"language":340,"meta":300,"style":300},"sync:\n  enabled: true\n  apiTokens:\n    - \"CHANGE_ME_TO_A_LONG_RANDOM_TOKEN\"\n",[277,684,685,692,703,710],{"__ignoreMap":300},[304,686,687,690],{"class":306,"line":307},[304,688,689],{"class":347},"sync",[304,691,352],{"class":351},[304,693,694,697,699],{"class":306,"line":355},[304,695,696],{"class":347},"  enabled",[304,698,361],{"class":351},[304,700,702],{"class":701},"sfNiH"," true\n",[304,704,705,708],{"class":306,"line":373},[304,706,707],{"class":347},"  apiTokens",[304,709,352],{"class":351},[304,711,712,714,716,719],{"class":306,"line":381},[304,713,384],{"class":351},[304,715,364],{"class":351},[304,717,718],{"class":314},"CHANGE_ME_TO_A_LONG_RANDOM_TOKEN",[304,720,370],{"class":351},[239,722,723],{},"Use the token only in the DBSync and plugin configuration that need it. If you rotate the token, update both integrations.",[250,725,727],{"id":726},"_7-configure-upload-storage","7. Configure Upload Storage",[239,729,730],{},"The default filesystem storage is suitable for a single instance when its directory is persistent:",[295,732,734],{"className":338,"code":733,"language":340,"meta":300,"style":300},"storage:\n  type: filesystem\n  filesystem:\n    path: \u002Fdata\n",[277,735,736,743,753,760],{"__ignoreMap":300},[304,737,738,741],{"class":306,"line":307},[304,739,740],{"class":347},"storage",[304,742,352],{"class":351},[304,744,745,748,750],{"class":306,"line":355},[304,746,747],{"class":347},"  type",[304,749,361],{"class":351},[304,751,752],{"class":314}," filesystem\n",[304,754,755,758],{"class":306,"line":373},[304,756,757],{"class":347},"  filesystem",[304,759,352],{"class":351},[304,761,762,765,767],{"class":306,"line":381},[304,763,764],{"class":347},"    path",[304,766,361],{"class":351},[304,768,769],{"class":314}," \u002Fdata\n",[239,771,772,773,776,777,328],{},"Make sure ",[277,774,775],{},"\u002Fdata"," is backed by a persistent volume in Docker or Kubernetes. For multiple instances or externally managed uploads, configure the S3-compatible storage options instead. See ",[246,778,93],{"href":94},[250,780,782],{"id":781},"_8-grant-initial-configuration-access","8. Grant Initial Configuration Access",[239,784,785],{},"Give the group used by your first administrator access to configuration settings:",[295,787,789],{"className":338,"code":788,"language":340,"meta":300,"style":300},"auth:\n  configAdminGroups:\n    - admin\n",[277,790,791,798,805],{"__ignoreMap":300},[304,792,793,796],{"class":306,"line":307},[304,794,795],{"class":347},"auth",[304,797,352],{"class":351},[304,799,800,803],{"class":306,"line":355},[304,801,802],{"class":347},"  configAdminGroups",[304,804,352],{"class":351},[304,806,807,809],{"class":306,"line":373},[304,808,384],{"class":351},[304,810,811],{"class":314}," admin\n",[239,813,814,815,818,819,328],{},"You can also use ",[277,816,817],{},"auth.configAdminUsers"," for specific users. The first account still needs to be created and registered as described in ",[246,820,53],{"href":54},[250,822,824],{"id":823},"_9-start-and-validate-fivenet","9. Start and Validate FiveNet",[239,826,827],{},"Start the deployment using the command appropriate for your installation method. Then check:",[258,829,830,833,836,839,842],{},[261,831,832],{},"The server starts without database or NATS errors.",[261,834,835],{},"Database migrations complete successfully.",[261,837,838],{},"The configured public URL loads over HTTPS.",[261,840,841],{},"The first account can register and sign in.",[261,843,844],{},"The upload storage path is writable.",[239,846,847,848,851,852,854],{},"Once the core server is working, continue with ",[246,849,850],{"href":68},"DBSync"," and then ",[246,853,53],{"href":54}," to connect the gameserver and configure FiveNet in the application.",[856,857,858],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-