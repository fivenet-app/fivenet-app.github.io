[223,224,225],"p",{},"Understand the database defaults FiveNet expects and how to avoid common collation-related migration issues.",[227,228,230],"h2",{"id":229},"charset-and-collation","Charset and Collation",[223,232,233,234,238,239,242],{},"Make sure the ",[235,236,237],"strong",{},"charset"," and ",[235,240,241],{},"collation"," of your database, tables, and columns are consistent.",[223,244,245],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[247,248,249],"callout",{},[223,250,251,252,256,257],{},"Recommended collation: ",[253,254,255],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[253,258,259],{},"utf8mb4",[227,261,263],{"id":262},"check-the-current-database-settings","Check the Current Database Settings",[223,265,266],{},"Use the following queries to inspect the current charset and collation:",[268,269,274],"pre",{"className":270,"code":271,"language":272,"meta":273,"style":273},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[253,275,276,300,320],{"__ignoreMap":273},[277,278,281,285,289,293,296],"span",{"class":279,"line":280},"line",1,[277,282,284],{"class":283},"sbssI","USE",[277,286,288],{"class":287},"sMK4o"," `",[277,290,292],{"class":291},"sfazB","__YOUR_DATABASE_NAME_HERE__",[277,294,295],{"class":287},"`",[277,297,299],{"class":298},"sTEyZ",";\n",[277,301,303,306,309,312,314,316,318],{"class":279,"line":302},2,[277,304,305],{"class":298},"SHOW ",[277,307,308],{"class":283},"CREATE",[277,310,311],{"class":283}," DATABASE",[277,313,288],{"class":287},[277,315,292],{"class":291},[277,317,295],{"class":287},[277,319,299],{"class":298},[277,321,323,325,328,331],{"class":279,"line":322},3,[277,324,305],{"class":298},[277,326,327],{"class":283},"TABLE",[277,329,330],{"class":283}," STATUS",[277,332,299],{"class":298},[223,334,335],{},"If you also want to inspect column-level collations, review the table definitions directly:",[268,337,339],{"className":270,"code":338,"language":272,"meta":273,"style":273},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[253,340,341],{"__ignoreMap":273},[277,342,343,345,347,350,352,355,357],{"class":279,"line":280},[277,344,305],{"class":298},[277,346,308],{"class":283},[277,348,349],{"class":283}," TABLE",[277,351,288],{"class":287},[277,353,354],{"class":291},"__YOUR_TABLE_NAME_HERE__",[277,356,295],{"class":287},[277,358,299],{"class":298},[227,360,362],{"id":361},"fixing-collation-mismatches","Fixing Collation Mismatches",[223,364,365,366,368,369,371,372,379],{},"A useful guide for converting tables to ",[253,367,259],{},"\u002F",[253,370,255],{}," in MySQL 5.5 can be found on the ",[373,374,378],"a",{"href":375,"rel":376},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[377],"nofollow","Database Administrators Stack Exchange",".",[223,381,382],{},"Before running generated conversion queries, disable foreign key checks:",[268,384,386],{"className":270,"code":385,"language":272,"meta":273,"style":273},"SET foreign_key_checks = 0;\n",[253,387,388],{"__ignoreMap":273},[277,389,390,393,396,399,402],{"class":279,"line":280},[277,391,392],{"class":283},"SET",[277,394,395],{"class":298}," foreign_key_checks ",[277,397,398],{"class":287},"=",[277,400,401],{"class":283}," 0",[277,403,299],{"class":298},[223,405,406],{},"After the conversion is complete, enable them again:",[268,408,410],{"className":270,"code":409,"language":272,"meta":273,"style":273},"SET foreign_key_checks = 1;\n",[253,411,412],{"__ignoreMap":273},[277,413,414,416,418,420,423],{"class":279,"line":280},[277,415,392],{"class":283},[277,417,395],{"class":298},[277,419,398],{"class":287},[277,421,422],{"class":283}," 1",[277,424,299],{"class":298},[426,427,428],"warning",{},[223,429,430],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[227,432,434],{"id":433},"dsn-collation","DSN Collation",[223,436,437],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[223,439,440],{},"Example:",[268,442,447],{"className":443,"code":445,"language":446,"meta":273},[444],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[253,448,445],{"__ignoreMap":273},[223,450,451],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[227,453,455],{"id":454},"creating-a-database-user","Creating a Database User",[223,457,458,459,462,463,238,466,469],{},"Below are sample queries to create a database user named ",[253,460,461],{},"fivenet"," with full access to a specific database. Replace ",[253,464,465],{},"password",[253,467,468],{},"database_name"," with your actual values before using them.",[268,471,473],{"className":270,"code":472,"language":272,"meta":273,"style":273},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[253,474,475,513],{"__ignoreMap":273},[277,476,477,479,482,485,488,491,494,497,499,502,505,507,509,511],{"class":279,"line":280},[277,478,308],{"class":283},[277,480,481],{"class":283}," USER",[277,483,484],{"class":298}," '",[277,486,461],{"class":487},"s2Zo4",[277,489,490],{"class":298},"'@",[277,492,493],{"class":287},"'",[277,495,496],{"class":291},"%",[277,498,493],{"class":287},[277,500,501],{"class":298}," IDENTIFIED ",[277,503,504],{"class":283},"BY",[277,506,484],{"class":287},[277,508,465],{"class":291},[277,510,493],{"class":287},[277,512,299],{"class":298},[277,514,515,518,521,524,526,528,530,532,535,538,540,542,544,547,549,551,553],{"class":279,"line":302},[277,516,517],{"class":283},"GRANT",[277,519,520],{"class":298}," ALL PRIVILEGES ",[277,522,523],{"class":283},"ON",[277,525,288],{"class":287},[277,527,468],{"class":291},[277,529,295],{"class":287},[277,531,379],{"class":298},[277,533,534],{"class":287},"*",[277,536,537],{"class":283}," TO",[277,539,484],{"class":287},[277,541,461],{"class":291},[277,543,493],{"class":287},[277,545,546],{"class":298},"@",[277,548,493],{"class":287},[277,550,496],{"class":291},[277,552,493],{"class":287},[277,554,299],{"class":298},[223,556,557,558,561],{},"For a separate DBSync source user, read-only access is usually enough. See ",[373,559,67],{"href":560},".\u002Fdbsync"," for an example of a dedicated read-only user.",[227,563,565],{"id":564},"recommended-tools","Recommended Tools",[223,567,568,573],{},[373,569,572],{"href":570,"rel":571},"https:\u002F\u002Fdbeaver.io\u002F",[377],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[575,576,577],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-defa