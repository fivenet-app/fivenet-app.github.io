after moving databases between servers or importing older dumps.",[211,212,213],"callout",{},[187,214,215,216,220,221],{},"Recommended collation: ",[217,218,219],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[217,222,223],{},"utf8mb4",[191,225,227],{"id":226},"check-the-current-database-settings","Check the Current Database Settings",[187,229,230],{},"Use the following queries to inspect the current charset and collation:",[232,233,238],"pre",{"className":234,"code":235,"language":236,"meta":237,"style":237},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[217,239,240,264,284],{"__ignoreMap":237},[241,242,245,249,253,257,260],"span",{"class":243,"line":244},"line",1,[241,246,248],{"class":247},"sbssI","USE",[241,250,252],{"class":251},"sMK4o"," `",[241,254,256],{"class":255},"sfazB","__YOUR_DATABASE_NAME_HERE__",[241,258,259],{"class":251},"`",[241,261,263],{"class":262},"sTEyZ",";\n",[241,265,267,270,273,276,278,280,282],{"class":243,"line":266},2,[241,268,269],{"class":262},"SHOW ",[241,271,272],{"class":247},"CREATE",[241,274,275],{"class":247}," DATABASE",[241,277,252],{"class":251},[241,279,256],{"class":255},[241,281,259],{"class":251},[241,283,263],{"class":262},[241,285,287,289,292,295],{"class":243,"line":286},3,[241,288,269],{"class":262},[241,290,291],{"class":247},"TABLE",[241,293,294],{"class":247}," STATUS",[241,296,263],{"class":262},[187,298,299],{},"If you also want to inspect column-level collations, review the table definitions directly:",[232,301,303],{"className":234,"code":302,"language":236,"meta":237,"style":237},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[217,304,305],{"__ignoreMap":237},[241,306,307,309,311,314,316,319,321],{"class":243,"line":244},[241,308,269],{"class":262},[241,310,272],{"class":247},[241,312,313],{"class":247}," TABLE",[241,315,252],{"class":251},[241,317,318],{"class":255},"__YOUR_TABLE_NAME_HERE__",[241,320,259],{"class":251},[241,322,263],{"class":262},[191,324,326],{"id":325},"fixing-collation-mismatches","Fixing Collation Mismatches",[187,328,329,330,332,333,335,336,343],{},"A useful guide for converting tables to ",[217,331,223],{},"\u002F",[217,334,219],{}," in MySQL 5.5 can be found on the ",[337,338,342],"a",{"href":339,"rel":340},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[341],"nofollow","Database Administrators Stack Exchange",".",[187,345,346],{},"Before running generated conversion queries, disable foreign key checks:",[232,348,350],{"className":234,"code":349,"language":236,"meta":237,"style":237},"SET foreign_key_checks = 0;\n",[217,351,352],{"__ignoreMap":237},[241,353,354,357,360,363,366],{"class":243,"line":244},[241,355,356],{"class":247},"SET",[241,358,359],{"class":262}," foreign_key_checks ",[241,361,362],{"class":251},"=",[241,364,365],{"class":247}," 0",[241,367,263],{"class":262},[187,369,370],{},"After the conversion is complete, enable them again:",[232,372,374],{"className":234,"code":373,"language":236,"meta":237,"style":237},"SET foreign_key_checks = 1;\n",[217,375,376],{"__ignoreMap":237},[241,377,378,380,382,384,387],{"class":243,"line":244},[241,379,356],{"class":247},[241,381,359],{"class":262},[241,383,362],{"class":251},[241,385,386],{"class":247}," 1",[241,388,263],{"class":262},[390,391,392],"warning",{},[187,393,394],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[191,396,398],{"id":397},"dsn-collation","DSN Collation",[187,400,401],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[187,403,404],{},"Example:",[232,406,411],{"className":407,"code":409,"language":410,"meta":237},[408],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[217,412,409],{"__ignoreMap":237},[187,414,415],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[191,417,419],{"id":418},"creating-a-database-user","Creating a Database User",[187,421,422,423,426,427,202,430,433],{},"Below are sample queries to create a database user named ",[217,424,425],{},"fivenet"," with full access to a specific database. Replace ",[217,428,429],{},"password",[217,431,432],{},"database_name"," with your actual values before using them.",[232,435,437],{"className":234,"code":436,"language":236,"meta":237,"style":237},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[217,438,439,477],{"__ignoreMap":237},[241,440,441,443,446,449,452,455,458,461,463,466,469,471,473,475],{"class":243,"line":244},[241,442,272],{"class":247},[241,444,445],{"class":247}," USER",[241,447,448],{"class":262}," '",[241,450,425],{"class":451},"s2Zo4",[241,453,454],{"class":262},"'@",[241,456,457],{"class":251},"'",[241,459,460],{"class":255},"%",[241,462,457],{"class":251},[241,464,465],{"class":262}," IDENTIFIED ",[241,467,468],{"class":247},"BY",[241,470,448],{"class":251},[241,472,429],{"class":255},[241,474,457],{"class":251},[241,476,263],{"class":262},[241,478,479,482,485,488,490,492,494,496,499,502,504,506,508,511,513,515,517],{"class":243,"line":266},[241,480,481],{"class":247},"GRANT",[241,483,484],{"class":262}," ALL PRIVILEGES ",[241,486,487],{"class":247},"ON",[241,489,252],{"class":251},[241,491,432],{"class":255},[241,493,259],{"class":251},[241,495,343],{"class":262},[241,497,498],{"class":251},"*",[241,500,501],{"class":247}," TO",[241,503,448],{"class":251},[241,505,425],{"class":255},[241,507,457],{"class":251},[241,509,510],{"class":262},"@",[241,512,457],{"class":251},[241,514,460],{"class":255},[241,516,457],{"class":251},[241,518,263],{"class":262},[187,520,521,522,525],{},"For a separate DBSync source user, read-only access is usually enough. See ",[337,523,66],{"href":524},".\u002Fdbsync"," for an example of a dedicated read-only user.",[191,527,529],{"id":528},"recommended-tools","Recommended Tools",[187,531,532,537],{},[337,533,536],{"href":534,"rel":535},"https:\u002F\u002Fdbeaver.io\u002F",[341],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[539,540,541],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-d