],"h2",{"id":225},"charset-and-collation","Charset and Collation",[219,228,229,230,234,235,238],{},"Make sure the ",[231,232,233],"strong",{},"charset"," and ",[231,236,237],{},"collation"," of your database, tables, and columns are consistent.",[219,240,241],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[243,244,245],"callout",{},[219,246,247,248,252,253],{},"Recommended collation: ",[249,250,251],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[249,254,255],{},"utf8mb4",[223,257,259],{"id":258},"check-the-current-database-settings","Check the Current Database Settings",[219,261,262],{},"Use the following queries to inspect the current charset and collation:",[264,265,270],"pre",{"className":266,"code":267,"language":268,"meta":269,"style":269},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[249,271,272,296,316],{"__ignoreMap":269},[273,274,277,281,285,289,292],"span",{"class":275,"line":276},"line",1,[273,278,280],{"class":279},"sbssI","USE",[273,282,284],{"class":283},"sMK4o"," `",[273,286,288],{"class":287},"sfazB","__YOUR_DATABASE_NAME_HERE__",[273,290,291],{"class":283},"`",[273,293,295],{"class":294},"sTEyZ",";\n",[273,297,299,302,305,308,310,312,314],{"class":275,"line":298},2,[273,300,301],{"class":294},"SHOW ",[273,303,304],{"class":279},"CREATE",[273,306,307],{"class":279}," DATABASE",[273,309,284],{"class":283},[273,311,288],{"class":287},[273,313,291],{"class":283},[273,315,295],{"class":294},[273,317,319,321,324,327],{"class":275,"line":318},3,[273,320,301],{"class":294},[273,322,323],{"class":279},"TABLE",[273,325,326],{"class":279}," STATUS",[273,328,295],{"class":294},[219,330,331],{},"If you also want to inspect column-level collations, review the table definitions directly:",[264,333,335],{"className":266,"code":334,"language":268,"meta":269,"style":269},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[249,336,337],{"__ignoreMap":269},[273,338,339,341,343,346,348,351,353],{"class":275,"line":276},[273,340,301],{"class":294},[273,342,304],{"class":279},[273,344,345],{"class":279}," TABLE",[273,347,284],{"class":283},[273,349,350],{"class":287},"__YOUR_TABLE_NAME_HERE__",[273,352,291],{"class":283},[273,354,295],{"class":294},[223,356,358],{"id":357},"fixing-collation-mismatches","Fixing Collation Mismatches",[219,360,361,362,364,365,367,368,375],{},"A useful guide for converting tables to ",[249,363,255],{},"\u002F",[249,366,251],{}," in MySQL 5.5 can be found on the ",[369,370,374],"a",{"href":371,"rel":372},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[373],"nofollow","Database Administrators Stack Exchange",".",[219,377,378],{},"Before running generated conversion queries, disable foreign key checks:",[264,380,382],{"className":266,"code":381,"language":268,"meta":269,"style":269},"SET foreign_key_checks = 0;\n",[249,383,384],{"__ignoreMap":269},[273,385,386,389,392,395,398],{"class":275,"line":276},[273,387,388],{"class":279},"SET",[273,390,391],{"class":294}," foreign_key_checks ",[273,393,394],{"class":283},"=",[273,396,397],{"class":279}," 0",[273,399,295],{"class":294},[219,401,402],{},"After the conversion is complete, enable them again:",[264,404,406],{"className":266,"code":405,"language":268,"meta":269,"style":269},"SET foreign_key_checks = 1;\n",[249,407,408],{"__ignoreMap":269},[273,409,410,412,414,416,419],{"class":275,"line":276},[273,411,388],{"class":279},[273,413,391],{"class":294},[273,415,394],{"class":283},[273,417,418],{"class":279}," 1",[273,420,295],{"class":294},[422,423,424],"warning",{},[219,425,426],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[223,428,430],{"id":429},"dsn-collation","DSN Collation",[219,432,433],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[219,435,436],{},"Example:",[264,438,443],{"className":439,"code":441,"language":442,"meta":269},[440],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[249,444,441],{"__ignoreMap":269},[219,446,447],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[223,449,451],{"id":450},"creating-a-database-user","Creating a Database User",[219,453,454,455,458,459,234,462,465],{},"Below are sample queries to create a database user named ",[249,456,457],{},"fivenet"," with full access to a specific database. Replace ",[249,460,461],{},"password",[249,463,464],{},"database_name"," with your actual values before using them.",[264,467,469],{"className":266,"code":468,"language":268,"meta":269,"style":269},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[249,470,471,509],{"__ignoreMap":269},[273,472,473,475,478,481,484,487,490,493,495,498,501,503,505,507],{"class":275,"line":276},[273,474,304],{"class":279},[273,476,477],{"class":279}," USER",[273,479,480],{"class":294}," '",[273,482,457],{"class":483},"s2Zo4",[273,485,486],{"class":294},"'@",[273,488,489],{"class":283},"'",[273,491,492],{"class":287},"%",[273,494,489],{"class":283},[273,496,497],{"class":294}," IDENTIFIED ",[273,499,500],{"class":279},"BY",[273,502,480],{"class":283},[273,504,461],{"class":287},[273,506,489],{"class":283},[273,508,295],{"class":294},[273,510,511,514,517,520,522,524,526,528,531,534,536,538,540,543,545,547,549],{"class":275,"line":298},[273,512,513],{"class":279},"GRANT",[273,515,516],{"class":294}," ALL PRIVILEGES ",[273,518,519],{"class":279},"ON",[273,521,284],{"class":283},[273,523,464],{"class":287},[273,525,291],{"class":283},[273,527,375],{"class":294},[273,529,530],{"class":283},"*",[273,532,533],{"class":279}," TO",[273,535,480],{"class":283},[273,537,457],{"class":287},[273,539,489],{"class":283},[273,541,542],{"class":294},"@",[273,544,489],{"class":283},[273,546,492],{"class":287},[273,548,489],{"class":283},[273,550,295],{"class":294},[219,552,553,554,557],{},"For a separate DBSync source user, read-only access is usually enough. See ",[369,555,67],{"href":556},".\u002Fdbsync"," for an example of a dedicated read-only user.",[223,559,561],{"id":560},"recommended-tools","Recommended Tools",[219,563,564,569],{},[369,565,568],{"href":566,"rel":567},"https:\u002F\u002Fdbeaver.io\u002F",[373],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[571,572,573],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: va