les, and columns are consistent.",[191,212,213],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[215,216,217],"callout",{},[191,218,219,220,224,225],{},"Recommended collation: ",[221,222,223],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[221,226,227],{},"utf8mb4",[195,229,231],{"id":230},"check-the-current-database-settings","Check the Current Database Settings",[191,233,234],{},"Use the following queries to inspect the current charset and collation:",[236,237,242],"pre",{"className":238,"code":239,"language":240,"meta":241,"style":241},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[221,243,244,268,288],{"__ignoreMap":241},[245,246,249,253,257,261,264],"span",{"class":247,"line":248},"line",1,[245,250,252],{"class":251},"sbssI","USE",[245,254,256],{"class":255},"sMK4o"," `",[245,258,260],{"class":259},"sfazB","__YOUR_DATABASE_NAME_HERE__",[245,262,263],{"class":255},"`",[245,265,267],{"class":266},"sTEyZ",";\n",[245,269,271,274,277,280,282,284,286],{"class":247,"line":270},2,[245,272,273],{"class":266},"SHOW ",[245,275,276],{"class":251},"CREATE",[245,278,279],{"class":251}," DATABASE",[245,281,256],{"class":255},[245,283,260],{"class":259},[245,285,263],{"class":255},[245,287,267],{"class":266},[245,289,291,293,296,299],{"class":247,"line":290},3,[245,292,273],{"class":266},[245,294,295],{"class":251},"TABLE",[245,297,298],{"class":251}," STATUS",[245,300,267],{"class":266},[191,302,303],{},"If you also want to inspect column-level collations, review the table definitions directly:",[236,305,307],{"className":238,"code":306,"language":240,"meta":241,"style":241},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[221,308,309],{"__ignoreMap":241},[245,310,311,313,315,318,320,323,325],{"class":247,"line":248},[245,312,273],{"class":266},[245,314,276],{"class":251},[245,316,317],{"class":251}," TABLE",[245,319,256],{"class":255},[245,321,322],{"class":259},"__YOUR_TABLE_NAME_HERE__",[245,324,263],{"class":255},[245,326,267],{"class":266},[195,328,330],{"id":329},"fixing-collation-mismatches","Fixing Collation Mismatches",[191,332,333,334,336,337,339,340,347],{},"A useful guide for converting tables to ",[221,335,227],{},"\u002F",[221,338,223],{}," in MySQL 5.5 can be found on the ",[341,342,346],"a",{"href":343,"rel":344},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[345],"nofollow","Database Administrators Stack Exchange",".",[191,349,350],{},"Before running generated conversion queries, disable foreign key checks:",[236,352,354],{"className":238,"code":353,"language":240,"meta":241,"style":241},"SET foreign_key_checks = 0;\n",[221,355,356],{"__ignoreMap":241},[245,357,358,361,364,367,370],{"class":247,"line":248},[245,359,360],{"class":251},"SET",[245,362,363],{"class":266}," foreign_key_checks ",[245,365,366],{"class":255},"=",[245,368,369],{"class":251}," 0",[245,371,267],{"class":266},[191,373,374],{},"After the conversion is complete, enable them again:",[236,376,378],{"className":238,"code":377,"language":240,"meta":241,"style":241},"SET foreign_key_checks = 1;\n",[221,379,380],{"__ignoreMap":241},[245,381,382,384,386,388,391],{"class":247,"line":248},[245,383,360],{"class":251},[245,385,363],{"class":266},[245,387,366],{"class":255},[245,389,390],{"class":251}," 1",[245,392,267],{"class":266},[394,395,396],"warning",{},[191,397,398],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[195,400,402],{"id":401},"dsn-collation","DSN Collation",[191,404,405],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[191,407,408],{},"Example:",[236,410,415],{"className":411,"code":413,"language":414,"meta":241},[412],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[221,416,413],{"__ignoreMap":241},[191,418,419],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[195,421,423],{"id":422},"creating-a-database-user","Creating a Database User",[191,425,426,427,430,431,206,434,437],{},"Below are sample queries to create a database user named ",[221,428,429],{},"fivenet"," with full access to a specific database. Replace ",[221,432,433],{},"password",[221,435,436],{},"database_name"," with your actual values before using them.",[236,439,441],{"className":238,"code":440,"language":240,"meta":241,"style":241},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[221,442,443,481],{"__ignoreMap":241},[245,444,445,447,450,453,456,459,462,465,467,470,473,475,477,479],{"class":247,"line":248},[245,446,276],{"class":251},[245,448,449],{"class":251}," USER",[245,451,452],{"class":266}," '",[245,454,429],{"class":455},"s2Zo4",[245,457,458],{"class":266},"'@",[245,460,461],{"class":255},"'",[245,463,464],{"class":259},"%",[245,466,461],{"class":255},[245,468,469],{"class":266}," IDENTIFIED ",[245,471,472],{"class":251},"BY",[245,474,452],{"class":255},[245,476,433],{"class":259},[245,478,461],{"class":255},[245,480,267],{"class":266},[245,482,483,486,489,492,494,496,498,500,503,506,508,510,512,515,517,519,521],{"class":247,"line":270},[245,484,485],{"class":251},"GRANT",[245,487,488],{"class":266}," ALL PRIVILEGES ",[245,490,491],{"class":251},"ON",[245,493,256],{"class":255},[245,495,436],{"class":259},[245,497,263],{"class":255},[245,499,347],{"class":266},[245,501,502],{"class":255},"*",[245,504,505],{"class":251}," TO",[245,507,452],{"class":255},[245,509,429],{"class":259},[245,511,461],{"class":255},[245,513,514],{"class":266},"@",[245,516,461],{"class":255},[245,518,464],{"class":259},[245,520,461],{"class":255},[245,522,267],{"class":266},[191,524,525,526,529],{},"For a separate DBSync source user, read-only access is usually enough. See ",[341,527,66],{"href":528},".\u002Fdbsync"," for an example of a dedicated read-only user.",[195,531,533],{"id":532},"recommended-tools","Recommended Tools",[191,535,536,541],{},[341,537,540],{"href":538,"rel":539},"https:\u002F\u002Fdbeaver.io\u002F",[345],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[543,544,545],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .