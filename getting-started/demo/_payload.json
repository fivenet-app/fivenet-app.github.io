:203,"value":204,"toc":310},"minimark",[205,209,219,232,237,240,251,257,261,272,279,289,296,303,307],[206,207,208],"p",{},"Try FiveNet in a live environment using the public demo instance.",[210,211],"prose-button",{"color":212,"external":213,"icon":214,"label":215,"size":216,"target":217,"to":218},"primary","true","i-mdi-play-circle-outline","Access the Demo Instance","lg","_blank","https:\u002F\u002Fdemo.fivenet.app\u002F",[220,221,224],"callout",{"icon":222,"color":223},"i-mdi-warning-circle","warning",[206,225,226,227,231],{},"The demo instance resets every ",[228,229,230],"strong",{},"12 hours",". During the reset, it may be unavailable for a few seconds, and some data may be cleared.",[233,234,236],"h2",{"id":235},"login","Login",[206,238,239],{},"Use the following credentials:",[241,242,248],"pre",{"className":243,"code":245,"language":246,"meta":247},[244],"language-text","Username: demo\nPassword: fivenet-demo\n","text","",[249,250,245],"code",{"__ignoreMap":247},[220,252,254],{"icon":253},"i-mdi-info-slab-circle",[206,255,256],{},"Not every feature is fully available in the demo environment. Some advanced functionality may be limited or simulated.",[233,258,260],{"id":259},"best-way-to-explore","Best Way to Explore",[206,262,263,264,267,268,271],{},"The demo account includes multiple characters. For the best overview, use the ",[228,265,266],{},"Los Santos Police Department (LSPD)"," character with the ",[249,269,270],{},"police"," job.",[206,273,274,275,278],{},"This character has access to ",[228,276,277],{},"superuser mode",", which lets you:",[280,281,282,286],"ul",{},[283,284,285],"li",{},"Switch between jobs",[283,287,288],{},"Explore administrative features",[206,290,291,292,295],{},"You can enable or disable superuser mode from the ",[228,293,294],{},"user menu"," in the left sidebar.",[220,297,300],{"icon":298,"color":299},"i-mdi-lightbulb-on-outline","info",[206,301,302],{},"If you want to explore as much of FiveNet as possible, start with the police character and enable superuser mode.",[233,304,306],{"id":305},"feedback","Feedback",[206,308,309],{},"If you run into problems or have suggestions, reach out to the FiveNet team on Discord.",{"title":247,"searchDepth":311,"depth":311,"links":312},2,[313,314,315],{"id":235,"depth":311,"text":236},{"id":259,"depth":311,"text":260},{"id":305,"depth":311,"text":306},"Try FiveNet using the public demo instance.","md",null,{},true,"\u002Fgetting-started\u002Fdemo",{"title":15,"description":316},"1.getting-started\u002F2.demo","zmgFGSF0IMz-keHr9k8AtB3j52j6y5BtxHX8AKsWRoc",[326,331],{"title":327,"path":328,"stem":329,"description":330,"children":-1},"Features","\u002Fgetting-started\u002Ffeatures","1.getting-started\u002F1.features","Overview of the features provided by FiveNet, including details about the frontend, backend, and gameserver plugins.",{"title":332,"path":333,"stem":334,"description":335,"children":-1},"Requirements","\u002Fgetting-started\u002Frequirements","1.getting-started\u002F2.requirements","Infrastructure and software requirements for running FiveNet.",1789078696832]