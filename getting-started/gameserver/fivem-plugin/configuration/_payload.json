stance and integrate with your framework, dispatch, and tracking setup.",[223,224,226],"h2",{"id":225},"before-you-start","Before You Start",[219,228,229],{},"Before adjusting the plugin configuration, make sure:",[231,232,233,237,240],"ul",{},[234,235,236],"li",{},"your FiveNet instance is reachable from the gameserver",[234,238,239],{},"the Sync API token is configured in FiveNet",[234,241,242,243,247,248],{},"you know which framework the server is using, such as ",[244,245,246],"code",{},"esx"," or ",[244,249,250],{},"qbcore",[223,252,254],{"id":253},"minimum-required-settings","Minimum Required Settings",[219,256,257],{},"At a minimum, review these values before starting the plugin:",[231,259,260,269,277,284],{},[234,261,262,265,266],{},[244,263,264],{},"Config.WebURL"," in ",[244,267,268],{},"config\u002Fclient.lua",[234,270,271,265,274],{},[244,272,273],{},"Config.Framework",[244,275,276],{},"config\u002Fserver.lua",[234,278,279,265,282],{},[244,280,281],{},"Config.API.Host",[244,283,276],{},[234,285,286,265,289],{},[244,287,288],{},"Config.API.Token",[244,290,276],{},[219,292,293],{},"If these values are wrong, the in-game tablet or plugin integration will not work correctly.",[223,295,297],{"id":296},"configuration-reference","Configuration Reference",[299,300,302],"h3",{"id":301},"client-side","Client Side",[219,304,305,306,308],{},"The client-side configuration is located in ",[244,307,268],{},".",[310,311,312,328],"table",{},[313,314,315],"thead",{},[316,317,318,322,325],"tr",{},[319,320,321],"th",{},"Option",[319,323,324],{},"Default Value",[319,326,327],{},"Description",[329,330,331,346,361,376],"tbody",{},[316,332,333,338,343],{},[334,335,336],"td",{},[244,337,264],{},[334,339,340],{},[244,341,342],{},"'https:\u002F\u002Fdemo.fivenet.app'",[334,344,345],{},"Your FiveNet URL without a trailing slash.",[316,347,348,353,358],{},[334,349,350],{},[244,351,352],{},"Config.Hotkey.Enable",[334,354,355],{},[244,356,357],{},"true",[334,359,360],{},"If the tablet hotkey should be registered.",[316,362,363,368,373],{},[334,364,365],{},[244,366,367],{},"Config.Hotkey.Key",[334,369,370],{},[244,371,372],{},"'F5'",[334,374,375],{},"The key used for the tablet hotkey.",[316,377,378,383,388],{},[334,379,380],{},[244,381,382],{},"Config.PostalCommand",[334,384,385],{},[244,386,387],{},"'plz'",[334,389,390],{},"Command to mark the postal code on the player's map.",[299,392,394],{"id":393},"server-side","Server-Side",[219,396,397,398,308],{},"The server-side configuration is located in ",[244,399,276],{},[310,401,402,412],{},[313,403,404],{},[316,405,406,408,410],{},[319,407,321],{},[319,409,324],{},[319,411,327],{},[329,413,414,432,446,460,475,489,503,518,533,548,562,577,591,606,625,640,654],{},[316,415,416,420,425],{},[334,417,418],{},[244,419,273],{},[334,421,422],{},[244,423,424],{},"'esx'",[334,426,427,428,247,430,308],{},"The framework being used. Can be ",[244,429,246],{},[244,431,250],{},[316,433,434,438,443],{},[334,435,436],{},[244,437,281],{},[334,439,440],{},[244,441,442],{},"'demo.fivenet.app:443'",[334,444,445],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[316,447,448,452,457],{},[334,449,450],{},[244,451,288],{},[334,453,454],{},[244,455,456],{},"'YOUR_SYNC_API_TOKEN'",[334,458,459],{},"The API token for FiveNet.",[316,461,462,467,472],{},[334,463,464],{},[244,465,466],{},"Config.API.Insecure",[334,468,469],{},[244,470,471],{},"false",[334,473,474],{},"Whether to allow insecure connections.",[316,476,477,482,486],{},[334,478,479],{},[244,480,481],{},"Config.TrackCharIDs",[334,483,484],{},[244,485,357],{},[334,487,488],{},"Whether to record the last character ID.",[316,490,491,496,500],{},[334,492,493],{},[244,494,495],{},"Config.Tracking.Enable",[334,497,498],{},[244,499,357],{},[334,501,502],{},"Enable or disable player tracking.",[316,504,505,510,515],{},[334,506,507],{},[244,508,509],{},"Config.Tracking.Jobs",[334,511,512],{},[244,513,514],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[334,516,517],{},"Jobs that will be tracked.",[316,519,520,525,530],{},[334,521,522],{},[244,523,524],{},"Config.Tracking.Item",[334,526,527],{},[244,528,529],{},"'radio'",[334,531,532],{},"Players without this item will be marked as 'hidden'.",[316,534,535,540,545],{},[334,536,537],{},[244,538,539],{},"Config.Tracking.Interval",[334,541,542],{},[244,543,544],{},"3000",[334,546,547],{},"Interval in milliseconds for updating positions.",[316,549,550,555,559],{},[334,551,552],{},[244,553,554],{},"Config.TimeclockJobs",[334,556,557],{},[244,558,514],{},[334,560,561],{},"Jobs that will be tracked for timeclock purposes.",[316,563,564,569,574],{},[334,565,566],{},[244,567,568],{},"Config.Events.BillingJobs",[334,570,571],{},[244,572,573],{},"{ ['doj'] = true, ['police'] = true }",[334,575,576],{},"Jobs that will trigger user activity for billing cycle events.",[316,578,579,584,588],{},[334,580,581],{},[244,582,583],{},"Config.Discord.ConnectOnJoin",[334,585,586],{},[244,587,357],{},[334,589,590],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[316,592,593,598,603],{},[334,594,595],{},[244,596,597],{},"Config.Discord.OAuth2Provider",[334,599,600],{},[244,601,602],{},"'discord'",[334,604,605],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[316,607,608,613,618],{},[334,609,610],{},[244,611,612],{},"Config.Dispatches.CivilProtectionJobs",[334,614,615],{},[244,616,617],{},"{ ['police'] = true }",[334,619,620,621,624],{},"Jobs that will receive dispatches created via the ",[244,622,623],{},"createCivilProtectionJobDispatch"," function.",[316,626,627,632,637],{},[334,628,629],{},[244,630,631],{},"Config.Dispatches.PanicButtonTitle",[334,633,634],{},[244,635,636],{},"'Panikknopf ausgelöst'",[334,638,639],{},"Title for the panic button dispatch.",[316,641,642,647,651],{},[334,643,644],{},[244,645,646],{},"Config.UserProps.SetBloodType",[334,648,649],{},[244,650,357],{},[334,652,653],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[316,655,656,661,666],{},[334,657,658],{},[244,659,660],{},"Config.UserProps.BloodTypes",[334,662,663],{},[244,664,665],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[334,667,668],{},"Blood types to assign to users if not already set.",[223,670,672],{"id":671},"functions","Functions",[219,674,675,676,678],{},"Some plugin integrations depend on the ",[244,677,672],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[219,680,681],{},"Make sure the required functions are implemented for the resources your server uses.",[219,683,684],{},"Below are examples for client-side and server-side functions.",[299,686,688],{"id":687},"client-side-1","Client-Side",[219,690,691,692,695,696,699],{},"When using ",[244,693,694],{},"pma-voice",", implement ",[244,697,698],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[701,702,707],"pre",{"className":703,"code":704,"language":705,"meta":706,"style":706},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[244,708,709,718,749,755,787,794,811,829,835],{"__ignoreMap":706},[710,711,714],"span",{"class":712,"line":713},"line",1,[710,715,717],{"class":716},"sHwdD","-- Set radio frequency\n",[710,719,721,725,728,732,736,739,743,746],{"class":712,"line":720},2,[710,722,724],{"class":723},"sTEyZ","Functions.",[710,726,698],{"class":727},"s2Zo4",[710,729,731],{"class":730},"sMK4o"," =",[710,733,735],{"class":734},"s7zQu"," f