ost",[269,308,301],{},[259,310,311,290,314],{},[269,312,313],{},"Config.API.Token",[269,315,301],{},[244,317,318],{},"If these values are wrong, the in-game tablet or plugin integration will not work correctly.",[248,320,322],{"id":321},"configuration-reference","Configuration Reference",[324,325,327],"h3",{"id":326},"client-side","Client Side",[244,329,330,331,333],{},"The client-side configuration is located in ",[269,332,293],{},".",[335,336,337,353],"table",{},[338,339,340],"thead",{},[341,342,343,347,350],"tr",{},[344,345,346],"th",{},"Option",[344,348,349],{},"Default Value",[344,351,352],{},"Description",[354,355,356,371,386,401],"tbody",{},[341,357,358,363,368],{},[359,360,361],"td",{},[269,362,289],{},[359,364,365],{},[269,366,367],{},"'https:\u002F\u002Fdemo.fivenet.app'",[359,369,370],{},"Your FiveNet URL without a trailing slash.",[341,372,373,378,383],{},[359,374,375],{},[269,376,377],{},"Config.Hotkey.Enable",[359,379,380],{},[269,381,382],{},"true",[359,384,385],{},"If the tablet hotkey should be registered.",[341,387,388,393,398],{},[359,389,390],{},[269,391,392],{},"Config.Hotkey.Key",[359,394,395],{},[269,396,397],{},"'F5'",[359,399,400],{},"The key used for the tablet hotkey.",[341,402,403,408,413],{},[359,404,405],{},[269,406,407],{},"Config.PostalCommand",[359,409,410],{},[269,411,412],{},"'plz'",[359,414,415],{},"Command to mark the postal code on the player's map.",[324,417,419],{"id":418},"server-side","Server-Side",[244,421,422,423,333],{},"The server-side configuration is located in ",[269,424,301],{},[335,426,427,437],{},[338,428,429],{},[341,430,431,433,435],{},[344,432,346],{},[344,434,349],{},[344,436,352],{},[354,438,439,457,471,485,500,514,528,543,558,573,587,602,616,631,650,665,679],{},[341,440,441,445,450],{},[359,442,443],{},[269,444,298],{},[359,446,447],{},[269,448,449],{},"'esx'",[359,451,452,453,272,455,333],{},"The framework being used. Can be ",[269,454,271],{},[269,456,275],{},[341,458,459,463,468],{},[359,460,461],{},[269,462,306],{},[359,464,465],{},[269,466,467],{},"'demo.fivenet.app:443'",[359,469,470],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[341,472,473,477,482],{},[359,474,475],{},[269,476,313],{},[359,478,479],{},[269,480,481],{},"'YOUR_SYNC_API_TOKEN'",[359,483,484],{},"The API token for FiveNet.",[341,486,487,492,497],{},[359,488,489],{},[269,490,491],{},"Config.API.Insecure",[359,493,494],{},[269,495,496],{},"false",[359,498,499],{},"Whether to allow insecure connections.",[341,501,502,507,511],{},[359,503,504],{},[269,505,506],{},"Config.TrackCharIDs",[359,508,509],{},[269,510,382],{},[359,512,513],{},"Whether to record the last character ID.",[341,515,516,521,525],{},[359,517,518],{},[269,519,520],{},"Config.Tracking.Enable",[359,522,523],{},[269,524,382],{},[359,526,527],{},"Enable or disable player tracking.",[341,529,530,535,540],{},[359,531,532],{},[269,533,534],{},"Config.Tracking.Jobs",[359,536,537],{},[269,538,539],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[359,541,542],{},"Jobs that will be tracked.",[341,544,545,550,555],{},[359,546,547],{},[269,548,549],{},"Config.Tracking.Item",[359,551,552],{},[269,553,554],{},"'radio'",[359,556,557],{},"Players without this item will be marked as 'hidden'.",[341,559,560,565,570],{},[359,561,562],{},[269,563,564],{},"Config.Tracking.Interval",[359,566,567],{},[269,568,569],{},"3000",[359,571,572],{},"Interval in milliseconds for updating positions.",[341,574,575,580,584],{},[359,576,577],{},[269,578,579],{},"Config.TimeclockJobs",[359,581,582],{},[269,583,539],{},[359,585,586],{},"Jobs that will be tracked for timeclock purposes.",[341,588,589,594,599],{},[359,590,591],{},[269,592,593],{},"Config.Events.BillingJobs",[359,595,596],{},[269,597,598],{},"{ ['doj'] = true, ['police'] = true }",[359,600,601],{},"Jobs that will trigger user activity for billing cycle events.",[341,603,604,609,613],{},[359,605,606],{},[269,607,608],{},"Config.Discord.ConnectOnJoin",[359,610,611],{},[269,612,382],{},[359,614,615],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[341,617,618,623,628],{},[359,619,620],{},[269,621,622],{},"Config.Discord.OAuth2Provider",[359,624,625],{},[269,626,627],{},"'discord'",[359,629,630],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[341,632,633,638,643],{},[359,634,635],{},[269,636,637],{},"Config.Dispatches.CivilProtectionJobs",[359,639,640],{},[269,641,642],{},"{ ['police'] = true }",[359,644,645,646,649],{},"Jobs that will receive dispatches created via the ",[269,647,648],{},"createCivilProtectionJobDispatch"," function.",[341,651,652,657,662],{},[359,653,654],{},[269,655,656],{},"Config.Dispatches.PanicButtonTitle",[359,658,659],{},[269,660,661],{},"'Panikknopf ausgelöst'",[359,663,664],{},"Title for the panic button dispatch.",[341,666,667,672,676],{},[359,668,669],{},[269,670,671],{},"Config.UserProps.SetBloodType",[359,673,674],{},[269,675,382],{},[359,677,678],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[341,680,681,686,691],{},[359,682,683],{},[269,684,685],{},"Config.UserProps.BloodTypes",[359,687,688],{},[269,689,690],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[359,692,693],{},"Blood types to assign to users if not already set.",[248,695,697],{"id":696},"functions","Functions",[244,699,700,701,703],{},"Some plugin integrations depend on the ",[269,702,697],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[244,705,706],{},"Make sure the required functions are implemented for the resources your server uses.",[244,708,709],{},"Below are examples for client-side and server-side functions.",[324,711,713],{"id":712},"client-side-1","Client-Side",[244,715,716,717,720,721,724],{},"When using ",[269,718,719],{},"pma-voice",", implement ",[269,722,723],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[726,727,732],"pre",{"className":728,"code":729,"language":730,"meta":731,"style":731},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[269,733,734,743,774,780,812,819,836,854,860],{"__ignoreMap":731},[735,736,739],"span",{"class":737,"line":738},"line",1,[735,740,742],{"class":741},"sHwdD","-- Set radio frequency\n",[735,744,746,750,753,757,761,764,768,771],{"class":737,"line":745},2,[735,747,749],{"class":748},"sTEyZ","Functions.",[735,751,723],{"class":752},"s2Zo4",[735,754,756],{"class":755},"sMK4o"," =",[735,758,760],{"class":759},"s7zQu"," function",[735,762,763],{"class":755},"(",[735,765,767],{"class":766},"sHdIc","frequency",[735,769,770],{"class":741}," --[[number]]",[735,772,773],{"class":748},")\n",[735,775,777],{"class":737,"line":776},3,[735,778,779],{"class":741},"    -- This is for pma-voice\n",[735,781,783,786,789,792,795,798,801,803,806,809],{"class":737,"line":782},4,[735,784,785],{"class":755},"    local",[735,787,788],{"class":748}," currentChannel ",[735,790,791],{"class":755},"=",[735,793,794],{"class":748}," exports[",[735,796,797],{"class":755},"'",[735,799,719],{"class":800},"sfazB",[735,802,797],{"class":755},[735,804,805],{"class":748},"]:",[735,807,808],{"class":752},"getRadioChannel",[735,810,811],{"class":748},"()\n",[735,813,815],{"class":737,"line":814},5,[735,816,818],{"emptyLinePlaceholder":817},true,"\n",[735,820,822,825,827,830,833],{"class":737,"line":821},6,[735,823,824],{"class":759},"    if",[735,826,788],{"class":748},[735,828,829],{"class":755},"~=",[735,831,832],{"class":748}," frequency ",[735,834,835],{"class":759},"then\n",[735,837,839,842,844,846,849,851],{"class":737,"line":838},7,[735,840,841],{"class":752},"        TriggerEvent",[735,843,763],{"class":748},[735,845,797],{"class":755},[735,847,848],{"class":800},"tgiann-radio:t",[735,850,797],{"class":755},[735,852,853],{"class":748},", frequency)\n",[735,855,857],{"class":737,"line":856},8,[735,858,859],{"class":759},"    end\n",[735,861,863],{"class":737,"line":862},9,[735,864,865],{"class":759},"end\n",[324,867,419],{"id":868},"server-side-1",[244,870,716,871,272,873,720,875,878],{},[269,872,271],{},[269,874,275],{},[269,876,877],{},"CheckIfPlayerHidden"," in your server-side script. This function checks whether a player should be hidden based on duty state and whether they have the required tracking item in their inventory.",[726,880,882],{"className":728,"code":881,"language":730,"meta":731,"style":731},"-- Player tracker - Check if hidden function\nFunctions.CheckIfPlayerHidden = function(xPlayer)\n    if Config.Framework == 'esx' then\n        -- ESX\n        return not xPlayer.job.onDuty or (Config.Tracking.Item and not xPlayer.getInventoryItem(Config.Tracking.Item))\n    elseif Config.Framework == 'qbcore' then\n        -- QBCore\n        return not xPlayer.PlayerData.job.onduty or (Config.Tracking.Item and not exports['qb-inventory']:HasItem(xPlayer.PlayerData.source, Config.Tracking.Item))\n    else\n        -- Fallback\n        return false\n    end\nend\n",[269,883,884,889,906,930,935,990,1009,1014,1083,1088,1094,1102,1107],{"__ignoreMap":731},[735,885,886],{"class":737,"line":738},[735,887,888],{"class":741},"-- Player tracker - Check if hidden function\n",[735,890,891,893,895,897,899,901,904],{"class":737,"line":745},[735,892,749],{"class":748},[735,894,877],{"class":752},[735,896,756],{"class":755},[735,898,760],{"class":759},[735,900,763],{"class":755},[735,902,903],{"class":766},"xPlayer",[735,905,773],{"class":755},[735,907,908,910,913,917,920,923,925,928],{"cla