if Config.Framework == 'esx' then\n        -- ESX\n        return not xPlayer.job.onDuty or (Config.Tracking.Item and not xPlayer.getInventoryItem(Config.Tracking.Item))\n    elseif Config.Framework == 'qbcore' then\n        -- QBCore\n        return not xPlayer.PlayerData.job.onduty or (Config.Tracking.Item and not exports['qb-inventory']:HasItem(xPlayer.PlayerData.source, Config.Tracking.Item))\n    else\n        -- Fallback\n        return false\n    end\nend\n",[244,858,859,864,881,905,910,965,984,989,1058,1063,1069,1077,1082],{"__ignoreMap":706},[710,860,861],{"class":712,"line":713},[710,862,863],{"class":716},"-- Player tracker - Check if hidden function\n",[710,865,866,868,870,872,874,876,879],{"class":712,"line":720},[710,867,724],{"class":723},[710,869,852],{"class":727},[710,871,731],{"class":730},[710,873,735],{"class":734},[710,875,738],{"class":730},[710,877,878],{"class":741},"xPlayer",[710,880,748],{"class":730},[710,882,883,885,888,892,895,898,900,903],{"class":712,"line":751},[710,884,799],{"class":734},[710,886,887],{"class":723}," Config.",[710,889,891],{"class":890},"sBMFI","Framework",[710,893,894],{"class":730}," ==",[710,896,897],{"class":730}," '",[710,899,246],{"class":775},[710,901,902],{"class":730},"' ",[710,904,810],{"class":734},[710,906,907],{"class":712,"line":757},[710,908,909],{"class":716},"        -- ESX\n",[710,911,912,915,918,921,924,926,929,932,935,938,940,943,946,948,950,953,956,958,960,962],{"class":712,"line":789},[710,913,914],{"class":734},"        return",[710,916,917],{"class":730}," not",[710,919,920],{"class":723}," xPlayer.",[710,922,923],{"class":890},"job",[710,925,308],{"class":723},[710,927,928],{"class":890},"onDuty",[710,930,931],{"class":730}," or",[710,933,934],{"class":723}," (Config.",[710,936,937],{"class":890},"Tracking",[710,939,308],{"class":723},[710,941,942],{"class":890},"Item",[710,944,945],{"class":730}," and",[710,947,917],{"class":730},[710,949,920],{"class":723},[710,951,952],{"class":727},"getI