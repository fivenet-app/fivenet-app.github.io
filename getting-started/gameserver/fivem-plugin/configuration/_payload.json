token for FiveNet.",[336,481,482,487,492],{},[354,483,484],{},[264,485,486],{},"Config.API.Insecure",[354,488,489],{},[264,490,491],{},"false",[354,493,494],{},"Whether to allow insecure connections.",[336,496,497,502,506],{},[354,498,499],{},[264,500,501],{},"Config.TrackCharIDs",[354,503,504],{},[264,505,377],{},[354,507,508],{},"Whether to record the last character ID.",[336,510,511,516,520],{},[354,512,513],{},[264,514,515],{},"Config.Tracking.Enable",[354,517,518],{},[264,519,377],{},[354,521,522],{},"Enable or disable player tracking.",[336,524,525,530,535],{},[354,526,527],{},[264,528,529],{},"Config.Tracking.Jobs",[354,531,532],{},[264,533,534],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[354,536,537],{},"Jobs that will be tracked.",[336,539,540,545,550],{},[354,541,542],{},[264,543,544],{},"Config.Tracking.Item",[354,546,547],{},[264,548,549],{},"'radio'",[354,551,552],{},"Players without this item will be marked as 'hidden'.",[336,554,555,560,565],{},[354,556,557],{},[264,558,559],{},"Config.Tracking.Interval",[354,561,562],{},[264,563,564],{},"3000",[354,566,567],{},"Interval in milliseconds for updating positions.",[336,569,570,575,579],{},[354,571,572],{},[264,573,574],{},"Config.TimeclockJobs",[354,576,577],{},[264,578,534],{},[354,580,581],{},"Jobs that will be tracked for timeclock purposes.",[336,583,584,589,594],{},[354,585,586],{},[264,587,588],{},"Config.Events.BillingJobs",[354,590,591],{},[264,592,593],{},"{ ['doj'] = true, ['police'] = true }",[354,595,596],{},"Jobs that will trigger user activity for billing cycle events.",[336,598,599,604,608],{},[354,600,601],{},[264,602,603],{},"Config.Discord.ConnectOnJoin",[354,605,606],{},[264,607,377],{},[354,609,610],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[336,612,613,618,623],{},[354,614,615],{},[264,616,617],{},"Config.Discord.OAuth2Provider",[354,619,620],{},[264,621,622],{},"'discord'",[354,624,625],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[336,627,628,633,638],{},[354,629,630],{},[264,631,632],{},"Config.Dispatches.CivilProtectionJobs",[354,634,635],{},[264,636,637],{},"{ ['police'] = true }",[354,639,640,641,644],{},"Jobs that will receive dispatches created via the ",[264,642,643],{},"createCivilProtectionJobDispatch"," function.",[336,646,647,652,657],{},[354,648,649],{},[264,650,651],{},"Config.Dispatches.PanicButtonTitle",[354,653,654],{},[264,655,656],{},"'Panikknopf ausgelöst'",[354,658,659],{},"Title for the panic button dispatch.",[336,661,662,667,671],{},[354,663,664],{},[264,665,666],{},"Config.UserProps.SetBloodType",[354,668,669],{},[264,670,377],{},[354,672,673],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[336,675,676,681,686],{},[354,677,678],{},[264,679,680],{},"Config.UserProps.BloodTypes",[354,682,683],{},[264,684,685],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[354,687,688],{},"Blood types to assign to users if not already set.",[243,690,692],{"id":691},"functions","Functions",[239,694,695,696,698],{},"Some plugin integrations depend on the ",[264,697,692],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[239,700,701],{},"Make sure the required functions are implemented for the resources your server uses.",[239,703,704],{},"Below are examples for client-side and server-side functions.",[319,706,708],{"id":707},"client-side-1","Client-Side",[239,710,711,712,715,716,719],{},"When using ",[264,713,714],{},"pma-voice",", implement ",[264,717,718],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[721,722,727],"pre",{"className":723,"code":724,"language":725,"meta":726,"style":726},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[264,728,729,738,769,775,807,814,831,849,855],{"__ignoreMap":726},[730,731,734],"span",{"class":732,"line":733},"line",1,[730,735,737],{"class":736},"sHwdD","-- Set radio frequency\n",[730,739,741,745,748,752,756,759,763,766],{"class":732,"line":740},2,[730,742,744],{"class":743},"sTEyZ","Functions.",[730,746,718],{"class":747},"s2Zo4",[730,749,751],{"class":750},"sMK4o"," =",[730,753,755],{"class":754},"s7zQu"," function",[730,757,758],{"class":750},"(",[730,760,762],{"class":761},"sHdIc","frequency",[730,764,765],{"class":736}," --[[number]]",[730,767,768],{"class":743},")\n",[730,770,772],{"class":732,"line":771},3,[730,773,774],{"class":736},"    -- This is for pma-voice\n",[730,776,778,781,784,787,790,793,796,798,801,804],{"class":732,"line":777},4,[730,779,780],{"class":750},"    local",[730,782,783],{"class":743}," currentChannel ",[730,785,786],{"class":750},"=",[730,788,789],{"class":743}," exports[",[730,791,792],{"class":750},"'",[730,794,714],{"class":795},"sfazB",[730,797,792],{"class":750},[730,799,800],{"class":743},"]:",[730,802,803],{"class":747},"getRadioChannel",[730,805,806],{"class":743},"()\n",[730,808,810],{"class":732,"line":809},5,[730,811,813],{"emptyLinePlaceholder":812},true,"\n",[730,815,817,820,822,825,828],{"class":732,"line":816},6,[730,818,819],{"class":754},"    if",[730,821,783],{"class":743},[730,823,824],{"class":750},"~=",[730,826,827],{"class":743}," frequency ",[730,829,830],{"class":754},"then\n",[730,832,834,837,839,841,844,846],{"class":732,"line":833},7,[730,835,836],{"class":747},"        TriggerEvent",[730,838,758],{"class":743},[730,840,792],{"class":750},[730,842,843],{"class":795},"tgiann-radio:t",[730,845,792],{"class":750},[730,84