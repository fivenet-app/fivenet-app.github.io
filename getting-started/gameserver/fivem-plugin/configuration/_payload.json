in FiveNet",[202,209,210,211,215,216],{},"you know which framework the server is using, such as ",[212,213,214],"code",{},"esx"," or ",[212,217,218],{},"qbcore",[191,220,222],{"id":221},"minimum-required-settings","Minimum Required Settings",[187,224,225],{},"At a minimum, review these values before starting the plugin:",[199,227,228,237,245,252],{},[202,229,230,233,234],{},[212,231,232],{},"Config.WebURL"," in ",[212,235,236],{},"config\u002Fclient.lua",[202,238,239,233,242],{},[212,240,241],{},"Config.Framework",[212,243,244],{},"config\u002Fserver.lua",[202,246,247,233,250],{},[212,248,249],{},"Config.API.Host",[212,251,244],{},[202,253,254,233,257],{},[212,255,256],{},"Config.API.Token",[212,258,244],{},[187,260,261],{},"If these values are wrong, the in-game tablet or plugin integration will not work correctly.",[191,263,265],{"id":264},"configuration-reference","Configuration Reference",[267,268,270],"h3",{"id":269},"client-side","Client Side",[187,272,273,274,276],{},"The client-side configuration is located in ",[212,275,236],{},".",[278,279,280,296],"table",{},[281,282,283],"thead",{},[284,285,286,290,293],"tr",{},[287,288,289],"th",{},"Option",[287,291,292],{},"Default Value",[287,294,295],{},"Description",[297,298,299,314,329,344],"tbody",{},[284,300,301,306,311],{},[302,303,304],"td",{},[212,305,232],{},[302,307,308],{},[212,309,310],{},"'https:\u002F\u002Fdemo.fivenet.app'",[302,312,313],{},"Your FiveNet URL without a trailing slash.",[284,315,316,321,326],{},[302,317,318],{},[212,319,320],{},"Config.Hotkey.Enable",[302,322,323],{},[212,324,325],{},"true",[302,327,328],{},"If the tablet hotkey should be registered.",[284,330,331,336,341],{},[302,332,333],{},[212,334,335],{},"Config.Hotkey.Key",[302,337,338],{},[212,339,340],{},"'F5'",[302,342,343],{},"The key used for the tablet hotkey.",[284,345,346,351,356],{},[302,347,348],{},[212,349,350],{},"Config.PostalCommand",[302,352,353],{},[212,354,355],{},"'plz'",[302,357,358],{},"Command to mark the postal code on the player's map.",[267,360,362],{"id":361},"server-side","Server-Side",[187,364,365,366,276],{},"The server-side configuration is located in ",[212,367,244],{},[278,369,370,380],{},[281,371,372],{},[284,373,374,376,378],{},[287,375,289],{},[287,377,292],{},[287,379,295],{},[297,381,382,400,414,428,443,457,471,486,501,516,530,545,559,574,593,608,622],{},[284,383,384,388,393],{},[302,385,386],{},[212,387,241],{},[302,389,390],{},[212,391,392],{},"'esx'",[302,394,395,396,215,398,276],{},"The framework being used. Can be ",[212,397,214],{},[212,399,218],{},[284,401,402,406,411],{},[302,403,404],{},[212,405,249],{},[302,407,408],{},[212,409,410],{},"'demo.fivenet.app:443'",[302,412,413],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[284,415,416,420,425],{},[302,417,418],{},[212,419,256],{},[302,421,422],{},[212,423,424],{},"'YOUR_SYNC_API_TOKEN'",[302,426,427],{},"The API token for FiveNet.",[284,429,430,435,440],{},[302,431,432],{},[212,433,434],{},"Config.API.Insecure",[302,436,437],{},[212,438,439],{},"false",[302,441,442],{},"Whether to allow insecure connections.",[284,444,445,450,454],{},[302,446,447],{},[212,448,449],{},"Config.TrackCharIDs",[302,451,452],{},[212,453,325],{},[302,455,456],{},"Whether to record the last character ID.",[284,458,459,464,468],{},[302,460,461],{},[212,462,463],{},"Config.Tracking.Enable",[302,465,466],{},[212,467,325],{},[302,469,470],{},"Enable or disable player tracking.",[284,472,473,478,483],{},[302,474,475],{},[212,476,477],{},"Config.Tracking.Jobs",[302,479,480],{},[212,481,482],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[302,484,485],{},"Jobs that will be tracked.",[284,487,488,493,498],{},[302,489,490],{},[212,491,492],{},"Config.Tracking.Item",[302,494,495],{},[212,496,497],{},"'radio'",[302,499,500],{},"Players without this item will be marked as 'hidden'.",[284,502,503,508,513],{},[302,504,505],{},[212,506,507],{},"Config.Tracking.Interval",[302,509,510],{},[212,511,512],{},"3000",[302,514,515],{},"Interval in milliseconds for updating positions.",[284,517,518,523,527],{},[302,519,520],{},[212,521,522],{},"Config.TimeclockJobs",[302,524,525],{},[212,526,482],{},[302,528,529],{},"Jobs that will be tracked for timeclock purposes.",[284,531,532,537,542],{},[302,533,534],{},[212,535,536],{},"Config.Events.BillingJobs",[302,538,539],{},[212,540,541],{},"{ ['doj'] = true, ['police'] = true }",[302,543,544],{},"Jobs that will trigger user activity for billing cycle events.",[284,546,547,552,556],{},[302,548,549],{},[212,550,551],{},"Config.Discord.ConnectOnJoin",[302,553,554],{},[212,555,325],{},[302,557,558],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[284,560,561,566,571],{},[302,562,563],{},[212,564,565],{},"Config.Discord.OAuth2Provider",[302,567,568],{},[212,569,570],{},"'discord'",[302,572,573],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[284,575,576,581,586],{},[302,577,578],{},[212,579,580],{},"Config.Dispatches.CivilProtectionJobs",[302,582,583],{},[212,584,585],{},"{ ['police'] = true }",[302,587,588,589,592],{},"Jobs that will receive dispatches created via the ",[212,590,591],{},"createCivilProtectionJobDispatch"," function.",[284,594,595,600,605],{},[302,596,597],{},[212,598,599],{},"Config.Dispatches.PanicButtonTitle",[302,601,602],{},[212,603,604],{},"'Panikknopf ausgelöst'",[302,606,607],{},"Title for the panic button dispatch.",[284,609,610,615,619],{},[302,611,612],{},[212,613,614],{},"Config.UserProps.SetBloodType",[302,616,617],{},[212,618,325],{},[302,620,621],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[284,623,624,629,634],{},[302,625,626],{},[212,627,628],{},"Config.UserProps.BloodTypes",[302,630,631],{},[212,632,633],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[302,635,636],{},"Blood types to assign to users if not already set.",[191,638,640],{"id":639},"functions","Functions",[187,642,643,644,646],{},"Some plugin integrations depend on the ",[212,645,640],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[187,648,649],{},"Make sure the required functions are implemented for the resources your server uses.",[187,651,652],{},"Below are examples for client-side and server-side functions.",[267,654,656],{"id":655},"client-side-1","Client-Side",[187,658,659,660,663,664,667],{},"When using ",[212,661,662],{},"pma-voice",", implement ",[212,665,666],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[669,670,675],"pre",{"className":671,"code":672,"language":673,"meta":674,"style":674},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[212,676,677,686,717,723,755,762,779,797,803],{"__ignoreMap":674},[678,679,682],"span",{"class":680,"line":681},"line",1,[678,683,685],{"class":684},"sHwdD","-- Set radio frequency\n",[678,687,689,693,696,700,704,707,711,714],{"class":680,"line":688},2,[678,690,692],{"class":691},"sTEyZ","Functions.",[678,694,666],{"class":695},"s2Zo4",[678,697,699],{"class":698},"sMK4o"," =",[678,701,703],{"class":702},"s7zQu"," function",[678,705,706],{"class":698},"(",[678,708,710],{"class":709},"sHdIc","frequency",[678,712,713],{"class":684}," --[[number]]",[678,715,716],{"class":691},")\n",[678,718,720],{"class":680,"line":719},3,[678,721,722],{"class":684},"    -- This is for pma-voice\n",[678,724,726,729,732,735,738,741,744,746,749,752],{"class":680,"line":725},4,[678,727,728],{"class":698},