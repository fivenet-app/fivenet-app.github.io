77,683,686,689,693,704,845,848,858,1091,1095,1105],[223,224,225],"p",{},"Configure the FiveNet FiveM plugin so it can connect to your FiveNet instance and integrate with your framework, dispatch, and tracking setup.",[227,228,230],"h2",{"id":229},"before-you-start","Before You Start",[223,232,233],{},"Before adjusting the plugin configuration, make sure:",[235,236,237,241,244],"ul",{},[238,239,240],"li",{},"your FiveNet instance is reachable from the gameserver",[238,242,243],{},"the Sync API token is configured in FiveNet",[238,245,246,247,251,252],{},"you know which framework the server is using, such as ",[248,249,250],"code",{},"esx"," or ",[248,253,254],{},"qbcore",[227,256,258],{"id":257},"minimum-required-settings","Minimum Required Settings",[223,260,261],{},"At a minimum, review these values before starting the plugin:",[235,263,264,273,281,288],{},[238,265,266,269,270],{},[248,267,268],{},"Config.WebURL"," in ",[248,271,272],{},"config\u002Fclient.lua",[238,274,275,269,278],{},[248,276,277],{},"Config.Framework",[248,279,280],{},"config\u002Fserver.lua",[238,282,283,269,286],{},[248,284,285],{},"Config.API.Host",[248,287,280],{},[238,289,290,269,293],{},[248,291,292],{},"Config.API.Token",[248,294,280],{},[223,296,297],{},"If these values are wrong, the in-game tablet or plugin integration will not work correctly.",[227,299,301],{"id":300},"configuration-reference","Configuration Reference",[303,304,306],"h3",{"id":305},"client-side","Client Side",[223,308,309,310,312],{},"The client-side configuration is located in ",[248,311,272],{},".",[314,315,316,332],"table",{},[317,318,319],"thead",{},[320,321,322,326,329],"tr",{},[323,324,325],"th",{},"Option",[323,327,328],{},"Default Value",[323,330,331],{},"Description",[333,334,335,350,365,380],"tbody",{},[320,336,337,342,347],{},[338,339,340],"td",{},[248,341,268],{},[338,343,344],{},[248,345,346],{},"'https:\u002F\u002Fdemo.fivenet.app'",[338,348,349],{},"Your FiveNet URL without a trailing slash.",[320,351,352,357,362],{},[338,353,354],{},[248,355,356],{},"Config.Hotkey.Enable",[338,358,359],{},[248,360,361],{},"true",[338,363,364],{},"If the tablet hotkey should be registered.",[320,366,367,372,377],{},[338,368,369],{},[248,370,371],{},"Config.Hotkey.Key",[338,373,374],{},[248,375,376],{},"'F5'",[338,378,379],{},"The key used for the tablet hotkey.",[320,381,382,387,392],{},[338,383,384],{},[248,385,386],{},"Config.PostalCommand",[338,388,389],{},[248,390,391],{},"'plz'",[338,393,394],{},"Command to mark the postal code on the player's map.",[303,396,398],{"id":397},"server-side","Server-Side",[223,400,401,402,312],{},"The server-side configuration is located in ",[248,403,280],{},[314,405,406,416],{},[317,407,408],{},[320,409,410,412,414],{},[323,411,325],{},[323,413,328],{},[323,415,331],{},[333,417,418,436,450,464,479,493,507,522,537,552,566,581,595,610,629,644,658],{},[320,419,420,424,429],{},[338,421,422],{},[248,423,277],{},[338,425,426],{},[248,427,428],{},"'esx'",[338,430,431,432,251,434,312],{},"The framework being used. Can be ",[248,433,250],{},[248,435,254],{},[320,437,438,442,447],{},[338,439,440],{},[248,441,285],{},[338,443,444],{},[248,445,446],{},"'demo.fivenet.app:443'",[338,448,449],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[320,451,452,456,461],{},[338,453,454],{},[248,455,292],{},[338,457,458],{},[248,459,460],{},"'YOUR_SYNC_API_TOKEN'",[338,462,463],{},"The API token for FiveNet.",[320,465,466,471,476],{},[338,467,468],{},[248,469,470],{},"Config.API.Insecure",[338,472,473],{},[248,474,475],{},"false",[338,477,478],{},"Whether to allow insecure connections.",[320,480,481,486,490],{},[338,482,483],{},[248,484,485],{},"Config.TrackCharIDs",[338,487,488],{},[248,489,361],{},[338,491,492],{},"Whether to record the last character ID.",[320,494,495,500,504],{},[338,496,497],{},[248,498,499],{},"Config.Tracking.Enable",[338,501,502],{},[248,503,361],{},[338,505,506],{},"Enable or disable player tracking.",[320,508,509,514,519],{},[338,510,511],{},[248,512,513],{},"Config.Tracking.Jobs",[338,515,516],{},[248,517,518],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[338,520,521],{},"Jobs that will be tracked.",[320,523,524,529,534],{},[338,525,526],{},[248,527,528],{},"Config.Tracking.Item",[338,530,531],{},[248,532,533],{},"'radio'",[338,535,536],{},"Players without this item will be marked as 'hidden'.",[320,538,539,544,549],{},[338,540,541],{},[248,542,543],{},"Config.Tracking.Interval",[338,545,546],{},[248,547,548],{},"3000",[338,550,551],{},"Interval in milliseconds for updating positions.",[320,553,554,559,563],{},[338,555,556],{},[248,557,558],{},"Config.TimeclockJobs",[338,560,561],{},[248,562,518],{},[338,564,565],{},"Jobs that will be tracked for timeclock purposes.",[320,567,568,573,578],{},[338,569,570],{},[248,571,572],{},"Config.Events.BillingJobs",[338,574,575],{},[248,576,577],{},"{ ['doj'] = true, ['police'] = true }",[338,579,580],{},"Jobs that will trigger user activity for billing cycle events.",[320,582,583,588,592],{},[338,584,585],{},[248,586,587],{},"Config.Discord.ConnectOnJoin",[338,589,590],{},[248,591,361],{},[338,593,594],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[320,596,597,602,607],{},[338,598,599],{},[248,600,601],{},"Config.Discord.OAuth2Provider",[338,603,604],{},[248,605,606],{},"'discord'",[338,608,609],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[320,611,612,617,622],{},[338,613,614],{},[248,615,616],{},"Config.Dispatches.CivilProtectionJobs",[338,618,619],{},[248,620,621],{},"{ ['police'] = true }",[338,623,624,625,628],{},"Jobs that will receive dispatches created via the ",[248,626,627],{},"createCivilProtectionJobDispatch"," function.",[320,630,631,636,641],{},[338,632,633],{},[248,634,635],{},"Config.Dispatches.PanicButtonTitle",[338,637,638],{},[248,639,640],{},"'Panikknopf ausgelöst'",[338,642,643],{},"Title for the panic button dispatch.",[320,645,646,651,655],{},[338,647,648],{},[248,649,650],{},"Config.UserProps.SetBloodType",[338,652,653],{},[248,654,361],{},[338,656,657],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[320,659,660,665,670],{},[338,661,662],{},[248,663,664],{},"Config.UserProps.BloodTypes",[338,666,667],{},[248,668,669],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[338,671,672],{},"Blood types to assign to users if not already set.",[227,674,676],{"id":675},"functions","Functions",[223,678,679,680,682],{},"Some plugin integrations depend on the ",[248,681,676],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[223,684,685],{},"Make sure the required functions are implemented for the resources your server uses.",[223,687,688],{},"Below are examples for client-side and server-side functions.",[303,690,692],{"id":691},"client-side-1","Client-Side",[223,694,695,696,699,700,703],{},"When using ",[248,697,698],{},"pma-voice",", implement ",[248,701,702],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[705,706,711],"pre",{"className":707,"code":708,"language":709,"meta":710,"style":710},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[248,712,713,722,753,759,791,798,815,833,839],{"__ignoreMap":710},[714,715,718],"span",{"class":716,"line":717},"line",1,[714,719,721],{"class":720},"sHwdD","-- Set radio frequency\n",[714,723,725,729,732,736,740,743,747,750],{"class":716,"line":724},2,[714,726,728],{"class