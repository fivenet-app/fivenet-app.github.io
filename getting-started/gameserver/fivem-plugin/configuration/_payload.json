[203,204,205,209,212],"ul",{},[206,207,208],"li",{},"your FiveNet instance is reachable from the gameserver",[206,210,211],{},"the Sync API token is configured in FiveNet",[206,213,214,215,219,220],{},"you know which framework the server is using, such as ",[216,217,218],"code",{},"esx"," or ",[216,221,222],{},"qbcore",[195,224,226],{"id":225},"minimum-required-settings","Minimum Required Settings",[191,228,229],{},"At a minimum, review these values before starting the plugin:",[203,231,232,241,249,256],{},[206,233,234,237,238],{},[216,235,236],{},"Config.WebURL"," in ",[216,239,240],{},"config\u002Fclient.lua",[206,242,243,237,246],{},[216,244,245],{},"Config.Framework",[216,247,248],{},"config\u002Fserver.lua",[206,250,251,237,254],{},[216,252,253],{},"Config.API.Host",[216,255,248],{},[206,257,258,237,261],{},[216,259,260],{},"Config.API.Token",[216,262,248],{},[191,264,265],{},"If these values are wrong, the in-game tablet or plugin integration will not work correctly.",[195,267,269],{"id":268},"configuration-reference","Configuration Reference",[271,272,274],"h3",{"id":273},"client-side","Client Side",[191,276,277,278,280],{},"The client-side configuration is located in ",[216,279,240],{},".",[282,283,284,300],"table",{},[285,286,287],"thead",{},[288,289,290,294,297],"tr",{},[291,292,293],"th",{},"Option",[291,295,296],{},"Default Value",[291,298,299],{},"Description",[301,302,303,318,333,348],"tbody",{},[288,304,305,310,315],{},[306,307,308],"td",{},[216,309,236],{},[306,311,312],{},[216,313,314],{},"'https:\u002F\u002Fdemo.fivenet.app'",[306,316,317],{},"Your FiveNet URL without a trailing slash.",[288,319,320,325,330],{},[306,321,322],{},[216,323,324],{},"Config.Hotkey.Enable",[306,326,327],{},[216,328,329],{},"true",[306,331,332],{},"If the tablet hotkey should be registered.",[288,334,335,340,345],{},[306,336,337],{},[216,338,339],{},"Config.Hotkey.Key",[306,341,342],{},[216,343,344],{},"'F5'",[306,346,347],{},"The key used for the tablet hotkey.",[288,349,350,355,360],{},[306,351,352],{},[216,353,354],{},"Config.PostalCommand",[306,356,357],{},[216,358,359],{},"'plz'",[306,361,362],{},"Command to mark the postal code on the player's map.",[271,364,366],{"id":365},"server-side","Server-Side",[191,368,369,370,280],{},"The server-side configuration is located in ",[216,371,248],{},[282,373,374,384],{},[285,375,376],{},[288,377,378,380,382],{},[291,379,293],{},[291,381,296],{},[291,383,299],{},[301,385,386,404,418,432,447,461,475,490,505,520,534,549,563,578,597,612,626],{},[288,387,388,392,397],{},[306,389,390],{},[216,391,245],{},[306,393,394],{},[216,395,396],{},"'esx'",[306,398,399,400,219,402,280],{},"The framework being used. Can be ",[216,401,218],{},[216,403,222],{},[288,405,406,410,415],{},[306,407,408],{},[216,409,253],{},[306,411,412],{},[216,413,414],{},"'demo.fivenet.app:443'",[306,416,417],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[288,419,420,424,429],{},[306,421,422],{},[216,423,260],{},[306,425,426],{},[216,427,428],{},"'YOUR_SYNC_API_TOKEN'",[306,430,431],{},"The API token for FiveNet.",[288,433,434,439,444],{},[306,435,436],{},[216,437,438],{},"Config.API.Insecure",[306,440,441],{},[216,442,443],{},"false",[306,445,446],{},"Whether to allow insecure connections.",[288,448,449,454,458],{},[306,450,451],{},[216,452,453],{},"Config.TrackCharIDs",[306,455,456],{},[216,457,329],{},[306,459,460],{},"Whether to record the last character ID.",[288,462,463,468,472],{},[306,464,465],{},[216,466,467],{},"Config.Tracking.Enable",[306,469,470],{},[216,471,329],{},[306,473,474],{},"Enable or disable player tracking.",[288,476,477,482,487],{},[306,478,479],{},[216,480,481],{},"Config.Tracking.Jobs",[306,483,484],{},[216,485,486],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[306,488,489],{},"Jobs that will be tracked.",[288,491,492,497,502],{},[306,493,494],{},[216,495,496],{},"Config.Tracking.Item",[306,498,499],{},[216,500,501],{},"'radio'",[306,503,504],{},"Players without this item will be marked as 'hidden'.",[288,506,507,512,517],{},[306,508,509],{},[216,510,511],{},"Config.Tracking.Interval",[306,513,514],{},[216,515,516],{},"3000",[306,518,519],{},"Interval in milliseconds for updating positions.",[288,521,522,527,531],{},[306,523,524],{},[216,525,526],{},"Config.TimeclockJobs",[306,528,529],{},[216,530,486],{},[306,532,533],{},"Jobs that will be tracked for timeclock purposes.",[288,535,536,541,546],{},[306,537,538],{},[216,539,540],{},"Config.Events.BillingJobs",[306,542,543],{},[216,544,545],{},"{ ['doj'] = true, ['police'] = true }",[306,547,548],{},"Jobs that will trigger user activity for billing cycle events.",[288,550,551,556,560],{},[306,552,553],{},[216,554,555],{},"Config.Discord.ConnectOnJoin",[306,557,558],{},[216,559,329],{},[306,561,562],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[288,564,565,570,575],{},[306,566,567],{},[216,568,569],{},"Config.Discord.OAuth2Provider",[306,571,572],{},[216,573,574],{},"'discord'",[306,576,577],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[288,579,580,585,590],{},[306,581,582],{},[216,583,584],{},"Config.Dispatches.CivilProtectionJobs",[306,586,587],{},[216,588,589],{},"{ ['police'] = true }",[306,591,592,593,596],{},"Jobs that will receive dispatches created via the ",[216,594,595],{},"createCivilProtectionJobDispatch"," function.",[288,598,599,604,609],{},[306,600,601],{},[216,602,603],{},"Config.Dispatches.PanicButtonTitle",[306,605,606],{},[216,607,608],{},"'Panikknopf ausgelöst'",[306,610,611],{},"Title for the panic button dispatch.",[288,613,614,619,623],{},[306,615,616],{},[216,617,618],{},"Config.UserProps.SetBloodType",[306,620,621],{},[216,622,329],{},[306,624,625],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[288,627,628,633,638],{},[306,629,630],{},[216,631,632],{},"Config.UserProps.BloodTypes",[306,634,635],{},[216,636,637],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[306,639,640],{},"Blood types to assign to users if not already set.",[195,642,644],{"id":643},"functions","Functions",[191,646,647,648,650],{},"Some plugin integrations depend on the ",[216,649,644],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[191,652,653],{},"Make sure the required functions are implemented for the resources your server uses.",[191,655,656],{},"Below are examples for client-side and server-side functions.",[271,658,660],{"id":659},"client-side-1","Client-Side",[191,662,663,664,667,668,671],{},"When using ",[216,665,666],{},"pma-voice",", implement ",[216,669,670],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[673,674,679],"pre",{"className":675,"code":676,"language":677,"meta":678,"style":678},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[216,680,681,690,721,727,759,766,783,801,807],{"__ignoreMap":678},[682,683,686],"span",{"class":684,"line":685},"line",1,[682,687,689],{"class":688},"sHwdD","-- Set radio frequency\n",[682,691,693,697,700,704,708,711,715,718],{"class":684,"line":692},2,[682,694,696],{"class":695},"sTEyZ","Functions.",[682,698,670],{"class":699},"s2Zo4",[682,701,703],{"class":702},"sMK4o"," =",[682,705,707],{"class":706},"s7zQu"," function",[682,709,710],{"class":702},"(",[682,712,714],{"class":713},"sHdIc","frequency",[682,716,717],{"class":688}," --[[number]]",[682,719,720],{"class":695},")\n",[682,722,724],{"class":684,"line":723},3,[682,7