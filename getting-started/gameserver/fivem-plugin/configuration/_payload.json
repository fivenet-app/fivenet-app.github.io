5],{},"Description",[317,318,319,334,349,364],"tbody",{},[304,320,321,326,331],{},[322,323,324],"td",{},[232,325,252],{},[322,327,328],{},[232,329,330],{},"'https:\u002F\u002Fdemo.fivenet.app'",[322,332,333],{},"Your FiveNet URL without a trailing slash.",[304,335,336,341,346],{},[322,337,338],{},[232,339,340],{},"Config.Hotkey.Enable",[322,342,343],{},[232,344,345],{},"true",[322,347,348],{},"If the tablet hotkey should be registered.",[304,350,351,356,361],{},[322,352,353],{},[232,354,355],{},"Config.Hotkey.Key",[322,357,358],{},[232,359,360],{},"'F5'",[322,362,363],{},"The key used for the tablet hotkey.",[304,365,366,371,376],{},[322,367,368],{},[232,369,370],{},"Config.PostalCommand",[322,372,373],{},[232,374,375],{},"'plz'",[322,377,378],{},"Command to mark the postal code on the player's map.",[287,380,382],{"id":381},"server-side","Server-Side",[207,384,385,386,296],{},"The server-side configuration is located in ",[232,387,264],{},[298,389,390,400],{},[301,391,392],{},[304,393,394,396,398],{},[307,395,309],{},[307,397,312],{},[307,399,315],{},[317,401,402,420,434,448,463,477,491,506,521,536,550,565,579,594,613,628,642],{},[304,403,404,408,413],{},[322,405,406],{},[232,407,261],{},[322,409,410],{},[232,411,412],{},"'esx'",[322,414,415,416,235,418,296],{},"The framework being used. Can be ",[232,417,234],{},[232,419,238],{},[304,421,422,426,431],{},[322,423,424],{},[232,425,269],{},[322,427,428],{},[232,429,430],{},"'demo.fivenet.app:443'",[322,432,433],{},"The FiveNet Hostname, must include port if not 443, requires HTTPS.",[304,435,436,440,445],{},[322,437,438],{},[232,439,276],{},[322,441,442],{},[232,443,444],{},"'YOUR_SYNC_API_TOKEN'",[322,446,447],{},"The API token for FiveNet.",[304,449,450,455,460],{},[322,451,452],{},[232,453,454],{},"Config.API.Insecure",[322,456,457],{},[232,458,459],{},"false",[322,461,462],{},"Whether to allow insecure connections.",[304,464,465,470,474],{},[322,466,467],{},[232,468,469],{},"Config.TrackCharIDs",[322,471,472],{},[232,473,345],{},[322,475,476],{},"Whether to record the last character ID.",[304,478,479,484,488],{},[322,480,481],{},[232,482,483],{},"Config.Tracking.Enable",[322,485,486],{},[232,487,345],{},[322,489,490],{},"Enable or disable player tracking.",[304,492,493,498,503],{},[322,494,495],{},[232,496,497],{},"Config.Tracking.Jobs",[322,499,500],{},[232,501,502],{},"{ ['ambulance'] = true, ['doj'] = true, ['police'] = true }",[322,504,505],{},"Jobs that will be tracked.",[304,507,508,513,518],{},[322,509,510],{},[232,511,512],{},"Config.Tracking.Item",[322,514,515],{},[232,516,517],{},"'radio'",[322,519,520],{},"Players without this item will be marked as 'hidden'.",[304,522,523,528,533],{},[322,524,525],{},[232,526,527],{},"Config.Tracking.Interval",[322,529,530],{},[232,531,532],{},"3000",[322,534,535],{},"Interval in milliseconds for updating positions.",[304,537,538,543,547],{},[322,539,540],{},[232,541,542],{},"Config.TimeclockJobs",[322,544,545],{},[232,546,502],{},[322,548,549],{},"Jobs that will be tracked for timeclock purposes.",[304,551,552,557,562],{},[322,553,554],{},[232,555,556],{},"Config.Events.BillingJobs",[322,558,559],{},[232,560,561],{},"{ ['doj'] = true, ['police'] = true }",[322,563,564],{},"Jobs that will trigger user activity for billing cycle events.",[304,566,567,572,576],{},[322,568,569],{},[232,570,571],{},"Config.Discord.ConnectOnJoin",[322,573,574],{},[232,575,345],{},[322,577,578],{},"Automatically create Discord OAuth2 connections when a player joins with a Discord ID.",[304,580,581,586,591],{},[322,582,583],{},[232,584,585],{},"Config.Discord.OAuth2Provider",[322,587,588],{},[232,589,590],{},"'discord'",[322,592,593],{},"Name of the Discord OAuth2 provider from the FiveNet server config.",[304,595,596,601,606],{},[322,597,598],{},[232,599,600],{},"Config.Dispatches.CivilProtectionJobs",[322,602,603],{},[232,604,605],{},"{ ['police'] = true }",[322,607,608,609,612],{},"Jobs that will receive dispatches created via the ",[232,610,611],{},"createCivilProtectionJobDispatch"," function.",[304,614,615,620,625],{},[322,616,617],{},[232,618,619],{},"Config.Dispatches.PanicButtonTitle",[322,621,622],{},[232,623,624],{},"'Panikknopf ausgelöst'",[322,626,627],{},"Title for the panic button dispatch.",[304,629,630,635,639],{},[322,631,632],{},[232,633,634],{},"Config.UserProps.SetBloodType",[322,636,637],{},[232,638,345],{},[322,640,641],{},"Enable setting the blood type for a user on \"join\u002Floaded\" event.",[304,643,644,649,654],{},[322,645,646],{},[232,647,648],{},"Config.UserProps.BloodTypes",[322,650,651],{},[232,652,653],{},"{ 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-' }",[322,655,656],{},"Blood types to assign to users if not already set.",[211,658,660],{"id":659},"functions","Functions",[207,662,663,664,666],{},"Some plugin integrations depend on the ",[232,665,660],{}," definitions in the config files. These functions act as integration points for voice systems, inventory systems, duty checks, and similar framework-specific behavior.",[207,668,669],{},"Make sure the required functions are implemented for the resources your server uses.",[207,671,672],{},"Below are examples for client-side and server-side functions.",[287,674,676],{"id":675},"client-side-1","Client-Side",[207,678,679,680,683,684,687],{},"When using ",[232,681,682],{},"pma-voice",", implement ",[232,685,686],{},"SetRadioFrequency"," in your client-side script. This function is responsible for setting the radio frequency for the player.",[689,690,695],"pre",{"className":691,"code":692,"language":693,"meta":694,"style":694},"language-lua shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","-- Set radio frequency\nFunctions.SetRadioFrequency = function(frequency --[[number]])\n    -- This is for pma-voice\n    local currentChannel = exports['pma-voice']:getRadioChannel()\n\n    if currentChannel ~= frequency then\n        TriggerEvent('tgiann-radio:t', frequency)\n    end\nend\n","lua","",[232,696