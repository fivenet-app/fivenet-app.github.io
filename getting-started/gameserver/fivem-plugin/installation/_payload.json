yer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":32,"body":235,"description":241,"extension":535,"links":536,"meta":537,"navigation":538,"path":81,"redirect":536,"seo":539,"stem":82,"__hash__":540},"content_en\u002F1.getting-started\u002F6.gameserver\u002F1.fivem-plugin\u002F1.installation.md",{"type":236,"value":237,"toc":531},"minimark",[238,242,247,250,299,418,490,494,497,508,527],[239,240,241],"p",{},"Install the FiveNet FiveM plugin to connect your gameserver to your FiveNet instance.",[243,244,246],"h2",{"id":245},"installation-steps","Installation Steps",[239,248,249],{},"To integrate FiveNet with your FiveM gameserver:",[251,252,253,277],"ol",{},[254,255,256,260],"li",{},[257,258,259],"strong",{},"Download the Plugin",[261,262,263,274],"ul",{},[254,264,265,266,273],{},"Download the ",[267,268,272],"a",{"href":269,"rel":270},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[271],"nofollow","FiveM plugin code"," from GitHub.",[254,275,276],{},"Use the latest version to avoid compatibility issues with newer FiveNet releases.",[254,278,279,282],{},[257,280,281],{},"Install the Plugin",[261,283,284,292],{},[254,285,286,287,291],{},"Place the plugin files in your FiveM server's ",[288,289,290],"code",{},"resources"," directory.",[254,293,294,295,298],{},"Make sure the resource folder name remains ",[288,296,297],{},"fivenet"," unless you intentionally adjust your server configuration to match a different name.",[300,301,302,315,330],"callout",{},[239,303,304,307,308,314],{},[257,305,306],{},"Note:"," At the moment, you must patch the ",[257,309,310,313],{},[288,311,312],{},"yarn"," builder system resource"," to make it work with the FiveNet plugin. This is a temporary workaround until FiveM officially switches to a newer Node.js version.",[239,316,317,318,321,322,325,326,329],{},"In ",[288,319,320],{},"yarn\u002Fyarn_builder.js",", update the arguments passed to ",[288,323,324],{},"yarn install"," to include the ",[288,327,328],{},"--ignore-engines"," flag. This allows the plugin build step to bypass engine checks that may not match your FiveM environment.",[331,332,337],"pre",{"className":333,"code":334,"language":335,"meta":336,"style":336},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[288,338,339,348,362,368,374,380,390,400,406,412],{"__ignoreMap":336},[340,341,344],"span",{"class":342,"line":343},"line",1,[340,345,347],{"class":346},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[340,349,351,355,359],{"class":342,"line":350},2,[340,352,354],{"class":353},"sMK4o","@@",[340,356,358],{"class":357},"sTEyZ"," -43,7 +43,7 ",[340,360,361],{"class":353},"@@\n",[340,363,365],{"class":342,"line":364},3,[340,366,367],{"class":357},"            currentBuildingModule = resourceName;\n",[340,369,371],{"class":342,"line":370},4,[340,372,373],{"class":357},"            const proc = child_process.fork(\n",[340,375,377],{"class":342,"line":376},5,[34