 the ",[218,219,223],"a",{"href":220,"rel":221},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[222],"nofollow","FiveM plugin code"," from GitHub.",[205,226,227],{},"Use the latest version to avoid compatibility issues with newer FiveNet releases.",[205,229,230,233],{},[208,231,232],{},"Install the Plugin",[212,234,235,243],{},[205,236,237,238,242],{},"Place the plugin files in your FiveM server's ",[239,240,241],"code",{},"resources"," directory.",[205,244,245,246,249],{},"Make sure the resource folder name remains ",[239,247,248],{},"fivenet"," unless you intentionally adjust your server configuration to match a different name.",[251,252,253,266,281],"callout",{},[190,254,255,258,259,265],{},[208,256,257],{},"Note:"," At the moment, you must patch the ",[208,260,261,264],{},[239,262,263],{},"yarn"," builder system resource"," to make it work with the FiveNet plugin. This is a temporary workaround until FiveM officially switches to a newer Node.js version.",[190,267,268,269,272,273,276,277,280],{},"In ",[239,270,271],{},"yarn\u002Fyarn_builder.js",", update the arguments passed to ",[239,274,275],{},"yarn install"," to include the ",[239,278,279],{},"--ignore-engines"," flag. This allows the plugin build step to bypass engine checks that may not match your FiveM environment.",[282,283,288],"pre",{"className":284,"code":285,"language":286,"meta":287,"style":287},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[239,289,290,299,313,319,325,331,341,351,357,363],{"__ignoreMap":287},[291,292,295],"span",{"class":293,"line":294},"line",1,[291,296,298],{"class":297},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[291,300,302,306,310],{"class":293,"line":301},2,[291,303,305],{"class":304},"sMK4o","@@",[291,307,309],{"class":308},"sTEyZ"," -43,7 +43,7 ",[291,311,312],{"class":304},"@@\n",[291,314,316],{"class":293,"line":315},3,[291,317,318],{"class":308},"            currentBuildingModule = resourceName;\n",[291,320,322],{"class":293,"line":321},4,[291,323,324],{"class":308},"            const proc = child_process.fork(\n",[291,326,328],{"class":293,"line":327},5,[291,329,330],{"class":308},"                require.resolve('.\u002Fyarn_cli.js'),\n",[291,332,334,337],{"class":293,"line":333},6,[291,335,336],{"class":304},"-",[291,338,340],{"class":339},"swJcz","               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[291,342,344,347],{"class":293,"line":343},7,[291,345,346],{"class":304},"+",[291,348,350],{"class":349},"sfazB","               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[291,352,354],{"class":293,"line":353},8,[291,355,356],{"class":308},"                {\n",[291,358,360],{"class":293,"line":359},9,[291,361,362],{"class":308},"                    cwd: path.resolve(GetResourcePath(resourceName)),\n",[291,364,366],{"class":293,"line":365},10,[291,367,368],{"class":308},"                    stdio: 'pipe',\n",[202,370,371,400,413],{"start":315},[205,372,373,376],{},[208,374,375],{},"Configure the Plugin",[212,377,378,389,392],{},[205,379,380,381,384,385,388],{},"Open ",[239,382,383],{},"config\u002Fclient.lua"," and ",[239,386,387],{},"config\u002Fserver.lua",".",[205,390,391],{},"Adjust the values so they match your FiveNet instance, framework, and server requirements.",[205,393,394,395,399],{},"Follow the ",[218,396,398],{"href":397},"configuration","plugin configuration page"," for the most important options.",[205,401,402,405],{},[208,403,404],{},"Add Event Triggers",[212,406,407,410],{},[205,408,409],{},"Review your existing framework and job-related plugins and add the necessary event triggers so FiveNet can collect the required activity data.",[205,411,412],{},"Not all required events are present in default ESX-based resources, so some customization may be needed.",[205,414,415,418],{},[208,416,417],{},"Start the Plugin",[212,419,420,438],{},[205,421,422,423,426,427],{},"Add the plugin to your ",[239,424,425],{},"server.cfg",":\n",[282,428,432],{"className":429,"code":430,"language":431,"meta":287,"style":287},"language-cfg shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ensure fivenet\n","cfg",[239,433,434],{"__ignoreMap":287},[291,435,436],{"class":293,"line":294},[291,437,430],{},[205,439,440],{},"Restart your server so the resource is loaded.",[194,442,444],{"id":443},"after-installation","After Installation",[190,446,447],{},"Once the plugin is installed:",[212,449,450,453,456],{},[205,451,452],{},"Confirm that the plugin can reach your FiveNet instance.",[205,454,455],{},"Verify that the API host and token are configured correctly.",[205,457,458],{},"Test the tablet in game and confirm that expected sync and event-based features are working.",[251,460,461,466],{},[190,462,463],{},[208,464,465],{},"Important:",[212,467,468,475],{},[205,469,470,471,474],{},"Always read the ",[239,472,473],{},"README.md"," file provided with the plugin for detailed setup instructions and troubleshooting tips.",[205,476,477],{},"Ensure your server is running a compatible version of FiveM and your selected framework to avoid conflicts.",[479,480,481],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki