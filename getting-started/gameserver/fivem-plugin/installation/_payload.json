FiveNet FiveM plugin to connect your gameserver to your FiveNet instance.",[227,228,230],"h2",{"id":229},"installation-steps","Installation Steps",[223,232,233],{},"To integrate FiveNet with your FiveM gameserver:",[235,236,237,261],"ol",{},[238,239,240,244],"li",{},[241,242,243],"strong",{},"Download the Plugin",[245,246,247,258],"ul",{},[238,248,249,250,257],{},"Download the ",[251,252,256],"a",{"href":253,"rel":254},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[255],"nofollow","FiveM plugin code"," from GitHub.",[238,259,260],{},"Use the latest version to avoid compatibility issues with newer FiveNet releases.",[238,262,263,266],{},[241,264,265],{},"Install the Plugin",[245,267,268,276],{},[238,269,270,271,275],{},"Place the plugin files in your FiveM server's ",[272,273,274],"code",{},"resources"," directory.",[238,277,278,279,282],{},"Make sure the resource folder name remains ",[272,280,281],{},"fivenet"," unless you intentionally adjust your server configuration to match a different name.",[284,285,286,299,314],"callout",{},[223,287,288,291,292,298],{},[241,289,290],{},"Note:"," At the moment, you must patch the ",[241,293,294,297],{},[272,295,296],{},"yarn"," builder system resource"," to make it work with the FiveNet plugin. This is a temporary workaround until FiveM officially switches to a newer Node.js version.",[223,300,301,302,305,306,309,310,313],{},"In ",[272,303,304],{},"yarn\u002Fyarn_builder.js",", update the arguments passed to ",[272,307,308],{},"yarn install"," to include the ",[272,311,312],{},"--ignore-engines"," flag. This allows the plugin build step to bypass engine checks that may not match your FiveM environment.",[315,316,321],"pre",{"className":317,"code":318,"language":319,"meta":320,"style":320},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[272,322,323,332,346,352,358,364,374,384,390,396],{"__ignoreMap":320},[324,325,328],"span",{"class":326,"line":327},"line",1,[324,329,331],{"class":330},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[324,333,335,339,343],{"class":326,"line":334},2,[324,336,338],{"class":337},"sMK4o","@@",[324,340,342],{"class":341},"sTEyZ"," -43,7 +43,7 ",[324,344,345],{"class":337},"@@\n",[324,347,349],{"class":326,"line":348},3,[324,350,351],{"class":341},"            currentBuildingModule = resourceName;\n",[324,353,355],{"class":326,"line":354},4,[324,356,357],{"class":341},"            const proc = child_process.fork(\n",[324,359,361],{"class":326,"line":360},5,[324,362,363],{"class":341},"                require.resolve('.\u002Fyarn_cli.js'),\n",[324,365,367,370],{"class":326,"line":366},6,[324,368,369],{"class":337},"-",[324,371,373],{"class":372},"swJcz","               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[324,375,377,380],{"class":326,"line":376},7,[324,378,379],{"class":337},"+",[324,381,383],{"class":382},"sfazB","               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[324,385,387],{"class":326,"line":386},8,[324,388,389],{"class":341},"                {\n",[324,391,393],{"class":326,"line":392},9,[324,394,395],{"class":341},"                    cwd: path.resolve(GetResourcePath(resourceName)),\n",[324,397,399],{"class":326,"line":398},10,[324,400,401],{"class":341},"                    stdio: 'pipe',\n",[235,403,404,433,446],{"start":348},[238,405,406,409],{},[241,407,408],{},"Configure the Plugin",[245,410,411,422,425],{},[238,412,413,414,417,418,421],{},"Open ",[272,415,416],{},"config\u002Fclient.lua"," and ",[272,419,420],{},"config\u002Fserver.lua",".",[238,423,424],{},"Adjust the values so they match your FiveNet instance, framework, and server requirements.",[238,426,427,428,432],{},"Follow the ",[251,429,431],{"href":430},"configuration","plugin configuration page"," for the most important options.",[238,434,435,438],{},[241,436,437],{},"Add Event Triggers",[245,439,440,443],{},[238,441,442],{},"Review your existing framework and job-related plugins and add the necessary event triggers so FiveNet can collect the required activity data.",[238,444,445],{},"Not all required events are present in default ESX-based resources, so some customization may be needed.",[238,447,448,451],{},[241,449,450],{},"Start the Plugin",[245,452,453,471],{},[238,454,455,456,459,460],{},"Add the plugin to your ",[272,457,458],{},"server.cfg",":\n",[315,461,465],{"className":462,"code":463,"language":464,"meta":320,"style":320},"language-cfg shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ensure fivenet\n","cfg",[272,466,467],{"__ignoreMap":320},[324,468,469],{"class":326,"line":327},[324,470,463],{},[238,472,473],{},"Restart your server so the resource is loaded.",[227,475,477],{"id":476},"after-installation","After Installation",[223,479,480],{},"Once the plugin is installed:",[245,482,483,486,489],{},[238,484,485],{},"Confirm that the plugin can reach your FiveNet instance.",[238,487,488],{},"Verify that the API host and token are configured correctly.",[238,490,491],{},"Test the tablet in game and confirm that expected sync and event-based features are working.",[284,493,494,499],{},[223,495,496],{},[241,497,498],{},"Important:",[245,500,501,508],{},[238,502,503,504,507],{},"Always read the ",[272,505,506],{},"README.md"," file provided with the plugin for detailed setup instructions and troubleshooting tips.",[238,509,510],{},"Ensure your server is running a compatible version of FiveM and your selected framework to avoid conflicts.",[512,513,514],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--s