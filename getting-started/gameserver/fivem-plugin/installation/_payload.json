2,475,476],{},"Add the plugin to your ",[288,473,474],{},"server.cfg",":\n",[331,477,481],{"className":478,"code":479,"language":480,"meta":336,"style":336},"language-cfg shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ensure fivenet\n","cfg",[288,482,483],{"__ignoreMap":336},[340,484,485],{"class":342,"line":343},[340,486,479],{},[254,488,489],{},"Restart your server so the resource is loaded.",[243,491,493],{"id":492},"after-installation","After Installation",[239,495,496],{},"Once the plugin is installed:",[261,498,499,502,505],{},[254,500,501],{},"Confirm that the plugin can reach your FiveNet instance.",[254,503,504],{},"Verify that the API host and token are configured correctly.",[254,506,507],{},"Test the tablet in game and confirm that expected sync and event-based features are working.",[300,509,510,515],{},[239,511,512],{},[257,513,514],{},"Important:",[261,516,517,524],{},[254,518,519,520,523],{},"Always read the ",[288,521,522],{},"README.md"," file provided with the plugin for detailed setup instructions and troubleshooting tips.",[254,525,526],{},"Ensure your server is running a compatible version of FiveM and your selected framework to avoid conflicts.",[528,529,530],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shi