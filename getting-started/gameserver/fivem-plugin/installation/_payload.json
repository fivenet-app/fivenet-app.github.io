nofollow","FiveM plugin code"," from GitHub.",[201,222,223],{},"Use the latest version to avoid compatibility issues with newer FiveNet releases.",[201,225,226,229],{},[204,227,228],{},"Install the Plugin",[208,230,231,239],{},[201,232,233,234,238],{},"Place the plugin files in your FiveM server's ",[235,236,237],"code",{},"resources"," directory.",[201,240,241,242,245],{},"Make sure the resource folder name remains ",[235,243,244],{},"fivenet"," unless you intentionally adjust your server configuration to match a different name.",[247,248,249,262,277],"callout",{},[186,250,251,254,255,261],{},[204,252,253],{},"Note:"," At the moment, you must patch the ",[204,256,257,260],{},[235,258,259],{},"yarn"," builder system resource"," to make it work with the FiveNet plugin. This is a temporary workaround until FiveM officially switches to a newer Node.js version.",[186,263,264,265,268,269,272,273,276],{},"In ",[235,266,267],{},"yarn\u002Fyarn_builder.js",", update the arguments passed to ",[235,270,271],{},"yarn install"," to include the ",[235,274,275],{},"--ignore-engines"," flag. This allows the plugin build step to bypass engine checks that may not match your FiveM environment.",[278,279,284],"pre",{"className":280,"code":281,"language":282,"meta":283,"style":283},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[235,285,286,295,309,315,321,327,337,347,353,359],{"__ignoreMap":283},[287,288,291],"span",{"class":289,"line":290},"line",1,[287,292,294],{"class":293},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[287,296,298,302,306],{"class":289,"line":297},2,[287,299,301],{"class":300},"sMK4o","@@",[287,303,305],{"class":304},"sTEyZ"," -43,7 +43,7 ",[287,307,308],{"class":300},"@@\n",[287,310,312],{"class":289,"line":311},3,[287,313,314],{"class":304},"            currentBuildingModule = resourceName;\n",[287,316,318],{"class":289,"line":317},4,[287,319,320],{"class":304},"            const proc = child_process.fork(\n",[287,322,324],{"class":289,"line":323},5,[287,325,326],{"class":304},"                require.resolve('.\u002Fyarn_cli.js'),\n",[287,328,330,333],{"class":289,"line":329},6,[287,331,332],{"class":300},"-",[287,334,336],{"class":335},"swJcz","               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[287,338,340,343],{"class":289,"line":339},7,[287,341,342],{"class":300},"+",[287,344,346],{"class":345},"sfazB","               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[287,348,350],{"class":289,"line":349},8,[287,351,352],{"class":304},"                {\n",[287,354,356],{"class":289,"line":355},9,[287,357,358],{"class":304},"                    cwd: path.resolve(GetResourcePath(resourceName)),\n",[287,360,362],{"class":289,"line":361},10,[287,363,364],{"class":304},"                    stdio: 'pipe',\n",[198,366,367,396,409],{"start":311},[201,368,369,372],{},[204,370,371],{},"Configure the Plugin",[208,373,374,385,388],{},[201,375,376,377,380,381,384],{},"Open ",[235,378,379],{},"config\u002Fclient.lua"," and ",[235,382,383],{},"config\u002Fserver.lua",".",[201,386,387],{},"Adjust the values so they match your FiveNet instance, framework, and server requirements.",[201,389,390,391,395],{},"Follow the ",[214,392,394],{"href":393},"configuration","plugin configuration page"," for the most important options.",[201,397,398,401],{},[204,399,400],{},"Add Event Triggers",[208,402,403,406],{},[201,404,405],{},"Review your existing framework and job-related plugins and add the necessary event triggers so FiveNet can collect the required activity data.",[201,407,408],{},"Not all required events are present in default ESX-based resources, so some customization may be needed.",[201,410,411,414],{},[204,412,413],{},"Start the Plugin",[208,415,416,434],{},[201,417,418,419,422,423],{},"Add the plugin to your ",[235,420,421],{},"server.cfg",":\n",[278,424,428],{"className":425,"code":426,"language":427,"meta":283,"style":283},"language-cfg shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ensure fivenet\n","cfg",[235,429,430],{"__ignoreMap":283},[287,431,432],{"class":289,"line":290},[287,433,426],{},[201,435,436],{},"Restart your server so the resource is loaded.",[190,438,440],{"id":439},"after-installation","After Installation",[186,442,443],{},"Once the plugin is installed:",[208,445,446,449,452],{},[201,447,448],{},"Confirm that the plugin can reach your FiveNet instance.",[201,450,451],{},"Verify that the API host and token are configured correctly.",[201,453,454],{},"Test the tablet in game and confirm that expected sync and event-based features are working.",[247,456,457,462],{},[186,458,459],{},[204,460,461],{},"Important:",[208,463,464,471],{},[201,465,466,467,470],{},"Always read the ",[235,468,469],{},"README.md"," file provided with the plugin for detailed setup instructions and troubleshooting tips.",[201,