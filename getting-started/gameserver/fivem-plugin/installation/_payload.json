s",[219,228,229],{},"To integrate FiveNet with your FiveM gameserver:",[231,232,233,257],"ol",{},[234,235,236,240],"li",{},[237,238,239],"strong",{},"Download the Plugin",[241,242,243,254],"ul",{},[234,244,245,246,253],{},"Download the ",[247,248,252],"a",{"href":249,"rel":250},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[251],"nofollow","FiveM plugin code"," from GitHub.",[234,255,256],{},"Use the latest version to avoid compatibility issues with newer FiveNet releases.",[234,258,259,262],{},[237,260,261],{},"Install the Plugin",[241,263,264,272],{},[234,265,266,267,271],{},"Place the plugin files in your FiveM server's ",[268,269,270],"code",{},"resources"," directory.",[234,273,274,275,278],{},"Make sure the resource folder name remains ",[268,276,277],{},"fivenet"," unless you intentionally adjust your server configuration to match a different name.",[280,281,282,295,310],"callout",{},[219,283,284,287,288,294],{},[237,285,286],{},"Note:"," At the moment, you must patch the ",[237,289,290,293],{},[268,291,292],{},"yarn"," builder system resource"," to make it work with the FiveNet plugin. This is a temporary workaround until FiveM officially switches to a newer Node.js version.",[219,296,297,298,301,302,305,306,309],{},"In ",[268,299,300],{},"yarn\u002Fyarn_builder.js",", update the arguments passed to ",[268,303,304],{},"yarn install"," to include the ",[268,307,308],{},"--ignore-engines"," flag. This allows the plugin build step to bypass engine checks that may not match your FiveM environment.",[311,312,317],"pre",{"className":313,"code":314,"language":315,"meta":316,"style":316},"language-diff shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n@@ -43,7 +43,7 @@\n            currentBuildingModule = resourceName;\n            const proc = child_process.fork(\n                require.resolve('.\u002Fyarn_cli.js'),\n-               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n+               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n                {\n                    cwd: path.resolve(GetResourcePath(resourceName)),\n                    stdio: 'pipe',\n","diff","",[268,318,319,328,342,348,354,360,370,380,386,392],{"__ignoreMap":316},[320,321,324],"span",{"class":322,"line":323},"line",1,[320,325,327],{"class":326},"sHwdD","#diff a\u002F[builders]\u002Fyarn\u002Fyarn_builder.js b\u002F[builders]\u002Fyarn\u002Fyarn_builder.js\n",[320,329,331,335,339],{"class":322,"line":330},2,[320,332,334],{"class":333},"sMK4o","@@",[320,336,338],{"class":337},"sTEyZ"," -43,7 +43,7 ",[320,340,341],{"class":333},"@@\n",[320,343,345],{"class":322,"line":344},3,[320,346,347],{"class":337},"            currentBuildingModule = resourceName;\n",[320,349,351],{"class":322,"line":350},4,[320,352,353],{"class":337},"            const proc = child_process.fork(\n",[320,355,357],{"class":322,"line":356},5,[320,358,359],{"class":337},"                require.resolve('.\u002Fyarn_cli.js'),\n",[320,361,363,366],{"class":322,"line":362},6,[320,364,365],{"class":333},"-",[320,367,369],{"class":368},"swJcz","               ['install', '--ignore-scripts', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[320,371,373,376],{"class":322,"line":372},7,[320,374,375],{"class":333},"+",[320,377,379],{"class":378},"sfazB","               ['install', '--ignore-scripts', '--ignore-engines', '--cache-folder', path.join(initCwd, 'cache', 'yarn-cache'), '--mutex', 'file:' + path.join(initCwd, 'cache', 'yarn-mutex')],\n",[320,381,383],{"class":322,"line":382},8,[320,384,385],{"class":337},"                {\n",[320,387,389],{"class":322,"line":388},9,[320,390,391],{"class":337},"                    cwd: path.resolve(GetResourcePath(resourceName)),\n",[320,393,395],{"class":322,"line":394},10,[320,396,397],{"class":337},"                    stdio: 'pipe',\n",[231,399,400,429,442],{"start":344},[234,401,402,405],{},[237,403,404],{},"Configure the Plugin",[241,406,407,418,421],{},[234,408,409,410,413,414,417],{},"Open ",[268,411,412],{},"config\u002Fclient.lua"," and ",[268,415,416],{},"config\u002Fserver.lua",".",[234,419,420],{},"Adjust the values so they match your FiveNet instance, framework, and server requirements.",[234,422,423,424,428],{},"Follow the ",[247,425,427],{"href":426},"configuration","plugin configuration page"," for the most important options.",[234,430,431,434],{},[237,432,433],{},"Add Event Triggers",[241,435,436,439],{},[234,437,438],{},"Review your existing framework and job-related plugins and add the necessary event triggers so FiveNet can collect the required activity data.",[234,440,441],{},"Not all required events are present in default ESX-based resources, so some customization may be needed.",[234,443,444,447],{},[237,445,446],{},"Start the Plugin",[241,448,449,467],{},[234,450,451,452,455,456],{},"Add the plugin to your ",[268,453,454],{},"server.cfg",":\n",[311,457,461],{"className":458,"code":459,"language":460,"meta":316,"style":316},"language-cfg shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ensure fivenet\n","cfg",[268,462,463],{"__ignoreMap":316},[320,464,465],{"class":322,"line":323},[320,466,459],{},[234,468,469],{},"Restart your server so the resource is loaded.",[223,471,473],{"id":472},"after-installation","After Installation",[219,475,476],{},"Once the plugin is installed:",[241,478,479,482,485],{},[234,480,481],{},"Confirm that the plugin can reach your FiveNet instance.",[234,483,484],{},"Verify that the API host and token are configured correctly.",[234,486,487],{},"Test the tablet in game and confirm that expected sync and event-based features are working.",[280,489,490,495],{},[219,491,492],{},[237,493,494],{},"Important:",[241,496,497,504],{},[234,498,499,500,503],{},"Always read the ",[268,501,502],{},"README.md"," file provided with the plugin for detailed setup instructions and troubleshooting tips.",[234,505,506],{},"Ensure your server is running a compatible version of FiveM and your selected framework to avoid conflicts.",[508,509,510],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-def