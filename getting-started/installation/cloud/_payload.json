2F3.user-guides\u002F3.documents\u002Ftemplates",{"title":146,"path":147,"stem":148},"Jobs","\u002Fde\u002Fuser-guides\u002Fjobs","de\u002F3.user-guides\u002F3.jobs",{"title":150,"path":151,"stem":152},"Kalender","\u002Fde\u002Fuser-guides\u002Fcalendar","de\u002F3.user-guides\u002F4.calendar",{"title":154,"path":155,"stem":156},"Livemap","\u002Fde\u002Fuser-guides\u002Flivemap","de\u002F3.user-guides\u002F5.livemap",{"title":158,"path":159,"stem":160},"Einsatzzentrale","\u002Fde\u002Fuser-guides\u002Fcentrum","de\u002F3.user-guides\u002F6.centrum",{"title":162,"path":163,"stem":164},"Mailer","\u002Fde\u002Fuser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":166,"path":167,"stem":168},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":170,"path":171,"stem":172},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":174,"path":175,"stem":176},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":178,"path":179,"stem":180},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":182,"path":183,"stem":184,"children":185},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[186,187,191],{"title":182,"path":183,"stem":184},{"title":188,"path":189,"stem":190},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":170,"path":192,"stem":193},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":195,"path":196,"stem":197,"children":198},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[199],{"title":195,"path":196,"stem":197},{"id":201,"title":40,"body":202,"description":208,"extension":345,"links":346,"meta":347,"navigation":348,"path":349,"redirect":346,"seo":350,"stem":351,"__hash__":352},"content_en\u002F1.getting-started\u002F4.installation\u002F2.cloud.md",{"type":203,"value":204,"toc":335},"minimark",[205,209,212,217,246,250,261,264,268,283,287,328,332],[206,207,208],"p",{},"FiveNet Cloud is available today as a managed hosting option for communities that want us to run and maintain FiveNet for them.",[206,210,211],{},"The service is hosted by ZerBytes UG (haftungsbeschrankt).",[213,214,216],"h3",{"id":215},"why-choose-fivenet-cloud","Why Choose FiveNet Cloud",[218,219,220,228,234,240],"ul",{},[221,222,223,227],"li",{},[224,225,226],"strong",{},"Managed Hosting",": We run and maintain your FiveNet instance for you.",[221,229,230,233],{},[224,231,232],{},"Less Operational Overhead",": You do not need to build and maintain your own Docker or Kubernetes setup for FiveNet.",[221,235,236,239],{},[224,237,238],{},"Ongoing Updates",": We keep your FiveNet instance up to date as new releases become available.",[221,241,242,245],{},[224,243,244],{},"Direct Support",": Cloud customers can reach out through Discord support tickets for onboarding and operational questions.",[213,247,249],{"id":248},"what-you-still-need-to-provide","What You Still Need To Provide",[218,251,252,255,258],{},[221,253,254],{},"Access to the gameserver database that FiveNet should use.",[221,256,257],{},"The required plugin integration on your gameserver.",[221,259,260],{},"Any server-specific configuration needed for your community and framework.",[206,262,263],{},"FiveNet Cloud reduces the infrastructure work on your side, but you still need to connect it to your gameserver environment.",[213,265,267],{"id":266},"getting-started","Getting Started",[269,270,271,274,277,280],"ol",{},[221,272,273],{},"Join the FiveNet Discord.",[221,275,276],{},"Create a support ticket for FiveNet Cloud.",[221,278,279],{},"Share the details needed for your setup, such as your community, gameserver environment, and database connectivity.",[221,281,282],{},"We will guide you through onboarding and the remaining setup steps.",[213,284,286],{"id":285},"faqs","FAQs",[288,289,292,300,307,314,321],"card-group",{"className":290},[291],"sm:grid-cols-1",[293,294,297],"card",{"icon":295,"title":296},"i-mdi-database","What happens to my data?",[206,298,299],{},"Your gameserver database must be accessible to FiveNet. If you later switch to a self-hosted instance, you can request the attachment data, such as avatars.",[293,301,304],{"icon":302,"title":303},"i-mdi-currency-usd-off","Is there a free tier?",[206,305,306],{},"Currently, there is no free tier available for FiveNet.",[293,308,311],{"icon":309,"title":310},"i-mdi-cloud-upload","How do I migrate from self-hosted to cloud?",[206,312,313],{},"No full migration is required. Since your FiveNet data, such as citizens and documents, remains tied to your database, the main extra step is handling attachment data if needed.",[293,315,318],{"icon":316,"title":317},"i-mdi-cloud-download","How do I migrate from cloud to self-hosted?",[206,319,320],{},"Since FiveNet data, such as citizens and documents, is stored in your database, you mainly need a copy of the attachment data for your self-hosted instance. The FiveNet Cloud team can assist with this process.",[293,322,325],{"icon":323,"title":324},"i-mdi-tools","Do I still need technical setup on my side?",[206,326,327],{},"Yes. FiveNet Cloud removes most of the infrastructure work, but you still need to provide database access and complete the required plugin integration for your gameserver.",[213,329,331],{"id":330},"next-step","Next Step",[206,333,334],{},"Join the FiveNet Discord and create a cloud support ticket to get started with FiveNet Cloud. Our team can help with onboarding, setup questions, and migration planning.",{"title":336,"searchDepth":337,"depth":337,"links":338},"",2,[339,341,342,343,344],{"id":215,"depth":340,"text":216},3,{"id":248,"depth":340,"text":249},{"id":266,"depth":340,"text":267},{"id":285,"depth":340,"text":286},{"id":330,"depth":340,"text":331},"md",null,{},true,"\u002Fgetting-started\u002Finstallation\u002Fcloud",{"title":40,"description":208},"1.getting-started\u002F4.installation\u002F2.cloud","M84Q8MCY-jjvqNEWXcEl1kSYvi5-yQioBd4sxSzDUHY",[354,359],{"title":355,"path":356,"stem":357,"description":358,"children":-1},"Installation Methods","\u002Fgetting-started\u002Finstallation\u002Fmethods","1.getting-started\u002F4.installation\u002F1.methods","Choose the installation path that fits your environment, whether you want managed hosting with FiveNet Cloud or a self-hosted deployment with Docker or Kubernetes.",{"title":360,"path":361,"stem":362,"description":363,"children":-1},"Using Docker","\u002Fgetting-started\u002Finstallation\u002Fcontainer-docker","1.getting-started\u002F4.installation\u002F3.container-docker","Deploy FiveNet with Docker Engine and the Docker Compose plugin on a single server.",1789078706319]