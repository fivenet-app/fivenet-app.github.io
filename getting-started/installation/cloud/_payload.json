:170},"Development","\u002Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":41,"body":219,"description":225,"extension":361,"links":362,"meta":363,"navigation":364,"path":42,"redirect":362,"seo":365,"stem":43,"__hash__":366},"content_en\u002F1.getting-started\u002F4.installation\u002F2.cloud.md",{"type":220,"value":221,"toc":351},"minimark",[222,226,229,234,263,267,278,281,284,299,303,344,348],[223,224,225],"p",{},"FiveNet Cloud is available today as a managed hosting option for communities that want us to run and maintain FiveNet for them.",[223,227,228],{},"The service is hosted by ZerBytes UG (haftungsbeschrankt).",[230,231,233],"h3",{"id":232},"why-choose-fivenet-cloud","Why Choose FiveNet Cloud",[235,236,237,245,251,257],"ul",{},[238,239,240,244],"li",{},[241,242,243],"strong",{},"Managed Hosting",": We run and maintain your FiveNet instance for you.",[238,246,247,250],{},[241,248,249],{},"Less Operational Overhead",": You do not need to build and maintain your own Docker or Kubernetes setup for FiveNet.",[238,252,253,256],{},[241,254,255],{},"Ongoing Updates",": We keep your FiveNet instance up to date as new releases become available.",[238,258,259,262],{},[241,260,261],{},"Direct Support",": Cloud customers can reach out through Discord support tickets for onboarding and operational questions.",[230,264,266],{"id":265},"what-you-still-need-to-provide","What You Still Need To Provide",[235,268,269,272,275],{},[238,270,271],{},"Access to the gameserver database that FiveNet should use.",[238,273,274],{},"The required plugin integration on your gameserver.",[238,276,277],{},"Any server-specific configuration needed for your community and framework.",[223,279,280],{},"FiveNet Cloud reduces the infrastructure work on your side, but you still need to connect it to your gameserver environment.",[230,282,5],{"id":283},"getting-started",[285,286,287,290,293,296],"ol",{},[238,288,289],{},"Join the FiveNet Discord.",[238,291,292],{},"Create a support ticket for FiveNet Cloud.",[238,294,295],{},"Share the details needed for your setup, such as your community, gameserver environment, and database connectivity.",[238,297,298],{},"We will guide you through onboarding and the remaining setup steps.",[230,300,302],{"id":301},"faqs","FAQs",[304,305,308,316,323,330,337],"card-group",{"className":306},[307],"sm:grid-cols-1",[309,310,313],"card",{"icon":311,"title":312},"i-mdi-database","What happens to my data?",[223,314,315],{},"Your gameserver database must be accessible to FiveNet. If you later switch to a self-hosted instance, you can request the attachment data, such as avatars.",[309,317,320],{"icon":318,"title":319},"i-mdi-currency-usd-off","Is there a free tier?",[223,321,322],{},"Currently, there is no free tier available for FiveNet.",[309,324,327],{"icon":325,"title":326},"i-mdi-cloud-upload","How do I migrate from self-hosted to cloud?",[223,328,329],{},"No full migration is required. Since your FiveNet data, such as citizens and documents, remains tied to your database, the main extra step is handling attachment data if needed.",[309,331,334],{"icon":332,"title":333},"i-mdi-cloud-download","How do I migrate from cloud to self-hosted?",[223,335,336],{},"Since FiveNet data, such as citizens and documents, is stored in your database, you mainly need a copy of the attachment data for your self-hosted instance. The FiveNet Cloud team can assist with this process.",[309,338,341],{"icon":339,"title":340},"i-mdi-tools","Do I still need technical setup on my side?",[223,342,343],{},"Yes. FiveNet Cloud removes most of the infrastructure work, but you still need to provide database access and complete the required plugin integration for your gameserver.",[230,345,347],{"id":346},"next-step","Next Step",[223,349,350],{},"Join the FiveNet Discord and create a cloud support ticket to get started with FiveNet Cloud. Our team can help with onboarding, setup questions, and migration planning.",{"title":352,"searchDepth":353,"depth":353,"links":354},"",2,[355,357,358,359,360],{"id":232,"depth":356,"text":233},3,{"id":265,"depth":356,"text":266},{"id":283,"depth":356,"text":5},{"id":301,"depth":356,"text":302},{"id":346,"depth":356,"text":347},"md",null,{},true,{"title":41,"description":225},"M84Q8MCY-jjvqNEWXcEl1kSYvi5-yQioBd4sxSzDUHY",[368,370],{"title":37,"path":38,"stem":39,"description":369,"children":-1},"Choose the installation path that fits your environment, whether you want managed hosting with FiveNet Cloud or a self-hosted deployment with Docker or Kubernetes.",{"title":45,"path":46,"stem":47,"description":371,"children":-1},"Deploy FiveNet with Docker Engine and the Docker Compose plugin on a single server.",1789005930154]