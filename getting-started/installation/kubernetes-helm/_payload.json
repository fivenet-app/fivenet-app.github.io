. Add Helm Chart Repo",[244,282,283],{},"Add the FiveNet Helm chart repository to your Helm client:",[285,286,291],"pre",{"className":287,"code":288,"language":289,"meta":290,"style":290},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[292,293,294,316],"code",{"__ignoreMap":290},[295,296,299,303,307,310,313],"span",{"class":297,"line":298},"line",1,[295,300,302],{"class":301},"sBMFI","helm",[295,304,306],{"class":305},"sfazB"," repo",[295,308,309],{"class":305}," add",[295,311,312],{"class":305}," fivenet",[295,314,315],{"class":305}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[295,317,319,321,323],{"class":297,"line":318},2,[295,320,302],{"class":301},[295,322,306],{"class":305},[295,324,325],{"class":305}," update\n",[264,327,329],{"id":328},"_2-create-a-namespace","2. Create a Namespace",[244,331,332],{},"Create a dedicated namespace for FiveNet if you do not already have one:",[285,334,336],{"className":287,"code":335,"language":289,"meta":290,"style":290},"kubectl create namespace fivenet\n",[292,337,338],{"__ignoreMap":290},[295,339,340,343,346,349],{"class":297,"line":298},[295,341,342],{"class":301},"kubectl",[295,344,345],{"class":305}," create",[295,347,348],{"class":305}," namespace",[295,350,351],{"class":305}," fivenet\n",[264,353,355,356],{"id":354},"_3-get-the-latest-valuesyaml","3. Get the Latest ",[292,357,358],{},"values.yaml",[244,360,361,362,364],{},"Retrieve the default ",[292,363,358],{}," file for the Helm chart to start configuring your deployment:",[285,366,368],{"className":287,"code":367,"language":289,"meta":290,"style":290},"helm show values fivenet\u002Ffivenet > values.yaml\n",[292,369,370],{"__ignoreMap":290},[295,371,372,374,377,380,383,387],{"class":297,"line":298},[295,373,302],{"class":301},[295,375,376],{"class":305}," show",[295,378,379],{"class":305}," values",[295,381,382],{"class":305}," fivenet\u002Ffivenet",[295,384,386],{"class":385},"sMK4o"," >",[295,388,389],{"class":305}," values.yaml\n",[264,391,393,394],{"id":392},"_4-configure-valuesyaml","4. Configure ",[292,395,358],{},[244,397,398,399,401,402,405,406,409,410,412],{},"Edit the ",[292,400,358],{}," file to suit your deployment needs. Follow the ",[248,403,404],{"href":69},"Configure FiveNet guide"," for the required settings in ",[292,407,408],{},".fivenet.config",", then use the ",[248,411,102],{"href":103}," for individual options.",[244,414,415],{},"At a minimum, you should review the FiveNet configuration, secrets, persistence, and how the deployment should be exposed in your cluster.",[264,417,419],{"id":418},"_5-install-or-upgrade-fivenet","5. Install or Upgrade FiveNet",[244,421,422,423,425],{},"Deploy or update FiveNet in your Kubernetes cluster using the configured ",[292,424,358],{}," file:",[285,427,429],{"className":287,"code":428,"language":289,"meta":290,"style":290},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[292,430,431,449,458],{"__ignoreMap":290},[295,432,433,435,438,441,443,445],{"class":297,"line":298},[295,434,302],{"class":301},[295,436,437],{"class":305}," upgrade",[295,439,440],{"class":305}," --install",[295,442,312],{"class":305},[295,444,382],{"class":305},[295,446,448],{"class":447},"sTEyZ"," \\\n",[295,450,451,454,456],{"class":297,"line":318},[295,452,453],{"class":305},"  --namespace",[295,455,312],{"class":305},[295,457,448],{"class":447},[295,459,461,464],{"class":297,"line":460},3,[295,462,463],{"class":305},"  -f",[295,465,389],{"class":305},[264,467,469],{"id":468},"_6-verify-the-deployment","6. Verify the Deployment",[244,471,472],{},"After the Helm release is installed, verify that the workloads are starting correctly:",[285,474,476],{"className":287,"code":475,"language":289,"meta":290,"style":290},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[292,477,478,493],{"_