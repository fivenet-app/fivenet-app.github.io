ign\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":49,"body":235,"description":555,"extension":556,"links":557,"meta":558,"navigation":559,"path":50,"redirect":557,"seo":560,"stem":51,"__hash__":561},"content_en\u002F1.getting-started\u002F4.installation\u002F4.kubernetes-helm.md",{"type":236,"value":237,"toc":541},"minimark",[238,250,258,263,272,276,279,321,325,328,347,354,360,385,391,408,411,415,421,461,465,468,501,515,519,527,531,537],[239,240,241,242,249],"p",{},"For installation to Kubernetes, a Helm chart is available in our charts repository. The source code of the chart(s) is available on ",[243,244,248],"a",{"href":245,"rel":246},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fcharts",[247],"nofollow","GitHub fivenet-app\u002Fcharts",".",[239,251,252,253,257],{},"Before you begin, review the ",[243,254,256],{"href":255},"..\u002Frequirements","requirements"," and make sure your database, NATS server, storage, domain, and cluster ingress are ready.",[259,260,262],"h2",{"id":261},"_0-prerequisites","0. Prerequisites",[239,264,265,266,271],{},"This guide assumes you have a working Kubernetes cluster and a Helm client installed. If you haven't set up a Kubernetes cluster yet, please refer to the ",[243,267,270],{"href":268,"rel":269},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fsetup\u002F",[247],"Kubernetes installation guide",".\nYou can use any Kubernetes cluster, including local clusters like Minikube or KinD, or cloud providers like GKE, EKS, or AKS.",[259,273,275],{"id":274},"_1-add-helm-chart-repo","1. Add Helm Chart Repo",[239,277,278],{},"Add the FiveNet Helm chart repository to your Helm client:",[280,281,286],"pre",{"className":282,"code":283,"language":284,"meta":285,"style":285},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[287,288,289,311],"code",{"__ignoreMap":285},[290,291,294,298,302,305,308],"span",{"class":292,"line":293},"line",1,[290,295,297],{"class":296},"sBMFI","helm",[290,299,301],{"class":300},"sfazB"," repo",[290,303,304],{"class":300}," add",[290,306,307],{"class":300}," fivenet",[290,309,310],{"class":300}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[290,312,314,316,318],{"class":292,"line":313},2,[290,315,297],{"class":296},[290,317,301],{"class":300},[290,319,320],{"class":300}," update\n",[259,322,324],{"id":323},"_2-create-a-namespace","2. Create a Namespace",[239,326,327],{},"Create a dedicated namespace for FiveNet if you do not already have one:",[280,329,331],{"className":282,"code":330,"language":284,"meta":285,"style":285},"kubectl create namespace fivenet\n",[287,332,333],{"__ignoreMap":285},[290,334,335,338,341,344],{"class":292,"line":293},[290,336,337],{"class":296},"kubectl",[290,339,340],{"class":300}," create",[290,342,343],{"class":300}," namespace",[290,345,346],{"class":300}," fivenet\n",[259,348,350,351],{"id":349},"_3-get-the-latest-valuesyaml","3. Get the Latest ",[287,352,353],{},"values.yaml",[239,355,356,357,359],{},"Retrieve the default ",[287,358,353],{}," file for the Helm chart to start configuring your deployment:",[280,361,363],{"className":282,"code":362,"language":284,"meta":285,"style":285},"helm show values fivenet\u002Ffivenet > values.yaml\n",[287,364,365],{"__ignoreMap":285},[290,366,367,369,372,375,378,382],{"class":292,"line":293},[290,368,297],{"class":296},[290,370,371],{"class":300}," show",[290,373,374],{"class":300}," values",[290,376,377],{"class":300}," fivenet\u002Ffivenet",[290,379,381],{"class":380},"sMK4o"," >",[290,383,384],{"class":300}," values.yaml\n",[259,386,388,389],{"id":387},"_4-configure-valuesyaml","4. Configure ",[287,390,353],{},[239,392,393,394,396,397,400,401,404,405,407],{},"Edit the ",[287,395,353],{}," file to suit your deployment needs. Follow the ",[243,398,399],{"href":64},"Configure FiveNet guide"," for the required settings in ",[287,402,403],{},".fivenet.config",", then use the ",[243,406,97],{"href":98}," for individual options.",[239,409,410],{},"At a minimum, you should review the FiveNet configuration, secrets, persistence, and how the deployment should be exposed in your cluster.",[259,412,414],{"id":413},"_5-install-or-upgrade-fivenet","5. Install or Upgrade FiveNet",[239,416,417,418,420],{},"Deploy or update FiveNet in your Kubernetes cluster using the configured ",[287,419,353],{}," file:",[280,422,424],{"className":282,"code":423,"language":284,"meta":285,"style":285},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[287,425,426,444,453],{"__ignoreMap":285},[290,427,428,430,433,436,438,440],{"class":292,"line":293},[290,429,297],{"class":296},[290,431,432],{"class":300}," upgrade",[290,434,435],{"class":300}," --install",[290,437,307],{"class":300},[290,439,377],{"class":300},[290,441,443],{"class":442},"sTEyZ"," \\\n",[290,445,446,449,451],{"class":292,"line":313},[290,447,448],{"class":300},"  --namespace",[290,450,307],{"class":300},[290,452,443],{"class":442},[290,454,456,459],{"class":292,"line":455},3,[290,457,458],{"class":300},"  -f",[290,460,384],{"class":300},[259,462,464],{"id":463},"_6-verify-the-deployment","6. Verify the Deployment",[239,466,467],{},"After the Helm release is installed, verify that the workloads are starting correctly:",[280,469,471],{"className":282,"code":470,"language":284,"meta":285,"style":285},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[287,472,473,488],{"__ignoreMap":285},[290,474,475,477,480,483,486],{"class":292,"line":293},[290,476,337],{"class":296},[290,478,479],{"class":300}," get",[290,481,482],{"class":300}," pods",[290,484,485],{"class":300}," -n",[290,487,346],{"class":300},[290,489,490,492,495,497,499],{"class":292,"line":313},[290,491,297],{"class":296},[290,493,494],{"class":300}," status",[290,496,307],{"class":300},[290,498,485],{"class":300},[290,500,346],{"class":300},[239,502,503,504,506,507,510,511,514],{},"Ensure that FiveNet is externally reachable as configured in your ",[287,505,353],{}," file, for example through your configured ",[287,508,509],{},"Ingress",", ",[287,512,513],{},"Service",", hostnames, and TLS settings.",[259,516,518],{"id":517},"_7-post-installation-steps","7. Post-Installation Steps",[239,520,521,522,526],{},"After installation, follow the ",[243,523,525],{"href":524},"post-install-steps","post-installation steps"," to complete the setup.",[528,529,109],"h3",{"id":530},"troubleshooting",[239,532,533,534,536],{},"For common issues during Kubernetes or Helm installation, such as database-related errors, refer to the ",[243,535,115],{"href":116}," page.",[538,539,540],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .