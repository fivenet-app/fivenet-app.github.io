 a Kubernetes cluster yet, please refer to the ",[191,207,210],{"href":208,"rel":209},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fsetup\u002F",[195],"Kubernetes installation guide",".\nYou can use any Kubernetes cluster, including local clusters like Minikube or KinD, or cloud providers like GKE, EKS, or AKS.",[199,213,215],{"id":214},"_1-add-helm-chart-repo","1. Add Helm Chart Repo",[187,217,218],{},"Add the FiveNet Helm chart repository to your Helm client:",[220,221,226],"pre",{"className":222,"code":223,"language":224,"meta":225,"style":225},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[227,228,229,251],"code",{"__ignoreMap":225},[230,231,234,238,242,245,248],"span",{"class":232,"line":233},"line",1,[230,235,237],{"class":236},"sBMFI","helm",[230,239,241],{"class":240},"sfazB"," repo",[230,243,244],{"class":240}," add",[230,246,247],{"class":240}," fivenet",[230,249,250],{"class":240}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[230,252,254,256,258],{"class":232,"line":253},2,[230,255,237],{"class":236},[230,257,241],{"class":240},[230,259,260],{"class":240}," update\n",[199,262,264],{"id":263},"_2-create-a-namespace","2. Create a Namespace",[187,266,267],{},"Create a dedicated namespace for FiveNet if you do not already have one:",[220,269,271],{"className":222,"code":270,"language":224,"meta":225,"style":225},"kubectl create namespace fivenet\n",[227,272,273],{"__ignoreMap":225},[230,274,275,278,281,284],{"class":232,"line":233},[230,276,277],{"class":236},"kubectl",[230,279,280],{"class":240}," create",[230,282,283],{"class":240}," namespace",[230,285,286],{"class":240}," fivenet\n",[199,288,290,291],{"id":289},"_3-get-the-latest-valuesyaml","3. Get the Latest ",[227,292,293],{},"values.yaml",[187,295,296,297,299],{},"Retrieve the default ",[227,298,293],{}," file for the Helm chart to start configuring your deployment:",[220,301,303],{"className":222,"code":302,"language":224,"meta":225,"style":225},"helm show values fivenet\u002Ffivenet > values.yaml\n",[227,304,305],{"__ignoreMap":225},[230,306,307,309,312,315,318,322],{"class":232,"line":233},[230,308,237],{"class":236},[230,310,311],{"class":240}," show",[230,313,314],{"class":240}," values",[230,316,317],{"class":240}," fivenet\u002Ffivenet",[230,319,321],{"class":320},"sMK4o"," >",[230,323,324],{"class":240}," values.yaml\n",[199,326,328,329],{"id":327},"_4-configure-valuesyaml","4. Configure ",[227,330,293],{},[187,332,333,334,336,337,340,341,345,346,350,351,354],{},"Edit the ",[227,335,293],{}," file to suit your deployment needs. For details about the ",[227,338,339],{},".fivenet.config"," section, refer to the ",[191,342,344],{"href":343},"..\u002Fconfiguration\u002Fconfig-reference#must-set-config-options","configuration reference page",", specifically the ",[347,348,349],"strong",{},"\"Must Set Config Options\""," section and reference list at the top, to create a working ",[227,352,353],{},"config.yaml"," for FiveNet.",[187,356,357],{},"At a minimum, you should review the FiveNet configuration, secrets, persistence, and how the deployment should be exposed in your cluster.",[199,359,361],{"id":360},"_5-install-or-upgrade-fivenet","5. Install or Upgrade FiveNet",[187,363,364,365,367],{},"Deploy or update FiveNet in your Kubernetes cluster using the configured ",[227,366,293],{}," file:",[220,369,371],{"className":222,"code":370,"language":224,"meta":225,"style":225},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[227,372,373,391,400],{"__ignoreMap":225},[230,374,375,377,380,383,385,387],{"class":232,"line":233},[230,376,237],{"class":236},[230,378,379],{"class":240}," upgrade",[230,381,382],{"class":240}," --install",[230,384,247],{"class":240},[230,386,317],{"class":240},[230,388,390],{"class":389},"sTEyZ"," \\\n",[230,392,393,396,398],{"class":232,"line":253},[230,394,395],{"class":240},"  --namespace",[230,397,247],{"class":240},[230,399,390],{"class":389},[230,401,403,406],{"class":232,"line":402},3,[230,404,405],{"class":240},"  -f",[230,407,324],{"class":240},[199,409,411],{"id":410},"_6-verify-the-deployment","6. Verify the Deployment",[187,413,414],{},"After the Helm release is installed, verify that the workloads are starting correctly:",[220,416,418],{"className":222,"code":417,"language":224,"meta":225,"style":225},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[227,419,420,435],{"__ignoreMap":225},[230,421,422,424,427,430,433],{"class":232,"line":233},[230,423,277],{"class":236},[230,425,426],{"class":240}," get",[230,428,429],{"class":240}," pods",[230,431,432],{"class":240}," -n",[230,434,286],{"class":240},[230,436,437,439,442,444,446],{"class":232,"line":253},[230,438,237],{"class":236},[230,440,441],{"class":240}," status",[230,443,247],{"class":240},[230,445,432],{"class":240},[230,447,286],{"class":240},[187,449,450,451,453,454,457,458,461],{},"Ensure that FiveNet is externally reachable as configured in your ",[227,452,293],{}," file, for example through your configured ",[227,455,456],{},"Ingress",", ",[227,459,460],{},"Service",", hostnames, and TLS settings.",[199,463,465],{"id":464},"_7-post-installation-steps","7. Post-Installation Steps",[187,467,468,469,473],{},"After installation, follow the ",[191,470,472],{"href":471},"post-install-steps","post-installation steps"," to complete the setup.",[475,476,478],"h3",{"id":477},"troubleshooting","Troubleshooting",[187,480,481,482,486],{},"For common issues during Kubernetes or Helm installation, such as database-related errors, refer to the ",[191,483,485],{"href":484},"..\u002Fconfiguration\u002Fcommon-installation-issues","Common Installation Issues"," page.",[488,489,490],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code 