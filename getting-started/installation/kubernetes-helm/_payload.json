5,226,233],"p",{},"For installation to Kubernetes, a Helm chart is available in our charts repository. The source code of the chart(s) is available on ",[227,228,232],"a",{"href":229,"rel":230},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fcharts",[231],"nofollow","GitHub fivenet-app\u002Fcharts",".",[235,236,238],"h2",{"id":237},"_0-prerequisites","0. Prerequisites",[223,240,241,242,247],{},"This guide assumes you have a working Kubernetes cluster and a Helm client installed. If you haven't set up a Kubernetes cluster yet, please refer to the ",[227,243,246],{"href":244,"rel":245},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fsetup\u002F",[231],"Kubernetes installation guide",".\nYou can use any Kubernetes cluster, including local clusters like Minikube or KinD, or cloud providers like GKE, EKS, or AKS.",[235,249,251],{"id":250},"_1-add-helm-chart-repo","1. Add Helm Chart Repo",[223,253,254],{},"Add the FiveNet Helm chart repository to your Helm client:",[256,257,262],"pre",{"className":258,"code":259,"language":260,"meta":261,"style":261},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[263,264,265,287],"code",{"__ignoreMap":261},[266,267,270,274,278,281,284],"span",{"class":268,"line":269},"line",1,[266,271,273],{"class":272},"sBMFI","helm",[266,275,277],{"class":276},"sfazB"," repo",[266,279,280],{"class":276}," add",[266,282,283],{"class":276}," fivenet",[266,285,286],{"class":276}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[266,288,290,292,294],{"class":268,"line":289},2,[266,291,273],{"class":272},[266,293,277],{"class":276},[266,295,296],{"class":276}," update\n",[235,298,300],{"id":299},"_2-create-a-namespace","2. Create a Namespace",[223,302,303],{},"Create a dedicated namespace for FiveNet if you do not already have one:",[256,305,307],{"className":258,"code":306,"language":260,"meta":261,"style":261},"kubectl create namespace fivenet\n",[263,308,309],{"__ignoreMap":261},[266,310,311,314,317,320],{"class":268,"line":269},[266,312,313],{"class":272},"kubectl",[266,315,316],{"class":276}," create",[266,318,319],{"class":276}," namespace",[266,321,322],{"class":276}," fivenet\n",[235,324,326,327],{"id":325},"_3-get-the-latest-valuesyaml","3. Get the Latest ",[263,328,329],{},"values.yaml",[223,331,332,333,335],{},"Retrieve the default ",[263,334,329],{}," file for the Helm chart to start configuring your deployment:",[256,337,339],{"className":258,"code":338,"language":260,"meta":261,"style":261},"helm show values fivenet\u002Ffivenet > values.yaml\n",[263,340,341],{"__ignoreMap":261},[266,342,343,345,348,351,354,358],{"class":268,"line":269},[266,344,273],{"class":272},[266,346,347],{"class":276}," show",[266,349,350],{"class":276}," values",[266,352,353],{"class":276}," fivenet\u002Ffivenet",[266,355,357],{"class":356},"sMK4o"," >",[266,359,360],{"class":276}," values.yaml\n",[235,362,364,365],{"id":363},"_4-configure-valuesyaml","4. Configure ",[263,366,329],{},[223,368,369,370,372,373,376,377,381,382,386,387,390],{},"Edit the ",[263,371,329],{}," file to suit your deployment needs. For details about the ",[263,374,375],{},".fivenet.config"," section, refer to the ",[227,378,380],{"href":379},"..\u002Fconfiguration\u002Fconfig-reference#must-set-config-options","configuration reference page",", specifically the ",[383,384,385],"strong",{},"\"Must Set Config Options\""," section and reference list at the top, to create a working ",[263,388,389],{},"config.yaml"," for FiveNet.",[223,392,393],{},"At a minimum, you should review the FiveNet configuration, secrets, persistence, and how the deployment should be exposed in your cluster.",[235,395,397],{"id":396},"_5-install-or-upgrade-fivenet","5. Install or Upgrade FiveNet",[223,399,400,401,403],{},"Deploy or update FiveNet in your Kubernetes cluster using the configured ",[263,402,329],{}," file:",[256,405,407],{"className":258,"code":406,"language":260,"meta":261,"style":261},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[263,408,409,427,436],{"__ignoreMap":261},[266,410,411,413,416,419,421,423],{"class":268,"line":269},[266,412,273],{"class":272},[266,414,415],{"class":276}," upgrade",[266,417,418],{"class":276}," --install",[266,420,283],{"class":276},[266,422,353],{"class":276},[266,424,426],{"class":425},"sTEyZ"," \\\n",[266,428,429,432,434],{"class":268,"line":289},[266,430,431],{"class":276},"  --namespace",[266,433,283],{"class":276},[266,435,426],{"class":425},[266,437,439,442],{"class":268,"line":438},3,[266,440,441],{"class":276},"  -f",[266,443,360],{"class":276},[235,445,447],{"id":446},"_6-verify-the-deployment","6. Verify the Deployment",[223,449,450],{},"After the Helm release is installed, verify that the workloads are starting correctly:",[256,452,454],{"className":258,"code":453,"language":260,"meta":261,"style":261},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[263,455,456,471],{"__ignoreMap":261},[266,457,458,460,463,466,469],{"class":268,"line":269},[266,459,313],{"class":272},[266,461,462],{"class":276}," get",[266,464,465],{"class":276}," pods",[266,467,468],{"class":276}," -n",[266,470,322],{"class":276},[266,472,473,475,478,480,482],{"class":268,"line":289},[266,474,273],{"class":272},[266,476,477],{"class":276}," status",[266,479,283],{"class":276},[266,481,468],{"class":276},[266,483,322],{"class":276},[223,485,486,487,489,490,493,494,497],{},"Ensure that FiveNet is externally reachable as configured in your ",[263,488,329],{}," file, for example through your configured ",[263,491,492],{},"Ingress",", ",[263,495,496],{},"Service",", hostnames, and TLS settings.",[235,499,501],{"id":500},"_7-post-installation-steps","7. Post-Installation Steps",[223,503,504,505,509],{},"After installation, follow the ",[227,506,508],{"href":507},"post-install-steps","post-installation steps",