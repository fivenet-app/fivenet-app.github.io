ble on ",[223,224,228],"a",{"href":225,"rel":226},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fcharts",[227],"nofollow","GitHub fivenet-app\u002Fcharts",".",[231,232,234],"h2",{"id":233},"_0-prerequisites","0. Prerequisites",[219,236,237,238,243],{},"This guide assumes you have a working Kubernetes cluster and a Helm client installed. If you haven't set up a Kubernetes cluster yet, please refer to the ",[223,239,242],{"href":240,"rel":241},"https:\u002F\u002Fkubernetes.io\u002Fdocs\u002Fsetup\u002F",[227],"Kubernetes installation guide",".\nYou can use any Kubernetes cluster, including local clusters like Minikube or KinD, or cloud providers like GKE, EKS, or AKS.",[231,245,247],{"id":246},"_1-add-helm-chart-repo","1. Add Helm Chart Repo",[219,249,250],{},"Add the FiveNet Helm chart repository to your Helm client:",[252,253,258],"pre",{"className":254,"code":255,"language":256,"meta":257,"style":257},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","helm repo add fivenet https:\u002F\u002Ffivenet.app\u002Fcharts\nhelm repo update\n","bash","",[259,260,261,283],"code",{"__ignoreMap":257},[262,263,266,270,274,277,280],"span",{"class":264,"line":265},"line",1,[262,267,269],{"class":268},"sBMFI","helm",[262,271,273],{"class":272},"sfazB"," repo",[262,275,276],{"class":272}," add",[262,278,279],{"class":272}," fivenet",[262,281,282],{"class":272}," https:\u002F\u002Ffivenet.app\u002Fcharts\n",[262,284,286,288,290],{"class":264,"line":285},2,[262,287,269],{"class":268},[262,289,273],{"class":272},[262,291,292],{"class":272}," update\n",[231,294,296],{"id":295},"_2-create-a-namespace","2. Create a Namespace",[219,298,299],{},"Create a dedicated namespace for FiveNet if you do not already have one:",[252,301,303],{"className":254,"code":302,"language":256,"meta":257,"style":257},"kubectl create namespace fivenet\n",[259,304,305],{"__ignoreMap":257},[262,306,307,310,313,316],{"class":264,"line":265},[262,308,309],{"class":268},"kubectl",[262,311,312],{"class":272}," create",[262,314,315],{"class":272}," namespace",[262,317,318],{"class":272}," fivenet\n",[231,320,322,323],{"id":321},"_3-get-the-latest-valuesyaml","3. Get the Latest ",[259,324,325],{},"values.yaml",[219,327,328,329,331],{},"Retrieve the default ",[259,330,325],{}," file for the Helm chart to start configuring your deployment:",[252,333,335],{"className":254,"code":334,"language":256,"meta":257,"style":257},"helm show values fivenet\u002Ffivenet > values.yaml\n",[259,336,337],{"__ignoreMap":257},[262,338,339,341,344,347,350,354],{"class":264,"line":265},[262,340,269],{"class":268},[262,342,343],{"class":272}," show",[262,345,346],{"class":272}," values",[262,348,349],{"class":272}," fivenet\u002Ffivenet",[262,351,353],{"class":352},"sMK4o"," >",[262,355,356],{"class":272}," values.yaml\n",[231,358,360,361],{"id":359},"_4-configure-valuesyaml","4. Configure ",[259,362,325],{},[219,364,365,366,368,369,372,373,377,378,382,383,386],{},"Edit the ",[259,367,325],{}," file to suit your deployment needs. For details about the ",[259,370,371],{},".fivenet.config"," section, refer to the ",[223,374,376],{"href":375},"..\u002Fconfiguration\u002Fconfig-reference#must-set-config-options","configuration reference page",", specifically the ",[379,380,381],"strong",{},"\"Must Set Config Options\""," section and reference list at the top, to create a working ",[259,384,385],{},"config.yaml"," for FiveNet.",[219,388,389],{},"At a minimum, you should review the FiveNet configuration, secrets, persistence, and how the deployment should be exposed in your cluster.",[231,391,393],{"id":392},"_5-install-or-upgrade-fivenet","5. Install or Upgrade FiveNet",[219,395,396,397,399],{},"Deploy or update FiveNet in your Kubernetes cluster using the configured ",[259,398,325],{}," file:",[252,401,403],{"className":254,"code":402,"language":256,"meta":257,"style":257},"helm upgrade --install fivenet fivenet\u002Ffivenet \\\n  --namespace fivenet \\\n  -f values.yaml\n",[259,404,405,423,432],{"__ignoreMap":257},[262,406,407,409,412,415,417,419],{"class":264,"line":265},[262,408,269],{"class":268},[262,410,411],{"class":272}," upgrade",[262,413,414],{"class":272}," --install",[262,416,279],{"class":272},[262,418,349],{"class":272},[262,420,422],{"class":421},"sTEyZ"," \\\n",[262,424,425,428,430],{"class":264,"line":285},[262,426,427],{"class":272},"  --namespace",[262,429,279],{"class":272},[262,431,422],{"class":421},[262,433,435,438],{"class":264,"line":434},3,[262,436,437],{"class":272},"  -f",[262,439,356],{"class":272},[231,441,443],{"id":442},"_6-verify-the-deployment","6. Verify the Deployment",[219,445,446],{},"After the Helm release is installed, verify that the workloads are starting correctly:",[252,448,450],{"className":254,"code":449,"language":256,"meta":257,"style":257},"kubectl get pods -n fivenet\nhelm status fivenet -n fivenet\n",[259,451,452,467],{"__ignoreMap":257},[262,453,454,456,459,462,465],{"class":264,"line":265},[262,455,309],{"class":268},[262,457,458],{"class":272}," get",[262,460,461],{"class":272}," pods",[262,463,464],{"class":272}," -n",[262,466,318],{"class":272},[262,468,469,471,474,476,478],{"class":264,"line":285},[262,470,269],{"class":268},[262,472,473],{"class":272}," status",[262,475,279],{"class":272},[262,477,464],{"class":272},[262,479,318],{"class":272},[219,481,482,483,485,486,489,490,493],{},"Ensure that FiveNet is externally reachable as configured in your ",[259,484,325],{}," file, for example through your configured ",[259,487,488],{},"Ingress",", ",[259,491,492],{},"Service",", hostnames, and TLS settings.",[231,495,497],{"id":496},"_7-post-installation-steps","7. Post-Installation Steps",[219,499,500,501,505],{},"After installation, follow the ",[223,502,504],{"href":503},"post-install-steps","post-installation steps"," to complete the setup.",[507,508,510],"h3",{"id":509},"troubleshooting","Troubleshooting",[219,512,513,514,517],{},"For common issues during K