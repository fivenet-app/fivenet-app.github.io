rmation",[219,228,229,233,234,239,240,243],{},[230,231,232],"strong",{},"Important",": Self-hosting FiveNet requires intermediate knowledge of Docker or Kubernetes. For professional support, simplified setup, or managed hosting, we recommend using ",[235,236,238],"a",{"href":237},"cloud","FiveNet Cloud",".",[241,242],"br",{},"\nPlease ensure you have sufficient experience with these technologies before attempting installation. Community-based support is available for installation and configuration.",[245,246,248],"h2",{"id":247},"self-hosted","Self-hosted",[250,251,252,260],"card-group",{},[253,254,257],"card",{"icon":255,"title":256,"to":46},"i-mdi-docker","Docker",[219,258,259],{},"Learn how to set up FiveNet using Docker and the Docker Compose plugin.",[253,261,264],{"icon":262,"title":263,"to":50},"i-mdi-kubernetes","Kubernetes",[219,265,266],{},"Deploy FiveNet on Kubernetes using our Helm Chart.",[245,268,270],{"id":269},"cloud-hosted","Cloud-hosted",[219,272,273,274,239],{},"For those who prefer a hassle-free experience, FiveNet Cloud offers a streamlined way to run FiveNet for your roleplay server. Learn more on the ",[235,275,276],{"href":237},"Cloud info page",[253,278,280],{"icon":279,"title":238,"to":42},"i-mdi-cloud",[219,281,282],{},"Get started with FiveNet Cloud for a fully managed solution, eliminating the need for manual setup and maintenance. Perfect for those who want to focus on their roleplay server without worrying about infrastructure.",{"title":284,"searchDepth":285,"depth":285,"links":286},"",2,[287,288],{"id":247,"depth":285,"text":248},{"id":269,"depth":285,"text":270},"md",null,{},true,{"title":37,"description":221},"GTx_J8DS6z83h5Ab-A0j3tlRPq5-OLcdUU_rgT_TBzo",[296,298],{"title":28,"path":29,"stem":30,"description":297,"children":-1},"Learn how FiveNet version numbers are structured and what release and development builds mean.",{"title":41,"path":42,"stem":43,"description":299,"children":-1},"FiveNet Cloud is available today as a managed hosting option for communities that want us to run and maintain FiveNet for them.",1787957461937]