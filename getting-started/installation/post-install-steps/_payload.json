 setup and connect your gameserver after installing FiveNet.",[227,228,230],"h2",{"id":229},"_1-create-the-first-account-manually","1. Create the First Account Manually",[223,232,233],{},"If no account exists yet, create the first account directly in the database:",[235,236,237,260,466,469],"ol",{},[238,239,240,241,245,246,253,254,259],"li",{},"Open your MySQL management tool or database UI, such as ",[242,243,244],"code",{},"mysql",", ",[247,248,252],"a",{"href":249,"rel":250},"https:\u002F\u002Fdbeaver.io\u002F",[251],"nofollow","DBeaver",", or ",[247,255,258],{"href":256,"rel":257},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[251],"PHPMyAdmin",", and connect to the database used by FiveNet or your gameserver.",[238,261,262,263,266,267,348,358,361,364],{},"Navigate to the ",[242,264,265],{},"fivenet_accounts"," table and create a new entry with the following values:",[268,269,270,283],"table",{},[271,272,273],"thead",{},[274,275,276,280],"tr",{},[277,278,279],"th",{},"Field",[277,281,282],{},"Value Description",[284,285,286,301,324,334],"tbody",{},[274,287,288,294],{},[289,290,291],"td",{},[242,292,293],{},"enabled",[289,295,296,297,300],{},"Set to ",[242,298,299],{},"1"," to enable the account.",[274,302,303,308],{},[289,304,305],{},[242,306,307],{},"license",[289,309,310,311,245,314,245,317,245,320,323],{},"Your in-game identifier\u002Flicense without any prefix (e.g., ",[242,312,313],{},"char*:",[242,315,316],{},"license:",[242,318,319],{},"steam:",[242,321,322],{},"discord:",").",[274,325,326,331],{},[289,327,328],{},[242,329,330],{},"reg_token",[289,332,333],{},"A 6-digit registration token for account registration.",[274,335,336,341],{},[289,337,338],{},[242,339,340],{},"groups",[289,342,343,344,347],{},"A JSON string array, e.g., ",[242,345,346],{},"[\"admin\"]"," (list of groups).",[349,350,351],"blockquote",{},[223,352,353,357],{},[354,355,356],"strong",{},"Note:"," Leave all other fields as they are.",[359,360],"br",{},[354,362,363],{},"Example query:",