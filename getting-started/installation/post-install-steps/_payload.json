7,322,345,355],"tbody",{},[295,308,309,315],{},[310,311,312],"td",{},[263,313,314],{},"enabled",[310,316,317,318,321],{},"Set to ",[263,319,320],{},"1"," to enable the account.",[295,323,324,329],{},[310,325,326],{},[263,327,328],{},"license",[310,330,331,332,266,335,266,338,266,341,344],{},"Your in-game identifier\u002Flicense without any prefix (e.g., ",[263,333,334],{},"char*:",[263,336,337],{},"license:",[263,339,340],{},"steam:",[263,342,343],{},"discord:",").",[295,346,347,352],{},[310,348,349],{},[263,350,351],{},"reg_token",[310,353,354],{},"A 6-digit registration token for account registration.",[295,356,357,362],{},[310,358,359],{},[263,360,361],{},"groups",[310,363,364,365,368],{},"A JSON string array, e.g., ",[263,366,367],{},"[\"admin\"]"," (list of groups).",[370,371,372],"blockquote",{},[244,373,374,378],{},[375,376,377],"strong",{},"Note:"," Leave all other fields as they are.",[380,381],"br",{},[375,383,384],{},"Example query:",[386,387,392],"pre",{"className":388,"code":389,"language":390,"meta":391,"style":391},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[263,393,394],{"__ignoreMap":391},[395,396,399,403,407,410,413,417,419,421,423,425,427,429,431,433,435,437,439,441,443,445,447,450,453,455,457,459,462,465,467,469,471,474,476,478,480,482,484],"span",{"class":397,"line":398},"line",1,[395,400,402],{"class":401},"sbssI","INSERT INTO",[395,404,406],{"class":405},"sMK4o"," `",[395,408,286],{"class":409},"sfazB",[395,411,412],{"class":405},"`",[395,414,416],{"class":415},"sTEyZ"," (",[395,418,412],{"class":405},[395,420,314],{"class":409},[395,422,412],{"class":405},[395,424,266],{"class":415},[395,426,412],{"class":405},[395,428,328],{"class":409},[395,430,412],{"class":405},[395,432,266],{"class":415},[395,434,412],{"class":405},[395,436,351],{"class":409},[395,438,412],{"class":405},[395,440,266],{"class":415},[395,442,412],{"class":405},[395,444,361],{"class":409},[395,446,412],{"class":405},[395,448,449],{"class":415},") ",[395,451,452],{"class":401},"VALUES",[395,454,416],{"class":415},[395,456,320],{"class":401},[395,458,266],{"class":415},[395,460,461],{"class":405},"'",[395,463,464],{"class":409},"YOUR_LICENSE_HERE",[395,466,461],{"class":405},[395,468,266],{"class":415},[395,470,461],{"class":405},[395,472,473],{"class":409},"123456",[395,475,461],{"class":405},[395,477,266],{"class":415},[395,479,461],{"class":405},[395,481,367],{"class":409},[395,483,461],{"class":405},[395,485,486],{"class":415},");\n",[259,488,489],{},"Open your FiveNet instance in your browser, navigate to the registration page, and use the registration token to create your account.",[259,491,492,493,495,496,499,500,502,503,506],{},"Once registered, log in to FiveNet. If the ",[263,494,328],{}," value is correct, you should see any characters (",[263,497,498],{},"users"," table) associated with the ",[263,501,328],{},"\u002F",[263,504,505],{},"identifier",".",[248,508,510],{"id":509},"_2-install-the-fivenet-plugin-on-your-gameserver","2. Install the FiveNet Plugin on Your Gameserver",[244,512,513],{},"To connect FiveNet to your gameserver:",[515,516,517,526],"ul",{},[259,518,519,520,525],{},"Download the ",[268,521,524],{"href":522,"rel":523},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[272],"FiveM Plugin code"," from GitHub.",[259,527,528],{},"Install and configure the plugin on your FiveM server.",[530,531,532,537],"callout",{},[244,533,534],{},[375,535,536],{},"Important:",[515,538,539,546],{},[259,540,541,542,545],{},"Read the ",[263,543,544],{},"README.md"," file of the plugin you install and follow the instructions to ensure optimal setup.",[259,547,548],{},"Add event triggers to your ESX plugins as required. Not all events collected by FiveNet are available in the standard ESX plugin code.",[244,550,551,552,506],{},"For additional details and step-by-step setup guidance, refer to the ",[268,553,555],{"href":554},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","plugin installation documentation",[248,557,559],{"id":558},"_3-configure-your-fivenet","3. Configure Your FiveNet",[244,561,562,563,566,567,570,571,574],{},"When logged in with a character selected, you must be able to enable superuser mode (controlled by config option ",[263,564,565],{},"auth.configAdminGroups"," and ",[263,568,569],{},"auth.configAdminUsers","), navigate to your \"FiveNet Settings\" (",[263,572,573],{},"\u002Fsettings\u002Fsettings"," URL path).",[244,576,577],{},"In there go over each tab and configure them to suit your servers' config, jobs and roleplay.",[244,579,580],{},"Some of the most important settings to configure here are:",[256,582,583,591],{},[259,584,585,586],{},"\"Jobs & Tracker\" Tab\n",[515,587,588],{},[259,589,590],{},"Make sure to select the correct unemployed job and grade.",[259,592,593,594],{},"\"Website\" Tab\n",[515,595,596],{},[259,597,598],{},"Make sure to set the URLs to your gameservers' privacy policy and imprint pages.",[600,601,602],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-