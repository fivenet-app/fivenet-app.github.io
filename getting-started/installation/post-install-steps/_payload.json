r.io\u002F",[215],"nofollow","DBeaver",", or ",[211,219,222],{"href":220,"rel":221},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[215],"PHPMyAdmin",", and connect to the database used by FiveNet or your gameserver.",[202,225,226,227,230,231,312,322,325,328],{},"Navigate to the ",[206,228,229],{},"fivenet_accounts"," table and create a new entry with the following values:",[232,233,234,247],"table",{},[235,236,237],"thead",{},[238,239,240,244],"tr",{},[241,242,243],"th",{},"Field",[241,245,246],{},"Value Description",[248,249,250,265,288,298],"tbody",{},[238,251,252,258],{},[253,254,255],"td",{},[206,256,257],{},"enabled",[253,259,260,261,264],{},"Set to ",[206,262,263],{},"1"," to enable the account.",[238,266,267,272],{},[253,268,269],{},[206,270,271],{},"license",[253,273,274,275,209,278,209,281,209,284,287],{},"Your in-game identifier\u002Flicense without any prefix (e.g., ",[206,276,277],{},"char*:",[206,279,280],{},"license:",[206,282,283],{},"steam:",[206,285,286],{},"discord:",").",[238,289,290,295],{},[253,291,292],{},[206,293,294],{},"reg_token",[253,296,297],{},"A 6-digit registration token for account registration.",[238,299,300,305],{},[253,301,302],{},[206,303,304],{},"groups",[253,306,307,308,311],{},"A JSON string array, e.g., ",[206,309,310],{},"[\"admin\"]"," (list of groups).",[313,314,315],"blockquote",{},[187,316,317,321],{},[318,319,320],"strong",{},"Note:"," Leave all other fields as they are.",[323,324],"br",{},[318,326,327],{},"Example query:",[329,330,335],"pre",{"className":331,"code":332,"language":333,"meta":334,"style":334},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[206,336,337],{"__ignoreMap":334},[338,339,342,346,350,353,356,360,362,364,366,368,370,372,374,376,378,380,382,384,386,388,390,393,396,398,400,402,405,408,410,412,414,417,419,421,423,425,427],"span",{"class":340,"line":341},"line",1,[338,343,345],{"class":344},"sbssI","INSERT INTO",[338,347,349],{"class":348},"sMK4o"," `",[338,351,229],{"class":352},"sfazB",[338,354,355],{"class":348},"`",[338,357,359],{"class":358},"sTEyZ"," (",[338,361,355],{"class":348},[338,363,257],{"class":352},[338,365,355],{"class":348},[338,367,209],{"class":358},[338,369,355],{"class":348},[338,371,271],{"class":352},[338,373,355],{"class":348},[338,375,209],{"class":358},[338,377,355],{"class":348},[338,379,294],{"class":352},[338,381,355],{"class":348},[338,383,209],{"class":358},[338,385,355],{"class":348},[338,387,304],{"class":352},[338,389,355],{"class":348},[338,391,392],{"class":358},") ",[338,394,395],{"class":344},"VALUES",[338,397,359],{"class":358},[338,399,263],{"class":344},[338,401,209],{"class":358},[338,403,404],{"class":348},"'",[338,406,407],{"class":352},"YOUR_LICENSE_HERE",[338,409,404],{"class":348},[338,411,209],{"class":358},[338,413,404],{"class":348},[338,415,416],{"class":352},"123456",[338,418,404],{"class":348},[338,420,209],{"class":358},[338,422,404],{"class":348},[338,424,310],{"class":352},[338,426,404],{"class":348},[338,428,429],{"class":358},");\n",[202,431,432],{},"Open your FiveNet instance in your browser, navigate to the registration page, and use the registration token to create your account.",[202,434,435,436,438,439,442,443,445,446,449],{},"Once registered, log in to FiveNet. If the ",[206,437,271],{}," value is correct, you should see any characters (",[206,440,441],{},"users"," table) associated with the ",[206,444,271],{},"\u002F",[206,447,448],{},"identifier",".",[191,451,453],{"id":452},"_2-install-the-fivenet-plugin-on-your-gameserver","2. Install the FiveNet Plugin on Your Gameserver",[187,455,456],{},"To connect FiveNet to your gameserver:",[458,459,460,469],"ul",{},[202,461,462,463,468],{},"Download the ",[211,464,467],{"href":465,"rel":466},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[215],"FiveM Plugin code"," from GitHub.",[202,470,471],{},"Install and configure the plugin on your FiveM server.",[473,474,475,480],"callout",{},[187,476,477],{},[318,478,479],{},"Important:",[458,481,482,489],{},[202,483,484,485,488],{},"Read the ",[206,486,487],{},"README.md"," file of the plugin you install and follow the instructions to ensure optimal setup.",[202,490,491],{},"Add event triggers to your ESX plugins as required. Not all events collected by FiveNet are available in the standard ESX plugin code.",[187,493,494,495,449],{},"For additional details and step-by-step setup guidance, refer to the ",[211,496,498],{"href":497},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","plugin installation documentation",[191,500,502],{"id":501},"_3-configure-your-fivenet","3. Configure Your FiveNet",[187,504,505,506,509,510,513,514,517],{},"When logged in with a character selected, you must be able to enable superuser mode (controlled by config option ",[206,507,508],{},"auth.configAdminGroups"," and ",[206,511,512],{},"auth.configAdminUsers","), navigate to your \"FiveNet Settings\" (",[206,515,516],{},"\u002Fsettings\u002Fsettings"," URL path).",[187,519,520],{},"In there go over each tab and configure them to suit your servers' config, jobs and roleplay.",[187,522,523],{},"Some of the most important settings to configure here are:",[199,525,526,534],{},[202,527,528,529],{},"\"Jobs & Tracker\" Tab\n",[458,530,531],{},[202,532,533],{},"Make sure to select the correct enemployed job and grade.",[202,535,536,537],{},"\"Website\" Tab\n",[458,538,539],{},[202,540,541],{},"Make sure to set the URLs to your gameservers' privacy policy and imprint pages.",[543,544,545],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki c