":579},"content_en\u002F1.getting-started\u002F4.installation\u002F6.post-install-steps.md","Complete Initial Setup",{"type":204,"value":205,"toc":566},"minimark",[206,210,215,218,470,474,477,492,512,519,523,538,541,544,562],[207,208,209],"p",{},"Complete the first-admin setup and connect your gameserver after the FiveNet server is running.",[211,212,214],"h2",{"id":213},"_1-create-the-first-account-manually","1. Create the First Account Manually",[207,216,217],{},"If no account exists yet, create the first account directly in the database:",[219,220,221,244,450,453],"ol",{},[222,223,224,225,229,230,237,238,243],"li",{},"Open your MySQL management tool or database UI, such as ",[226,227,228],"code",{},"mysql",", ",[231,232,236],"a",{"href":233,"rel":234},"https:\u002F\u002Fdbeaver.io\u002F",[235],"nofollow","DBeaver",", or ",[231,239,242],{"href":240,"rel":241},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[235],"PHPMyAdmin",", and connect to the database used by FiveNet or your gameserver.",[222,245,246,247,250,251,332,342,345,348],{},"Navigate to the ",[226,248,249],{},"fivenet_accounts"," table and create a new entry with the following values:",[252,253,254,267],"table",{},[255,256,257],"thead",{},[258,259,260,264],"tr",{},[261,262,263],"th",{},"Field",[261,265,266],{},"Value Description",[268,269,270,285,308,318],"tbody",{},[258,271,272,278],{},[273,274,275],"td",{},[226,276,277],{},"enabled",[273,279,280,281,284],{},"Set to ",[226,282,283],{},"1"," to enable the account.",[258,286,287,292],{},[273,288,289],{},[226,290,291],{},"license",[273,293,294,295,229,298,229,301,229,304,307],{},"Your in-game identifier\u002Flicense without any prefix (e.g., ",[226,296,297],{},"char*:",[226,299,300],{},"license:",[226,302,303],{},"steam:",[226,305,306],{},"discord:",").",[258,309,310,315],{},[273,311,312],{},[226,313,314],{},"reg_token",[273,316,317],{},"A 6-digit registration token for account registration.",[258,319,320,325],{},[273,321,322],{},[226,323,324],{},"groups",[273,326,327,328,331],{},"A JSON string array, e.g., ",[226,329,330],{},"[\"admin\"]"," (list of groups).",[333,334,335],"blockquote",{},[207,336,337,341],{},[338,339,340],"strong",{},"Note:"," Leave all other fields as they are.",[343,344],"br",{},[338,346,347],{},"Example query:",[349,350,355],"pre",{"className":351,"code":352,"language":353,"meta":354,"style":354},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[226,356,357],{"__ignoreMap":354},[358,359,362,366,370,373,376,380,382,384,386,388,390,392,394,396,398,400,402,404,406,408,410,413,416,418,420,422,425,428,430,432,434,437,439,441,443,445,447],"span",{"class":360,"line":361},"line",1,[358,363,365],{"class":364},"sbssI","INSERT INTO",[358,367,369],{"class":368},"sMK4o"," `",[358,371,249],{"class":372},"sfazB",[358,374,375],{"class":368},"`",[358,377,379],{"class":378},"sTEyZ"," (",[358,381,375],{"class":368},[358,383,277],{"class":372},[358,385,375],{"class":368},[358,387,229],{"class":378},[358,389,375],{"class":368},[358,391,291],{"class":372},[358,393,375],{"class":368},[358,395,229],{"class":378},[358,397,375],{"class":368},[358,399,314],{"class":372},[358,401,375],{"class":368},[358,403,229],{"class":378},[358,405,375],{"class":368},[358,407,324],{"class":372},[358,409,375],{"class":368},[358,411,412],{"class":378},") ",[358,414,415],{"class":364},"VALUES",[358,417,379],{"class":378},[358,419,283],{"class":364},[358,421,229],{"class":378},[358,423,424],{"class":368},"'",[358,426,427],{"class":372},"YOUR_LICENSE_HERE",[358,429,424],{"class":368},[358,431,229],{"class":378},[358,433,424],{"class":368},[358,435,436],{"class":372},"123456",[358,438,424],{"class":368},[358,440,229],{"class":378},[358,442,424],{"class":368},[358,444,330],{"class":372},[358,446,424],{"class":368},[358,448,449],{"class":378},");\n",[222,451,452],{},"Open your FiveNet instance in your browser, navigate to the registration page, and use the registration token to create your account.",[222,454,455,456,458,459,462,463,465,466,469],{},"Once registered, log in to FiveNet. If the ",[226,457,291],{}," value is correct, you should see any characters (",[226,460,461],{},"users"," table) associated with the ",[226,464,291],{},"\u002F",[226,467,468],{},"identifier",".",[211,471,473],{"id":472},"_2-install-the-fivenet-plugin-on-your-gameserver","2. Install the FiveNet Plugin on Your Gameserver",[207,475,476],{},"To connect FiveNet to your gameserver:",[478,479,480,489],"ul",{},[222,481,482,483,488],{},"Download the ",[231,484,487],{"href":485,"rel":486},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[235],"FiveM Plugin code"," from GitHub.",[222,490,491],{},"Install and configure the plugin on your FiveM server.",[493,494,495,500],"callout",{},[207,496,497],{},[338,498,499],{},"Important:",[478,501,502,509],{},[222,503,504,505,508],{},"Read the ",[226,506,507],{},"README.md"," file of the plugin you install and follow the instructions to ensure optimal setup.",[222,510,511],{},"Add event triggers to your ESX plugins as required. Not all events collected by FiveNet are available in the standard ESX plugin code.",[207,513,514,515,469],{},"For additional details and step-by-step setup guidance, refer to the ",[231,516,518],{"href":517},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","plugin installation documentation",[211,520,522],{"id":521},"_3-configure-your-fivenet","3. Configure Your FiveNet",[207,524,525,526,529,530,533,534,537],{},"When logged in with a character selected, you must be able to enable superuser mode (controlled by config option ",[226,527,528],{},"auth.configAdminGroups"," and ",[226,531,532],{},"auth.configAdminUsers","), navigate to your \"FiveNet Settings\" (",[226,535,536],{},"\u002Fsettings\u002Fsettings"," URL path).",[207,539,540],{},"In there go over each tab and configure them to suit your servers' config, jobs and roleplay.",[207,542,543],{},"Some of the most important settings to configure here are:",[219,545,546,554],{},[222,547,548,549],{},"\"Jobs & Tracker\" Tab\n",[478,550,551],{},[222,552,553],{},"Make sure to select the correct unemployed job and grade.",[222,555,556,557],{},"\"Website\" Tab\n",[478,558,559],{},[222,560,561],{},"Make sure to set the URLs to your gameservers' privacy policy and imprint pages.",[563,564,565],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":354,"searchDepth":567,"depth":567,"links":568},2,[569,570,571],{"id":213,"depth":567,"text":214},{"id":472,"depth":567,"text":473},{"id":521,"depth":567,"text":522},"md",null,{},true,"\u002Fgetting-started\u002Finstallation\u002Fpost-install-steps",{"title":202,"description":209},"1.getting-started\u002F4.installation\u002F6.post-install-steps","ytw1p9MitiHl3oTUvThivxshpvvHnyEhD_bTFJChn6g",[581,586],{"title":582,"path":583,"stem":584,"description":585,"children":-1},"Kubernetes: Using Helm","\u002Fgetting-started\u002Finstallation\u002Fkubernetes-helm","1.getting-started\u002F4.installation\u002F4.kubernetes-helm","For installation to Kubernetes, a Helm chart is available in our charts repository. The source code of the chart(s) is available on GitHub fivenet-app\u002Fcharts.",{"title":587,"path":588,"stem":589,"description":590,"children":-1},"Configure FiveNet","\u002Fgetting-started\u002Fconfiguration\u002Fconfigure","1.getting-started\u002F5.configuration\u002F2.configure","Configure the FiveNet server before connecting your gameserver.",1789078105395]