"9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":53,"body":235,"description":241,"extension":604,"links":605,"meta":606,"navigation":607,"path":54,"redirect":605,"seo":608,"stem":55,"__hash__":609},"content_en\u002F1.getting-started\u002F4.installation\u002F6.post-install-steps.md",{"type":236,"value":237,"toc":598},"minimark",[238,242,247,250,502,506,509,524,544,551,555,570,573,576,594],[239,240,241],"p",{},"Complete the first-admin setup and connect your gameserver after the FiveNet server is running.",[243,244,246],"h2",{"id":245},"_1-create-the-first-account-manually","1. Create the First Account Manually",[239,248,249],{},"If no account exists yet, create the first account directly in the database:",[251,252,253,276,482,485],"ol",{},[254,255,256,257,261,262,269,270,275],"li",{},"Open your MySQL management tool or database UI, such as ",[258,259,260],"code",{},"mysql",", ",[263,264,268],"a",{"href":265,"rel":266},"https:\u002F\u002Fdbeaver.io\u002F",[267],"nofollow","DBeaver",", or ",[263,271,274],{"href":272,"rel":273},"https:\u002F\u002Fwww.phpmyadmin.net\u002F",[267],"PHPMyAdmin",", and connect to the database used by FiveNet or your gameserver.",[254,277,278,279,282,283,364,374,377,380],{},"Navigate to the ",[258,280,281],{},"fivenet_accounts"," table and create a new entry with the following values:",[284,285,286,299],"table",{},[287,288,289],"thead",{},[290,291,292,296],"tr",{},[293,294,295],"th",{},"Field",[293,297,298],{},"Value Description",[300,301,302,317,340,350],"tbody",{},[290,303,304,310],{},[305,306,307],"td",{},[258,308,309],{},"enabled",[305,311,312,313,316],{},"Set to ",[258,314,315],{},"1"," to enable the account.",[290,318,319,324],{},[305,320,321],{},[258,322,323],{},"license",[305,325,326,327,261,330,261,333,261,336,339],{},"Your in-game identifier\u002Flicense without any prefix (e.g., ",[258,328,329],{},"char*:",[258,331,332],{},"license:",[258,334,335],{},"steam:",[258,337,338],{},"discord:",").",[290,341,342,347],{},[305,343,344],{},[258,345,346],{},"reg_token",[305,348,349],{},"A 6-digit registration token for account registration.",[290,351,352,357],{},[305,353,354],{},[258,355,356],{},"groups",[305,358,359,360,363],{},"A JSON string array, e.g., ",[258,361,362],{},"[\"admin\"]"," (list of groups).",[365,366,367],"blockquote",{},[239,368,369,373],{},[370,371,372],"strong",{},"Note:"," Leave all other fields as they are.",[375,376],"br",{},[370,378,379],{},"Example query:",[381,382,387],"pre",{"className":383,"code":384,"language":385,"meta":386,"style":386},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","INSERT INTO `fivenet_accounts` (`enabled`, `license`, `reg_token`, `groups`) VALUES (1, 'YOUR_LICENSE_HERE', '123456', '[\"admin\"]');\n","sql","",[258,388,389],{"__ignoreMap":386},[390,391,394,398,402,405,408,412,414,416,418,420,422,424,426,428,430,432,434,436,438,440,442,445,448,450,452,454,457,460,462,464,466,469,471,473,475,477,479],"span",{"class":392,"line":393},"line",1,[390,395,397],{"class":396},"sbssI","INSERT INTO",[390,399,401],{"class":400},"sMK4o"," `",[390,403,281],{"class":404},"sfazB",[390,406,407],{"class":400},"`",[390,409,411],{"class":410},"sTEyZ"," (",[390,413,407],{"class":400},[390,415,309],{"class":404},[390,417,407],{"class":400},[390,419,261],{"class":410},[390,421,407],{"class":400},[390,423,323],{"class":404},[390,425,407],{"class":400},[390,427,261],{"class":410},[390,429,407],{"class":400},[390,431,346],{"class":404},[390,433,407],{"class":400},[390,435,261],{"class":410},[390,437,407],{"class":400},[390,439,356],{"class":404},[390,441,407],{"class":400},[390,443,444],{"class":410},") ",[390,446,447],{"class":396},"VALUES",[390,449,411],{"class":410},[390,451,315],{"class":396},[390,453,261],{"class":410},[390,455,456],{"class":400},"'",[390,458,459],{"class":404},"YOUR_LICENSE_HERE",[390,461,456],{"class":400},[390,463,261],{"class":410},[390,465,456],{"class":400},[390,467,468],{"class":404},"123456",[390,470,456],{"class":400},[390,472,261],{"class":410},[390,474,456],{"class":400},[390,476,362],{"class":404},[390,478,456],{"class":400},[390,480,481],{"class":410},");\n",[254,483,484],{},"Open your FiveNet instance in your browser, navigate to the registration page, and use the registration token to create your account.",[254,486,487,488,490,491,494,495,497,498,501],{},"Once registered, log in to FiveNet. If the ",[258,489,323],{}," value is correct, you should see any characters (",[258,492,493],{},"users"," table) associated with the ",[258,496,323],{},"\u002F",[258,499,500],{},"identifier",".",[243,503,505],{"id":504},"_2-install-the-fivenet-plugin-on-your-gameserver","2. Install the FiveNet Plugin on Your Gameserver",[239,507,508],{},"To connect FiveNet to your gameserver:",[510,511,512,521],"ul",{},[254,513,514,515,520],{},"Download the ",[263,516,519],{"href":517,"rel":518},"https:\u002F\u002Fgithub.com\u002Ffivenet-app\u002Fplugins\u002Ftree\u002Fmain\u002Ffivem\u002Ffivenet",[267],"FiveM Plugin code"," from GitHub.",[254,522,523],{},"Install and configure the plugin on your FiveM server.",[525,526,527,532],"callout",{},[239,528,529],{},[370,530,531],{},"Important:",[510,533,534,541],{},[254,535,536,537,540],{},"Read the ",[258,538,539],{},"README.md"," file of the plugin you install and follow the instructions to ensure optimal setup.",[254,542,543],{},"Add event triggers to your ESX plugins as required. Not all events collected by FiveNet are available in the standard ESX plugin code.",[239,545,546,547,501],{},"For additional details and step-by-step setup guidance, refer to the ",[263,548,550],{"href":549},"..\u002Fgameserver\u002Ffivem-plugin\u002Finstallation","plugin installation documentation",[243,552,554],{"id":553},"_3-configure-your-fivenet","3. Configure Your FiveNet",[239,556,557,558,561,562,565,566,569],{},"When logged in with a character selected, you must be able to enable superuser mode (controlled by config option ",[258,559,560],{},"auth.configAdminGroups"," and ",[258,563,564],{},"auth.configAdminUsers","), navigate to your \"FiveNet Settings\" (",[258,567,568],{},"\u002Fsettings\u002Fsettings"," URL path).",[239,571,572],{},"In there go over each tab and configure them to suit your servers' config, jobs and roleplay.",[239,574,575],{},"Some of the most important settings to configure here are:",[251,577,578,586],{},[254,579,580,581],{},"\"Jobs & Tracker\" Tab\n",[510,582,583],{},[254,584,585],{},"Make sure to select the correct unemployed job and grade.",[254,587,588,589],{},"\"Website\" Tab\n",[510,590,591],{},[254,592,593],{},"Make sure to set the URLs to your gameservers' privacy policy and imprint pages.",[595,596,597],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki spa