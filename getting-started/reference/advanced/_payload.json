ker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":93,"body":235,"description":600,"extension":601,"links":602,"meta":603,"navigation":604,"path":94,"redirect":602,"seo":605,"stem":95,"__hash__":606},"content_en\u002F1.getting-started\u002F7.reference\u002Fadvanced.md",{"type":236,"value":237,"toc":589},"minimark",[238,242,247,250,279,287,292,334,338,348,351,362,372,376,383,386,397,406,410,416,419,426,430,433,436,440,585],[239,240,241],"p",{},"Use this page when your FiveNet setup goes beyond the basic installation and required configuration options.",[243,244,246],"h2",{"id":245},"common-advanced-topics","Common Advanced Topics",[239,248,249],{},"The most common advanced configuration areas are:",[251,252,253,261,267,273],"ul",{},[254,255,256,260],"li",{},[257,258,259],"strong",{},"Trusted proxies"," when FiveNet runs behind NGINX, Traefik, Cloudflare, or another reverse proxy.",[254,262,263,266],{},[257,264,265],{},"Object storage"," when uploads should be stored in S3-compatible storage instead of the local filesystem.",[254,268,269,272],{},[257,270,271],{},"OAuth2 providers"," when users should be able to authenticate through external identity providers.",[254,274,275,278],{},[257,276,277],{},"Tracing and observability"," for debugging, performance analysis, and distributed request tracing.",[239,280,281,282,286],{},"For the most important option names and config paths, see the ",[283,284,97],"a",{"href":285},".\u002Fconfig-reference",".",[288,289,291],"h3",{"id":290},"tracing-notes","Tracing Notes",[251,293,294,302,309,327],{},[254,295,296,297,301],{},"Set ",[298,299,300],"code",{},"enabled: true"," only after you have a working OTLP endpoint.",[254,303,304,305,308],{},"Use a low ",[298,306,307],{},"ratio"," value in production unless you explicitly want to sample more traffic.",[254,310,311,312,315,316,319,320,323,324,286],{},"Keep the ",[298,313,314],{},"environment"," value aligned with the environment where FiveNet runs, such as ",[298,317,318],{},"development",", ",[298,321,322],{},"staging",", or ",[298,325,326],{},"production",[254,328,329,330,333],{},"Use ",[298,331,332],{},"attributes"," to attach additional metadata that helps identify traces in your observability platform.",[243,335,337],{"id":336},"reverse-proxy-and-trusted-proxies","Reverse Proxy and Trusted Proxies",[239,339,340,341,344,345,286],{},"If FiveNet is deployed behind one or more reverse proxies, review the ",[298,342,343],{},"http.trustedProxies"," option in your ",[298,346,347],{},"config.yaml",[239,349,350],{},"This is especially important when:",[251,352,353,356,359],{},[254,354,355],{},"client IP addresses should be preserved correctly",[254,357,358],{},"FiveNet is running behind NGINX, Traefik, or Cloudflare",[254,360,361],{},"you rely on forwarded headers from trusted infrastructure",[239,363,364,365,368,369,371],{},"See the ",[283,366,97],{"href":367},".\u002Fconfig-reference#http"," for the ",[298,370,343],{}," setting.",[243,373,375],{"id":374},"object-storage","Object Storage",[239,377,378,379,382],{},"By default, FiveNet stores uploads on the local filesystem. For more scalable or externally managed storage, you can switch to S3-compatible object storage through the ",[298,380,381],{},"storage"," configuration.",[239,384,385],{},"This is commonly useful when:",[251,387,388,391,394],{},[254,389,390],{},"running multiple instances",[254,392,393],{},"using cloud infrastructure",[254,395,396],{},"keeping uploaded files outside the application host",[239,398,364,399,368,402,405],{},[283,400,97],{"href":401},".\u002Fconfig-reference#storage",[298,403,404],{},"storage.type"," setting and related storage options.",[243,407,409],{"id":408},"oauth2-providers","OAuth2 Providers",[239,411,412,413,382],{},"FiveNet can be integrated with external authentication providers through the ",[298,414,415],{},"oauth2.providers",[239,417,418],{},"Use this when users should sign in through systems such as Discord or another OAuth2 or OpenID Connect provider instead of relying only on local authentication flows.",[239,420,364,421,368,424,371],{},[283,422,97],{"href":423},".\u002Fconfig-reference#oauth2",[298,425,415],{},[243,427,429],{"id":428},"tracing","Tracing",[239,431,432],{},"FiveNet supports OpenTelemetry-based tracing for the server and worker components. This can help you inspect request flow, background processing, and performance bottlenecks in more advanced environments.",[239,434,435],{},"Tracing is usually only needed when you already have an observability stack in place or when you are troubleshooting more complex issues.",[288,437,439],{"id":438},"example-tracing-configuration","Example Tracing Configuration",[441,442,447],"pre",{"className":443,"code":444,"language":445,"meta":446,"style":446},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","otlp:\n  enabled: false\n  # otlptracegrpc or otlptracehttp\n  type: \"otlptracegrpc\"\n  # OTLP tracing endpoint URL\n  url: \"https:\u002F\u002Fexample.com:4317\"\n  insecure: false\n  timeout: 10s\n  environment: \"production\"\n  ratio: 0.1\n  attributes:\n    - service.name=fivenet-server\n","yaml","",[298,448,449,462,475,482,500,506,521,531,542,556,568,576],{"__ignoreMap":446},[450,451,454,458],"span",{"class":452,"line":453},"line",1,[450,455,457],{"class":456},"swJcz","otlp",[450,459,461],{"class":460},"sMK4o",":\n",[450,463,465,468,471],{"class":452,"line":464},2,[450,466,467],{"class":456},"  enabled",[450,469,470],{"class":460},":",[450,472,474],{"class":473},"sfNiH"," false\n",[450,476,478],{"class":452,"line":477},3,[450,479,481],{"class":480},"sHwdD","  # otlptracegrpc or otlptracehttp\n",[450,483,485,488,490,493,497],{"class":452,"line":484},4,[450,486,487],{"class":456},"  type",[450,489,470],{"class":460},[450,491,492],{"class":460}," \"",[450,494,496],{"class":495},"sfazB","otlptracegrpc",[450,498,499],{"class":460},"\"\n",[450,501,503],{"class":452,"line":502},5,[450,504,505],{"class":480},"  # OTLP tracing endpoint URL\n",[450,507,509,512,514,516,519],{"class":452,"line":508},6,[450,510,511],{"class":456},"  url",[450,513,470],{"class":460},[450,515,492],{"class":460},[450,517,518],{"class":495},"https:\u002F\u002Fexample.com:4317",[450,520,499],{"class":460},[450,522,524,527,529],{"class":452,"line":523},7,[450,525,526],{"class":456},"  insecure",[450,528,470],{"class":460},[450,530,474],{"class":473},[450,532,534,537,539],{"class":452,"line":533},8,[450,535,536],{"class":456},"  timeout",[450,538,470],{"class":460},[450,540,541],{"class":495}," 10s\n",[450,543,545,548,550,552,554],{"class":452,"line":544},9,[450,546,547],{"class":456},"  environment",[450,549,470],{"class":460},[450,551,492],{"class":460},[450,553,326],{"class":495},[450,555,499],{"class":460},[450,557,559,562,564],{"class":452,"line":558},10,[450,560,561],{"class":456},"  ratio",[450,563,470],{"class":460},[450,565,567],{"class":566},"sbssI"," 0.1\n",[450,569,571,574],{"class":452,"line":570},11,[450,572,573],{"class":456},"  attributes",[450,575,461],{"class":460},[450,577,579,582],{"class":452,"line":578},12,[450,580,581],{"class":460},"    -",[450,583,584],{"class":495}," service.name=fivenet-server\n",[586,587,588],"style",{},"html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-d