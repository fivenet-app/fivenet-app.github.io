t_en\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md","Database Setup",{"type":204,"value":205,"toc":563},"minimark",[206,210,215,227,230,244,248,251,317,320,343,347,364,367,388,391,409,415,419,422,425,433,436,440,454,539,547,551,559],[207,208,209],"p",{},"Understand the database defaults FiveNet expects and how to avoid common collation-related migration issues.",[211,212,214],"h2",{"id":213},"charset-and-collation","Charset and Collation",[207,216,217,218,222,223,226],{},"Make sure the ",[219,220,221],"strong",{},"charset"," and ",[219,224,225],{},"collation"," of your database, tables, and columns are consistent.",[207,228,229],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[231,232,233],"callout",{},[207,234,235,236,240,241],{},"Recommended collation: ",[237,238,239],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[237,242,243],{},"utf8mb4",[211,245,247],{"id":246},"check-the-current-database-settings","Check the Current Database Settings",[207,249,250],{},"Use the following queries to inspect the current charset and collation:",[252,253,258],"pre",{"className":254,"code":255,"language":256,"meta":257,"style":257},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[237,259,260,284,304],{"__ignoreMap":257},[261,262,265,269,273,277,280],"span",{"class":263,"line":264},"line",1,[261,266,268],{"class":267},"sbssI","USE",[261,270,272],{"class":271},"sMK4o"," `",[261,274,276],{"class":275},"sfazB","__YOUR_DATABASE_NAME_HERE__",[261,278,279],{"class":271},"`",[261,281,283],{"class":282},"sTEyZ",";\n",[261,285,287,290,293,296,298,300,302],{"class":263,"line":286},2,[261,288,289],{"class":282},"SHOW ",[261,291,292],{"class":267},"CREATE",[261,294,295],{"class":267}," DATABASE",[261,297,272],{"class":271},[261,299,276],{"class":275},[261,301,279],{"class":271},[261,303,283],{"class":282},[261,305,307,309,312,315],{"class":263,"line":306},3,[261,308,289],{"class":282},[261,310,311],{"class":267},"TABLE",[261,313,314],{"class":267}," STATUS",[261,316,283],{"class":282},[207,318,319],{},"If you also want to inspect column-level collations, review the table definitions directly:",[252,321,323],{"className":254,"code":322,"language":256,"meta":257,"style":257},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[237,324,325],{"__ignoreMap":257},[261,326,327,329,331,334,336,339,341],{"class":263,"line":264},[261,328,289],{"class":282},[261,330,292],{"class":267},[261,332,333],{"class":267}," TABLE",[261,335,272],{"class":271},[261,337,338],{"class":275},"__YOUR_TABLE_NAME_HERE__",[261,340,279],{"class":271},[261,342,283],{"class":282},[211,344,346],{"id":345},"fixing-collation-mismatches","Fixing Collation Mismatches",[207,348,349,350,352,353,355,356,363],{},"A useful guide for converting tables to ",[237,351,243],{},"\u002F",[237,354,239],{}," in MySQL 5.5 can be found on the ",[357,358,362],"a",{"href":359,"rel":360},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[361],"nofollow","Database Administrators Stack Exchange",".",[207,365,366],{},"Before running generated conversion queries, disable foreign key checks:",[252,368,370],{"className":254,"code":369,"language":256,"meta":257,"style":257},"SET foreign_key_checks = 0;\n",[237,371,372],{"__ignoreMap":257},[261,373,374,377,380,383,386],{"class":263,"line":264},[261,375,376],{"class":267},"SET",[261,378,379],{"class":282}," foreign_key_checks ",[261,381,382],{"class":271},"=",[261,384,385],{"class":267}," 0",[261,387,283],{"class":282},[207,389,390],{},"After the conversion is complete, enable them again:",[252,392,394],{"className":254,"code":393,"language":256,"meta":257,"style":257},"SET foreign_key_checks = 1;\n",[237,395,396],{"__ignoreMap":257},[261,397,398,400,402,404,407],{"class":263,"line":264},[261,399,376],{"class":267},[261,401,379],{"class":282},[261,403,382],{"class":271},[261,405,406],{"class":267}," 1",[261,408,283],{"class":282},[410,411,412],"warning",{},[207,413,414],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[211,416,418],{"id":417},"dsn-collation","DSN Collation",[207,420,421],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[207,423,424],{},"Example:",[252,426,431],{"className":427,"code":429,"language":430,"meta":257},[428],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[237,432,429],{"__ignoreMap":257},[207,434,435],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[211,437,439],{"id":438},"creating-a-database-user","Creating a Database User",[207,441,442,443,446,447,222,450,453],{},"Below are sample queries to create a database user named ",[237,444,445],{},"fivenet"," with full access to a specific database. Replace ",[237,448,449],{},"password",[237,451,452],{},"database_name"," with your actual values before using them.",[252,455,457],{"className":254,"code":456,"language":256,"meta":257,"style":257},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[237,458,459,497],{"__ignoreMap":257},[261,460,461,463,466,469,472,475,478,481,483,486,489,491,493,495],{"class":263,"line":264},[261,462,292],{"class":267},[261,464,465],{"class":267}," USER",[261,467,468],{"class":282}," '",[261,470,445],{"class":471},"s2Zo4",[261,473,474],{"class":282},"'@",[261,476,477],{"class":271},"'",[261,479,480],{"class":275},"%",[261,482,477],{"class":271},[261,484,485],{"class":282}," IDENTIFIED ",[261,487,488],{"class":267},"BY",[261,490,468],{"class":271},[261,492,449],{"class":275},[261,494,477],{"class":271},[261,496,283],{"class":282},[261,498,499,502,505,508,510,512,514,516,519,522,524,526,528,531,533,535,537],{"class":263,"line":286},[261,500,501],{"class":267},"GRANT",[261,503,504],{"class":282}," ALL PRIVILEGES ",[261,506,507],{"class":267},"ON",[261,509,272],{"class":271},[261,511,452],{"class":275},[261,513,279],{"class":271},[261,515,363],{"class":282},[261,517,518],{"class":271},"*",[261,520,521],{"class":267}," TO",[261,523,468],{"class":271},[261,525,445],{"class":275},[261,527,477],{"class":271},[261,529,530],{"class":282},"@",[261,532,477],{"class":271},[261,534,480],{"class":275},[261,536,477],{"class":271},[261,538,283],{"class":282},[207,540,541,542,546],{},"For a separate DBSync source user, read-only access is usually enough. See ",[357,543,545],{"href":544},"\u002Fgetting-started\u002Fconfiguration\u002Fdbsync","DBSync"," for an example of a dedicated read-only user.",[211,548,550],{"id":549},"recommended-tools","Recommended Tools",[207,552,553,558],{},[357,554,557],{"href":555,"rel":556},"https:\u002F\u002Fdbeaver.io\u002F",[361],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[560,561,562],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-