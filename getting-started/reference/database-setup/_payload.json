Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":101,"body":235,"description":241,"extension":602,"links":603,"meta":604,"navigation":605,"path":102,"redirect":603,"seo":606,"stem":103,"__hash__":607},"content_en\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md",{"type":236,"value":237,"toc":594},"minimark",[238,242,247,259,262,276,280,283,349,352,375,379,396,399,420,423,441,447,451,454,457,465,468,472,486,571,578,582,590],[239,240,241],"p",{},"Understand the database defaults FiveNet expects and how to avoid common collation-related migration issues.",[243,244,246],"h2",{"id":245},"charset-and-collation","Charset and Collation",[239,248,249,250,254,255,258],{},"Make sure the ",[251,252,253],"strong",{},"charset"," and ",[251,256,257],{},"collation"," of your database, tables, and columns are consistent.",[239,260,261],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[263,264,265],"callout",{},[239,266,267,268,272,273],{},"Recommended collation: ",[269,270,271],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[269,274,275],{},"utf8mb4",[243,277,279],{"id":278},"check-the-current-database-settings","Check the Current Database Settings",[239,281,282],{},"Use the following queries to inspect the current charset and collation:",[284,285,290],"pre",{"className":286,"code":287,"language":288,"meta":289,"style":289},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[269,291,292,316,336],{"__ignoreMap":289},[293,294,297,301,305,309,312],"span",{"class":295,"line":296},"line",1,[293,298,300],{"class":299},"sbssI","USE",[293,302,304],{"class":303},"sMK4o"," `",[293,306,308],{"class":307},"sfazB","__YOUR_DATABASE_NAME_HERE__",[293,310,311],{"class":303},"`",[293,313,315],{"class":314},"sTEyZ",";\n",[293,317,319,322,325,328,330,332,334],{"class":295,"line":318},2,[293,320,321],{"class":314},"SHOW ",[293,323,324],{"class":299},"CREATE",[293,326,327],{"class":299}," DATABASE",[293,329,304],{"class":303},[293,331,308],{"class":307},[293,333,311],{"class":303},[293,335,315],{"class":314},[293,337,339,341,344,347],{"class":295,"line":338},3,[293,340,321],{"class":314},[293,342,343],{"class":299},"TABLE",[293,345,346],{"class":299}," STATUS",[293,348,315],{"class":314},[239,350,351],{},"If you also want to inspect column-level collations, review the table definitions directly:",[284,353,355],{"className":286,"code":354,"language":288,"meta":289,"style":289},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[269,356,357],{"__ignoreMap":289},[293,358,359,361,363,366,368,371,373],{"class":295,"line":296},[293,360,321],{"class":314},[293,362,324],{"class":299},[293,364,365],{"class":299}," TABLE",[293,367,304],{"class":303},[293,369,370],{"class":307},"__YOUR_TABLE_NAME_HERE__",[293,372,311],{"class":303},[293,374,315],{"class":314},[243,376,378],{"id":377},"fixing-collation-mismatches","Fixing Collation Mismatches",[239,380,381,382,384,385,387,388,395],{},"A useful guide for converting tables to ",[269,383,275],{},"\u002F",[269,386,271],{}," in MySQL 5.5 can be found on the ",[389,390,394],"a",{"href":391,"rel":392},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[393],"nofollow","Database Administrators Stack Exchange",".",[239,397,398],{},"Before running generated conversion queries, disable foreign key checks:",[284,400,402],{"className":286,"code":401,"language":288,"meta":289,"style":289},"SET foreign_key_checks = 0;\n",[269,403,404],{"__ignoreMap":289},[293,405,406,409,412,415,418],{"class":295,"line":296},[293,407,408],{"class":299},"SET",[293,410,411],{"class":314}," foreign_key_checks ",[293,413,414],{"class":303},"=",[293,416,417],{"class":299}," 0",[293,419,315],{"class":314},[239,421,422],{},"After the conversion is complete, enable them again:",[284,424,426],{"className":286,"code":425,"language":288,"meta":289,"style":289},"SET foreign_key_checks = 1;\n",[269,427,428],{"__ignoreMap":289},[293,429,430,432,434,436,439],{"class":295,"line":296},[293,431,408],{"class":299},[293,433,411],{"class":314},[293,435,414],{"class":303},[293,437,438],{"class":299}," 1",[293,440,315],{"class":314},[442,443,444],"warning",{},[239,445,446],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[243,448,450],{"id":449},"dsn-collation","DSN Collation",[239,452,453],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[239,455,456],{},"Example:",[284,458,463],{"className":459,"code":461,"language":462,"meta":289},[460],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[269,464,461],{"__ignoreMap":289},[239,466,467],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[243,469,471],{"id":470},"creating-a-database-user","Creating a Database User",[239,473,474,475,478,479,254,482,485],{},"Below are sample queries to create a database user named ",[269,476,477],{},"fivenet"," with full access to a specific database. Replace ",[269,480,481],{},"password",[269,483,484],{},"database_name"," with your actual values before using them.",[284,487,489],{"className":286,"code":488,"language":288,"meta":289,"style":289},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[269,490,491,529],{"__ignoreMap":289},[293,492,493,495,498,501,504,507,510,513,515,518,521,523,525,527],{"class":295,"line":296},[293,494,324],{"class":299},[293,496,497],{"class":299}," USER",[293,499,500],{"class":314}," '",[293,502,477],{"class":503},"s2Zo4",[293,505,506],{"class":314},"'@",[293,508,509],{"class":303},"'",[293,511,512],{"class":307},"%",[293,514,509],{"class":303},[293,516,517],{"class":314}," IDENTIFIED ",[293,519,520],{"class":299},"BY",[293,522,500],{"class":303},[293,524,481],{"class":307},[293,526,509],{"class":303},[293,528,315],{"class":314},[293,530,531,534,537,540,542,544,546,548,551,554,556,558,560,563,565,567,569],{"class":295,"line":318},[293,532,533],{"class":299},"GRANT",[293,535,536],{"class":314}," ALL PRIVILEGES ",[293,538,539],{"class":299},"ON",[293,541,304],{"class":303},[293,543,484],{"class":307},[293,545,311],{"class":303},[293,547,395],{"class":314},[293,549,550],{"class":303},"*",[293,552,553],{"class":299}," TO",[293,555,500],{"class":303},[293,557,477],{"class":307},[293,559,509],{"class":303},[293,561,562],{"class":314},"@",[293,564,509],{"class":303},[293,566,512],{"class":307},[293,568,509],{"class":303},[293,570,315],{"class":314},[239,572,573,574,577],{},"For a separate DBSync source user, read-only access is usually enough. See ",[389,575,576],{"href":68},"DBSync"," for an example of a dedicated read-only user.",[243,579,581],{"id":580},"recommended-tools","Recommended Tools",[239,583,584,589],{},[389,585,588],{"href":586,"rel":587},"https:\u002F\u002Fdbeaver.io\u002F",[393],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[591,592,593],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki s