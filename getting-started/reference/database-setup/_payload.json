"path":221,"stem":222},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":164,"path":224,"stem":225},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":227,"path":228,"stem":229},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":231,"path":232,"stem":233},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":235,"path":236,"stem":237},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":239,"title":109,"body":240,"description":246,"extension":607,"links":608,"meta":609,"navigation":610,"path":110,"redirect":608,"seo":611,"stem":111,"__hash__":612},"content_en\u002F1.getting-started\u002F7.reference\u002Fdatabase-setup.md",{"type":241,"value":242,"toc":599},"minimark",[243,247,252,264,267,281,285,288,354,357,380,384,401,404,425,428,446,452,456,459,462,470,473,477,491,576,583,587,595],[244,245,246],"p",{},"Understand the database defaults FiveNet expects and how to avoid common collation-related migration issues.",[248,249,251],"h2",{"id":250},"charset-and-collation","Charset and Collation",[244,253,254,255,259,260,263],{},"Make sure the ",[256,257,258],"strong",{},"charset"," and ",[256,261,262],{},"collation"," of your database, tables, and columns are consistent.",[244,265,266],{},"Collation mismatches are one of the most common reasons for FiveNet database migrations to fail, especially after moving databases between servers or importing older dumps.",[268,269,270],"callout",{},[244,271,272,273,277,278],{},"Recommended collation: ",[274,275,276],"code",{},"utf8mb4_unicode_ci","\nRecommended charset: ",[274,279,280],{},"utf8mb4",[248,282,284],{"id":283},"check-the-current-database-settings","Check the Current Database Settings",[244,286,287],{},"Use the following queries to inspect the current charset and collation:",[289,290,295],"pre",{"className":291,"code":292,"language":293,"meta":294,"style":294},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","USE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW CREATE DATABASE `__YOUR_DATABASE_NAME_HERE__`;\nSHOW TABLE STATUS;\n","sql","",[274,296,297,321,341],{"__ignoreMap":294},[298,299,302,306,310,314,317],"span",{"class":300,"line":301},"line",1,[298,303,305],{"class":304},"sbssI","USE",[298,307,309],{"class":308},"sMK4o"," `",[298,311,313],{"class":312},"sfazB","__YOUR_DATABASE_NAME_HERE__",[298,315,316],{"class":308},"`",[298,318,320],{"class":319},"sTEyZ",";\n",[298,322,324,327,330,333,335,337,339],{"class":300,"line":323},2,[298,325,326],{"class":319},"SHOW ",[298,328,329],{"class":304},"CREATE",[298,331,332],{"class":304}," DATABASE",[298,334,309],{"class":308},[298,336,313],{"class":312},[298,338,316],{"class":308},[298,340,320],{"class":319},[298,342,344,346,349,352],{"class":300,"line":343},3,[298,345,326],{"class":319},[298,347,348],{"class":304},"TABLE",[298,350,351],{"class":304}," STATUS",[298,353,320],{"class":319},[244,355,356],{},"If you also want to inspect column-level collations, review the table definitions directly:",[289,358,360],{"className":291,"code":359,"language":293,"meta":294,"style":294},"SHOW CREATE TABLE `__YOUR_TABLE_NAME_HERE__`;\n",[274,361,362],{"__ignoreMap":294},[298,363,364,366,368,371,373,376,378],{"class":300,"line":301},[298,365,326],{"class":319},[298,367,329],{"class":304},[298,369,370],{"class":304}," TABLE",[298,372,309],{"class":308},[298,374,375],{"class":312},"__YOUR_TABLE_NAME_HERE__",[298,377,316],{"class":308},[298,379,320],{"class":319},[248,381,383],{"id":382},"fixing-collation-mismatches","Fixing Collation Mismatches",[244,385,386,387,389,390,392,393,400],{},"A useful guide for converting tables to ",[274,388,280],{},"\u002F",[274,391,276],{}," in MySQL 5.5 can be found on the ",[394,395,399],"a",{"href":396,"rel":397},"https:\u002F\u002Fdba.stackexchange.com\u002Fa\u002F104866",[398],"nofollow","Database Administrators Stack Exchange",".",[244,402,403],{},"Before running generated conversion queries, disable foreign key checks:",[289,405,407],{"className":291,"code":406,"language":293,"meta":294,"style":294},"SET foreign_key_checks = 0;\n",[274,408,409],{"__ignoreMap":294},[298,410,411,414,417,420,423],{"class":300,"line":301},[298,412,413],{"class":304},"SET",[298,415,416],{"class":319}," foreign_key_checks ",[298,418,419],{"class":308},"=",[298,421,422],{"class":304}," 0",[298,424,320],{"class":319},[244,426,427],{},"After the conversion is complete, enable them again:",[289,429,431],{"className":291,"code":430,"language":293,"meta":294,"style":294},"SET foreign_key_checks = 1;\n",[274,432,433],{"__ignoreMap":294},[298,434,435,437,439,441,444],{"class":300,"line":301},[298,436,413],{"class":304},[298,438,416],{"class":319},[298,440,419],{"class":308},[298,442,443],{"class":304}," 1",[298,445,320],{"class":319},[447,448,449],"warning",{},[244,450,451],{},"Disabling foreign key checks can lead to data integrity issues if not handled carefully. Proceed with caution.",[248,453,455],{"id":454},"dsn-collation","DSN Collation",[244,457,458],{},"The collation in your FiveNet database DSN should match the collation used by your database server and tables.",[244,460,461],{},"Example:",[289,463,468],{"className":464,"code":466,"language":467,"meta":294},[465],"language-text","DB_USER:DB_PASS@tcp(DB_HOST:DB_PORT)\u002FDB_NAME?collation=utf8mb4_unicode_ci&parseTime=True&loc=Europe%2FBerlin\n","text",[274,469,466],{"__ignoreMap":294},[244,471,472],{},"If your DSN uses a different collation than the actual database, migrations or queries may fail.",[248,474,476],{"id":475},"creating-a-database-user","Creating a Database User",[244,478,479,480,483,484,259,487,490],{},"Below are sample queries to create a database user named ",[274,481,482],{},"fivenet"," with full access to a specific database. Replace ",[274,485,486],{},"password",[274,488,489],{},"database_name"," with your actual values before using them.",[289,492,494],{"className":291,"code":493,"language":293,"meta":294,"style":294},"CREATE USER 'fivenet'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON `database_name`.* TO 'fivenet'@'%';\n",[274,495,496,534],{"__ignoreMap":294},[298,497,498,500,503,506,509,512,515,518,520,523,526,528,530,532],{"class":300,"line":301},[298,499,329],{"class":304},[298,501,502],{"class":304}," USER",[298,504,505],{"class":319}," '",[298,507,482],{"class":508},"s2Zo4",[298,510,511],{"class":319},"'@",[298,513,514],{"class":308},"'",[298,516,517],{"class":312},"%",[298,519,514],{"class":308},[298,521,522],{"class":319}," IDENTIFIED ",[298,524,525],{"class":304},"BY",[298,527,505],{"class":308},[298,529,486],{"class":312},[298,531,514],{"class":308},[298,533,320],{"class":319},[298,535,536,539,542,545,547,549,551,553,556,559,561,563,565,568,570,572,574],{"class":300,"line":323},[298,537,538],{"class":304},"GRANT",[298,540,541],{"class":319}," ALL PRIVILEGES ",[298,543,544],{"class":304},"ON",[298,546,309],{"class":308},[298,548,489],{"class":312},[298,550,316],{"class":308},[298,552,400],{"class":319},[298,554,555],{"class":308},"*",[298,557,558],{"class":304}," TO",[298,560,505],{"class":308},[298,562,482],{"class":312},[298,564,514],{"class":308},[298,566,567],{"class":319},"@",[298,569,514],{"class":308},[298,571,517],{"class":312},[298,573,514],{"class":308},[298,575,320],{"class":319},[244,577,578,579,582],{},"For a separate DBSync source user, read-only access is usually enough. See ",[394,580,581],{"href":79},"DBSync"," for an example of a dedicated read-only user.",[248,584,586],{"id":585},"recommended-tools","Recommended Tools",[244,588,589,594],{},[394,590,593],{"href":591,"rel":592},"https:\u002F\u002Fdbeaver.io\u002F",[398],"DBeaver"," is a good general-purpose database management tool if you prefer a GUI for inspecting schemas, collations, and data.",[596,597,598],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--