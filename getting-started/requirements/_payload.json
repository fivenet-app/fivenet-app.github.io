.documents\u002Ftemplates",{"title":146,"path":147,"stem":148},"Jobs","\u002Fde\u002Fuser-guides\u002Fjobs","de\u002F3.user-guides\u002F3.jobs",{"title":150,"path":151,"stem":152},"Kalender","\u002Fde\u002Fuser-guides\u002Fcalendar","de\u002F3.user-guides\u002F4.calendar",{"title":154,"path":155,"stem":156},"Livemap","\u002Fde\u002Fuser-guides\u002Flivemap","de\u002F3.user-guides\u002F5.livemap",{"title":158,"path":159,"stem":160},"Einsatzzentrale","\u002Fde\u002Fuser-guides\u002Fcentrum","de\u002F3.user-guides\u002F6.centrum",{"title":162,"path":163,"stem":164},"Mailer","\u002Fde\u002Fuser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":166,"path":167,"stem":168},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":170,"path":171,"stem":172},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":174,"path":175,"stem":176},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":178,"path":179,"stem":180},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":182,"path":183,"stem":184,"children":185},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[186,187,191],{"title":182,"path":183,"stem":184},{"title":188,"path":189,"stem":190},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":170,"path":192,"stem":193},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":195,"path":196,"stem":197,"children":198},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[199],{"title":195,"path":196,"stem":197},{"id":201,"title":202,"body":203,"description":506,"extension":507,"links":508,"meta":509,"navigation":510,"path":511,"redirect":508,"seo":512,"stem":513,"__hash__":514},"content_en\u002F1.getting-started\u002F2.requirements.md","Requirements",{"type":204,"value":205,"toc":490},"minimark",[206,227,232,235,267,271,276,305,309,346,350,366,370,374,400,404,450,457,477,481],[207,208,210],"callout",{"icon":209},"i-mdi-check-circle-outline",[211,212,213,214,218,219,222,223,226],"p",{},"You need a MySQL-compatible database, a NATS server with JetStream, storage for uploads, and a reverse proxy with HTTPS. As a rough baseline, plan for at least ",[215,216,217],"strong",{},"0.5 CPU core",", ",[215,220,221],{},"512 MB RAM",", and ",[215,224,225],{},"1 GB disk space",".",[228,229,231],"h2",{"id":230},"supported-platforms","Supported Platforms",[211,233,234],{},"FiveNet is available on:",[236,237,238,251],"ul",{},[239,240,241,242],"li",{},"Windows (only the latest version of Windows Server and Windows 11 are supported)\n",[236,243,244],{},[239,245,246,250],{},[247,248,249],"code",{},"amd64"," - Your typical Windows server will run on this architecture.",[239,252,253,254],{},"Linux\n",[236,255,256,261],{},[239,257,258,260],{},[247,259,249],{}," - Your typical Linux server will run on this architecture.",[239,262,263,266],{},[247,264,265],{},"arm64"," - The newer 64-bit ARM architecture commonly found in Raspberry Pi 4 and other ARM-based servers.",[228,268,270],{"id":269},"required-services","Required Services",[272,273,275],"h3",{"id":274},"database","Database",[236,277,278,294,302],{},[239,279,280,281,288,289,226],{},"Use ",[282,283,287],"a",{"href":284,"rel":285},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002F",[286],"nofollow","MySQL 8.4+"," or ",[282,290,293],{"href":291,"rel":292},"https:\u002F\u002Fmariadb.com\u002Fkb\u002Fen\u002Fwhat-is-mariadb-114\u002F",[286],"MariaDB 11.4+",[239,295,296,301],{},[282,297,300],{"href":298,"rel":299},"https:\u002F\u002Fdev.mysql.com\u002Fdoc\u002Frefman\u002F8.4\u002Fen\u002Ffulltext-search.html",[286],"Fulltext search"," must be available.",[239,303,304],{},"Older versions may still work, but they are not officially supported.",[272,306,308],{"id":307},"message-queue","Message Queue",[236,310,311,320,326,334],{},[239,312,313,314,319],{},"Run ",[282,315,318],{"href":316,"rel":317},"https:\u002F\u002Fnats.io\u002F",[286],"NATS server"," in single-server or clustered mode.",[239,321,322,323],{},"Required version: ",[215,324,325],{},"NATS 2.11.3+",[239,327,328,333],{},[282,329,332],{"href":330,"rel":331},"https:\u002F\u002Fdocs.nats.io\u002Fnats-concepts\u002Fjetstream",[286],"JetStream"," must be enabled.",[239,335,336,341,342,345],{},[282,337,340],{"href":338,"rel":339},"https:\u002F\u002Fdocs.nats.io\u002Frunning-a-nats-service\u002Fconfiguration#jetstream-server-settings",[286],"JetStream memory storage"," should have at least ",[215,343,344],{},"10-20 MB"," available.",[272,347,349],{"id":348},"storage","Storage",[236,351,352,355,358],{},[239,353,354],{},"Use either a local directory or S3-compatible bucket storage.",[239,356,357],{},"Storage is used for avatars, faction\u002Fjob logos, and uploaded files.",[239,359,360,361,226],{},"For S3, the bucket needs at least read and write access.\nSee this ",[282,362,365],{"href":363,"rel":364},"https:\u002F\u002Fdocs.aws.amazon.com\u002FIAM\u002Flatest\u002FUserGuide\u002Freference_policies_examples_s3_rw-bucket.html",[286],"example AWS S3 policy",[228,367,369],{"id":368},"network-requirements","Network Requirements",[272,371,373],{"id":372},"public-url-and-https","Public URL and HTTPS",[236,375,376,382,385,388,391],{},[239,377,378,379,226],{},"Use a publicly reachable domain or subdomain such as ",[247,380,381],{},"https:\u002F\u002Ffivenet.example.com",[239,383,384],{},"Point that domain to the server or reverse proxy that fronts your FiveNet instance.",[239,386,387],{},"Use a valid HTTPS certificate.",[239,389,390],{},"If you use Cloudflare Tunnel, Cloudflare can terminate HTTPS for you.",[239,392,393,394,399],{},"If you manage HTTPS yourself, ",[282,395,398],{"href":396,"rel":397},"https:\u002F\u002Fletsencrypt.org\u002F",[286],"Let's Encrypt"," is a good free option.",[272,401,403],{"id":402},"reverse-proxy","Reverse Proxy",[236,405,406,416,421,428,431],{},[239,407,408,409,412,413,226],{},"Your reverse proxy must support ",[215,410,411],{},"HTTP\u002F2"," and ",[215,414,415],{},"WebSockets",[239,417,418],{},[215,419,420],{},"DBSync is required.",[239,422,423,424,427],{},"Your reverse proxy only needs to support ",[215,425,426],{},"gRPC"," if DBSync or FiveNet plugin traffic passes through it.",[239,429,430],{},"HTTPS should be terminated at the reverse proxy before traffic is forwarded to FiveNet.",[239,432,433,434],{},"Known working options:\n",[236,435,436,443],{},[239,437,438],{},[282,439,442],{"href":440,"rel":441},"https:\u002F\u002Fwww.nginx.com\u002F",[286],"NGINX",[239,444,445],{},[282,446,449],{"href":447,"rel":448},"https:\u002F\u002Fdoc.traefik.io\u002Ftraefik\u002F",[286],"Traefik",[207,451,454],{"icon":452,"color":453},"i-mdi-lightbulb-on-outline","info",[211,455,456],{},"If FiveNet and DBSync run on the same host, you may not need gRPC support in the reverse proxy at all. If the FiveNet plugin or DBSync component connects through the proxy, it is recommended to use a separate subdomain for that gRPC traffic.",[211,458,459,460,463,464,467,468,471,472,226],{},"For ",[282,461,442],{"href":440,"rel":462},[286],", make sure ",[247,465,466],{},"http2"," is enabled in the ",[247,469,470],{},"listen"," directive and follow the ",[282,473,476],{"href":474,"rel":475},"https:\u002F\u002Fnginx.org\u002Fen\u002Fdocs\u002Fhttp\u002Fwebsocket.html",[286],"official WebSocket proxying guide",[228,478,480],{"id":479},"optional-requirements","Optional Requirements",[236,482,483],{},[239,484,485,489],{},[282,486,488],{"href":487},"\u002Fgetting-started\u002Freference\u002Fadvanced#tracing","Tracing",": OpenTelemetry-based tracing is available for the FiveNet server and worker components. It is useful for troubleshooting and performance monitoring.",{"title":491,"searchDepth":492,"depth":492,"links":493},"",2,[494,495,501,505],{"id":230,"depth":492,"text":231},{"id":269,"depth":492,"text":270,"children":496},[497,499,500],{"id":274,"depth":498,"text":275},3,{"id":307,"depth":498,"text":308},{"id":348,"depth":498,"text":349},{"id":368,"depth":492,"text":369,"children":502},[503,504],{"id":372,"depth":498,"text":373},{"id":402,"depth":498,"text":403},{"id":479,"depth":492,"text":480},"Infrastructure and software requirements for running FiveNet.","md",null,{},true,"\u002Fgetting-started\u002Frequirements",{"title":202,"description":506},"1.getting-started\u002F2.requirements","jay5YlYEbFq3cujPzdRkuNIUSjzF9TJwPQHzWsMDnTY",[516,520],{"title":15,"path":517,"stem":518,"description":519,"children":-1},"\u002Fgetting-started\u002Fdemo","1.getting-started\u002F2.demo","Try FiveNet using the public demo instance.",{"title":521,"path":522,"stem":523,"description":524,"children":-1},"Components","\u002Fgetting-started\u002Fcomponents","1.getting-started\u002F3.components","Overview of the main FiveNet components and how they interact.",1789078702482]