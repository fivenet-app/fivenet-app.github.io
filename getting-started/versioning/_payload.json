rotobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":173,"path":174,"stem":175},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":177,"path":178,"stem":179},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":181,"stem":182},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":184,"path":185,"stem":186,"children":187},"Design Docs","\u002Fdesign","9.design\u002F1.index",[188,190,194,198,201,205,209],{"title":189,"path":185,"stem":186},"Designs",{"title":191,"path":192,"stem":193},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":195,"path":196,"stem":197},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":199,"stem":200},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":202,"path":203,"stem":204},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":206,"path":207,"stem":208},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":210,"path":211,"stem":212},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":214,"title":28,"body":215,"description":571,"extension":572,"links":573,"meta":574,"navigation":575,"path":29,"redirect":573,"seo":576,"stem":30,"__hash__":577},"content_en\u002F1.getting-started\u002F3.versioning.md",{"type":216,"value":217,"toc":563},"minimark",[218,232,235,251,256,259,269,272,278,298,304,324,328,331,337,340,346,365,371,375,378,385,388,396,399,403,421,425,428,440,443,447,559],[219,220,221,222,226,227,231],"p",{},"FiveNet uses ",[223,224,225],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[228,229,230],"code",{},"1.2.3",".",[219,233,234],{},"You will usually see one of these two formats:",[236,237,238,245],"ul",{},[239,240,241,242],"li",{},"Release version: ",[228,243,244],{},"v2026.3.1",[239,246,247,248],{},"Development version: ",[228,249,250],{},"v2026.3.1-55-g07bf5c8e5",[252,253,255],"h2",{"id":254},"release-version","Release Version",[219,257,258],{},"A full release version looks like this:",[260,261,267],"pre",{"className":262,"code":264,"language":265,"meta":266},[263],"language-text","v2026.3.1\n","text","",[228,268,264],{"__ignoreMap":266},[219,270,271],{},"This format is:",[260,273,276],{"className":274,"code":275,"language":265,"meta":266},[263],"vYYYY.M.P\n",[228,277,275],{"__ignoreMap":266},[236,279,280,286,292],{},[239,281,282,285],{},[228,283,284],{},"YYYY"," = release year",[239,287,288,291],{},[228,289,290],{},"M"," = release month",[239,293,294,297],{},[228,295,296],{},"P"," = patch or revision number for that month",[219,299,300,301,303],{},"In the example ",[228,302,244],{},":",[236,305,306,312,318],{},[239,307,308,311],{},[228,309,310],{},"2026"," means the year 2026",[239,313,314,317],{},[228,315,316],{},"3"," means March",[239,319,320,323],{},[228,321,322],{},"1"," means the first release published for that month",[252,325,327],{"id":326},"development-version","Development Version",[219,329,330],{},"A development version looks like this:",[260,332,335],{"className":333,"code":334,"language":265,"meta":266},[263],"v2026.3.1-55-g07bf5c8e5\n",[228,336,334],{"__ignoreMap":266},[219,338,339],{},"This is based on the same release version, but with extra Git metadata appended:",[260,341,344],{"className":342,"code":343,"language":265,"meta":266},[263],"vYYYY.M.P-COMMITS-gHASH\n",[228,345,343],{"__ignoreMap":266},[236,347,348,353,359],{},[239,349,350,352],{},[228,351,244],{}," = the nearest release tag the build is based on",[239,354,355,358],{},[228,356,357],{},"55"," = the build contains 55 commits after that tag",[239,360,361,364],{},[228,362,363],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[219,366,367,368,370],{},"In practice, this means the build was created from code that is newer than the ",[228,369,244],{}," release, but not yet published as the next full release tag.",[252,372,374],{"id":373},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[219,376,377],{},"Not necessarily.",[219,379,380,381,384],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[223,382,383],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[219,386,387],{},"The main difference is version labeling:",[236,389,390,393],{},[239,391,392],{},"A release version is a tagged, full release.",[239,394,395],{},"A development version is a build from a specific Git commit after the last tagged release.",[219,397,398],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[252,400,402],{"id":401},"quick-examples","Quick Examples",[236,404,405,410],{},[239,406,407,409],{},[228,408,244],{},"\nThe first tagged release from March 2026.",[239,411,412,414,415,417,418,231],{},[228,413,250],{},"\nA build from 55 commits after ",[228,416,244],{},", based on commit ",[228,419,420],{},"07bf5c8e5",[252,422,424],{"id":423},"summary","Summary",[219,426,427],{},"If you only remember one thing, it is this:",[429,430,432],"callout",{"icon":431},"i-mdi-information-outline",[219,433,434,436,437,439],{},[228,435,244],{}," is a tagged release, while ",[228,438,250],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[441,442],"hr",{},[252,444,446],{"id":445},"how-to-check-your-version","How to Check Your Version",[448,449,450,489,523,541],"code-group",{},[260,451,456],{"className":452,"code":453,"filename":454,"language":455,"meta":266,"style":266},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[228,457,458,467],{"__ignoreMap":266},[459,460,463],"span",{"class":461,"line":462},"line",1,[459,464,466],{"class":465},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[459,468,470,474,478,481,484,486],{"class":461,"line":469},2,[459,471,473],{"class":472},"sBMFI","docker",[459,475,477],{"class":476},"sfazB"," compose",[459,479,480],{"class":476}," exec",[459,482,483],{"class":476}," fivenet",[459,485,483],{"class":476},[459,487,488],{"class":476}," --version\n",[260,490,493],{"className":452,"code":491,"filename":492,"language":455,"meta":266,"style":266},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[228,494,495,500,517],{"__ignoreMap":266},[459,496,497],{"class":461,"line":462},[459,498,499],{"class":465},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[459,501,502,505,507,510,513,515],{"class":461,"line":469},[459,503,504],{"class":472},"kubectl",[459,506,480],{"class":476},[459,508,509],{"class":476}," deployment\u002Ffivenet",[459,511,512],{"class":476}," --",[459,514,483],{"class":476},[459,516,488],{"class":476},[459,518,520],{"class":461,"line":519},3,[459,521,522],{"class":465},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[260,524,527],{"className":452,"code":525,"filename":526,"language":455,"meta":266,"style":266},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[228,528,529,534],{"__ignoreMap":266},[459,530,531],{"class":461,"line":462},[459,532,533],{"class":465},"# Assumes that the fivenet binary is in your PATH\n",[459,535,536,539],{"class":461,"line":469},[459,537,538],{"class":472},"fivenet",[459,540,488],{"class":476},[260,542,545],{"className":452,"code":543,"filename":544,"language":455,"meta":266,"style":266},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[228,546,547,552],{"__ignoreMap":266},[459,548,549],{"class":461,"line":462},[459,550,551],{"class":465},"# Assumes that the fivenet.exe is in your PATH\n",[459,553,554,557],{"class":461,"line":469},[459,555,556],{"class":472},"fivenet.exe",[459,558,488],{"class":476},[560,561,562],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {colo