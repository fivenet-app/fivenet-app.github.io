.user-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":166,"path":167,"stem":168,"children":169},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[170,171,175],{"title":166,"path":167,"stem":168},{"title":172,"path":173,"stem":174},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":176,"stem":177},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":179,"path":180,"stem":181,"children":182},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[183],{"title":179,"path":180,"stem":181},{"id":185,"title":186,"body":187,"description":543,"extension":544,"links":545,"meta":546,"navigation":547,"path":548,"redirect":545,"seo":549,"stem":550,"__hash__":551},"content_en\u002F1.getting-started\u002F3.versioning.md","Versioning",{"type":188,"value":189,"toc":535},"minimark",[190,204,207,223,228,231,241,244,250,270,276,296,300,303,309,312,318,337,343,347,350,357,360,368,371,375,393,397,400,412,415,419,531],[191,192,193,194,198,199,203],"p",{},"FiveNet uses ",[195,196,197],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[200,201,202],"code",{},"1.2.3",".",[191,205,206],{},"You will usually see one of these two formats:",[208,209,210,217],"ul",{},[211,212,213,214],"li",{},"Release version: ",[200,215,216],{},"v2026.3.1",[211,218,219,220],{},"Development version: ",[200,221,222],{},"v2026.3.1-55-g07bf5c8e5",[224,225,227],"h2",{"id":226},"release-version","Release Version",[191,229,230],{},"A full release version looks like this:",[232,233,239],"pre",{"className":234,"code":236,"language":237,"meta":238},[235],"language-text","v2026.3.1\n","text","",[200,240,236],{"__ignoreMap":238},[191,242,243],{},"This format is:",[232,245,248],{"className":246,"code":247,"language":237,"meta":238},[235],"vYYYY.M.P\n",[200,249,247],{"__ignoreMap":238},[208,251,252,258,264],{},[211,253,254,257],{},[200,255,256],{},"YYYY"," = release year",[211,259,260,263],{},[200,261,262],{},"M"," = release month",[211,265,266,269],{},[200,267,268],{},"P"," = patch or revision number for that month",[191,271,272,273,275],{},"In the example ",[200,274,216],{},":",[208,277,278,284,290],{},[211,279,280,283],{},[200,281,282],{},"2026"," means the year 2026",[211,285,286,289],{},[200,287,288],{},"3"," means March",[211,291,292,295],{},[200,293,294],{},"1"," means the first release published for that month",[224,297,299],{"id":298},"development-version","Development Version",[191,301,302],{},"A development version looks like this:",[232,304,307],{"className":305,"code":306,"language":237,"meta":238},[235],"v2026.3.1-55-g07bf5c8e5\n",[200,308,306],{"__ignoreMap":238},[191,310,311],{},"This is based on the same release version, but with extra Git metadata appended:",[232,313,316],{"className":314,"code":315,"language":237,"meta":238},[235],"vYYYY.M.P-COMMITS-gHASH\n",[200,317,315],{"__ignoreMap":238},[208,319,320,325,331],{},[211,321,322,324],{},[200,323,216],{}," = the nearest release tag the build is based on",[211,326,327,330],{},[200,328,329],{},"55"," = the build contains 55 commits after that tag",[211,332,333,336],{},[200,334,335],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[191,338,339,340,342],{},"In practice, this means the build was created from code that is newer than the ",[200,341,216],{}," release, but not yet published as the next full release tag.",[224,344,346],{"id":345},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[191,348,349],{},"Not necessarily.",[191,351,352,353,356],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[195,354,355],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[191,358,359],{},"The main difference is version labeling:",[208,361,362,365],{},[211,363,364],{},"A release version is a tagged, full release.",[211,366,367],{},"A development version is a build from a specific Git commit after the last tagged release.",[191,369,370],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[224,372,374],{"id":373},"quick-examples","Quick Examples",[208,376,377,382],{},[211,378,379,381],{},[200,380,216],{},"\nThe first tagged release from March 2026.",[211,383,384,386,387,389,390,203],{},[200,385,222],{},"\nA build from 55 commits after ",[200,388,216],{},", based on commit ",[200,391,392],{},"07bf5c8e5",[224,394,396],{"id":395},"summary","Summary",[191,398,399],{},"If you only remember one thing, it is this:",[401,402,404],"callout",{"icon":403},"i-mdi-information-outline",[191,405,406,408,409,411],{},[200,407,216],{}," is a tagged release, while ",[200,410,222],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[413,414],"hr",{},[224,416,418],{"id":417},"how-to-check-your-version","How to Check Your Version",[420,421,422,461,495,513],"code-group",{},[232,423,428],{"className":424,"code":425,"filename":426,"language":427,"meta":238,"style":238},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[200,429,430,439],{"__ignoreMap":238},[431,432,435],"span",{"class":433,"line":434},"line",1,[431,436,438],{"class":437},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[431,440,442,446,450,453,456,458],{"class":433,"line":441},2,[431,443,445],{"class":444},"sBMFI","docker",[431,447,449],{"class":448},"sfazB"," compose",[431,451,452],{"class":448}," exec",[431,454,455],{"class":448}," fivenet",[431,457,455],{"class":448},[431,459,460],{"class":448}," --version\n",[232,462,465],{"className":424,"code":463,"filename":464,"language":427,"meta":238,"style":238},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[200,466,467,472,489],{"__ignoreMap":238},[431,468,469],{"class":433,"line":434},[431,470,471],{"class":437},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[431,473,474,477,479,482,485,487],{"class":433,"line":441},[431,475,476],{"class":444},"kubectl",[431,478,452],{"class":448},[431,480,481],{"class":448}," deployment\u002Ffivenet",[431,483,484],{"class":448}," --",[431,486,455],{"class":448},[431,488,460],{"class":448},[431,490,492],{"class":433,"line":491},3,[431,493,494],{"class":437},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[232,496,499],{"className":424,"code":497,"filename":498,"language":427,"meta":238,"style":238},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[200,500,501,506],{"__ignoreMap":238},[431,502,503],{"class":433,"line":434},[431,504,505],{"class":437},"# Assumes that the fivenet binary is in your PATH\n",[431,507,508,511],{"class":433,"line":441},[431,509,510],{"class":444},"fivenet",[431,512,460],{"class":448},[232,514,517],{"className":424,"code":515,"filename":516,"language":427,"meta":238,"style":238},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[200,518,519,524],{"__ignoreMap":238},[431,520,521],{"class":433,"line":434},[431,522,523],{"class":437},"# Assumes that the fivenet.exe is in your PATH\n",[431,525,526,529],{"class":433,"line":441},[431,527,528],{"class":444},"fivenet.exe",[431,530,460],{"class":448},[532,533,534],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":238,"searchDepth":441,"depth":441,"links":536},[537,538,539,540,541,542],{"id":226,"depth":441,"text":227},{"id":298,"depth":441,"text":299},{"id":345,"depth":441,"text":346},{"id":373,"depth":441,"text":374},{"id":395,"depth":441,"text":396},{"id":417,"depth":441,"text":418},"Learn how FiveNet version numbers are structured and what release and development builds mean.","md",null,{},true,"\u002Fgetting-started\u002Fversioning",{"title":186,"description":543},"1.getting-started\u002F3.versioning","kozQiLaY4o3B71eJYLRxOg-Rm1pG639y-QZQnEzLzaA",[553,558],{"title":554,"path":555,"stem":556,"description":557,"children":-1},"Components","\u002Fgetting-started\u002Fcomponents","1.getting-started\u002F3.components","Overview of the main FiveNet components and how they interact.",{"title":559,"path":560,"stem":561,"description":562,"children":-1},"Installation Methods","\u002Fgetting-started\u002Finstallation\u002Fmethods","1.getting-started\u002F4.installation\u002F1.methods","Choose the installation path that fits your environment, whether you want managed hosting with FiveNet Cloud or a self-hosted deployment with Docker or Kubernetes.",1788932306134]