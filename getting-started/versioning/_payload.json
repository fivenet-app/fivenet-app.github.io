:164,"path":224,"stem":225},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":227,"path":228,"stem":229},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":231,"path":232,"stem":233},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":235,"path":236,"stem":237},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":239,"title":36,"body":240,"description":596,"extension":597,"links":598,"meta":599,"navigation":600,"path":37,"redirect":598,"seo":601,"stem":38,"__hash__":602},"content_en\u002F1.getting-started\u002F3.versioning.md",{"type":241,"value":242,"toc":588},"minimark",[243,257,260,276,281,284,294,297,303,323,329,349,353,356,362,365,371,390,396,400,403,410,413,421,424,428,446,450,453,465,468,472,584],[244,245,246,247,251,252,256],"p",{},"FiveNet uses ",[248,249,250],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[253,254,255],"code",{},"1.2.3",".",[244,258,259],{},"You will usually see one of these two formats:",[261,262,263,270],"ul",{},[264,265,266,267],"li",{},"Release version: ",[253,268,269],{},"v2026.3.1",[264,271,272,273],{},"Development version: ",[253,274,275],{},"v2026.3.1-55-g07bf5c8e5",[277,278,280],"h2",{"id":279},"release-version","Release Version",[244,282,283],{},"A full release version looks like this:",[285,286,292],"pre",{"className":287,"code":289,"language":290,"meta":291},[288],"language-text","v2026.3.1\n","text","",[253,293,289],{"__ignoreMap":291},[244,295,296],{},"This format is:",[285,298,301],{"className":299,"code":300,"language":290,"meta":291},[288],"vYYYY.M.P\n",[253,302,300],{"__ignoreMap":291},[261,304,305,311,317],{},[264,306,307,310],{},[253,308,309],{},"YYYY"," = release year",[264,312,313,316],{},[253,314,315],{},"M"," = release month",[264,318,319,322],{},[253,320,321],{},"P"," = patch or revision number for that month",[244,324,325,326,328],{},"In the example ",[253,327,269],{},":",[261,330,331,337,343],{},[264,332,333,336],{},[253,334,335],{},"2026"," means the year 2026",[264,338,339,342],{},[253,340,341],{},"3"," means March",[264,344,345,348],{},[253,346,347],{},"1"," means the first release published for that month",[277,350,352],{"id":351},"development-version","Development Version",[244,354,355],{},"A development version looks like this:",[285,357,360],{"className":358,"code":359,"language":290,"meta":291},[288],"v2026.3.1-55-g07bf5c8e5\n",[253,361,359],{"__ignoreMap":291},[244,363,364],{},"This is based on the same release version, but with extra Git metadata appended:",[285,366,369],{"className":367,"code":368,"language":290,"meta":291},[288],"vYYYY.M.P-COMMITS-gHASH\n",[253,370,368],{"__ignoreMap":291},[261,372,373,378,384],{},[264,374,375,377],{},[253,376,269],{}," = the nearest release tag the build is based on",[264,379,380,383],{},[253,381,382],{},"55"," = the build contains 55 commits after that tag",[264,385,386,389],{},[253,387,388],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[244,391,392,393,395],{},"In practice, this means the build was created from code that is newer than the ",[253,394,269],{}," release, but not yet published as the next full release tag.",[277,397,399],{"id":398},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[244,401,402],{},"Not necessarily.",[244,404,405,406,409],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[248,407,408],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[244,411,412],{},"The main difference is version labeling:",[261,414,415,418],{},[264,416,417],{},"A release version is a tagged, full release.",[264,419,420],{},"A development version is a build from a specific Git commit after the last tagged release.",[244,422,423],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[277,425,427],{"id":426},"quick-examples","Quick Examples",[261,429,430,435],{},[264,431,432,434],{},[253,433,269],{},"\nThe first tagged release from March 2026.",[264,436,437,439,440,442,443,256],{},[253,438,275],{},"\nA build from 55 commits after ",[253,441,269],{},", based on commit ",[253,444,445],{},"07bf5c8e5",[277,447,449],{"id":448},"summary","Summary",[244,451,452],{},"If you only remember one thing, it is this:",[454,455,457],"callout",{"icon":456},"i-mdi-information-outline",[244,458,459,461,462,464],{},[253,460,269],{}," is a tagged release, while ",[253,463,275],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[466,467],"hr",{},[277,469,471],{"id":470},"how-to-check-your-version","How to Check Your Version",[473,474,475,514,548,566],"code-group",{},[285,476,481],{"className":477,"code":478,"filename":479,"language":480,"meta":291,"style":291},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[253,482,483,492],{"__ignoreMap":291},[484,485,488],"span",{"class":486,"line":487},"line",1,[484,489,491],{"class":490},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[484,493,495,499,503,506,509,511],{"class":486,"line":494},2,[484,496,498],{"class":497},"sBMFI","docker",[484,500,502],{"class":501},"sfazB"," compose",[484,504,505],{"class":501}," exec",[484,507,508],{"class":501}," fivenet",[484,510,508],{"class":501},[484,512,513],{"class":501}," --version\n",[285,515,518],{"className":477,"code":516,"filename":517,"language":480,"meta":291,"style":291},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[253,519,520,525,542],{"__ignoreMap":291},[484,521,522],{"class":486,"line":487},[484,523,524],{"class":490},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[484,526,527,530,532,535,538,540],{"class":486,"line":494},[484,528,529],{"class":497},"kubectl",[484,531,505],{"class":501},[484,533,534],{"class":501}," deployment\u002Ffivenet",[484,536,537],{"class":501}," --",[484,539,508],{"class":501},[484,541,513],{"class":501},[484,543,545],{"class":486,"line":544},3,[484,546,547],{"class":490},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[285,549,552],{"className":477,"code":550,"filename":551,"language":480,"meta":291,"style":291},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[253,553,554,559],{"__ignoreMap":291},[484,555,556],{"class":486,"line":487},[484,557,558],{"class":490},"# Assumes that the fivenet binary is in your PATH\n",[484,560,561,564],{"class":486,"line":494},[484,562,563],{"class":497},"fivenet",[484,565,513],{"class":501},[285,567,570],{"className":477,"code":568,"filename":569,"language":480,"meta":291,"style":291},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[253,571,572,577],{"__ignoreMap":291},[484,573,574],{"class":486,"line":487},[484,575,576],{"class":490},"# Assumes that the fivenet.exe is in your PATH\n",[484,578,579,582],{"class":486,"line":494},[484,580,581],{"class":497},"fivenet.exe",[484,583,513],{"class":501},[585,586,587],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-li