ides\u002F6.mailer",{"title":167,"path":168,"stem":169},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings",{"title":171,"path":172,"stem":173},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n",{"title":175,"path":176,"stem":177},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",{"title":179,"path":180,"stem":181},"StreamDeck Plugin","\u002Fuser-guides\u002Fplugin-streamdeck","3.user-guides\u002F9.plugin-streamdeck",{"title":183,"path":184,"stem":185,"children":186},"Development","\u002Fdevelopment","8.development\u002F1.index",[187,188,192,196,200],{"title":183,"path":184,"stem":185},{"title":189,"path":190,"stem":191},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":193,"path":194,"stem":195},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":197,"path":198,"stem":199},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":171,"path":201,"stem":202},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":204,"path":205,"stem":206,"children":207},"Design Docs","\u002Fdesign","9.design\u002F1.index",[208,210,214,218,221,225,229],{"title":209,"path":205,"stem":206},"Designs",{"title":211,"path":212,"stem":213},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":215,"path":216,"stem":217},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":159,"path":219,"stem":220},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":222,"path":223,"stem":224},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":226,"path":227,"stem":228},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":230,"path":231,"stem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":28,"body":235,"description":591,"extension":592,"links":593,"meta":594,"navigation":595,"path":29,"redirect":593,"seo":596,"stem":30,"__hash__":597},"content_en\u002F1.getting-started\u002F3.versioning.md",{"type":236,"value":237,"toc":583},"minimark",[238,252,255,271,276,279,289,292,298,318,324,344,348,351,357,360,366,385,391,395,398,405,408,416,419,423,441,445,448,460,463,467,579],[239,240,241,242,246,247,251],"p",{},"FiveNet uses ",[243,244,245],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[248,249,250],"code",{},"1.2.3",".",[239,253,254],{},"You will usually see one of these two formats:",[256,257,258,265],"ul",{},[259,260,261,262],"li",{},"Release version: ",[248,263,264],{},"v2026.3.1",[259,266,267,268],{},"Development version: ",[248,269,270],{},"v2026.3.1-55-g07bf5c8e5",[272,273,275],"h2",{"id":274},"release-version","Release Version",[239,277,278],{},"A full release version looks like this:",[280,281,287],"pre",{"className":282,"code":284,"language":285,"meta":286},[283],"language-text","v2026.3.1\n","text","",[248,288,284],{"__ignoreMap":286},[239,290,291],{},"This format is:",[280,293,296],{"className":294,"code":295,"language":285,"meta":286},[283],"vYYYY.M.P\n",[248,297,295],{"__ignoreMap":286},[256,299,300,306,312],{},[259,301,302,305],{},[248,303,304],{},"YYYY"," = release year",[259,307,308,311],{},[248,309,310],{},"M"," = release month",[259,313,314,317],{},[248,315,316],{},"P"," = patch or revision number for that month",[239,319,320,321,323],{},"In the example ",[248,322,264],{},":",[256,325,326,332,338],{},[259,327,328,331],{},[248,329,330],{},"2026"," means the year 2026",[259,333,334,337],{},[248,335,336],{},"3"," means March",[259,339,340,343],{},[248,341,342],{},"1"," means the first release published for that month",[272,345,347],{"id":346},"development-version","Development Version",[239,349,350],{},"A development version looks like this:",[280,352,355],{"className":353,"code":354,"language":285,"meta":286},[283],"v2026.3.1-55-g07bf5c8e5\n",[248,356,354],{"__ignoreMap":286},[239,358,359],{},"This is based on the same release version, but with extra Git metadata appended:",[280,361,364],{"className":362,"code":363,"language":285,"meta":286},[283],"vYYYY.M.P-COMMITS-gHASH\n",[248,365,363],{"__ignoreMap":286},[256,367,368,373,379],{},[259,369,370,372],{},[248,371,264],{}," = the nearest release tag the build is based on",[259,374,375,378],{},[248,376,377],{},"55"," = the build contains 55 commits after that tag",[259,380,381,384],{},[248,382,383],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[239,386,387,388,390],{},"In practice, this means the build was created from code that is newer than the ",[248,389,264],{}," release, but not yet published as the next full release tag.",[272,392,394],{"id":393},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[239,396,397],{},"Not necessarily.",[239,399,400,401,404],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[243,402,403],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[239,406,407],{},"The main difference is version labeling:",[256,409,410,413],{},[259,411,412],{},"A release version is a tagged, full release.",[259,414,415],{},"A development version is a build from a specific Git commit after the last tagged release.",[239,417,418],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[272,420,422],{"id":421},"quick-examples","Quick Examples",[256,424,425,430],{},[259,426,427,429],{},[248,428,264],{},"\nThe first tagged release from March 2026.",[259,431,432,434,435,437,438,251],{},[248,433,270],{},"\nA build from 55 commits after ",[248,436,264],{},", based on commit ",[248,439,440],{},"07bf5c8e5",[272,442,444],{"id":443},"summary","Summary",[239,446,447],{},"If you only remember one thing, it is this:",[449,450,452],"callout",{"icon":451},"i-mdi-information-outline",[239,453,454,456,457,459],{},[248,455,264],{}," is a tagged release, while ",[248,458,270],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[461,462],"hr",{},[272,464,466],{"id":465},"how-to-check-your-version","How to Check Your Version",[468,469,470,509,543,561],"code-group",{},[280,471,476],{"className":472,"code":473,"filename":474,"language":475,"meta":286,"style":286},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[248,477,478,487],{"__ignoreMap":286},[479,480,483],"span",{"class":481,"line":482},"line",1,[479,484,486],{"class":485},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[479,488,490,494,498,501,504,506],{"class":481,"line":489},2,[479,491,493],{"class":492},"sBMFI","docker",[479,495,497],{"class":496},"sfazB"," compose",[479,499,500],{"class":496}," exec",[479,502,503],{"class":496}," fivenet",[479,505,503],{"class":496},[479,507,508],{"class":496}," --version\n",[280,510,513],{"className":472,"code":511,"filename":512,"language":475,"meta":286,"style":286},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[248,514,515,520,537],{"__ignoreMap":286},[479,516,517],{"class":481,"line":482},[479,518,519],{"class":485},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[479,521,522,525,527,530,533,535],{"class":481,"line":489},[479,523,524],{"class":492},"kubectl",[479,526,500],{"class":496},[479,528,529],{"class":496}," deployment\u002Ffivenet",[479,531,532],{"class":496}," --",[479,534,503],{"class":496},[479,536,508],{"class":496},[479,538,540],{"class":481,"line":539},3,[479,541,542],{"class":485},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[280,544,547],{"className":472,"code":545,"filename":546,"language":475,"meta":286,"style":286},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[248,548,549,554],{"__ignoreMap":286},[479,550,551],{"class":481,"line":482},[479,552,553],{"class":485},"# Assumes that the fivenet binary is in your PATH\n",[479,555,556,559],{"class":481,"line":489},[479,557,558],{"class":492},"fivenet",[479,560,508],{"class":496},[280,562,565],{"className":472,"code":563,"filename":564,"language":475,"meta":286,"style":286},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[248,566,567,572],{"__ignoreMap":286},[479,568,569],{"class":481,"line":482},[479,570,571],{"class":485},"# Assumes that the fivenet.exe is in your PATH\n",[479,573,574,577],{"class":481,"line":489},[479,575,576],{"class":492},"fivenet.exe",[479,578,508],{"class":496},[580,581,582],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C