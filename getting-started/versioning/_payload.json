uments\u002Ftemplates",{"title":146,"path":147,"stem":148},"Jobs","\u002Fde\u002Fuser-guides\u002Fjobs","de\u002F3.user-guides\u002F3.jobs",{"title":150,"path":151,"stem":152},"Kalender","\u002Fde\u002Fuser-guides\u002Fcalendar","de\u002F3.user-guides\u002F4.calendar",{"title":154,"path":155,"stem":156},"Livemap","\u002Fde\u002Fuser-guides\u002Flivemap","de\u002F3.user-guides\u002F5.livemap",{"title":158,"path":159,"stem":160},"Einsatzzentrale","\u002Fde\u002Fuser-guides\u002Fcentrum","de\u002F3.user-guides\u002F6.centrum",{"title":162,"path":163,"stem":164},"Mailer","\u002Fde\u002Fuser-guides\u002Fmailer","de\u002F3.user-guides\u002F6.mailer",{"title":166,"path":167,"stem":168},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":170,"path":171,"stem":172},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":174,"path":175,"stem":176},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":178,"path":179,"stem":180},"StreamDeck Plugin","\u002Fde\u002Fuser-guides\u002Fplugin-streamdeck","de\u002F3.user-guides\u002F9.plugin-streamdeck",{"title":182,"path":183,"stem":184,"children":185},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[186,187,191],{"title":182,"path":183,"stem":184},{"title":188,"path":189,"stem":190},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":170,"path":192,"stem":193},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":195,"path":196,"stem":197,"children":198},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[199],{"title":195,"path":196,"stem":197},{"id":201,"title":202,"body":203,"description":559,"extension":560,"links":561,"meta":562,"navigation":563,"path":564,"redirect":561,"seo":565,"stem":566,"__hash__":567},"content_en\u002F1.getting-started\u002F3.versioning.md","Versioning",{"type":204,"value":205,"toc":551},"minimark",[206,220,223,239,244,247,257,260,266,286,292,312,316,319,325,328,334,353,359,363,366,373,376,384,387,391,409,413,416,428,431,435,547],[207,208,209,210,214,215,219],"p",{},"FiveNet uses ",[211,212,213],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[216,217,218],"code",{},"1.2.3",".",[207,221,222],{},"You will usually see one of these two formats:",[224,225,226,233],"ul",{},[227,228,229,230],"li",{},"Release version: ",[216,231,232],{},"v2026.3.1",[227,234,235,236],{},"Development version: ",[216,237,238],{},"v2026.3.1-55-g07bf5c8e5",[240,241,243],"h2",{"id":242},"release-version","Release Version",[207,245,246],{},"A full release version looks like this:",[248,249,255],"pre",{"className":250,"code":252,"language":253,"meta":254},[251],"language-text","v2026.3.1\n","text","",[216,256,252],{"__ignoreMap":254},[207,258,259],{},"This format is:",[248,261,264],{"className":262,"code":263,"language":253,"meta":254},[251],"vYYYY.M.P\n",[216,265,263],{"__ignoreMap":254},[224,267,268,274,280],{},[227,269,270,273],{},[216,271,272],{},"YYYY"," = release year",[227,275,276,279],{},[216,277,278],{},"M"," = release month",[227,281,282,285],{},[216,283,284],{},"P"," = patch or revision number for that month",[207,287,288,289,291],{},"In the example ",[216,290,232],{},":",[224,293,294,300,306],{},[227,295,296,299],{},[216,297,298],{},"2026"," means the year 2026",[227,301,302,305],{},[216,303,304],{},"3"," means March",[227,307,308,311],{},[216,309,310],{},"1"," means the first release published for that month",[240,313,315],{"id":314},"development-version","Development Version",[207,317,318],{},"A development version looks like this:",[248,320,323],{"className":321,"code":322,"language":253,"meta":254},[251],"v2026.3.1-55-g07bf5c8e5\n",[216,324,322],{"__ignoreMap":254},[207,326,327],{},"This is based on the same release version, but with extra Git metadata appended:",[248,329,332],{"className":330,"code":331,"language":253,"meta":254},[251],"vYYYY.M.P-COMMITS-gHASH\n",[216,333,331],{"__ignoreMap":254},[224,335,336,341,347],{},[227,337,338,340],{},[216,339,232],{}," = the nearest release tag the build is based on",[227,342,343,346],{},[216,344,345],{},"55"," = the build contains 55 commits after that tag",[227,348,349,352],{},[216,350,351],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[207,354,355,356,358],{},"In practice, this means the build was created from code that is newer than the ",[216,357,232],{}," release, but not yet published as the next full release tag.",[240,360,362],{"id":361},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[207,364,365],{},"Not necessarily.",[207,367,368,369,372],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[211,370,371],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[207,374,375],{},"The main difference is version labeling:",[224,377,378,381],{},[227,379,380],{},"A release version is a tagged, full release.",[227,382,383],{},"A development version is a build from a specific Git commit after the last tagged release.",[207,385,386],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[240,388,390],{"id":389},"quick-examples","Quick Examples",[224,392,393,398],{},[227,394,395,397],{},[216,396,232],{},"\nThe first tagged release from March 2026.",[227,399,400,402,403,405,406,219],{},[216,401,238],{},"\nA build from 55 commits after ",[216,404,232],{},", based on commit ",[216,407,408],{},"07bf5c8e5",[240,410,412],{"id":411},"summary","Summary",[207,414,415],{},"If you only remember one thing, it is this:",[417,418,420],"callout",{"icon":419},"i-mdi-information-outline",[207,421,422,424,425,427],{},[216,423,232],{}," is a tagged release, while ",[216,426,238],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[429,430],"hr",{},[240,432,434],{"id":433},"how-to-check-your-version","How to Check Your Version",[436,437,438,477,511,529],"code-group",{},[248,439,444],{"className":440,"code":441,"filename":442,"language":443,"meta":254,"style":254},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[216,445,446,455],{"__ignoreMap":254},[447,448,451],"span",{"class":449,"line":450},"line",1,[447,452,454],{"class":453},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[447,456,458,462,466,469,472,474],{"class":449,"line":457},2,[447,459,461],{"class":460},"sBMFI","docker",[447,463,465],{"class":464},"sfazB"," compose",[447,467,468],{"class":464}," exec",[447,470,471],{"class":464}," fivenet",[447,473,471],{"class":464},[447,475,476],{"class":464}," --version\n",[248,478,481],{"className":440,"code":479,"filename":480,"language":443,"meta":254,"style":254},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[216,482,483,488,505],{"__ignoreMap":254},[447,484,485],{"class":449,"line":450},[447,486,487],{"class":453},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[447,489,490,493,495,498,501,503],{"class":449,"line":457},[447,491,492],{"class":460},"kubectl",[447,494,468],{"class":464},[447,496,497],{"class":464}," deployment\u002Ffivenet",[447,499,500],{"class":464}," --",[447,502,471],{"class":464},[447,504,476],{"class":464},[447,506,508],{"class":449,"line":507},3,[447,509,510],{"class":453},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[248,512,515],{"className":440,"code":513,"filename":514,"language":443,"meta":254,"style":254},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[216,516,517,522],{"__ignoreMap":254},[447,518,519],{"class":449,"line":450},[447,520,521],{"class":453},"# Assumes that the fivenet binary is in your PATH\n",[447,523,524,527],{"class":449,"line":457},[447,525,526],{"class":460},"fivenet",[447,528,476],{"class":464},[248,530,533],{"className":440,"code":531,"filename":532,"language":443,"meta":254,"style":254},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[216,534,535,540],{"__ignoreMap":254},[447,536,537],{"class":449,"line":450},[447,538,539],{"class":453},"# Assumes that the fivenet.exe is in your PATH\n",[447,541,542,545],{"class":449,"line":457},[447,543,544],{"class":460},"fivenet.exe",[447,546,476],{"class":464},[548,549,550],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-