r-guides\u002F6.mailer",{"title":150,"path":151,"stem":152},"Einstellungen","\u002Fde\u002Fuser-guides\u002Fsettings","de\u002F3.user-guides\u002F7.settings",{"title":154,"path":155,"stem":156},"Sprachen (i18n)","\u002Fde\u002Fuser-guides\u002Fi18n","de\u002F3.user-guides\u002F8.i18n",{"title":158,"path":159,"stem":160},"iOS-App","\u002Fde\u002Fuser-guides\u002Fios-app","de\u002F3.user-guides\u002F9.ios-app",{"title":162,"path":163,"stem":164,"children":165},"Entwicklung","\u002Fde\u002Fdevelopment","de\u002F8.development\u002F1.index",[166,167,171],{"title":162,"path":163,"stem":164},{"title":168,"path":169,"stem":170},"User Activity","\u002Fde\u002Fdevelopment\u002Fuser-activity","de\u002F8.development\u002F5.user-activity",{"title":154,"path":172,"stem":173},"\u002Fde\u002Fdevelopment\u002Fi18n","de\u002F8.development\u002Fi18n",{"title":175,"path":176,"stem":177,"children":178},"Design","\u002Fde\u002Fdesign","de\u002F9.design\u002F1.index",[179],{"title":175,"path":176,"stem":177},{"id":181,"title":182,"body":183,"description":539,"extension":540,"links":541,"meta":542,"navigation":543,"path":544,"redirect":541,"seo":545,"stem":546,"__hash__":547},"content_en\u002F1.getting-started\u002F3.versioning.md","Versioning",{"type":184,"value":185,"toc":531},"minimark",[186,200,203,219,224,227,237,240,246,266,272,292,296,299,305,308,314,333,339,343,346,353,356,364,367,371,389,393,396,408,411,415,527],[187,188,189,190,194,195,199],"p",{},"FiveNet uses ",[191,192,193],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[196,197,198],"code",{},"1.2.3",".",[187,201,202],{},"You will usually see one of these two formats:",[204,205,206,213],"ul",{},[207,208,209,210],"li",{},"Release version: ",[196,211,212],{},"v2026.3.1",[207,214,215,216],{},"Development version: ",[196,217,218],{},"v2026.3.1-55-g07bf5c8e5",[220,221,223],"h2",{"id":222},"release-version","Release Version",[187,225,226],{},"A full release version looks like this:",[228,229,235],"pre",{"className":230,"code":232,"language":233,"meta":234},[231],"language-text","v2026.3.1\n","text","",[196,236,232],{"__ignoreMap":234},[187,238,239],{},"This format is:",[228,241,244],{"className":242,"code":243,"language":233,"meta":234},[231],"vYYYY.M.P\n",[196,245,243],{"__ignoreMap":234},[204,247,248,254,260],{},[207,249,250,253],{},[196,251,252],{},"YYYY"," = release year",[207,255,256,259],{},[196,257,258],{},"M"," = release month",[207,261,262,265],{},[196,263,264],{},"P"," = patch or revision number for that month",[187,267,268,269,271],{},"In the example ",[196,270,212],{},":",[204,273,274,280,286],{},[207,275,276,279],{},[196,277,278],{},"2026"," means the year 2026",[207,281,282,285],{},[196,283,284],{},"3"," means March",[207,287,288,291],{},[196,289,290],{},"1"," means the first release published for that month",[220,293,295],{"id":294},"development-version","Development Version",[187,297,298],{},"A development version looks like this:",[228,300,303],{"className":301,"code":302,"language":233,"meta":234},[231],"v2026.3.1-55-g07bf5c8e5\n",[196,304,302],{"__ignoreMap":234},[187,306,307],{},"This is based on the same release version, but with extra Git metadata appended:",[228,309,312],{"className":310,"code":311,"language":233,"meta":234},[231],"vYYYY.M.P-COMMITS-gHASH\n",[196,313,311],{"__ignoreMap":234},[204,315,316,321,327],{},[207,317,318,320],{},[196,319,212],{}," = the nearest release tag the build is based on",[207,322,323,326],{},[196,324,325],{},"55"," = the build contains 55 commits after that tag",[207,328,329,332],{},[196,330,331],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[187,334,335,336,338],{},"In practice, this means the build was created from code that is newer than the ",[196,337,212],{}," release, but not yet published as the next full release tag.",[220,340,342],{"id":341},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[187,344,345],{},"Not necessarily.",[187,347,348,349,352],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[191,350,351],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[187,354,355],{},"The main difference is version labeling:",[204,357,358,361],{},[207,359,360],{},"A release version is a tagged, full release.",[207,362,363],{},"A development version is a build from a specific Git commit after the last tagged release.",[187,365,366],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[220,368,370],{"id":369},"quick-examples","Quick Examples",[204,372,373,378],{},[207,374,375,377],{},[196,376,212],{},"\nThe first tagged release from March 2026.",[207,379,380,382,383,385,386,199],{},[196,381,218],{},"\nA build from 55 commits after ",[196,384,212],{},", based on commit ",[196,387,388],{},"07bf5c8e5",[220,390,392],{"id":391},"summary","Summary",[187,394,395],{},"If you only remember one thing, it is this:",[397,398,400],"callout",{"icon":399},"i-mdi-information-outline",[187,401,402,404,405,407],{},[196,403,212],{}," is a tagged release, while ",[196,406,218],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[409,410],"hr",{},[220,412,414],{"id":413},"how-to-check-your-version","How to Check Your Version",[416,417,418,457,491,509],"code-group",{},[228,419,424],{"className":420,"code":421,"filename":422,"language":423,"meta":234,"style":234},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[196,425,426,435],{"__ignoreMap":234},[427,428,431],"span",{"class":429,"line":430},"line",1,[427,432,434],{"class":433},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[427,436,438,442,446,449,452,454],{"class":429,"line":437},2,[427,439,441],{"class":440},"sBMFI","docker",[427,443,445],{"class":444},"sfazB"," compose",[427,447,448],{"class":444}," exec",[427,450,451],{"class":444}," fivenet",[427,453,451],{"class":444},[427,455,456],{"class":444}," --version\n",[228,458,461],{"className":420,"code":459,"filename":460,"language":423,"meta":234,"style":234},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[196,462,463,468,485],{"__ignoreMap":234},[427,464,465],{"class":429,"line":430},[427,466,467],{"class":433},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[427,469,470,473,475,478,481,483],{"class":429,"line":437},[427,471,472],{"class":440},"kubectl",[427,474,448],{"class":444},[427,476,477],{"class":444}," deployment\u002Ffivenet",[427,479,480],{"class":444}," --",[427,482,451],{"class":444},[427,484,456],{"class":444},[427,486,488],{"class":429,"line":487},3,[427,489,490],{"class":433},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[228,492,495],{"className":420,"code":493,"filename":494,"language":423,"meta":234,"style":234},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[196,496,497,502],{"__ignoreMap":234},[427,498,499],{"class":429,"line":430},[427,500,501],{"class":433},"# Assumes that the fivenet binary is in your PATH\n",[427,503,504,507],{"class":429,"line":437},[427,505,506],{"class":440},"fivenet",[427,508,456],{"class":444},[228,510,513],{"className":420,"code":511,"filename":512,"language":423,"meta":234,"style":234},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[196,514,515,520],{"__ignoreMap":234},[427,516,517],{"class":429,"line":430},[427,518,519],{"class":433},"# Assumes that the fivenet.exe is in your PATH\n",[427,521,522,525],{"class":429,"line":437},[427,523,524],{"class":440},"fivenet.exe",[427,526,456],{"class":444},[528,529,530],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":234,"searchDepth":437,"depth":437,"links":532},[533,534,535,536,537,538],{"id":222,"depth":437,"text":223},{"id":294,"depth":437,"text":295},{"id":341,"depth":437,"text":342},{"id":369,"depth":437,"text":370},{"id":391,"depth":437,"text":392},{"id":413,"depth":437,"text":414},"Learn how FiveNet version numbers are structured and what release and development builds mean.","md",null,{},true,"\u002Fgetting-started\u002Fversioning",{"title":182,"description":539},"1.getting-started\u002F3.versioning","kozQiLaY4o3B71eJYLRxOg-Rm1pG639y-QZQnEzLzaA",[549,554],{"title":550,"path":551,"stem":552,"description":553,"children":-1},"Components","\u002Fgetting-started\u002Fcomponents","1.getting-started\u002F3.components","Overview of the main FiveNet components and how they interact.",{"title":555,"path":556,"stem":557,"description":558,"children":-1},"Installation Methods","\u002Fgetting-started\u002Finstallation\u002Fmethods","1.getting-started\u002F4.installation\u002F1.methods","Choose the installation path that fits your environment, whether you want managed hosting with FiveNet Cloud or a self-hosted deployment with Docker or Kubernetes.",1788403276274]