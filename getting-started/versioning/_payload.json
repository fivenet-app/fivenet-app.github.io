Fdevelopment","8.development\u002F1.index",[171,172,176,180,184],{"title":167,"path":168,"stem":169},{"title":173,"path":174,"stem":175},"GRPC Protobuf Documentation","\u002Fdevelopment\u002Fgrpc-api","8.development\u002F3.grpc-api",{"title":177,"path":178,"stem":179},"Release Process","\u002Fdevelopment\u002Frelease","8.development\u002F4.release",{"title":181,"path":182,"stem":183},"User Activity","\u002Fdevelopment\u002Fuser-activity","8.development\u002F5.user-activity",{"title":155,"path":185,"stem":186},"\u002Fdevelopment\u002Fi18n","8.development\u002Fi18n",{"title":188,"path":189,"stem":190,"children":191},"Design Docs","\u002Fdesign","9.design\u002F1.index",[192,194,198,202,205,209,213],{"title":193,"path":189,"stem":190},"Designs",{"title":195,"path":196,"stem":197},"Improving Data Separation and Management for Users and Citizens","\u002Fdesign\u002Fdata-separation-management","9.design\u002Fdata-separation-management",{"title":199,"path":200,"stem":201},"DB Sync","\u002Fdesign\u002Fdb-sync","9.design\u002Fdb-sync",{"title":143,"path":203,"stem":204},"\u002Fdesign\u002Fdispatch-center","9.design\u002Fdispatch-center",{"title":206,"path":207,"stem":208},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":210,"path":211,"stem":212},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":214,"path":215,"stem":216},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":218,"title":28,"body":219,"description":575,"extension":576,"links":577,"meta":578,"navigation":579,"path":29,"redirect":577,"seo":580,"stem":30,"__hash__":581},"content_en\u002F1.getting-started\u002F3.versioning.md",{"type":220,"value":221,"toc":567},"minimark",[222,236,239,255,260,263,273,276,282,302,308,328,332,335,341,344,350,369,375,379,382,389,392,400,403,407,425,429,432,444,447,451,563],[223,224,225,226,230,231,235],"p",{},"FiveNet uses ",[227,228,229],"strong",{},"CalVer"," versioning. That means the version number is based on the release date instead of a traditional semantic version like ",[232,233,234],"code",{},"1.2.3",".",[223,237,238],{},"You will usually see one of these two formats:",[240,241,242,249],"ul",{},[243,244,245,246],"li",{},"Release version: ",[232,247,248],{},"v2026.3.1",[243,250,251,252],{},"Development version: ",[232,253,254],{},"v2026.3.1-55-g07bf5c8e5",[256,257,259],"h2",{"id":258},"release-version","Release Version",[223,261,262],{},"A full release version looks like this:",[264,265,271],"pre",{"className":266,"code":268,"language":269,"meta":270},[267],"language-text","v2026.3.1\n","text","",[232,272,268],{"__ignoreMap":270},[223,274,275],{},"This format is:",[264,277,280],{"className":278,"code":279,"language":269,"meta":270},[267],"vYYYY.M.P\n",[232,281,279],{"__ignoreMap":270},[240,283,284,290,296],{},[243,285,286,289],{},[232,287,288],{},"YYYY"," = release year",[243,291,292,295],{},[232,293,294],{},"M"," = release month",[243,297,298,301],{},[232,299,300],{},"P"," = patch or revision number for that month",[223,303,304,305,307],{},"In the example ",[232,306,248],{},":",[240,309,310,316,322],{},[243,311,312,315],{},[232,313,314],{},"2026"," means the year 2026",[243,317,318,321],{},[232,319,320],{},"3"," means March",[243,323,324,327],{},[232,325,326],{},"1"," means the first release published for that month",[256,329,331],{"id":330},"development-version","Development Version",[223,333,334],{},"A development version looks like this:",[264,336,339],{"className":337,"code":338,"language":269,"meta":270},[267],"v2026.3.1-55-g07bf5c8e5\n",[232,340,338],{"__ignoreMap":270},[223,342,343],{},"This is based on the same release version, but with extra Git metadata appended:",[264,345,348],{"className":346,"code":347,"language":269,"meta":270},[267],"vYYYY.M.P-COMMITS-gHASH\n",[232,349,347],{"__ignoreMap":270},[240,351,352,357,363],{},[243,353,354,356],{},[232,355,248],{}," = the nearest release tag the build is based on",[243,358,359,362],{},[232,360,361],{},"55"," = the build contains 55 commits after that tag",[243,364,365,368],{},[232,366,367],{},"g07bf5c8e5"," = the short Git commit hash of the exact source revision",[223,370,371,372,374],{},"In practice, this means the build was created from code that is newer than the ",[232,373,248],{}," release, but not yet published as the next full release tag.",[256,376,378],{"id":377},"does-dev-mean-unstable","Does \"Dev\" Mean Unstable?",[223,380,381],{},"Not necessarily.",[223,383,384,385,388],{},"A development version simply means the build was created from a commit between tagged releases. It does ",[227,386,387],{},"not"," automatically mean the build is broken, unsafe, or unsuitable for production.",[223,390,391],{},"The main difference is version labeling:",[240,393,394,397],{},[243,395,396],{},"A release version is a tagged, full release.",[243,398,399],{},"A development version is a build from a specific Git commit after the last tagged release.",[223,401,402],{},"Because the commit hash is included, development versions are often even easier to trace back to the exact source code that was used.",[256,404,406],{"id":405},"quick-examples","Quick Examples",[240,408,409,414],{},[243,410,411,413],{},[232,412,248],{},"\nThe first tagged release from March 2026.",[243,415,416,418,419,421,422,235],{},[232,417,254],{},"\nA build from 55 commits after ",[232,420,248],{},", based on commit ",[232,423,424],{},"07bf5c8e5",[256,426,428],{"id":427},"summary","Summary",[223,430,431],{},"If you only remember one thing, it is this:",[433,434,436],"callout",{"icon":435},"i-mdi-information-outline",[223,437,438,440,441,443],{},[232,439,248],{}," is a tagged release, while ",[232,442,254],{}," is a newer build from a specific Git commit after that release. A development version is not automatically unstable.",[445,446],"hr",{},[256,448,450],{"id":449},"how-to-check-your-version","How to Check Your Version",[452,453,454,493,527,545],"code-group",{},[264,455,460],{"className":456,"code":457,"filename":458,"language":459,"meta":270,"style":270},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\ndocker compose exec fivenet fivenet --version\n","Docker \u002F Docker Compose","bash",[232,461,462,471],{"__ignoreMap":270},[463,464,467],"span",{"class":465,"line":466},"line",1,[463,468,470],{"class":469},"sHwdD","# Assumes you are in the directory containing your docker-compose.yml \u002F docker-compose.yaml file\n",[463,472,474,478,482,485,488,490],{"class":465,"line":473},2,[463,475,477],{"class":476},"sBMFI","docker",[463,479,481],{"class":480},"sfazB"," compose",[463,483,484],{"class":480}," exec",[463,486,487],{"class":480}," fivenet",[463,489,487],{"class":480},[463,491,492],{"class":480}," --version\n",[264,494,497],{"className":456,"code":495,"filename":496,"language":459,"meta":270,"style":270},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\nkubectl exec deployment\u002Ffivenet -- fivenet --version\n# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n","Kubernetes",[232,498,499,504,521],{"__ignoreMap":270},[463,500,501],{"class":465,"line":466},[463,502,503],{"class":469},"# Assumes that Helm was used to deploy FiveNet and kubectl is connected to your cluster and FiveNet app namespace\n",[463,505,506,509,511,514,517,519],{"class":465,"line":473},[463,507,508],{"class":476},"kubectl",[463,510,484],{"class":480},[463,512,513],{"class":480}," deployment\u002Ffivenet",[463,515,516],{"class":480}," --",[463,518,487],{"class":480},[463,520,492],{"class":480},[463,522,524],{"class":465,"line":523},3,[463,525,526],{"class":469},"# Additionally check the image.tag used in your Helm values to see the version of the image you are currentlyrunning\n",[264,528,531],{"className":456,"code":529,"filename":530,"language":459,"meta":270,"style":270},"# Assumes that the fivenet binary is in your PATH\nfivenet --version\n","Binary (Linux)",[232,532,533,538],{"__ignoreMap":270},[463,534,535],{"class":465,"line":466},[463,536,537],{"class":469},"# Assumes that the fivenet binary is in your PATH\n",[463,539,540,543],{"class":465,"line":473},[463,541,542],{"class":476},"fivenet",[463,544,492],{"class":480},[264,546,549],{"className":456,"code":547,"filename":548,"language":459,"meta":270,"style":270},"# Assumes that the fivenet.exe is in your PATH\nfivenet.exe --version\n","Binary (Windows)",[232,550,551,556],{"__ignoreMap":270},[463,552,553],{"class":465,"line":466},[463,554,555],{"class":469},"# Assumes that the fivenet.exe is in your PATH\n",[463,557,558,561],{"class":465,"line":473},[463,559,560],{"class":476},"fivenet.exe",[463,562,492],{"class":480},[564,565,566],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki