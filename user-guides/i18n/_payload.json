:228,"stem":229},"Employee Management","\u002Fdesign\u002Femployee-management","9.design\u002Femployee-management",{"title":231,"path":232,"stem":233},"Player Tracker Rework","\u002Fdesign\u002Fplayer-tracker-rework","9.design\u002Fplayer-tracker-rework",{"title":235,"path":236,"stem":237},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":239,"title":179,"body":240,"description":246,"extension":389,"links":390,"meta":391,"navigation":392,"path":180,"redirect":390,"seo":393,"stem":181,"__hash__":394},"content_en\u002F3.user-guides\u002F8.i18n.md",{"type":241,"value":242,"toc":381},"minimark",[243,247,254,259,269,278,281,285,294,299,356,358],[244,245,246],"p",{},"FiveNet supports multiple languages.",[244,248,249],{},[250,251],"img",{"alt":252,"src":253},"Feature i18n","\u002Fimages\u002Fscreenshots\u002Ffeatures-i18n.webp",[255,256,258],"h2",{"id":257},"currently-available-languages","Currently Available Languages",[260,261,262,266],"ul",{},[263,264,265],"li",{},"German",[263,267,268],{},"English",[244,270,271,272,277],{},"If you want to add another language, see the ",[273,274,276],"a",{"href":275},"#contributing","contributing section",".",[279,280],"hr",{},[255,282,284],{"id":283},"contributing","Contributing",[244,286,287,288,277],{},"We welcome contributions to improve or expand language support. To add a language or fix translations, create an issue in the FiveNet GitHub project or join directly through ",[273,289,293],{"href":290,"rel":291},"https:\u002F\u002Fpoeditor.com\u002Fjoin\u002Fproject\u002Fhszo85uo3K",[292],"nofollow","FiveNet's POEditor project",[295,296,298],"h3",{"id":297},"how-to-add-a-new-language","How to add a new language",[300,301,302,305,330,342,345],"ol",{},[263,303,304],{},"Create an issue in the FiveNet GitHub project to discuss the language you want to add.",[263,306,307,308],{},"Include the following details in the issue:\n",[260,309,310,318,324],{},[263,311,312,313,317],{},"Language name (for example ",[314,315,316],"code",{},"French",")",[263,319,320,321,317],{},"Language code (for example ",[314,322,323],{},"fr",[263,325,326,327,317],{},"Language icon (for example ",[314,328,329],{},"i-flagpack-fr",[263,331,332,333],{},"After approval, the language will be added to POEditor.\n",[260,334,335],{},[263,336,337,338,277],{},"Then create a POEditor account and join through ",[273,339,341],{"href":290,"rel":340},[292],"the project link",[263,343,344],{},"You can then start translating the strings in the POEditor project.",[263,346,347,348],{},"Developers sync translations from POEditor to FiveNet regularly.\n",[260,349,350,353],{},[263,351,352],{},"After sync and release, the language becomes available in the app.",[263,354,355],{},"If you run into issues, create a GitHub issue or ask in the FiveNet Discord server.",[279,357],{},[359,360,364,372],"card",{"target":361,"title":362,"to":363},"_blank","FiveNet uses POEditor for translations","https:\u002F\u002Fpoeditor.com\u002F",[244,365,366,367,371],{},"Thanks to ",[273,368,370],{"href":363,"rel":369},[292],"POEditor"," for providing FiveNet with a free translation project!",[244,373,374],{},[250,375],{"alt":376,"src":377,":width":378,":zoom":379,"align":380},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":13,"searchDepth":382,"depth":382,"links":383},2,[384,385],{"id":257,"depth":382,"text":258},{"id":283,"depth":382,"text":284,"children":386},[387],{"id":297,"depth":388,"text":298},3,"md",null,{},true,{"title":179,"description":246},"gpzHWxUl9YWlcWNf1eEWMJyuvB9mdfMeKR4iqdcUJ30",1795592555356,"e666030a-7717-4390-a061-5f12bacb18ad"]