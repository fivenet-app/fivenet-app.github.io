},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":171,"body":235,"description":241,"extension":385,"links":386,"meta":387,"navigation":388,"path":172,"redirect":386,"seo":389,"stem":173,"__hash__":390},"content_en\u002F3.user-guides\u002F8.i18n.md",{"type":236,"value":237,"toc":376},"minimark",[238,242,249,254,264,273,276,280,289,294,351,353],[239,240,241],"p",{},"FiveNet supports multiple languages.",[239,243,244],{},[245,246],"img",{"alt":247,"src":248},"Feature i18n","\u002Fimages\u002Fscreenshots\u002Ffeatures-i18n.webp",[250,251,253],"h2",{"id":252},"currently-available-languages","Currently Available Languages",[255,256,257,261],"ul",{},[258,259,260],"li",{},"German",[258,262,263],{},"English",[239,265,266,267,272],{},"If you want to add another language, see the ",[268,269,271],"a",{"href":270},"#contributing","contributing section",".",[274,275],"hr",{},[250,277,279],{"id":278},"contributing","Contributing",[239,281,282,283,272],{},"We welcome contributions to improve or expand language support. To add a language or fix translations, create an issue in the FiveNet GitHub project or join directly through ",[268,284,288],{"href":285,"rel":286},"https:\u002F\u002Fpoeditor.com\u002Fjoin\u002Fproject\u002Fhszo85uo3K",[287],"nofollow","FiveNet's POEditor project",[290,291,293],"h3",{"id":292},"how-to-add-a-new-language","How to add a new language",[295,296,297,300,325,337,340],"ol",{},[258,298,299],{},"Create an issue in the FiveNet GitHub project to discuss the language you want to add.",[258,301,302,303],{},"Include the following details in the issue:\n",[255,304,305,313,319],{},[258,306,307,308,312],{},"Language name (for example ",[309,310,311],"code",{},"French",")",[258,314,315,316,312],{},"Language code (for example ",[309,317,318],{},"fr",[258,320,321,322,312],{},"Language icon (for example ",[309,323,324],{},"i-flagpack-fr",[258,326,327,328],{},"After approval, the language will be added to POEditor.\n",[255,329,330],{},[258,331,332,333,272],{},"Then create a POEditor account and join through ",[268,334,336],{"href":285,"rel":335},[287],"the project link",[258,338,339],{},"You can then start translating the strings in the POEditor project.",[258,341,342,343],{},"Developers sync translations from POEditor to FiveNet regularly.\n",[255,344,345,348],{},[258,346,347],{},"After sync and release, the language becomes available in the app.",[258,349,350],{},"If you run into issues, create a GitHub issue or ask in the FiveNet Discord server.",[274,352],{},[354,355,359,367],"card",{"target":356,"title":357,"to":358},"_blank","FiveNet uses POEditor for translations","https:\u002F\u002Fpoeditor.com\u002F",[239,360,361,362,366],{},"Thanks to ",[268,363,365],{"href":358,"rel":364},[287],"POEditor"," for providing FiveNet with a free translation project!",[239,368,369],{},[245,370],{"alt":371,"src":372,":width":373,":zoom":374,"align":375},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":377,"searchDepth":378,"depth":378,"links":379},"",2,[380,381],{"id":252,"depth":378,"text":253},{"id":278,"depth":378,"text":279,"children":382},[383],{"id":292,"depth":384,"text":293},3,"md",null,{},true,{"title":171,"description":241},"gpzHWxUl9YWlcWNf1eEWMJyuvB9mdfMeKR4iqdcUJ30",[392,394],{"title":167,"path":168,"stem":169,"description":393,"children":-1},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.",{"title":175,"path":176,"stem":177,"description":377,"children":-1},1789177164985]