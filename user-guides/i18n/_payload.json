,{"type":204,"value":205,"toc":344},"minimark",[206,210,217,222,232,241,244,248,257,262,319,321],[207,208,209],"p",{},"FiveNet supports multiple languages.",[207,211,212],{},[213,214],"img",{"alt":215,"src":216},"Feature i18n","\u002Fimages\u002Fscreenshots\u002Ffeatures-i18n.webp",[218,219,221],"h2",{"id":220},"currently-available-languages","Currently Available Languages",[223,224,225,229],"ul",{},[226,227,228],"li",{},"German",[226,230,231],{},"English",[207,233,234,235,240],{},"If you want to add another language, see the ",[236,237,239],"a",{"href":238},"#contributing","contributing section",".",[242,243],"hr",{},[218,245,247],{"id":246},"contributing","Contributing",[207,249,250,251,240],{},"We welcome contributions to improve or expand language support. To add a language or fix translations, create an issue in the FiveNet GitHub project or join directly through ",[236,252,256],{"href":253,"rel":254},"https:\u002F\u002Fpoeditor.com\u002Fjoin\u002Fproject\u002Fhszo85uo3K",[255],"nofollow","FiveNet's POEditor project",[258,259,261],"h3",{"id":260},"how-to-add-a-new-language","How to add a new language",[263,264,265,268,293,305,308],"ol",{},[226,266,267],{},"Create an issue in the FiveNet GitHub project to discuss the language you want to add.",[226,269,270,271],{},"Include the following details in the issue:\n",[223,272,273,281,287],{},[226,274,275,276,280],{},"Language name (for example ",[277,278,279],"code",{},"French",")",[226,282,283,284,280],{},"Language code (for example ",[277,285,286],{},"fr",[226,288,289,290,280],{},"Language icon (for example ",[277,291,292],{},"i-flagpack-fr",[226,294,295,296],{},"After approval, the language will be added to POEditor.\n",[223,297,298],{},[226,299,300,301,240],{},"Then create a POEditor account and join through ",[236,302,304],{"href":253,"rel":303},[255],"the project link",[226,306,307],{},"You can then start translating the strings in the POEditor project.",[226,309,310,311],{},"Developers sync translations from POEditor to FiveNet regularly.\n",[223,312,313,316],{},[226,314,315],{},"After sync and release, the language becomes available in the app.",[226,317,318],{},"If you run into issues, create a GitHub issue or ask in the FiveNet Discord server.",[242,320],{},[322,323,327,335],"card",{"target":324,"title":325,"to":326},"_blank","FiveNet uses POEditor for translations","https:\u002F\u002Fpoeditor.com\u002F",[207,328,329,330,334],{},"Thanks to ",[236,331,333],{"href":326,"rel":332},[255],"POEditor"," for providing FiveNet with a free translation project!",[207,336,337],{},[213,338],{"alt":339,"src":340,":width":341,":zoom":342,"align":343},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":345,"searchDepth":346,"depth":346,"links":347},"",2,[348,349],{"id":220,"depth":346,"text":221},{"id":246,"depth":346,"text":247,"children":350},[351],{"id":260,"depth":352,"text":261},3,"md",null,{},true,"\u002Fuser-guides\u002Fi18n",{"title":202,"description":209},"3.user-guides\u002F8.i18n","gpzHWxUl9YWlcWNf1eEWMJyuvB9mdfMeKR4iqdcUJ30",[362,367],{"title":363,"path":364,"stem":365,"description":366,"children":-1},"Settings","\u002Fuser-guides\u002Fsettings","3.user-guides\u002F7.settings","Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.",{"title":368,"path":369,"stem":370,"description":345,"children":-1},"iOS App","\u002Fuser-guides\u002Fios-app","3.user-guides\u002F9.ios-app",1789078696832]