9,240],"li",{},"German",[238,242,243],{},"English",[219,245,246,247,252],{},"If you want to add another language, see the ",[248,249,251],"a",{"href":250},"#contributing","contributing section",".",[254,255],"hr",{},[230,257,259],{"id":258},"contributing","Contributing",[219,261,262,263,252],{},"We welcome contributions to improve or expand language support. To add a language or fix translations, create an issue in the FiveNet GitHub project or join directly through ",[248,264,268],{"href":265,"rel":266},"https:\u002F\u002Fpoeditor.com\u002Fjoin\u002Fproject\u002Fhszo85uo3K",[267],"nofollow","FiveNet's POEditor project",[270,271,273],"h3",{"id":272},"how-to-add-a-new-language","How to add a new language",[275,276,277,280,305,317,320],"ol",{},[238,278,279],{},"Create an issue in the FiveNet GitHub project to discuss the language you want to add.",[238,281,282,283],{},"Include the following details in the issue:\n",[235,284,285,293,299],{},[238,286,287,288,292],{},"Language name (for example ",[289,290,291],"code",{},"French",")",[238,294,295,296,292],{},"Language code (for example ",[289,297,298],{},"fr",[238,300,301,302,292],{},"Language icon (for example ",[289,303,304],{},"i-flagpack-fr",[238,306,307,308],{},"After approval, the language will be added to POEditor.\n",[235,309,310],{},[238,311,312,313,252],{},"Then create a POEditor account and join through ",[248,314,316],{"href":265,"rel":315},[267],"the project link",[238,318,319],{},"You can then start translating the strings in the POEditor project.",[238,321,322,323],{},"Developers sync translations from POEditor to FiveNet regularly.\n",[235,324,325,328],{},[238,326,327],{},"After sync and release, the language becomes available in the app.",[238,329,330],{},"If you run into issues, create a GitHub issue or ask in the FiveNet Discord server.",[254,332],{},[334,335,339,347],"card",{"target":336,"title":337,"to":338},"_blank","FiveNet uses POEditor for translations","https:\u002F\u002Fpoeditor.com\u002F",[219,340,341,342,346],{},"Thanks to ",[248,343,345],{"href":338,"rel":344},[267],"POEditor"," for providing FiveNet with a free translation project!",[219,348,349],{},[225,350],{"alt":351,"src":352,":width":353,":zoom":354,"align":355},"POEditor Logo","\u002Fimages\u002Fpoeditor-logo.svg","150","false","center",{"title":357,"searchDepth":358,"depth":358,"links":359},"",2,[360,361],{"id":232,"depth":358,"text":233},{"id":258,"depth":358,"text":259,"children":362},[363],{"id":272,"depth":364,"text":273},3,"md",null,{},true,{"title":155,"description":221},"gpzHWxUl9YWlcWNf1eEWMJyuvB9mdfMeKR4iqdcUJ30",[372,374],{"title":151,"path":152,"stem":153,"description":373,"children":-1},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.",{"title":159,"path":160,"stem":161,"description":357,"children":-1},1788139789625]