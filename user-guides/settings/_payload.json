12],"h2",{"id":232},"features",[234,235,236,240,243],"ul",{},[237,238,239],"li",{},"Configure job properties such as logo, radio frequency, and Discord bot sync.",[237,241,242],{},"Configure instance-level FiveNet options through the UI (server team).",[237,244,245,246],{},"For superusers:\n",[234,247,248,255,261,267],{},[237,249,250,254],{},[251,252,253],"strong",{},"Limiter",": Define which permissions each faction can assign to roles.",[237,256,257,260],{},[251,258,259],{},"Laws",": Configure law entries for each faction.",[237,262,263,266],{},[251,264,265],{},"Filestore",": Configure file storage per faction.",[237,268,269,272],{},[251,270,271],{},"App config",": Configure options that affect the entire FiveNet instance.",[230,274,276],{"id":275},"role-management","Role Management",[219,278,279],{},"Factions can manage their own roles when this is allowed by the permission system.",[219,281,282],{},[222,283],{"alt":284,"src":285},"features-settings-roles.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-roles.webp",[230,287,289],{"id":288},"limiter-and-roles-explained","Limiter And Roles Explained",[219,291,292],{},"To allow role self-service safely, use the limiter to define the maximum permission set a faction can assign.\nFor example, you can allow the police faction to see colleague positions on the livemap, while preventing unauthorized factions from assigning that permission.\nIn practice, the limiter is a list of permissions and attributes available to roles within a faction.",[219,294,295],{},"Usually, the server management team defines these limits for each faction.",[230,297,299],{"id":298},"discord-bot-sync-roles-to-your-factions-discord","Discord Bot - Sync roles to your faction's Discord",[219,301,302],{},"Sync examples:",[234,304,305,308,311],{},[237,306,307],{},"Employee ranks",[237,309,310],{},"Absent\u002Fvacation status",[237,312,313,314,318],{},"Server-team groups on Discord servers connected to FiveNet (for example a ",[315,316,317],"code",{},"Project Leader"," role)",[219,320,321],{},[222,322],{"alt":323,"src":324},"Feature Settings - Job Props - Discord Bot","\u002Fimages\u002Fscreenshots\u002Ffeatures-discordbot.webp",[230,326,328],{"id":327},"app-config","App Config",[219,330,331],{},[222,332],{"alt":333,"src":334},"Feature Settings - App Config","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-appconfig.webp",[219,336,337],{},"App config contains options that affect the whole FiveNet instance, including:",[234,339,340,343,346,349,352,355],{},[237,341,342],{},"The default language for the app.",[237,344,345],{},"Default permissions.",[237,347,348],{},"Imprint and Privacy Policy links.",[237,350,351],{},"Livemap sync intervals.",[237,353,354],{},"Banner message with expiration time (for example to announce maintenance).",[237,356,357],{},"And more.",{"title":359,"searchDepth":360,"depth":360,"links":361},"",2,[362,363,364,365,366],{"id":232,"depth":360,"text":12},{"id":275,"depth":360,"text":276},{"id":288,"depth":360,"text":289},{"id":298,"depth":360,"text":299},{"id":327,"depth":360,"text":328},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.","md",null,{},true,{"title":151,"description":367},"55vLMLgIY1GeHaFsgf81izPAfEv7G1PM8n8Tr8OtcYE",[375,376],{"title":147,"path":148,"stem":149,"description":359,"children":-1},{"title":155,"path":156,"stem":157,"description":377,"children":-1},"FiveNet supports multiple languages.",1788139791868]