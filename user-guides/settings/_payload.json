ngs",{"type":204,"value":205,"toc":347},"minimark",[206,214,217,222,262,266,269,275,279,282,285,289,292,308,314,318,324,327],[207,208,209],"p",{},[210,211],"img",{"alt":212,"src":213},"features-settings.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings.webp",[207,215,216],{},"The screenshot also includes admin-only settings (for example limiter, laws, filestore, and app config).",[218,219,221],"h2",{"id":220},"features","Features",[223,224,225,229,232],"ul",{},[226,227,228],"li",{},"Configure job properties such as logo, radio frequency, and Discord bot sync.",[226,230,231],{},"Configure instance-level FiveNet options through the UI (server team).",[226,233,234,235],{},"For superusers:\n",[223,236,237,244,250,256],{},[226,238,239,243],{},[240,241,242],"strong",{},"Limiter",": Define which permissions each faction can assign to roles.",[226,245,246,249],{},[240,247,248],{},"Laws",": Configure law entries for each faction.",[226,251,252,255],{},[240,253,254],{},"Filestore",": Configure file storage per faction.",[226,257,258,261],{},[240,259,260],{},"App config",": Configure options that affect the entire FiveNet instance.",[218,263,265],{"id":264},"role-management","Role Management",[207,267,268],{},"Factions can manage their own roles when this is allowed by the permission system.",[207,270,271],{},[210,272],{"alt":273,"src":274},"features-settings-roles.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-roles.webp",[218,276,278],{"id":277},"limiter-and-roles-explained","Limiter And Roles Explained",[207,280,281],{},"To allow role self-service safely, use the limiter to define the maximum permission set a faction can assign.\nFor example, you can allow the police faction to see colleague positions on the livemap, while preventing unauthorized factions from assigning that permission.\nIn practice, the limiter is a list of permissions and attributes available to roles within a faction.",[207,283,284],{},"Usually, the server management team defines these limits for each faction.",[218,286,288],{"id":287},"discord-bot-sync-roles-to-your-factions-discord","Discord Bot - Sync roles to your faction's Discord",[207,290,291],{},"Sync examples:",[223,293,294,297,300],{},[226,295,296],{},"Employee ranks",[226,298,299],{},"Absent\u002Fvacation status",[226,301,302,303,307],{},"Server-team groups on Discord servers connected to FiveNet (for example a ",[304,305,306],"code",{},"Project Leader"," role)",[207,309,310],{},[210,311],{"alt":312,"src":313},"Feature Settings - Job Props - Discord Bot","\u002Fimages\u002Fscreenshots\u002Ffeatures-discordbot.webp",[218,315,317],{"id":316},"app-config","App Config",[207,319,320],{},[210,321],{"alt":322,"src":323},"Feature Settings - App Config","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-appconfig.webp",[207,325,326],{},"App config contains options that affect the whole FiveNet instance, including:",[223,328,329,332,335,338,341,344],{},[226,330,331],{},"The default language for the app.",[226,333,334],{},"Default permissions.",[226,336,337],{},"Imprint and Privacy Policy links.",[226,339,340],{},"Livemap sync intervals.",[226,342,343],{},"Banner message with expiration time (for example to announce maintenance).",[226,345,346],{},"And more.",{"title":348,"searchDepth":349,"depth":349,"links":350},"",2,[351,352,353,354,355],{"id":220,"depth":349,"text":221},{"id":264,"depth":349,"text":265},{"id":277,"depth":349,"text":278},{"id":287,"depth":349,"text":288},{"id":316,"depth":349,"text":317},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.","md",null,{},true,"\u002Fuser-guides\u002Fsettings",{"title":202,"description":356},"3.user-guides\u002F7.settings","55vLMLgIY1GeHaFsgf81izPAfEv7G1PM8n8Tr8OtcYE",[366,369],{"title":162,"path":367,"stem":368,"description":348,"children":-1},"\u002Fuser-guides\u002Fmailer","3.user-guides\u002F6.mailer",{"title":370,"path":371,"stem":372,"description":373,"chi