tem":232},"Qualifications","\u002Fdesign\u002Fqualifications","9.design\u002Fqualifications",{"id":234,"title":167,"body":235,"description":387,"extension":388,"links":389,"meta":390,"navigation":391,"path":168,"redirect":389,"seo":392,"stem":169,"__hash__":393},"content_en\u002F3.user-guides\u002F7.settings.md",{"type":236,"value":237,"toc":378},"minimark",[238,246,249,253,293,297,300,306,310,313,316,320,323,339,345,349,355,358],[239,240,241],"p",{},[242,243],"img",{"alt":244,"src":245},"features-settings.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings.webp",[239,247,248],{},"The screenshot also includes admin-only settings (for example limiter, laws, filestore, and app config).",[250,251,12],"h2",{"id":252},"features",[254,255,256,260,263],"ul",{},[257,258,259],"li",{},"Configure job properties such as logo, radio frequency, and Discord bot sync.",[257,261,262],{},"Configure instance-level FiveNet options through the UI (server team).",[257,264,265,266],{},"For superusers:\n",[254,267,268,275,281,287],{},[257,269,270,274],{},[271,272,273],"strong",{},"Limiter",": Define which permissions each faction can assign to roles.",[257,276,277,280],{},[271,278,279],{},"Laws",": Configure law entries for each faction.",[257,282,283,286],{},[271,284,285],{},"Filestore",": Configure file storage per faction.",[257,288,289,292],{},[271,290,291],{},"App config",": Configure options that affect the entire FiveNet instance.",[250,294,296],{"id":295},"role-management","Role Management",[239,298,299],{},"Factions can manage their own roles when this is allowed by the permission system.",[239,301,302],{},[242,303],{"alt":304,"src":305},"features-settings-roles.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-roles.webp",[250,307,309],{"id":308},"limiter-and-roles-explained","Limiter And Roles Explained",[239,311,312],{},"To allow role self-service safely, use the limiter to define the maximum permission set a faction can assign.\nFor example, you can allow the police faction to see colleague positions on the livemap, while preventing unauthorized factions from assigning that permission.\nIn practice, the limiter is a list of permissions and attributes available to roles within a faction.",[239,314,315],{},"Usually, the server management team defines these limits for each faction.",[250,317,319],{"id":318},"discord-bot-sync-roles-to-your-factions-discord","Discord Bot - Sync roles to your faction's Discord",[239,321,322],{},"Sync examples:",[254,324,325,328,331],{},[257,326,327],{},"Employee ranks",[257,329,330],{},"Absent\u002Fvacation status",[257,332,333,334,338],{},"Server-team groups on Discord servers connected to FiveNet (for example a ",[335,336,337],"code",{},"Project Leader"," role)",[239,340,341],{},[242,342],{"alt":343,"src":344},"Feature Settings - Job Props - Discord Bot","\u002Fimages\u002Fscreenshots\u002Ffeatures-discordbot.webp",[250,346,348],{"id":347},"app-config","App Config",[239,350,351],{},[242,352],{"alt":353,"src":354},"Feature Settings - App Config","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-appconfig.webp",[239,356,357],{},"App config contains options that affect the whole FiveNet instance, including:",[254,359,360,363,366,369,372,375],{},[257,361,362],{},"The default language for the app.",[257,364,365],{},"Default permissions.",[257,367,368],{},"Imprint and Privacy Policy links.",[257,370,371],{},"Livemap sync intervals.",[257,373,374],{},"Banner message with expiration time (for example to announce maintenance).",[257,376,377],{},"And more.",{"title":379,"searchDepth":380,"depth":380,"links":381},"",2,[382,383,384,385,386],{"id":252,"depth":380,"text":12},{"id":295,"depth":380,"text":296},{"id":308,"depth":380,"text":309},{"id":318,"depth":380,"text":319},{"id":347,"depth":380,"text":348},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.","md",null,{},true,{"title":167,"description":387},"55vLMLgIY1GeHaFsgf81izPAfEv7G1PM8n8Tr8OtcYE",[395,396],{"title":163,"path":164,"stem":165,"description":379,"children":-1},{"title":171,"path":172,"stem":173,"description":397,"children":-1},"FiveNet supports multiple languages.",1789078883289]