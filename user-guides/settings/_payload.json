"Limiter",": Define which permissions each faction can assign to roles.",[206,225,226,229],{},[220,227,228],{},"Laws",": Configure law entries for each faction.",[206,231,232,235],{},[220,233,234],{},"Filestore",": Configure file storage per faction.",[206,237,238,241],{},[220,239,240],{},"App config",": Configure options that affect the entire FiveNet instance.",[198,243,245],{"id":244},"role-management","Role Management",[187,247,248],{},"Factions can manage their own roles when this is allowed by the permission system.",[187,250,251],{},[190,252],{"alt":253,"src":254},"features-settings-roles.webp","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-roles.webp",[198,256,258],{"id":257},"limiter-and-roles-explained","Limiter And Roles Explained",[187,260,261],{},"To allow role self-service safely, use the limiter to define the maximum permission set a faction can assign.\nFor example, you can allow the police faction to see colleague positions on the livemap, while preventing unauthorized factions from assigning that permission.\nIn practice, the limiter is a list of permissions and attributes available to roles within a faction.",[187,263,264],{},"Usually, the server management team defines these limits for each faction.",[198,266,268],{"id":267},"discord-bot-sync-roles-to-your-factions-discord","Discord Bot - Sync roles to your faction's Discord",[187,270,271],{},"Sync examples:",[203,273,274,277,280],{},[206,275,276],{},"Employee ranks",[206,278,279],{},"Absent\u002Fvacation status",[206,281,282,283,287],{},"Server-team groups on Discord servers connected to FiveNet (for example a ",[284,285,286],"code",{},"Project Leader"," role)",[187,289,290],{},[190,291],{"alt":292,"src":293},"Feature Settings - Job Props - Discord Bot","\u002Fimages\u002Fscreenshots\u002Ffeatures-discordbot.webp",[198,295,297],{"id":296},"app-config","App Config",[187,299,300],{},[190,301],{"alt":302,"src":303},"Feature Settings - App Config","\u002Fimages\u002Fscreenshots\u002Ffeatures-settings-appconfig.webp",[187,305,306],{},"App config contains options that affect the whole FiveNet instance, including:",[203,308,309,312,315,318,321,324],{},[206,310,311],{},"The default language for the app.",[206,313,314],{},"Default permissions.",[206,316,317],{},"Imprint and Privacy Policy links.",[206,319,320],{},"Livemap sync intervals.",[206,322,323],{},"Banner message with expiration time (for example to announce maintenance).",[206,325,326],{},"And more.",{"title":328,"searchDepth":329,"depth":329,"links":330},"",2,[331,332,333,334,335],{"id":200,"depth":329,"text":201},{"id":244,"depth":329,"text":245},{"id":257,"depth":329,"text":258},{"id":267,"depth":329,"text":268},{"id":296,"depth":329,"text":297},"Learn how to configure and manage settings in FiveNet, including job properties, roles, permissions, and app-wide configurations.","md",null,{},true,"\u002Fuser-guides\u002Fsettings",{"title":182,"description":336},"3.user-guides\u002F7.settings","55vLMLgIY1GeHaFsgf81izPAfEv7G1PM8n8Tr8OtcYE",[346,349],{"title":146,"path":347,"stem":348,"description":328,"children":-1},"\u002Fuser-guides\u002Fmailer","3.user-guides\u002F6.mailer",{"title":350,"path":351,"stem":352,"description":353,"children":-1},"Languages (i18n)","\u002Fuser-guides\u002Fi18n","3.user-guides\u002F8.i18n","FiveNet supports multiple languages.",1787913099637]